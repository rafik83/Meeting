{
    "name": "proximum/vimeet",
    "description": "The proximum/vimeet project",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Proximum\\Vimeet\\": "src/"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Proximum\\Vimeet\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.2",
        "ext-json": "*",
        "symfony/symfony": "^3.4.39",
        "doctrine/orm": "^2.6.1",
        "doctrine/doctrine-bundle": "^1.12",
        "symfony/swiftmailer-bundle": "^3.1.6",
        "symfony/monolog-bundle": "^3.3.0",
        "symfony/polyfill-apcu": "^1.10",
        "sensio/distribution-bundle": "~5.0.19",
        "sensio/framework-extra-bundle": "^5.0",
        "incenteev/composer-parameter-handler": "~2.1",
        "league/tactician": "^1.0.3",
        "league/tactician-bundle": "^1.1.5",
        "league/tactician-doctrine": "^1.1.1",
        "sonata-project/intl-bundle": "^2.3",
        "friendsofsymfony/elastica-bundle": "^v4.0",
        "pagerfanta/pagerfanta": "^1.0",
        "elao/form-translation-bundle": "^2.0",
        "doctrine/doctrine-fixtures-bundle": "~2.3",
        "erusev/parsedown": "^1.7.1",
        "ocramius/proxy-manager": "~2.1.0",
        "twig/extensions": "^1.3",
        "fzaninotto/faker": "^1.8",
        "liip/imagine-bundle": "^2.3",
        "doctrine/doctrine-migrations-bundle": "^1.0",
        "php-http/guzzle6-adapter": "^1.1",
        "payum/payum-bundle": "^2.1",
        "payum/offline": "^1.3",
        "payum/paypal-express-checkout-nvp": "^1.3",
        "sendgrid/sendgrid": "^5.1",
        "egulias/email-validator": "~2.1",
        "jms/job-queue-bundle": "^2.1.0",
        "sentry/sentry-symfony": "^3.0",
        "opentok/opentok": "^4.4.1",
        "twig/twig": "^1.42",
        "tilleuls/ovh-bundle": "^1.0.1",
        "league/iso3166": "^2.1",
        "defuse/php-encryption": "^2.2",
        "ruflin/elastica": "^3.2",
        "endroid/qr-code": "^3.4",
        "behat/transliterator": "^1.2",
        "snc/redis-bundle": "^3.2.3",
        "predis/predis": "^1.1",
        "twilio/sdk": "^5.27",
        "knpuniversity/oauth2-client-bundle": "^1.28",
        "league/oauth2-google": "^3.0",
        "league/oauth2-linkedin": "^5.1",
        "scssphp/scssphp": "^1.1.0",
        "league/flysystem": "^1.0",
        "superbalist/flysystem-google-storage": "^7.2",
        "yohang88/letter-avatar": "^2.2",
        "ramsey/uuid": "^4.1",
        "league/flysystem-aws-s3-v3": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^7",
        "behat/symfony2-extension": "^2.1.3",
        "behat/mink": "^1.8.1",
        "behat/mink-extension": "^2.3.0",
        "behat/mink-selenium2-driver": "~1.3.1",
        "behat/mink-browserkit-driver": "~1.3.2",
        "behat/mink-goutte-driver": "~1.2.1",
        "friendsofphp/php-cs-fixer": "^2.12",
        "behatch/contexts": "^3.2",
        "phpspec/prophecy": "^1.10.3",
        "friends-of-behat/context-service-extension": "^1.0",
        "hautelook/alice-bundle": "^1.4.1",
        "theofidry/alice-bundle-extension": "^1.3",
        "behat/behat": "^3.4.3",
        "phpstan/phpstan": "^0.12.25"
    },
    "scripts": {
        "symfony-scripts": [
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile"
        ],
        "post-install-cmd": [
            "@symfony-scripts"
        ],
        "post-update-cmd": [
            "@symfony-scripts"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "process-timeout": 600
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        }
    }
}
