{
    "name": "proximum/vimeet",
    "description": "The proximum/vimeet project",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Proximum\\Vimeet\\": "src/",
            "SymfonyStandard\\": "app/SymfonyStandard/"
        }
    },
    "require": {
        "php": ">=5.3.9",
        "symfony/symfony": "2.7.*",
        "doctrine/orm": "^2.5.0",
        "doctrine/doctrine-bundle": "~1.4",
        "symfony/swiftmailer-bundle": "~2.3",
        "symfony/monolog-bundle": "~2.4",
        "sensio/distribution-bundle": "~4.0",
        "sensio/framework-extra-bundle": "^3.0.2",
        "incenteev/composer-parameter-handler": "~2.0",

        "sonata-project/intl-bundle": "2.2.*",
        "friendsofsymfony/elastica-bundle": "^3.1",
        "elao/form-bundle": "^1.0@dev",
        "elao/form-translation-bundle": "1.2.*",
        "elao/theme-twitter-bootstrap-3-bundle": "~1.0",
        "nelmio/alice": "2.1.*",
        "doctrine/doctrine-fixtures-bundle": "2.2.*",
        "maximecolin/satisfaction": "~1.0",
        "knplabs/knp-paginator-bundle": "^2.5"
    },
    "require-dev": {
        "sensio/generator-bundle": "~2.3",

        "phpunit/phpunit": "~5.0",

        "behat/behat": "3.0.*",
        "behat/mink-selenium2-driver": "1.2.*",
        "knplabs/friendly-contexts": "0.5.*",
        "behat/symfony2-extension": "2.0.*",
        "behat/mink-browserkit-driver": "1.2.*",
        "behat/mink-extension": "~2.0",
        "behat/mink-goutte-driver": "~1.1",

        "hautelook/alice-bundle": "~1.0",
        "theofidry/alice-bundle-extension": "v1.1.0",
        "fabpot/php-cs-fixer": "^1.10"
    },
    "scripts": {
        "post-create-project-cmd": [
            "SymfonyStandard\\Composer::hookCreateProject"
        ],
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "process-timeout": 600
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        }
    }
}
