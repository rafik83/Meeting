{
  "name": "proximum/vimeet",
  "description": "The proximum/vimeet project",
  "license": "proprietary",
  "type": "project",
  "autoload": {
    "psr-4": {
      "Proximum\\Vimeet\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Proximum\\Vimeet\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^7.4",
    "ext-json": "*",
    "ext-simplexml": "*",
    "ext-soap": "*",
    "ext-zip": "*",
    "composer/package-versions-deprecated": "1.11.99.1",
    "defuse/php-encryption": "^2.2",
    "doctrine/doctrine-bundle": "^2.2",
    "doctrine/doctrine-migrations-bundle": "^3.0",
    "doctrine/orm": "^2.8",
    "egulias/email-validator": "~2.1",
    "elao/form-translation-bundle": "^3.0",
    "eluceo/ical": "^0.16.1",
    "endroid/qr-code": "^3.4",
    "friendsofsymfony/elastica-bundle": "^5.1",
    "knpuniversity/oauth2-client-bundle": "^1.28",
    "league/commonmark": "^1.5",
    "league/flysystem": "^1.0",
    "league/flysystem-aws-s3-v3": "^1.0",
    "league/iso3166": "^2.1",
    "league/oauth2-google": "^3.0",
    "league/oauth2-linkedin": "^5.1",
    "league/tactician": "^1.0.3",
    "league/tactician-bundle": "^1.1.5",
    "league/tactician-doctrine": "^1.1.1",
    "liip/imagine-bundle": "^2.3",
    "ocramius/proxy-manager": "^2.2",
    "opentok/opentok": "^4.4.1",
    "pagerfanta/pagerfanta": "^1.0",
    "payum/offline": "^1.3",
    "payum/paypal-express-checkout-nvp": "^1.3",
    "payum/payum-bundle": "^2.1",
    "php-http/guzzle6-adapter": "^1.1",
    "phpdocumentor/reflection-docblock": "^5.2",
    "predis/predis": "^1.1",
    "ramsey/uuid": "^4.1",
    "ruflin/elastica": "^6.1.1",
    "scssphp/scssphp": "^1.1.0",
    "sendgrid/php-http-client": "~3.7.0",
    "sendgrid/sendgrid": "^5.6.2",
    "sensio/framework-extra-bundle": "^5.1",
    "sentry/sentry-symfony": "^3.0",
    "snc/redis-bundle": "^3.2.3",
    "sonata-project/intl-bundle": "^2.3",
    "superbalist/flysystem-google-storage": "^7.2",
    "symfony/asset": "4.4.*",
    "symfony/console": "4.4.*",
    "symfony/dotenv": "4.4.*",
    "symfony/expression-language": "4.4.*",
    "symfony/flex": "^1.3.1",
    "symfony/form": "4.4.*",
    "symfony/framework-bundle": "4.4.*",
    "symfony/http-client": "4.4.*",
    "symfony/intl": "4.4.*",
    "symfony/lock": "4.4.*",
    "symfony/mailer": "4.4.*",
    "symfony/messenger": "4.4.*",
    "symfony/monolog-bundle": "^3.1",
    "symfony/process": "4.4.*",
    "symfony/property-access": "4.4.*",
    "symfony/property-info": "4.4.*",
    "symfony/proxy-manager-bridge": "4.4.*",
    "symfony/security-bundle": "4.4.*",
    "symfony/serializer": "4.4.*",
    "symfony/swiftmailer-bundle": "^3.5",
    "symfony/translation": "4.4.*",
    "symfony/twig-bundle": "^4.4",
    "symfony/validator": "4.4.*",
    "symfony/web-link": "4.4.*",
    "symfony/yaml": "4.4.*",
    "tilleuls/ovh-bundle": "^1.0.1",
    "twig/extensions": "^1.5",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/twig": "^2.12|^3.0",
    "twilio/sdk": "^5.27",
    "yohang88/letter-avatar": "^2.2"
  },
  "require-dev": {
    "behat/behat": "^3.4.3",
    "behatch/contexts": "^3.2",
    "friends-of-behat/mink": "^1.9",
    "friends-of-behat/mink-browserkit-driver": "^1.5",
    "friends-of-behat/mink-extension": "^2.5",
    "friends-of-behat/symfony-extension": "^2.0",
    "friendsofphp/php-cs-fixer": "^2.12",
    "hautelook/alice-bundle": "^2.8",
    "phpspec/prophecy": "^1.10.3",
    "phpstan/phpstan": "^0.12.25",
    "phpunit/phpunit": "^7",
    "symfony/debug-bundle": "4.4.*",
    "symfony/maker-bundle": "^1.29",
    "symfony/phpunit-bridge": "^5.2",
    "symfony/stopwatch": "4.4.*",
    "symfony/var-dumper": "4.4.*",
    "symfony/web-profiler-bundle": "4.4.*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "config": {
    "bin-dir": "bin",
    "preferred-install": {
      "*": "dist"
    },
    "process-timeout": 600,
    "sort-packages": true
  },
  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony-app-dir": "app",
    "symfony-bin-dir": "bin",
    "symfony-var-dir": "var",
    "symfony-web-dir": "web",
    "symfony-tests-dir": "tests",
    "symfony-assets-install": "relative"
  }
}
