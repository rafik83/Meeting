{
    "name": "proximum/vimeet",
    "description": "The proximum/vimeet project",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Proximum\\Vimeet\\": "src/",
            "Tests\\": "tests/",
            "SymfonyStandard\\": "app/SymfonyStandard/"
        },
        "files": [ "app/AppKernel.php" ]
    },
    "require": {
        "php": ">=5.3.9",
        "symfony/symfony": "~3.0",
        "doctrine/orm": "^2.5.0",
        "doctrine/doctrine-bundle": "~1.6",
        "symfony/swiftmailer-bundle": "~2.3",
        "symfony/monolog-bundle": "~2.8",
        "sensio/distribution-bundle": "~5.0",
        "sensio/framework-extra-bundle": "^3.0.2",
        "incenteev/composer-parameter-handler": "~2.1",

        "sonata-project/intl-bundle": "2.2.*@dev",
        "friendsofsymfony/elastica-bundle": "3.2.*@dev",
        "pagerfanta/pagerfanta": "^1.0",
        "elao/form-bundle": "^2.0.1",
        "elao/form-translation-bundle": "~1.4",
        "elao/theme-twitter-bootstrap-3-bundle": "2.0",
        "elao/error-notifier-bundle": "1.0.7",
        "nelmio/alice": "2.1.*",
        "doctrine/doctrine-fixtures-bundle": "~2.3"
    },
    "require-dev": {
        "sensio/generator-bundle": "~3.0",

        "phpunit/phpunit": "~5.0",

        "behat/behat": "3.1.*@dev",
        "behat/symfony2-extension": "2.1.*@dev",
        "behat/mink": "~1.7@dev",
        "behat/mink-extension": "2.1.*@dev",
        "behat/mink-selenium2-driver": "1.3.*@dev",
        "behat/mink-browserkit-driver": "1.3.*@dev",
        "behat/mink-goutte-driver": "1.2.*@dev",
        "theofidry/alice-bundle-extension": "~1.1@dev",
        "hautelook/alice-bundle": "1.*@dev",
        "fabpot/php-cs-fixer": "^1.10"
    },
    "scripts": {
        "post-create-project-cmd": [
            "SymfonyStandard\\Composer::hookCreateProject"
        ],
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "process-timeout": 600
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        }
    }
}
