{
    "name": "proximum/vimeet",
    "description": "The proximum/vimeet project",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Proximum\\Vimeet\\": "src/"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Proximum\\Vimeet\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.1",
        "symfony/symfony": "v3.4.11",
        "doctrine/orm": "^2.6.1",
        "doctrine/doctrine-bundle": "~1.6",
        "symfony/swiftmailer-bundle": "^3.1.6",
        "symfony/monolog-bundle": "^3.1.0",
        "symfony/polyfill-apcu": "^1.0",
        "sensio/distribution-bundle": "~5.0.19",
        "sensio/framework-extra-bundle": "^3.0.2",
        "incenteev/composer-parameter-handler": "~2.1",
        "league/tactician": "^1.0.3",
        "league/tactician-bundle": "^1.1.5",
        "league/tactician-doctrine": "^1.1.1",
        "sonata-project/intl-bundle": "^2.3",
        "friendsofsymfony/elastica-bundle": "v4.0.1",
        "pagerfanta/pagerfanta": "^1.0",
        "elao/form-bundle": "^2.1",
        "elao/form-translation-bundle": "^2.0",
        "elao/theme-twitter-bootstrap-3-bundle": "^2.0@dev",
        "doctrine/doctrine-fixtures-bundle": "~2.3",
        "erusev/parsedown": "^1.7.1",
        "leafo/scssphp": "^0.7.5",
        "ocramius/proxy-manager": "~2.1.0",
        "twig/extensions": "^1.3",
        "fzaninotto/faker": "^1.6",
        "liip/imagine-bundle": "1.6.*",
        "doctrine/doctrine-migrations-bundle": "^1.0",
        "php-http/guzzle6-adapter": "^1.1",
        "payum/payum-bundle": "^2.1",
        "payum/offline": "^1.3",
        "payum/paypal-express-checkout-nvp": "^1.3",
        "sendgrid/sendgrid": "^5.1",
        "egulias/email-validator": "~2.1",
        "jms/job-queue-bundle": "^1.4.2",
        "sentry/sentry-symfony": "~2.0.1",
        "behat/behat": "^3.3.1",
        "opentok/opentok": "^3.0",
        "twig/twig": "~1.35",
        "tilleuls/ovh-bundle": "^1.0.1",
        "league/iso3166": "^2.1",
        "defuse/php-encryption": "^2.2"
    },
    "require-dev": {
        "sensio/generator-bundle": "~3.0",
        "phpunit/phpunit": "^6.0",
        "behat/symfony2-extension": "~2.1",
        "behat/mink": "~1.7.1",
        "behat/mink-extension": "~2.2",
        "behat/mink-selenium2-driver": "~1.3.1",
        "behat/mink-browserkit-driver": "~1.3.2",
        "behat/mink-goutte-driver": "~1.2.1",
        "theofidry/alice-bundle-extension": "~1.1",
        "hautelook/alice-bundle": "~1.2.2",
        "friendsofphp/php-cs-fixer": "^2.1",
        "behatch/contexts": "^2.5",
        "friends-of-behat/performance-extension": "^1.0",
        "phpspec/prophecy": "^1.7",
        "friends-of-behat/context-service-extension": "^1.0",
        "nelmio/alice": "2.1.4"
    },
    "scripts": {
        "symfony-scripts": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile"
        ],
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "process-timeout": 600
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        }
    }
}
