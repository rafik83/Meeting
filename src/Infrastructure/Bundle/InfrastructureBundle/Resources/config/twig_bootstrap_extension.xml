<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="vimeet.twig.theme_twitter_bootstrap_3_extension.class">Proximum\Vimeet\Infrastructure\Bundle\InfrastructureBundle\Twig\Extension\TwitterBootstrap3Extension</parameter>
    </parameters>

    <services>
        <service id="vimeet.twig.theme_twitter_bootstrap_3_extension" class="%vimeet.twig.theme_twitter_bootstrap_3_extension.class%">
            <argument type="service" id="twig" />
            <tag name="twig.extension" />
        </service>
    </services>
</container>
