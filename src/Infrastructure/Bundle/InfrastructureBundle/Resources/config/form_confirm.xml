<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="vimeet.form.extension.form_confirm_type_extension.class">Proximum\Vimeet\Infrastructure\Bundle\InfrastructureBundle\Form\Extension\FormConfirmTypeExtension</parameter>
    </parameters>

    <services>
        <service id="vimeet.form.extension.form_confirm_type_extension" class="%vimeet.form.extension.form_confirm_type_extension.class%">
            <tag name="form.type_extension" extended-type="Symfony\Component\Form\Extension\Core\Type\ButtonType" />
        </service>
    </services>
</container>
