{% extends '@Infrastructure/Form/form_horizontal_layout.html.twig' %}

{% block box_widget %}
    {% set label =  '<span>' ~ label|trans({}, translation_domain) ~ '</span>' %}
    {{ parent() }}
{% endblock %}

{% block spot_reference_recipe_row %}
    {% set group_attr = group_attr|default({})|merge({ 'class': group_attr.class|default('') ~ ' row' }) %}
    <div {{ block('row_container_attributes') }}>
        {{ form_row(form.prefix, { 'group_attr': { 'class': 'col-md-3' } }) }}
        {{ form_row(form.start, { 'group_attr': { 'class': 'col-md-3' } }) }}
        {{ form_row(form.end, { 'group_attr': { 'class': 'col-md-3' } }) }}
        <div class="col-md-3 text-right">
            {{ block('collection_delete_button') }}
        </div>
    </div>
{% endblock %}

{% block plans_item_row %}
    <div {{ block('row_container_attributes') }}>
        <div class="form-inline plan-choice">
            <div class="form-group sort-handle">
                <i class="glyphicon glyphicon-product-plan"></i>
            </div>
            <div class="form-group">
                {{ form_widget(form) }}
            </div>
            <div class="form-group">
                {{ block('collection_delete_button') }}
            </div>
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block participants_item_row %}
    <div {{ block('row_container_attributes') }}>
        <div class="form-inline plan-choice">
            <div class="form-group sort-handle">
                <i class="glyphicon glyphicon-product-participant"></i>
            </div>
            <div class="form-group">
                {{ form_widget(form) }}
            </div>
            <div class="form-group">
                {{ block('collection_delete_button') }}
            </div>
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block options_item_row %}
    <div {{ block('row_container_attributes') }}>
        <div class="form-inline option-choice">
            <div class="form-group sort-handle">
                <i class="glyphicon glyphicon-product-option"></i>
            </div>
            <div class="form-group">
                {{ form_widget(form) }}
            </div>
            <div class="form-group">
                {{ block('collection_delete_button') }}
            </div>
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block groups_item_row %}
    <div {{ block('row_container_attributes') }}>
        <div class="mg-bt">
            <span class="btn btn-default sort-handle">
                <i class="glyphicon glyphicon-resize-vertical"></i>
            </span>
            <div class="pull-right">
                {{ block('collection_delete_button') }}
            </div>
        </div>
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block generate_slot_recipe_row %}
    <div {{ block('row_container_attributes') }}>
        <div class="col-lg-10 col-md-10 col-sm-10 col-xs-10">
            {{ form_row(form.begin, { 'group_attr': { 'class': 'col-lg-6 col-md-6 col-sm-6 col-xs-12' } }) }}
            {{ form_row(form.end, { 'group_attr': { 'class': 'col-lg-6 col-md-6 col-sm-6 col-xs-12' } }) }}
            {{ form_row(form.interval, { 'group_attr': { 'class': 'col-lg-6 col-md-6 col-sm-6 col-xs-12' } }) }}
            {{ form_row(form.duration, { 'group_attr': { 'class': 'col-lg-6 col-md-6 col-sm-6 col-xs-12' } }) }}
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
            {{ block('collection_delete_button') }}
        </div>
    </div>
{% endblock %}

{% block _sheet_template_preview_previewObjects_entry_row %}
    <div {{ block('row_container_attributes') }}>
        <div class="form-inline preview-object-choice">
            <div class="form-group">
                {{ form_widget(form) }}
            </div>
            <div class="form-group">
                {{ block('collection_delete_button') }}
            </div>
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{%- block url_widget -%}
    {%- set type = type|default('text') -%}
    {{ block('form_widget_simple') }}
{%- endblock url_widget -%}

{% block rating_widget %}
    <div {{ block('widget_container_attributes') }}>
        {% for child in form %}
            {% if loop.first %}
                <input disabled checked class="rating__input rating__input--none" name="{{ form.vars.full_name }}" id="{{ child.vars.id }}" value="0" type="radio"/>
            {% else %}
                <label class="rating__label" for="{{ child.vars.id }}"><i class="rating__icon rating__icon--star icon-EtoilePleine"></i></label>
                {{- form_widget(child) -}}
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}

{% block _happening_update_translations_entry_webinarHeaderImage_row %}
    {{ form_row(form) }}

    {% if form.parent.vars.data.currentWebinarHeaderImage %}
        <label class="col-lg-3 col-md-3 col-sm-3 control-label">
            {{ 'form.happening_create.children.translations.prototype.children.currentWebinarHeaderImage.label'|trans({}, 'forms') }}
        </label>
        <div class="col-lg-9 col-md-9 col-sm-9">
            <img src="{{ form.parent.vars.data.currentWebinarHeaderImage }}" class="img-responsive">
        </div>
    {% endif %}
{% endblock %}
