{% extends 'ElaoThemeTwitterBootstrap3Bundle:Form:form_default_layout.html.twig' %}

{% block box_widget %}
    {% set label =  '<span>' ~ label|trans({}, translation_domain) ~ '</span>' %}
    {{ parent() }}
{% endblock %}

{% block nomenclature_checkboxes_row %}
    {{ form_errors(form) }}
    {% if nomenclature.depth == 1 %}
        <div>
            <div class="content-header clearfix">
                <h1 class="pull-left">
                    <i class="icon-Valider_4"></i>
                    {{ form_label(form) }}
                </h1>

                {% if sheet_uri is defined %}
                    <a href="{{ sheet_uri }}" class="btn btn-gray pull-right">
                        <i class="icon-Retour"></i>Retour à la fiche
                    </a>
                {% endif %}
            </div>

            <section class="object object--collection style--style-1 section">
                <div class="row">
                    <div class="col-md-4">
                        <div class="object--nomenclature">
                            <h3 class="title-table">{{ nomenclature.title }}</h3>

                            <div class="border-table">
                                <table class="table table-striped">
                                    <tbody>
                                        {% for first_label_item in nomenclature.firstLevel %}
                                            <tr>
                                                <td>
                                                    {{ form_row(form[first_label_item.key]) }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            <p class="link-table pull-right">
                                <a href="#">Tous sélectionner</a> /
                                <a href="#">Aucun</a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    {% elseif nomenclature.depth == 2 %}
        <div>
            <div class="content-header clearfix">
                <h1 class="pull-left">
                    <i class="icon-Valider_4"></i>
                    {{ form_label(form) }}
                </h1>

                {% if sheet_uri is defined %}
                    <a href="{{ sheet_uri }}" class="btn btn-gray pull-right">
                        <i class="icon-Retour"></i>Retour à la fiche
                    </a>
                {% endif %}
            </div>

            <section class="object object--collection style--style-1 section">
                <div class="row">
                    {% for first_level_item in nomenclature.firstLevel %}
                        <div class="col-md-4">
                            <div class="object--nomenclature">
                                <h3 class="title-table">{{ first_level_item.label(locale) }}</h3>

                                <div class="border-table">
                                    <table class="table table-striped">
                                        <tbody>
                                        {% for second_label_item in first_level_item.children %}
                                            <tr>
                                                <td>
                                                    {{ form_row(form[second_label_item.key]) }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                                <p class="link-table pull-right">
                                    <a href="#">Tous sélectionner</a> /
                                    <a href="#">Aucun</a>
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </div>
    {% elseif nomenclature.depth == 3 %}
        <div>
            <div class="content-header clearfix">
                <h1 class="pull-left">
                    <i class="icon-Valider_4"></i>
                    {{ form_label(form) }}
                </h1>

                <ul class="nav nav-pills pull-left" role="tablist">
                    {% for first_level_item in nomenclature.firstLevel %}
                        <li role="presentation"{% if loop.first %} class="active"{% endif %}>
                            <a href="#{{ first_level_item.key }}" aria-controls="{{ first_level_item.key }}">
                                {{ first_level_item.label(locale) }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>

                {% if sheet_uri is defined %}
                    <a href="{{ sheet_uri }}" class="btn btn-gray pull-right">
                        <i class="icon-Retour"></i>Retour à la fiche
                    </a>
                {% endif %}
            </div>

            {% for first_level_item in nomenclature.firstLevel %}
                <section class="object object--collection style--style-1 section">
                    <div role="tabpanel" class="tab-pane{% if loop.first %} active{% endif %}" id="{{ first_level_item.key }}">
                        <header>
                            <h2>{{ first_level_item.label(locale) }}</h2>
                        </header>

                        <div class="row">
                            {% for second_level_item in first_level_item.children %}
                                <div class="col-md-4">
                                    <div class="object--nomenclature">
                                        <h3 class="title-table">{{ second_level_item.label(locale) }}</h3>

                                        <div class="border-table">
                                            <table class="table table-striped">
                                                <tbody>
                                                    {% for third_label_item in second_level_item.children %}
                                                        <tr>
                                                            <td>
                                                                {{ form_row(form[third_label_item.key], { 'attr': { 'class': 'item-' ~ second_level_item.key } }) }}
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>

                                        <p class="link-table pull-right">
                                            <button type="button" class="btn btn-link" data-check-all-button="{{ '.item-' ~ second_level_item.key }}">Tous sélectionner</button>
                                            /
                                            <button type="button" class="btn btn-link" data-uncheck-all-button="{{ '.item-' ~ second_level_item.key }}">Aucun</button>
                                        </p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
