{% extends '@Infrastructure/Form/form_default_layout.html.twig' %}

{%- block telephone_widget -%}
    {%- set type = type|default('tel') -%}
    {{ block('form_widget_simple') }}
{%- endblock telephone_widget -%}

{%- block quantity_widget -%}
    {% set attr = attr|merge({
        'data-min-message': attr['data-min-message']|trans,
        'data-max-message': attr['data-max-message']|trans
    }) %}

    <div class="select-quantity">
        <input type="button" value="-" class="qtyminus"/>
        {% set control_class = 'qty' %}
        {{ block('form_widget_simple') }}
        <input type="button" value="+" class="qtyplus"/>
    </div>
{%- endblock quantity_widget -%}

{%- block form_errors -%}
    {% if errors|length > 0 %}
        <ul class="text-danger">
            {% for error in errors %}
                <li>{{ error.message|trans({}, 'validators') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{%- endblock form_errors -%}

{%- block submit_row -%}
    <div class="validation">
        {{- form_widget(form) -}}
    </div>
{%- endblock -%}

{%- block submit_widget -%}
    {%- set type = type|default('submit') -%}
    {%- set attr = attr|default({})|merge({'class': 'btn'}) -%}
    {{ block('button_widget') }}
{%- endblock -%}

{%- block textarea_widget -%}
    {% if form.vars.fallbackTranslation is defined %}
        <p class="help-block">{{ form.vars.fallbackTranslation }}</p>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block nomenclature_checkboxes_one_level %}
    <div>
        <div class="content-header clearfix">
            <h1 class="pull-left">
                <i class="icon-Valider_4"></i>
                {{ form.vars.label|trans({}, 'forms') }}
            </h1>

            {% if sheet_uri is defined %}
                <a href="{{ sheet_uri }}" class="btn btn-gray pull-right">
                    <i class="icon-Retour"></i> {{ 'nomenclature.back_to_sheet'|trans }}
                </a>
            {% endif %}
        </div>

        <section class="object object--collection style--style-1 section">
            {% if nomenclature_label is defined %}
                <header>
                    <h2>{{ nomenclature_label }}</h2>
                </header>
            {% endif %}

            <div class="object--nomenclature">
                <div class="border-table">
                    <div class="row">
                        {% for table in nomenclature.firstLevelSorted(locale)|batch(nomenclature.firstLevel|length / 3) %}
                            {{ block('nomenclature_first_over_one') }}
                        {% endfor %}
                    </div>
                </div>

                <p class="link-table pull-right">
                    <button type="button" class="btn btn-link" data-check-all-button=".item">{{ 'nomenclature.select_all'|trans }}</button>
                    /
                    <button type="button" class="btn btn-link" data-uncheck-all-button=".item">{{ 'nomenclature.select_none'|trans}}</button>
                </p>
            </div>
        </section>
    </div>
{% endblock nomenclature_checkboxes_one_level %}

{% block nomenclature_first_over_one %}
    <div class="col-md-4">
        <table class="table table-striped">
            <tbody>
            {% for first_label_item in table %}
                <tr>
                    <td>
                        {{ form_row(form[first_label_item.cleanKey], { 'attr': { 'class': 'item' }, 'simple': true }) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock nomenclature_first_over_one %}

{% block nomenclature_checkboxes_two_levels %}
    {% set showTitle = form.vars.label or sheet_uri is defined %}

    <div>
        {% if showTitle %}
            <div class="content-header clearfix">
                {% if form.vars.label %}
                    <h1 class="pull-left">
                        <i class="icon-Valider_4"></i>
                        {{ form.vars.label|trans({}, 'forms') }}
                    </h1>
                {% endif %}

                {% if sheet_uri is defined %}
                    <button class="btn btn-primary pull-right mg-left" type="submit">{{ 'nomenclature.submit'|trans }}</button>
                    <a href="{{ sheet_uri }}" class="btn btn-gray pull-right">
                        <i class="icon-Retour"></i> {{ 'nomenclature.back_to_sheet'|trans }}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        <section class="object {% if showTitle %}object--collection{% endif %} style--style-1 section">
            <div class="row">
                {% set colMdSize = "col-md-4" %}
                {% if levelsArchitecture['numberOfColumns'] is defined and levelsArchitecture['numberOfColumns'] == 1 %}
                    {% set colMdSize = "col-md-12" %}
                {% elseif levelsArchitecture['numberOfColumns'] is defined and levelsArchitecture['numberOfColumns'] == 2 %}
                    {% set colMdSize = "col-md-6" %}
                {% endif %}
                <div class="{{ colMdSize }}">
                {% set secondColumnIteration = 1 %}
                {% for first_level_item in nomenclature.firstLevelSorted(locale) %}
                    {% set loopIndex = loop.index %}
                    {% if loopIndex > levelsArchitecture['elements'][secondColumnIteration]['secondLevels'] and secondColumnIteration < 3 %}
                        {% set secondColumnIteration = secondColumnIteration + 1 %}
                    </div><div class="{{ colMdSize }}">
                    {% endif %}
                    {{ block('nomenclature_first_over_two') }}
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock nomenclature_checkboxes_two_levels %}

{% block nomenclature_first_over_two %}
    <div class="object--nomenclature">
        <h3 class="title-table">{{ first_level_item.label(locale) }}</h3>

        <div class="border-table with-title">
            <table class="table table-striped">
                <tbody>
                {% for second_label_item in first_level_item.childrenSorted(locale) %}
                    <tr>
                        <td>
                            {{ form_row(form[second_label_item.cleanKey], { 'attr': { 'class': 'item item-' ~ first_level_item.cleanKey }, 'simple': true }) }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="link-table pull-right">
            <button type="button" class="btn btn-link" data-check-all-button="{{ '.item-' ~ first_level_item.cleanKey }}">{{ 'nomenclature.select_all'|trans}}</button>
            /
            <button type="button" class="btn btn-link" data-uncheck-all-button="{{ '.item-' ~ first_level_item.cleanKey }}">{{ 'nomenclature.select_none'|trans}}</button>
        </p>
    </div>
{% endblock nomenclature_first_over_two %}

{% block nomenclature_checkboxes_three_levels %}
    {% set showTitle = form.vars.label %}
    <div>
        <div class="content-header clearfix">
            {% if showTitle %}
                <h1 class="pull-left">
                    <i class="icon-Valider_4"></i>
                    {{ form.vars.label|trans({}, 'forms') }}
                </h1>
            {% endif %}

            <ul class="nav nav-pills pull-left" role="tablist">
                {% for first_level_item in nomenclature.firstLevelSorted(locale) %}
                    <li role="presentation"{% if loop.first %} class="active"{% endif %}>
                        <a href="#{{ first_level_item.cleanKey }}" aria-controls="{{ first_level_item.cleanKey }}">
                            {{ first_level_item.label(locale) }}
                        </a>
                    </li>
                {% endfor %}
            </ul>

            {% if sheet_uri is defined %}
                <button class="btn btn-primary pull-right mg-left" type="submit">{{ 'nomenclature.submit'|trans }}</button>
                <a href="{{ sheet_uri }}" class="btn btn-gray pull-right">
                    <i class="icon-Retour"></i> {{ 'nomenclature.back_to_sheet'|trans }}
                </a>
            {% endif %}
        </div>

        {% for first_level_item in nomenclature.firstLevelSorted(locale) %}
            {% set firstColumnIteration = loop.index - 1 %}
            {{ block('nomenclature_first_over_three') }}
        {% endfor %}
    </div>
{% endblock nomenclature_checkboxes_three_levels %}

{% block nomenclature_first_over_three %}
    <section class="object object--collection style--style-1 section">
        <div id="{{ first_level_item.cleanKey }}">
            <header>
                <h2>{{ first_level_item.label(locale) }}</h2>
            </header>

            <div class="row">
                {% set colMdSize = "col-md-4" %}
                {% if levelsArchitecture[firstColumnIteration]['numberOfColumns'] is defined and levelsArchitecture[firstColumnIteration]['numberOfColumns'] == 1 %}
                    {% set colMdSize = "col-md-12" %}
                {% elseif levelsArchitecture[firstColumnIteration]['numberOfColumns'] is defined and levelsArchitecture[firstColumnIteration]['numberOfColumns'] == 2 %}
                    {% set colMdSize = "col-md-6" %}
                {% endif %}
                <div class="{{ colMdSize }}">
                {% set secondColumnIteration = 1 %}
                {% for second_level_item in first_level_item.childrenSorted(locale) %}
                    {% set loopIndex = loop.index %}
                    {% if loopIndex > levelsArchitecture[firstColumnIteration]['elements'][secondColumnIteration]['secondLevels'] and secondColumnIteration < 3 %}
                        {% set secondColumnIteration = secondColumnIteration + 1 %}
                    </div><div class="{{ colMdSize }}">
                    {% endif %}
                    {{ block('nomenclature_second_over_three') }}
                {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock nomenclature_first_over_three %}

{% block nomenclature_second_over_three %}
    <div class="object--nomenclature clearboth">
        <h3 class="title-table">{{ second_level_item.label(locale) }}</h3>
        <div class="border-table with-title">
            <table class="table table-striped">
                <tbody>
                {% for third_label_item in second_level_item.childrenSorted(locale) %}
                    <tr>
                        <td>
                            {{ form_row(form[third_label_item.cleanKey], { 'attr': { 'class': 'item-' ~ second_level_item.cleanKey }, 'simple': true }) }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="link-table pull-right">
            <button type="button" class="btn btn-link" data-check-all-button="{{ '.item-' ~ second_level_item.cleanKey }}">{{ 'nomenclature.select_all'|trans}}</button>
            /
            <button type="button" class="btn btn-link" data-uncheck-all-button="{{ '.item-' ~ second_level_item.cleanKey }}">{{ 'nomenclature.select_none'|trans}}</button>
        </p>
    </div>
{% endblock nomenclature_second_over_three %}

{% block nomenclature_checkboxes_row %}
    {{ form_errors(form) }}
    {% if nomenclature.depth == 1 %}
        {{ block('nomenclature_checkboxes_one_level') }}
    {% elseif nomenclature.depth == 2 %}
        {{ block('nomenclature_checkboxes_two_levels') }}
    {% elseif nomenclature.depth == 3 %}
        {{ block('nomenclature_checkboxes_three_levels') }}
    {% endif %}
{% endblock %}

{%- block url_widget -%}
    {%- set type = type|default('text') -%}
    {{ block('form_widget_simple') }}
{%- endblock url_widget -%}

{% block sheet_item_data_row %}
    {% set group_attr = group_attr|default({})|merge({ 'class': group_attr.class|default('') ~ ' row' }) %}
    <div {{ block('row_container_attributes') }}>
        {{ form_row(form.title, { 'group_attr': { 'class': 'col-md-10' } }) }}
        <div class="col-md-1 text-right">
            {{ block('collection_delete_button') }}
        </div>
    </div>
{% endblock %}

{% block boolean_item_row %}
    {{ form_row(form, { 'inline': true }) }}
{% endblock %}

{% block _sheet_template_objects_collection_type_objectsCollection_entry_row %}
    {% spaceless %}
        {% set widget = widget|default('default') %}

        {% if widget == 'hidden' %}
            {{ form_errors(form) }}
            {{ form_widget(form) }}
        {% else %}
            {% set group_class = group_class|default('styled-form form') %}

            <div {{ block('row_container_attributes') }}>
                <div class="row">
                    <div class="col-md-10">
                        {% if label is not same as(false) %}
                            {% if label_group|default(false) %}
                                <div {{ block('label_group_attributes') }}>
                            {% endif %}

                            {{ form_label(form, label, {label_attr: label_attr|default({})}) }}

                            {% if label_group|default(false) %}
                                </div>
                            {% endif %}
                        {% endif %}

                        {% if control_group|default(false) %}
                            <div {{ block('control_group_attributes') }}>
                        {% endif %}
                                {% set help = help|default(false) %}
                                {{ form_widget(form) }}
                                {{ help ? block('form_help') : '' }}
                                {{ form_errors(form) }}
                        {% if control_group|default(false) %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="col-md-2 text-right" style="vertical-align: bottom">{{ block('collection_delete_button') }}</div>
                </div>
            </div>
        {% endif %}
    {% endspaceless %}
{% endblock %}
