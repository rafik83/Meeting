{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.schedule.slots.generate.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.schedule.slots.generate.title'|trans }}</h1>

    <div class="well">
        {{ 'admin.schedule.slots.generate.eventDay'|trans }}
        <ul>
            {% for day in days %}
                <li>
                    {{ day.startTime|localizeddate('short', 'none', app.request.locale, event.timeZone)}}:
                    {{ day.startTime|localizeddate('none', 'short', app.request.locale, event.timeZone)}} -
                    {{ day.endTime|localizeddate('none', 'short', app.request.locale, event.timeZone)}}
                </li>
            {% endfor %}
        </ul>
    </div>

    {{ form_start(form, { 'attr': { 'class': 'with-submit-section' } }) }}
        {{ form_errors(form) }}
        {{ form_row(form.recipes) }}
        <div class="form-group submit-section navbar-fixed-bottom">
            <div class="col-sm-3">
                <a href="{{ path('admin_schedule_slots', { 'event': event.id }) }}" class="btn btn-text">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                    {{ 'admin.schedule.slots.generate.back'|trans }}
                </a>
            </div>
            <div class="col-sm-9 text-right">
                {{ form_widget(form.submit) }}
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}

