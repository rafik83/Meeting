{% extends 'AdminBundle::base.html.twig' %}

{% from 'AdminBundle::macro.html.twig' import delete_button %}

{% block title 'admin.schedule.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.schedule.title'|trans }}
        {% if featureEventDatesToCurrentDateEnabled %}
            <a href="{{ path('admin_update_event_dates_to_current_date', {'event' : event.id}) }}" class="btn btn-danger">{{ 'admin.event.updateEventDates'|trans }}</a>
        {% endif %}
    </h1>
    <div class="mg-bt">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row">
                {{ form_row(form.scale, { 'group_attr': { 'class': 'col-md-4 col-sm-6' }, 'label_columns': 6 }) }}
                <div class="col-md-4 col-sm-6">
                    {{ form_widget(form.submit) }}
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <hr>

    <h2>{{ 'admin.schedule.days.title'|trans }}</h2>

    <a href="{{ path('admin_schedule_days', {'event': event.id}) }}" class="btn btn-info">
        <i class="glyphicon glyphicon-calendar"></i>
        {{ 'admin.schedule.days.link'|trans }}
    </a>

    {% if event.days|length > 0 %}
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ 'admin.schedule.days.day'|trans }}</th>
                <th>{{ 'admin.schedule.days.startTime'|trans }}</th>
                <th>{{ 'admin.schedule.days.endTime'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for day in event.days %}
                <tr>
                    <td>{{ day.day|localizeddate('medium', 'none', app.request.locale, event.timeZone) }}</td>
                    <td>{{ day.startTime|localizeddate('none', 'short', app.request.locale, event.timeZone) }}</td>
                    <td>{{ day.endTime|localizeddate('none', 'short', app.request.locale, event.timeZone) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <hr>

    <h2>{{ 'admin.schedule.slots.title'|trans }}</h2>

    <div class="mg-bt">
        <a href="{{ path('admin_schedule_slots_generate', { 'event': event.id }) }}" class="btn btn-info">
            <i class="glyphicon glyphicon-tasks"></i>
            {{ 'admin.schedule.slots.generate.action'|trans }}
        </a>
    </div>

    {% if slots|length > 0 %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{ 'admin.schedule.slots.table.begin'|trans }}</th>
                    <th>{{ 'admin.schedule.slots.table.end'|trans }}</th>
                    <th>{{ 'admin.schedule.slots.table.duration'|trans }}</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for slot in slots %}
                    <tr>
                        <td>{{ slot.begin|localizeddate('medium', 'medium', app.request.locale, event.timeZone) }}</td>
                        <td>{{ slot.end|localizeddate('medium', 'medium', app.request.locale, event.timeZone) }}</td>
                        <td>{{ slot.duration }}</td>
                        <td class="text-center col-md-1">
                            {% if slot.disabled == true %}
                                <div data-toggle="tooltip" title="{{ 'admin.schedule.slot.disabled'|trans }}" class="btn-group" role="group">
                                    <div class="btn {{ slot.locked ? 'btn-default' : 'btn-success active' }}"  disabled="disabled">
                                        <i class="glyphicon glyphicon-ok"></i>
                                    </div>
                                    <div class="btn {{ slot.locked ? 'btn-danger active' : 'btn-default' }} " disabled="disabled">
                                        <i class="glyphicon glyphicon-lock"></i>
                                    </div>
                                </div>
                            {% else %}
                                {% if slot.locked %}
                                    <form action="{{ path('admin_schedule_slot_unlock', { 'event': event.id, 'meetingSlot': slot.id }) }}" method="POST">
                                        <div class="btn-group" role="group" aria-label="locked">
                                            <button type="submit" class="btn btn-default" data-toggle="tooltip" title="{{ 'admin.schedule.slot.unlock'|trans }}">
                                                <i class="glyphicon glyphicon-ok"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger active" data-toggle="tooltip" title="{{ 'admin.schedule.slot.locked'|trans }}">
                                                <i class="glyphicon glyphicon-lock"></i>
                                            </button>
                                        </div>
                                    </form>
                                {% else %}
                                    <form action="{{ path('admin_schedule_slot_lock', { 'event': event.id, 'meetingSlot': slot.id }) }}" method="POST">
                                        <div class="btn-group" role="group" aria-label="locked">
                                            <button type="button" class="btn btn-success active" data-toggle="tooltip" title="{{ 'admin.schedule.slot.unlocked'|trans }}">
                                                <i class="glyphicon glyphicon-ok"></i>
                                            </button>
                                            <button type="submit" class="btn btn-default" data-toggle="tooltip" title="{{ 'admin.schedule.slot.lock'|trans }}">
                                                <i class="glyphicon glyphicon-lock"></i>
                                            </button>
                                        </div>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td class="text-right">
                            {% if not slot.disabled %}
                                {{ delete_button(path('admin_schedule_slot_remove', {'event': event.id, 'meetingSlot': slot.id, }), 'admin.schedule.slot.remove'|trans, {'class': 'btn btn-sm btn-danger', 'data-confirm': 'admin.schedule.slot.remove.confirm'|trans}) }}
                            {% else %}
                                <div class="btn btn-sm btn-danger disabled" disabled data-toggle="tooltip" title="{{ 'admin.schedule.slot.disabled'|trans }}">
                                    {{ 'admin.schedule.slot.remove'|trans }}
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

{% endblock %}
