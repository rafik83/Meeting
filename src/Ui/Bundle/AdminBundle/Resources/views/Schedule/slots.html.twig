{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1>{{ 'admin.schedule.title'|trans }}</h1>

    <div class="mg-bt">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row">
                {{ form_row(form.scale, { 'group_attr': { 'class': 'col-md-4 col-sm-6' }, 'label_columns': 6 }) }}
                <div class="col-md-4 col-sm-6">
                    {{ form_widget(form.submit) }}
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <h1>{{ 'admin.schedule.slots.title'|trans }}</h1>

    <div class="mg-bt">
        <a href="{{ path('admin_schedule_slots_generate', { 'event': event.id }) }}" class="btn btn-success">
            <i class="glyphicon glyphicon-tasks"></i>
            Générer des crénaux
        </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Début</th>
                <th>Fin</th>
                <th>Durée</th>
                <th>Activé</th>
            </tr>
        </thead>
        <tbody>
            {% for slot in slots %}
                <tr>
                    <td>{{ slot.begin|localizeddate }}</td>
                    <td>{{ slot.end|localizeddate }}</td>
                    <td>{{ slot.duration }}</td>
                    <td>
                        <i class="glyphicon {{ slot.enabled ? 'glyphicon-ok text-success' : 'glyphicon-remove text-danger' }}"></i>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
