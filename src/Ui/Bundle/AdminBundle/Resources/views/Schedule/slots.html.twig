{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.schedule.title'|trans }}</h1>

    <div class="mg-bt">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row">
                {{ form_row(form.scale, { 'group_attr': { 'class': 'col-md-4 col-sm-6' }, 'label_columns': 6 }) }}
                <div class="col-md-4 col-sm-6">
                    {{ form_widget(form.submit) }}
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <hr>

    <h2>{{ 'admin.schedule.days.title'|trans }}</h2>

    <a href="{{ path('admin_schedule_days', {'event': event.id}) }}" class="btn btn-info">
        <i class="glyphicon glyphicon-calendar"></i>
        {{ 'admin.schedule.days.link'|trans }}
    </a>

    {% if event.days|length > 0 %}
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ 'admin.schedule.days.day'|trans }}</th>
                <th>{{ 'admin.schedule.days.startTime'|trans }}</th>
                <th>{{ 'admin.schedule.days.endTime'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for day in event.days %}
                <tr>
                    <td>{{ day.day|localizeddate('medium', 'none') }}</td>
                    <td>{{ day.startTime|localizeddate('none', 'short') }}</td>
                    <td>{{ day.endTime|localizeddate('none', 'short') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <hr>

    <h2>{{ 'admin.schedule.slots.title'|trans }}</h2>

    <div class="mg-bt">
        <a href="{{ path('admin_schedule_slots_generate', { 'event': event.id }) }}" class="btn btn-info">
            <i class="glyphicon glyphicon-tasks"></i>
            {{ 'admin.schedule.slots.generate.action'|trans }}
        </a>
    </div>

    {% if slots|length > 0 %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{ 'admin.schedule.slots.table.begin'|trans }}</th>
                    <th>{{ 'admin.schedule.slots.table.end'|trans }}</th>
                    <th>{{ 'admin.schedule.slots.table.duration'|trans }}</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for slot in slots %}
                    <tr>
                        <td>{{ slot.begin|localizeddate }}</td>
                        <td>{{ slot.end|localizeddate }}</td>
                        <td>{{ slot.duration }}</td>
                        <td class="text-center">
                            {% if slot.locked %}
                                <form action="{{ path('admin_schedule_slot_unlock', { 'event': event.id, 'meetingSlot': slot.id }) }}" method="POST">
                                    <div class="btn-group" role="group" aria-label="locked">
                                        <button type="submit" class="btn btn-default" data-toggle="tooltip" title="{{ 'admin.schedule.slot.unlock'|trans }}">
                                            <i class="glyphicon glyphicon-ok"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger active" data-toggle="tooltip" title="{{ 'admin.schedule.slot.locked'|trans }}">
                                            <i class="glyphicon glyphicon-lock"></i>
                                        </button>
                                    </div>
                                </form>
                            {% else %}
                                <form action="{{ path('admin_schedule_slot_lock', { 'event': event.id, 'meetingSlot': slot.id }) }}" method="POST">
                                    <div class="btn-group" role="group" aria-label="locked">
                                        <button type="button" class="btn btn-success active" data-toggle="tooltip" title="{{ 'admin.schedule.slot.unlocked'|trans }}">
                                            <i class="glyphicon glyphicon-ok"></i>
                                        </button>
                                        <button type="submit" class="btn btn-default" data-toggle="tooltip" title="{{ 'admin.schedule.slot.lock'|trans }}">
                                            <i class="glyphicon glyphicon-lock"></i>
                                        </button>
                                    </div>
                                </form>
                            {% endif %}
                        </td>
                        <td>
                            <form action="{{ path('admin_schedule_slot_remove', { 'event': event.id, 'meetingSlot': slot.id }) }}" method="POST">
                                    <button type="submit" class="btn btn-danger">Supprimer</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

{% endblock %}
