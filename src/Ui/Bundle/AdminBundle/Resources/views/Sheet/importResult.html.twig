{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block content %}

    <h1>{{ 'admin.participant_import_result.title.label'|trans }}</h1>

    <div class="col-md-6">
        <table class="table table-striped col-md-6">
            <tbody>
                <tr>
                    <th>{{ 'admin.participant_import_result.database_participations'|trans }}</th>
                    <td>{{ view.existingParticipations }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.participant_import_result.file_participations'|trans }}</th>
                    <td>{{ view.fileParticipations }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.participant_import_result.created_sheets'|trans }}</th>
                    <td>{{ view.createdSheets }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.participant_import_result.created_users'|trans }}</th>
                    <td>{{ view.createdUsers }}</td>
                </tr>
                {% if view.errors is not empty %}
                    <tr>
                        <th colspan="2">{{ 'admin.participant_import_result.errors'|trans }}</th>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <ul class="list-unstyled">
                                {% for error in view.errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            {% if existingImportMapping %}
                <p>{{ 'form.sheet_import_mapping_result.text.diff'|trans({}, 'forms') }}</p>
            {% endif %}
            {% if updateForm is not null %}
                {{ form(updateForm) }}
            {% endif %}
            {% if createForm is not null %}
                {% if existingImportMapping %}
                    <hr>
                {% endif %}
                <h5>{{ 'form.sheet_import_mapping_result.text.save_title'|trans({}, 'forms') }}</h5>
                {{ form_start(createForm) }}
                    {{ form_row(createForm.title) }}
                    {{ form_row(createForm.submit) }}
                {{ form_end(createForm) }}
            {% endif %}
        </div>
    </div>

    <div class="form-group submit-section">
        <div class="col-sm-3">
            {% block goback %}
                <a href="{{ path('admin_sheet_import', {'event': event.getId}) }}" class="btn btn-link">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                    {{ 'admin.goback.link'|trans }}
                </a>
            {% endblock goback %}
        </div>
        <div class="col-sm-9 text-right">
            <a class="btn btn-primary" href="{{ path('admin_sheet', {'event': event.getId}) }}">{{ 'admin.sheet.see_list'|trans }}</a>
        </div>
    </div>
{% endblock %}
