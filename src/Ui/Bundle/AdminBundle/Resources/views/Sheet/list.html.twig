{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.sheet.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.sheet.title.count'|transchoice(sheets.total, {'%count%': sheets.total}) }}

        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
            <div class="dropdown pull-right" data-toggle="tooltip" data-placement="top" title="{{ 'admin.sheet.export.help'|trans }}">
                <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    {{ 'admin.sheet.export.button.label'|trans }}
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li>
                        <a href="{{ path('admin_sheet_export_sheet', { 'event': event.id }) }}">
                            {{ 'admin.sheet.export.sheet.button.label'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_participant_prepare_export', { 'event': event.id }) }}">
                            {{ 'admin.sheet.export.participant.button.label'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_event_export_uploaded_objets', {'event': event.id}) }}">
                            {{ 'admin.sheet.export.uploaded_objects.button.label'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_sheet_export_sheet', { 'event': event.id, displayNomenclatureIds: 'true' }) }}">
                            {{ 'admin.sheet.export.sheet.id.nomenclature.button.label'|trans }}
                        </a>
                    </li>
                </ul>
            </div>

            <div class="dropdown pull-right" style="margin: 0 10px;">
                <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    {{ 'admin.sheet.import.button.label'|trans }}
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li>
                        <a href="{{ path('admin_sheet_import', {'event': event.id}) }}">
                            {{ 'admin.sheet.import.button.label'|trans }}
                        </a>
                    </li>
                    {% if is_granted('PERMISSION_EVENT_ACCESS', event) %}
                        <li>
                            <a href="{{ path('admin_user_event_authentication_token_import', { 'event': event.id }) }}">
                                {{ 'admin.authentication_token.import.title'|trans }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        {% endif %}
    </h1>

    <div class="row filters">
        <div class="col-md-12 text-center">
            {{ include('AdminBundle:Common:filters_summary.html.twig', {
                filters:   filters_summary,
                resetLink: path('admin_sheet', { 'event': event.id, 'reset': true })
            }) }}
        </div>
    </div>

    {{ form_start(filter_form) }}
        <div class="row">
            <div class="filter-form">
                <div class="col-md-12">
                    <input type="hidden" name="rules" id="rules"/>
                    <div id="builder"
                         data-locale="{{ locale }}"
                         data-rules="{{ rules }}"
                         data-filters="{{ filters|json_encode }}">
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="pull-right">
                        <button type="submit" class="btn btn-primary" id="submit-rules">{{ 'admin.filter'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
        <br/>
        {{ include('AdminBundle:Sheet/Partial:filters.html.twig', { 'form': filter_form }) }}
    {{ form_end(filter_form) }}

    {% set sheetsLimit = (sheets.results|length < sheets.limit) ? sheets.results|length : sheets.limit %}

    {{ form_start(batch_form, { 'attr': { 'data-batch': true, 'data-page-items': sheetsLimit } }) }}
    {{ form_errors(batch_form) }}

    <div class="row filters">
        <div class="col-md-4">
            {% embed 'AdminBundle:Common:batch.html.twig' %}
                {% block actions %}
                    <li>{{ form_widget(batch_form.accept) }}</li>
                    <li>{{ form_widget(batch_form.pending) }}</li>
                    <li>
                        <a href="#" data-toggle="modal" data-target="#validate-comment">
                            {{ 'admin.sheet.validate'|trans }}
                        </a>
                    </li>

                    {% if batch_form.refuse is defined %}
                        <li>{{ form_widget(batch_form.refuse, { 'attr': { 'data-confirm': 'admin.batch_actions.confirm'|trans } }) }}</li>
                    {% endif %}

                    <li role="separator" class="divider"></li>

                    <li>
                        <a href="#" data-toggle="modal" data-target="#commercial-follow-up">
                            {{ 'admin.sheet.commercialFollowUp'|trans }}
                        </a>
                    </li>

                    {% if batch_form.duplicateToType is defined %}
                        <li role="separator" class="divider"></li>
                        <li>
                            <a href="#" class="duplication-sheet" data-types="{{ typesByEvent|json_encode }}" data-toggle="modal" data-target="#duplication-sheet">
                                {{ 'admin.sheet.duplication'|trans }}
                            </a>
                        </li>
                    {% endif %}

                    {% if batch_form.enable is defined or batch_form.disable is defined %}
                        <li role="separator" class="divider"></li>
                    {% endif %}

                    {% if batch_form.enable is defined %}
                        <li>{{ form_widget(batch_form.enable) }}</li>
                    {% endif %}

                    {% if batch_form.disable is defined %}
                        <li>{{ form_widget(batch_form.disable, { 'attr': { 'data-confirm': 'admin.batch_actions.confirm'|trans } }) }}</li>
                    {% endif %}

                    {% if batch_form.addCatalog is defined or batch_form.removeCatalog is defined %}
                        <li role="separator" class="divider"></li>
                    {% endif %}

                    {% if batch_form.addCatalog is defined %}
                        <li>{{ form_widget(batch_form.addCatalog) }}</li>
                    {% endif %}

                    {% if batch_form.removeCatalog is defined %}
                        <li>{{ form_widget(batch_form.removeCatalog, { 'attr': { 'data-confirm': 'admin.batch_actions.confirm'|trans } }) }}</li>
                    {% endif %}

                    {% if batch_form.validationStateDraft is defined or batch_form.validationStateValidate is defined %}
                        <li role="separator" class="divider"></li>
                    {% endif %}

                    {% if batch_form.validationStateDraft is defined %}
                        <li>{{ form_widget(batch_form.validationStateDraft) }}</li>
                    {% endif %}

                    {% if batch_form.validationStateValidate is defined %}
                        <li>{{ form_widget(batch_form.validationStateValidate) }}</li>
                    {% endif %}

                    {% if batch_form.assignToGroup is defined %}
                        <li role="separator" class="divider"></li>
                        <li>
                            <a href="#" data-toggle="modal" data-target="#sheetAssignToGroup">
                                {{ 'admin.sheet.assignToGroup'|trans }}
                            </a>
                        </li>
                    {% endif %}

                    {% if batch_form.generateInvoice is defined %}
                        <li role="separator" class="divider"></li>
                        <li>{{ form_widget(batch_form.generateInvoice, { 'attr': { 'data-confirm': 'admin.batch_actions.generateInvoice.confirm'|trans({'%prefix%': event.invoicePrefix.prefixExample}) } }) }}</li>
                        <li>{{ form_widget(batch_form.printInvoices) }}</li>
                    {% endif %}

                    {% if batch_form.printPdf is defined %}
                        <li role="separator" class="divider"></li>
                        <li>{{ form_widget(batch_form.printPdf) }}</li>
                    {% endif %}
                    {% if batch_form.printPlanning is defined or batch_form.printPlanningAndBadge is defined or batch_form.printBadge is defined %}
                        <li role="separator" class="divider"></li>
                        <li>
                            <a href="#" data-toggle="modal" data-target="#printPlanningOrderBy">
                                {{ 'admin.sheet.batch.printPlanningOrBadge'|trans }}
                            </a>
                        </li>
                    {% endif %}
                {% endblock actions %}
            {% endembed %}
        </div>
        <div class="col-md-8">
            {{ include('AdminBundle:Paginator:paginate.html.twig', { 'paginator': sheets }) }}
        </div>
    </div>

    {% set hasCategories = filter_form.categories is defined ? filter_form.categories.vars.choices|length > 1 : false %}

    <div id="batch-selection-helper" class="batch-helper alert alert-info text-center hide no-select" role="alert" data-page-items="{{ sheetsLimit }}" data-all-items="{{ sheets.total }}">
        <p>
            <span class="batch-helper-message"
                  data-all-selected-label="{{ 'admin.sheet.batch.allSelected.label'|trans({'%sheets%': sheets.total})|html }}"
                  data-page-selected-label="{{ 'admin.sheet.batch.selection.label'|trans({'%sheets%': sheetsLimit})|html }}">
                {{ 'admin.sheet.batch.selection.label'|trans({'%sheets%': sheetsLimit})|html }}
            </span>
            <span id="batch-select-all" class="batch-helper-select-all"
                  data-is-select-all-enabled="{{ sheets.total > sheets.limit ? 1 : 0 }}"
                  data-all-label="{{ 'admin.sheet.batch.selectionAll.label'|trans({'%allSheets%': sheets.total})|html }}"
                  data-cancel-label="{{ 'admin.sheet.batch.cancelSelection.label'|trans }}">
                {% if sheets.total > sheets.limit %}
                    {{ 'admin.sheet.batch.selectionAll.label'|trans({'%allSheets%': sheets.total})|html }}
                {% endif %}
            </span>
        </p>
    </div>

    <table class="table table-hover selectable-row filterable">
        <thead>
        <tr>
            <th class="minwidth">
                <input type="checkbox" data-batch-all="tbody input[type=checkbox]" title="{{ 'admin.check-all'|trans }}"/>
            </th>
            <th nowrap="nowrap">
                {{ 'form.sheet_filter.children.enabled.label'|trans({}, 'forms') }}
            </th>

            {% if hasCategories %}
                <th nowrap="nowrap">
                    {{ 'form.sheet_filter.children.category.label'|trans({}, 'forms') }}
                </th>
            {% endif %}

            <th nowrap="nowrap">
                {{ 'form.sheet_filter.children.type.label'|trans({}, 'forms') }}
            </th>
            <th nowrap="nowrap">
                {{ 'form.sheet_filter.children.validationState.label'|trans({}, 'forms') }}
            </th>
            <th nowrap="nowrap">
                {{ 'form.sheet_filter.children.state.label'|trans({}, 'forms') }}
            </th>
            <th>{{ 'admin.sheet.createdAt'|trans }}</th>
            <th>{{ 'admin.sheet.spot'|trans }}</th>
            <th nowrap="nowrap">
                {{ 'form.sheet_batch.children.follower.label'|trans({}, 'forms') }}
            </th>
            <th>{{ 'admin.sheet.commercialStatus'|trans() }}</th>
            <th class="col-md-1"></th>
        </tr>
        </thead>
        <tbody>
        {% for sheet in sheets.results %}
            <tr id="sheet-{{ sheet.id }}">
                <td>
                    {{ form_widget(batch_form.ids[sheet.id], { 'attr': { 'title': sheet.title } }) }}
                </td>
                <td>
                    <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}">
                        {{ sheet.title }}
                    </a>
                    {% if not sheet.isEnabled %}
                        <span class="label label-danger">{{ 'admin.sheet.disable'|trans }}</span>
                    {% endif %}

                    {% if sheet.countParticipant > 1 %}
                        <span class="label label-info"><i class="icon icon-Profil_1"></i> {{ sheet.countParticipant }}</span>
                    {% endif %}

                    {% if sheet.hasGroup %}
                        <span class="label label-success">
                            <i class="glyphicon glyphicon-duplicate" data-toggle="tooltip" data-placement="top" title="{{ sheet.groupTitle }}"></i>
                        </span>
                    {% endif %}

                    {% if sheet.linkedSheetsTitle is not empty %}
                        <span class="label label-info">
                            <i class="glyphicon glyphicon-duplicate" data-toggle="tooltip" data-placement="top" title="{{ 'admin.sheet.linkedTo'|trans ~ ' ' ~ sheet.linkedSheetsTitle|join(', ') }}"></i>
                        </span>
                    {% endif %}

                    {% if not sheet.attend %}
                        <span class="label label-danger">{{ 'event.sheet.attend.cancel'|trans }}</span>
                    {% endif %}
                    <br>
                    <small>
                        {{ sheet.owner.firstname }} {{ sheet.owner.lastname|upper }}
                        <a href="mailto:{{ sheet.owner.email }}">{{ sheet.owner.email }}</a>
                    </small>
                </td>

                {% if hasCategories %}
                    <td>{{ sheet.categories|join(', ') }}</td>
                {% endif %}

                <td>{{ sheet.type }}</td>
                <td>
                    {{ macro.state_label(
                    ('event.sheet.validationState.' ~ sheet.validationState)|trans,
                    sheet.validationState,
                    {
                        'draft': 'default',
                        'pending': 'warning',
                        'validated': 'success'
                    }
                    ) }}
                    <div class="progress progress-completeness" data-toggle="tooltip" title="{{ 'form.sheet_filter.children.completed.label'|trans({}, 'forms') }}">
                        <div class="progress-bar progress-bar-{{ sheet.completenessStatus }}" role="progressbar" aria-valuenow="{{ sheet.completeness }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ sheet.completeness }}%;">
                            {{ sheet.completeness }}%
                        </div>
                    </div>
                </td>
                <td>
                    <div>
                        {{ macro.state_label(
                        ('event.sheet.state.' ~ sheet.state)|trans,
                        sheet.state,
                        {
                            'pending': 'default',
                            'accepted': 'warning',
                            'validated': 'success',
                            'refused': 'danger',
                        },
                        sheet.hasTraceLabel ? ('admin.sheet.trace.' ~ sheet.traceAction)|trans({'%at%': sheet.traceAt|localizeddate('medium', 'short', app.request.locale, event.timeZone)}) ~ ' ' ~ (sheet.traceBy != null ? 'admin.sheet.trace.author'|trans({'%by%': sheet.traceBy}) : 'admin.sheet.trace.auto'|trans) : ''
                        ) }}
                    </div>
                    {% if sheet.isInCatalog %}
                        <div class="label label-info">
                            {{ 'admin.sheet.inCatalog'|trans }}
                        </div>
                    {% endif %}
                </td>
                <td>
                    <small>
                        {{ sheet.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
                    </small>
                </td>
                <td>
                    <div {% if is_granted('ROLE_ALLOWED_TO_ADMIN') %}class="updatable" data-type="string" data-url="{{ path('admin_sheet_assign_spot', {'event': event.id, 'sheet': sheet.id}) }}" data-update="{{ { 'value': sheet.spotReference }|json_encode }}" {% endif %}>
                        {% if sheet.spotReference != null %}
                            {{ sheet.spotReference }}
                        {% endif %}
                    </div>
                </td>
                <td>{{ sheet.follower }}</td>
                <td>
                    {% if sheet.hasCommercialStatus %}
                        <div class="label label-{{ sheet.getCommercialStatusLabel }}">
                            {{ ('admin.sheet.details.crm.record.trace.set_commercial_status.' ~ sheet.commercialStatus)|trans }}
                        </div>
                    {% endif %}
                    {% if sheet.hasReminderDate %}
                        <div data-toggle="tooltip" title="{{ 'form.sheet_comment.children.reminderDate.label'|trans({}, 'forms') }}">
                            <span class="label label-primary" >
                                {{ sheet.reminderDate|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
                            </span>
                        </div>
                    {% endif %}
                </td>
                <td class="text-right">
                    <div class="btn-group">
                        <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}" class="btn btn-default btn-sm">
                            {{ 'admin.sheet.read'|trans }}
                        </a>
                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                {{ macro.button(
                                    path('admin_impersonate',
                                        {
                                            'event': event.id,
                                            'user': sheet.owner.id,
                                            'route': 'event_sheet_default',
                                            'params': { 'sheet': sheet.id },
                                        }),
                                        'POST',
                                        'admin.sheet.impersonate'|trans,
                                        { 'class': 'btn btn-default btn-sm' },
                                        null,
                                        'impersonate-to-'~sheet.owner.id
                                    )
                                }}
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="{{ hasCategories ? 10 : 11 }}" class="text-danger text-center">{{ 'admin.zero-result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', { 'paginator': sheets }) }}

    {% if batch_form.duplicateToType is defined %}
        <div class="modal fade" tabindex="-1" role="dialog" id="duplication-sheet">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <h4 class="modal-title">{{ 'admin.sheet.duplication'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        <div id="events-block" class="form-group">
                            <label class="col-lg-3 col-md-3 col-sm-3 control-label required">
                                {{ 'form.sheet_batch.children.events.label'|trans({}, 'forms') }}
                            </label>
                            <div class="col-lg-9 col-md-9 col-sm-9">
                                <select class="form-control"></select>
                            </div>
                        </div>
                        <div id="types-block">
                            {{ form_row(batch_form.duplicateToType) }}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.cancel'|trans }}</button>
                        {{ form_row(batch_form.duplicate, {'attr': {'data-confirm': 'form.sheet_batch.children.duplicate.confirm.label'|trans({}, 'forms')}}) }}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="modal fade" tabindex="-1" role="dialog" id="commercial-follow-up">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">{{ 'admin.sheet.commercialFollowUp'|trans }}</h4>
                </div>
                <div class="modal-body">
                    {{ form_row(batch_form.follower) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.cancel'|trans }}</button>
                    {{ form_widget(batch_form.assign) }}
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" tabindex="-1" role="dialog" id="validate-comment">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">{{ 'admin.sheet.validateSheets'|trans }}</h4>
                </div>
                <div class="modal-body">
                    {{ form_row(batch_form.validateComment) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.cancel'|trans }}</button>
                    {{ form_widget(batch_form.validate) }}
                </div>
            </div>
        </div>
    </div>
    {% if batch_form.assignToGroup is defined %}
        <div class="modal fade" tabindex="-1" role="dialog" id="sheetAssignToGroup">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">{{ 'admin.sheet.assignToGroup'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_row(batch_form.group) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.cancel'|trans }}</button>
                        {{ form_widget(batch_form.assignToGroup) }}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    {% if batch_form.printPlanningOrderBy is defined %}
        <div class="modal fade" tabindex="-1" role="dialog" id="printPlanningOrderBy">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">{{ 'admin.sheet.batch.printPlanningOrderBy'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_row(batch_form.printPlanningOrderBy) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.cancel'|trans }}</button>
                        {% if batch_form.printPlanning is defined %}
                            {{ form_widget(batch_form.printPlanning, { label : 'admin.sheet.batch.printPlanning'|trans}) }}
                        {% endif %}
                        {% if batch_form.printPlanningAndBadge is defined %}
                            {{ form_widget(batch_form.printPlanningAndBadge) }}
                        {% endif %}
                        {% if batch_form.printBadge is defined %}
                            {{ form_widget(batch_form.printBadge) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    {{ form_end(batch_form) }}
{% endblock content %}
