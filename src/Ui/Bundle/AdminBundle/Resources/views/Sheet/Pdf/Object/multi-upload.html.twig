<section id="object-{{ uid }}" class="object object--media section">
    {% set label = item.label(locale, fallback) %}
    {% if label %}
        <header>
            <h2>{{ label }}</h2>
        </header>
    {% endif %}
    <div class="section__content">
        <ul class="list list--medias">
            {% for media in item.data|default([]) %}
                <li>
                    <a download href="{{ media['path'] }}" target="_blank">{{ media['title'] }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
