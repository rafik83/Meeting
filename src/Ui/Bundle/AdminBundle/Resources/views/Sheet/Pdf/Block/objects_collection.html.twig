{% set block = item %}
{% set label = block.label(locale, fallback) %}

<div class="row block block--12 {{ 'style--' ~ block.style }}">
    <div class="col-md-12">
        {% if label %}
            <header>
                <h2>{{ label }}</h2>
            </header>
        {% endif %}

        <table class="table table-striped">
            <thead>
            <tr>
                {% for label in block.objectsLabel %}
                    <th class="col-md-2>{{ label }}</th>
                {% endfor %}
            </tr>
            </thead>
            <tbody>
            {% for row in block.objectsCollectionContent %}
                <tr>
                    {% for column in row %}
                        <td>
                            {% for value in column if column is iterable %}
                                <span class="label label-default">{{ value }}</span>
                            {% else %}
                                {{ column }}
                            {% endfor %}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
