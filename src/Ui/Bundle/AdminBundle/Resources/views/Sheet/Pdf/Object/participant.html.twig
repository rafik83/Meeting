<section id="object-{{ uid }}" class="object object--participant {{ 'style--' ~ item.style }} section section--list">
    {% set label = item.label(locale, fallback) %}
    {% if label %}
        <header>
            <h2>{{ label }}</h2>
        </header>
    {% endif %}

    <div class="section__content">
        <div class="list list--users sheet-participants-list-users">
            {% for participant in participants.cardViews %}
                {{ include('AdminBundle:Participant:preview.html.twig', { 'participant': participant }) }}

                {% if not loop.last and loop.index == item.numberOfParticipantShown %}
                    <div class="show-more-zone" style="display: none;">
                {% endif %}
                {% if loop.last and loop.index > item.numberOfParticipantShown %}
                    </div>
                    <div class="pull-right btn btn-link show-more-button"
                         data-show-more-translation="{{ 'sheet.participant.seeMore.title'|trans }}"
                         data-show-less-translation="{{ 'sheet.participant.seeLess.title'|trans }}"
                        >
                        <i class="icon-Voir_1"></i> {{ 'sheet.participant.seeMore.title'|trans }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
