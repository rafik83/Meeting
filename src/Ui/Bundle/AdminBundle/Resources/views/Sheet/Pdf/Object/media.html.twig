{% if item.data['medias']|default([]) is not empty %}
<section class="object object--media section">
    {% set label = item.label(locale, fallback) %}
    {% if label %}
        <header>
            <h2>{{ label }}</h2>
        </header>
    {% endif %}
    <div class="section__content">
        <ul class="list list--medias">
            {% for media in item.data['medias']|default([]) %}
                <li>
                    {% if media['type'] is defined and media['type'] == 'video' %}
                        <i class="icon-Video_1"></i>
                    {% else %}
                        <i class="icon-Document_1"></i>
                    {% endif %}
                    <a href="{{ media['url'] }}" target="_blank">
                        {{ media['title']|localize(locale, fallback) }} :
                        {{ media['url'] }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endif %}
