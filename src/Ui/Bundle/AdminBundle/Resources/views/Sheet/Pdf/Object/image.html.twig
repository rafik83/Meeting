<div id="object-{{ uid }}" class="object object--image {{ 'style--' ~ item.style }}">
    <div class="image-background">
        <div class="placeholder">
            {% if item.data is defined and item.data['image'] is defined and null != item.data['image'] %}
                <img src="{{ fullPath }}{{ item.data['image']|imagine_filter('event_sheet_image') }}">
            {% endif %}
        </div>
    </div>
</div>
