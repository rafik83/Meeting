{% from 'AdminBundle::macro.html.twig' import delete_button %}

<div class="panel panel-default">
    <div class="panel-heading">
        {{ 'admin.sheet.details.transactions'|trans }}
        <a href="{{ path('admin_sheet_transaction_create', { 'event': event.id, 'sheet': sheet.id }) }}" class="btn btn-default btn-sm">
            {{ 'admin.transaction.add'|trans }}
        </a>
    </div>
    <div class="panel-body">
        {% if transactions|length > 0 %}
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>{{ 'admin.transaction.column.date'|trans }}</th>
                    <th>{{ 'admin.transaction.column.state'|trans }}</th>
                    <th>{{ 'admin.transaction.column.mode'|trans }}</th>
                    <th class="text-right">{{ 'admin.transaction.column.total'|trans }}</th>
                    <th>{{ 'admin.transaction.column.reference'|trans }}</th>
                    <th>{{ 'admin.transaction.column.user'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for transaction in transactions %}
                    <tr>
                        <td nowrap="nowrap">{{ transaction.date|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                        <td>{{ ('admin.transaction.state.' ~ transaction.state)|trans }}</a></td>
                        <td>{{ ('admin.transaction.mode.' ~ transaction.mode)|trans }}</td>
                        <td class="text-right">{{ transaction.amount|localizedcurrency(transaction.currency) }}</td>
                        <td>{{ transaction.reference }}</td>
                        <td>
                            {{ transaction.user.account.completeName }}
                            <br><small><a href="mailto:{{ transaction.user.email }}">{{ transaction.user.email }}</a></small>
                        </td>
                        <td class="text-right col-md-2" nowrap="nowrap">
                            <div class="btn-group">
                                <a id="update_transaction_{{ transaction.id }}_link"
                                   href="{{ path('admin_sheet_transaction_update', {
                                    'event': event.id,
                                    'sheet': sheet.id,
                                    'transaction': transaction.id
                                }) }}" class="btn btn-default btn-sm">{{ 'admin.transaction.edit'|trans }}</a>
                                <button type="button" class="btn btn-default btn-sm dropdown-toggle"
                                        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-right">
                                    <li>
                                        {{ delete_button(
                                        path('admin_sheet_transaction_remove', {
                                            'event': event.id,
                                            'sheet': sheet.id,
                                            'transaction': transaction.id
                                        }),
                                        'admin.transaction.remove'|trans,
                                        {}) }}
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-danger">{{ 'admin.zero-result'|trans }}</p>
        {% endif %}
    </div>
</div>
