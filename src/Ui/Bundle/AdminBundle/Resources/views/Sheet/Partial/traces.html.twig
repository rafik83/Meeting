<ul class="list-group">
    <li class="list-group-item">
        {{ 'admin.sheet.createdAt'|trans }}
        <span class="badge">{{ sheet.createdAt|localizeddate('medium', 'short', app.request.locale) }}</span>
    </li>
    {% if sheet.lastLoginAt is not null %}
        <li class="list-group-item">
            {{ 'admin.sheet.lastLoginAt'|trans }}
            <span class="badge">
                {{ sheet.lastLoginAt|localizeddate('medium', 'short', app.request.locale) }}
            </span>
        </li>
    {% endif %}

    {% for trace in traces %}
        <li class="list-group-item">
            {{ ('admin.sheet.trace.' ~ trace.action)|trans({'%at%': trace.date|localizeddate('medium', 'short', app.request.locale)}) }}
            {% if trace.author != '' %}
                {{ 'admin.sheet.trace.author'|trans({'%by%': trace.author}) }}
            {% else %}
                {{ 'admin.sheet.trace.auto'|trans }}
            {% endif %}
            {% if trace.comment != '' %}
                {{ 'admin.sheet.trace.comment'|trans({'%comment%': trace.comment}) }}
            {% endif %}
            <span class="badge">{{ trace.date|localizeddate('medium', 'short', app.request.locale) }}</span>
        </li>
    {% endfor %}
</ul>
