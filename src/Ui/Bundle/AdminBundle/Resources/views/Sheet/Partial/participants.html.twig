{% from 'AdminBundle::macro.html.twig' import button %}

<div class="row">
    <div class="col-md-6">
    {% if details.participants.owner.shouldBeDisplayed %}
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    {{ 'admin.sheet.details.owner_not_participant.title'|trans }}

                    {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                        <div class="pull-right">
                            <a href="{{ path('admin_sheet_change_owner', {'event': event.id, 'sheet': sheet.id}) }}" class="btn btn-xs btn-default">
                                {{ 'admin.sheet.changeOwner.link'|trans }}
                            </a>
                        </div>
                    {% endif %}
                </div>
                <div class="panel-body">
                    {{ details.participants.owner.firstName }}  {{ details.participants.owner.lastName }}<br>
                    {{ 'admin.sheet.details.owner.mobile'|trans }}: {{ details.participants.owner.mobile }}<br>
                    {{ 'admin.sheet.details.owner.phone'|trans }}: {{ details.participants.owner.phone }}<br>
                    {{ button(path('admin_impersonate', {
                                'event': event.id,
                                'user': details.participants.owner.user.id,
                                'route': 'event_sheet_default',
                                'params': { 'sheet': sheet.id },
                            }),
                            'POST',
                            'admin.sheet.impersonate'|trans,
                            { 'class': 'btn btn-default btn-sm' },
                            null,
                            'impersonate-to-'~participant.userId
                        ) }}
                </div>
            </div>
        </div>
    {% endif %}
    {% for participant in details.participants.participants %}
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    {{ 'admin.sheet.details.participant.title'|trans }} {{ loop.index }}

                    {% if participant.isOwner %}
                        ({{ 'admin.sheet.details.owner.title'|trans }})

                        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                            <a href="{{ path('admin_sheet_change_owner', {'event': event.id, 'sheet': sheet.id}) }}" class="btn btn-xs btn-default">
                                {{ 'admin.sheet.changeOwner.link'|trans }}
                            </a>
                        {% endif %}
                    {% endif %}

                    {% if not event.configuration.isVisio %}
                        <div class="pull-right">
                            <form class="form-participant-visio" action="{{ path('admin_sheet_update_participant_visio', {
                                        'event': event.id,
                                        'participant': participant.id
                                    }) }}">
                                <label for="is-visio-{{ participant.id }}">
                                    {{ 'admin.sheet.details.participant.visio'|trans }}
                                    <input type="checkbox" id="is-visio-{{ participant.id }}" name="is-visio" {{ participant.visio ? "checked" : '' }}>
                                </label>
                            </form>
                        </div>
                    {% endif %}
                </div>
                <div class="panel-body">
                    {% for object in participant.templateData.getProfileObjects %}
                        {{ include('AdminBundle:Sheet/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}
                    {% endfor %}
                    <b>{{ 'admin.sheet.details.participant.email'|trans }}: </b>{{ participant.email }}
                    <br/>
                    <b>{{ 'admin.sheet.details.participant.phoneValidationStatus.title'|trans }}: </b><span class="label label-{{ participant.phoneValidationStatusView.indicator }}">{{ participant.phoneValidationStatusView.message|trans }}</span>
                    <br/>
                    {% include 'AdminBundle:Sheet/Partial:is_agenda_confirmed.html.twig' with {
                        'agendaConfirmationStatus': participant.agendaConfirmationStatus
                    } %}
                    <br/>
                    <b>{{ 'admin.sheet.details.participant.availability_confirmation.title'|trans }}: </b><span class="label label-{{ participant.availabilityConfirmationView.indicator }}">{{ participant.availabilityConfirmationView.message|trans }}</span>
                    <br/>

                    {{ button(path('admin_impersonate', {
                                'event': event.id,
                                'user': participant.userId,
                                'route': 'event_sheet_default',
                                'params': { 'sheet': sheet.id },
                            }),
                            'POST',
                            'admin.sheet.impersonate'|trans,
                            { 'class': 'btn btn-default btn-sm' },
                            null,
                            'impersonate-to-'~participant.userId
                    ) }}

                </div>
            </div>
        </div>
    {% endfor %}
    </div>
    <div class="col-md-6">
        {% if details.companyObjects is not empty %}
            <div class="panel panel-info">
                <div class="panel-heading">
                    {{ 'admin.sheet.details.company.title'|trans }}
                </div>
                <div class="panel-body">
                    {% for object in details.companyObjects %}
                        {{ include('AdminBundle:Sheet/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
