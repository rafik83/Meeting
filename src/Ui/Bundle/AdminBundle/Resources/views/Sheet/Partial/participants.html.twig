<div class="row">
    {% set impersonationUrl = app.request.scheme ~ '://' ~ event.domain ~ path('event_sheet', {'sheet': sheet.id, '_switchto': impersonationToken}) %}
    <div class="col-md-6">
    {% if details.owner.shouldBeDisplayed %}
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    {{ 'admin.sheet.details.owner_not_participant.title'|trans }}
                </div>
                <div class="panel-body">
                    {{ details.owner.firstName }}  {{ details.owner.lastName }}<br>
                    {{ details.owner.email }}<br>
                    {{ 'admin.sheet.details.owner.mobile'|trans }}: {{ details.owner.mobile }}<br>
                    {{ 'admin.sheet.details.owner.phone'|trans }}: {{ details.owner.phone }}<br>
                    <a href="{{ impersonationUrl }}" class="btn btn-default btn-sm">{{ 'admin.sheet.impersonate'|trans }}</a>
                </div>
            </div>
        </div>
    {% endif %}
    {% for participant in details.participants %}
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    {{ 'admin.sheet.details.participant.title'|trans }} {{ loop.index }}

                    {% if participant.isOwner %}
                        ({{ 'admin.sheet.details.owner.title'|trans }})
                    {% endif %}

                    <div class="pull-right">
                        <form class="form-participant-visio" action="{{ path('admin_sheet_update_participant_visio', {
                                    'event': event.id,
                                    'sheet': sheet.id,
                                    'participant': participant.id
                                }) }}"
                                data-action="{{ path('admin_sheet_update_participant_visio', {
                                    'event': event.id,
                                    'sheet': sheet.id,
                                    'participant': participant.id
                                }) }}">
                            <label for="is-visio-{{ participant.id }}">
                                {{ 'admin.sheet.details.participant.visio'|trans }}
                                <input type="checkbox" id="is-visio-{{ participant.id }}" name="is-visio" {{ participant.isVisio }}>
                            </label>
                        </form>
                    </div>
                </div>
                <div class="panel-body">
                    {% for object in participant.templateData.getProfileObjects %}
                        {{ include('AdminBundle:Sheet/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}
                    {% endfor %}

                    {% if participant.isOwner %}
                        <a href="{{ impersonationUrl }}" class="btn btn-default btn-sm">{{ 'admin.sheet.impersonate'|trans }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
    </div>
    <div class="col-md-6">
        {% if details.companyObjects is not empty %}
            <div class="panel panel-info">
                <div class="panel-heading">
                    {{ 'admin.sheet.details.company.title'|trans }}
                </div>
                <div class="panel-body">
                    {% for object in details.companyObjects %}
                        {{ include('AdminBundle:Sheet/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
