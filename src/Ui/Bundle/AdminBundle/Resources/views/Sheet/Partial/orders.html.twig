{% from 'AdminBundle::macro.html.twig' import delete_button %}

<div class="panel panel-default">
    <div class="panel-heading">
        {{ 'admin.sheet.details.orders'|trans }}
        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') and not hasInvoice and orderVatViews|length > 0 %}
            {{ delete_button(
                path('admin_sheet_orders_cancel', {'event': event.id, 'sheet': sheet.id}),
                'admin.sheet.orders.cancel'|trans,
                {
                    'class' : 'btn btn-danger btn-sm',
                    'data-confirm': 'admin.sheet.orders.cancel.confirm'|trans
                },
                constant('Proximum\\Vimeet\\Domain\\Intention\\IntentionType::INTENTION_CANCEL_ORDERS')
                )
            }}
        {% endif %}
    </div>
    <div class="panel-body">
        {% if orderVatViews|length > 0 %}
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>{{ 'admin.order.id'|trans }}</th>
                    <th>{{ 'admin.order.createdAt'|trans }}</th>
                    <th class="text-right">{{ 'admin.order.total'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for orderVatView in orderVatViews %}
                    <tr>
                        <td>
                            {{ orderVatView.numero }}
                            {% if orderVatView.isCancelled %}
                                <span class="label label-danger">{{ 'admin.order.cancelled'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {{ orderVatView.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
                        </td>
                        <td class="text-right">
                            {{ orderVatView.totalWithVat|format_amount|localizedcurrency(orderVatView.currency) }}
                            {{ ('admin.event.vatMode.' ~ orderVatView.totalVatMode)|trans }}
                        </td>
                        <td class="text-right">
                            {% if not orderVatView.hasInvoice %}
                                <a href="{{ path('admin_sheet_order_edit', { event: event.id, order: orderVatView.orderId }) }}" class="btn btn-default btn-sm">
                                    {{ 'admin.order_edit.link'|trans }}
                                </a>
                            {% else %}
                                <span class="label label-success">
                                    {{ 'admin.order.invoiceNumber'|trans }}
                                    {{ orderVatView.invoice.number }}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-danger">{{ 'admin.zero-result'|trans }}</p>
        {% endif %}
    </div>
</div>

