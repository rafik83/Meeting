<div class="panel panel-default">
    <div class="panel-heading">
        {{ 'admin.sheet.details.invoices'|trans }}
    </div>
    <div class="panel-body">
        {% if invoiceViews|length > 0 %}
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>{{ 'admin.invoice.column.number'|trans }}</th>
                    <th>{{ 'admin.invoice.column.orders'|trans }}</th>
                    <th>{{ 'admin.invoice.column.date'|trans }}</th>
                    <th class="text-right">{{ 'admin.invoice.column.total'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for invoiceView in invoiceViews %}
                    <tr>
                        <td>{{ invoiceView.number }}</td>
                        <td>
                            <ul>
                                {% for orderView in invoiceView.orderViews %}
                                    <li>{{ orderView.numero }}</li>
                                {% endfor %}
                            </ul>
                        </td>
                        <td nowrap="nowrap">{{ invoiceView.createdAt|localizeddate('medium', 'short', app.request.locale) }}</td>
                        <td class="text-right">{{ invoiceView.total|format_amount|localizedcurrency(invoiceView.currency) }}</td>
                        <td class="text-right">
                            <a href="{{ invoiceView.url }}" target="_blank" class="btn btn-sm btn-default">
                                {{ 'admin.invoice.show'|trans }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-danger">{{ 'admin.zero-result'|trans }}</p>
        {% endif %}
    </div>
</div>
