<div class="panel panel-default">
    <div class="panel-heading">
        {{ 'admin.sheet.details.invoices'|trans }}
    </div>
    <div class="panel-body">
        {% if invoices|length > 0 %}
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>{{ 'admin.invoice.column.number'|trans }}</th>
                    <th>{{ 'admin.invoice.column.date'|trans }}</th>
                    <th class="text-right">{{ 'admin.invoice.column.total'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for invoice in invoices %}
                    <tr>
                        <td>{{ invoice.number }}</td>
                        <td nowrap="nowrap">{{ invoice.createdAt|localizeddate('medium', 'short', app.request.locale) }}</td>
                        <td class="text-right">{{ invoice.total }}</td>
                        <td class="text-right col-md-2" nowrap="nowrap">
                            <div class="btn-group">
                                <a href="#" class="btn btn-default btn-sm">{{ 'admin.invoice.pdf'|trans }}</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-danger">{{ 'admin.zero-result'|trans }}</p>
        {% endif %}
    </div>
</div>
