<div class="row">
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ 'admin.sheet.dashboard.totalOrders'|trans }}
            </div>
            <div class="panel-body text-center h1">
                {{ view.totalOrders|localizedcurrency(event.currency) }}
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ 'admin.sheet.dashboard.totalPaid'|trans }}
            </div>
            <div class="panel-body text-center h1">
                {{ view.totalPaid|localizedcurrency(event.currency) }}
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ 'admin.sheet.dashboard.totalRemainingToPay'|trans }}
            </div>
            <div class="panel-body text-center h1">
                {{ view.totalRemainingToPay|localizedcurrency(event.currency) }}
            </div>
        </div>
    </div>
</div>
