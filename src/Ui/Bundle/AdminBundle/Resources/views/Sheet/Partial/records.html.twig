<div class="well well-sm">
    {{ form_start(addCommentForm) }}
        {{ form_label(addCommentForm.reminderDate) }}
        {{ form_widget(addCommentForm.reminderDate) }}
        {{ form_label(addCommentForm.commercialStatus) }}
        {{ form_errors(addCommentForm.commercialStatus) }}
        {{ form_widget(addCommentForm.commercialStatus) }}
        <br />
        <br />
        {{ form_row(addCommentForm.text) }}
    {{ form_end(addCommentForm) }}
</div>

{% for record in records %}
        <blockquote>
        {% if is_granted('ROLE_SUPER_ADMIN') and record.isComment %}
            <form style="float: right;" data-confirm="{{ 'admin.event.sheet.comment.remove.confirm'|trans }}" method="post" action="{{ path('admin_sheet_remove_comment', {'event': event.id, 'sheet': sheet.id, 'comment': record.commentId}) }}">
                <input type="hidden" name="_method" value="DELETE" />
                <input type="hidden" name="_token" value="{{ csrf_token(record.getRemoveIntentionComment) }}">
                <button class="btn btn-xs btn-danger" type="submit">x</button>
            </form>
        {% endif %}

        {% if record.isTrace %}
            <span class="label label-{{ record.getCorrespondingLabel }}">
                {{ (record.getTraceTranslationKey ~ record.comment)|trans }}
            </span>
        {% else %}
            {{ record.comment|nl2br }}
        {% endif %}
        <footer>
            {{ 'admin.sheet.details.comments.author'|trans({
                '%firstname%': record.author.firstname,
                '%lastname%': record.author.lastname,
                '%date%': record.createdAt|localizeddate('medium', 'short', app.request.locale)
            }) }}
        </footer>
    </blockquote>
{% endfor %}
