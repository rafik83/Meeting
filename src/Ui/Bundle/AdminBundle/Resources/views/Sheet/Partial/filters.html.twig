{% import 'AdminBundle::macro.html.twig' as macro %}

<div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
    <div class="panel panel-default">
        <div class="panel-heading" role="tab" id="headingOne">
            <h4 class="panel-title text-center">
                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#advancedFilters" aria-expanded="true" aria-controls="advancedFilters">
                    {{ 'admin.sheet.list.filters.label'|trans }} <span class="glyphicon glyphicon-chevron-down"></span>
                </a>
            </h4>
        </div>
        <div id="advancedFilters"
             class="panel-collapse collapse {% if not filter_form.vars.valid %}in{% endif %}"
             role="tabpanel"
             {% if not filter_form.vars.valid %}aria-expanded="true"{% endif %}
             aria-labelledby="headingOne"
        >
            <div class="panel-body">
                <div class="col-md-12">
                    <div class="form-group pull-right">
                        <button type="submit" id="submit" name="submit" class=" btn btn-primary">
                            {{ 'form.admin.sheet.filter.children.submit.label'|trans({}, 'forms') }}
                        </button>
                    </div>
                </div>
                <div class="row filters">
                    <div class="col-md-12 text-right">
                        {{ macro.choice_as_dropdown(filter_form.orderBy, true, true, false, false, false) }}
                        {{ form_widget(filter_form.orderBy, {'attr': {'class': 'hide'}}) }}
                    </div>
                </div>
                <div class="col-md-6">
                    {{ form_row(form.enabled, {'inline': true}) }}
                    {{ form_row(form.validationState, {'inline': true}) }}
                    {{ form_row(form.state, {'inline': true}) }}
                    {{ form_row(form.completed, {'inline': true}) }}
                    {{ form_row(form.inCatalog, {'inline': true}) }}
                    {{ form_row(form.cancelAttendance, {'inline': true}) }}
                    {{ form_row(form.hasGroup, {'inline': true}) }}
                    {{ form_row(form.hasSpot, {'inline': true}) }}
                    {{ form_row(form.type) }}

                    {% if form.categories is defined %}
                        {{ form_row(form.categories) }}
                    {% endif %}

                    {{ form_row(form.registeredAt, {'inline': true}) }}
                    {{ form_row(form.imported) }}
                    {{ form_row(form.hasHappeningParticipation, {'inline': true}) }}

                    <hr>

                    {{ form_row(form.hasRemainingToPay, {'inline': true}) }}
                    {{ form_row(form.order_status, {'inline': true}) }}
                    {{ form_row(form.has_cart, {'inline': true}) }}
                    {{ form_row(form.hasInvoice, {'inline': true}) }}

                    <hr>

                    {{ form_row(form.hasScheduledMeeting, {'inline': true}) }}
                    {{ form_row(form.agendaConfirmedStatus) }}
                    {{ form_row(form.phoneValidationStatus) }}
                    {{ form_row(form.availabilityConfirmationStatus) }}
                    {{ form_row(form.hasPendingMeetingPropositions, {'inline': true}) }}
                    {{ form_row(form.hasNoMeetingRequest, {'inline': true}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.country) }}
                    {{ form_row(form.reminderDate) }}
                    {{ form_row(form.follower) }}
                    {{ form_row(form.commercialStatus) }}

                    {% if form.filled_filters is defined %}
                        {% for filled_filter in form.filled_filters.children %}
                            {{ form_row(filled_filter) }}
                        {% endfor %}
                    {% endif %}

                    <hr>

                    {% if form.boolean_filters is defined %}
                        {% for boolean_filter in form.boolean_filters.children %}
                            {{ form_row(boolean_filter, {'inline': true}) }}
                        {% endfor %}
                    {% endif %}
                </div>
                <div class="col-md-12">
                    <div class="form-group pull-right">
                        <button type="submit" id="submit" name="submit" class=" btn btn-primary">
                            {{ 'form.admin.sheet.filter.children.submit.label'|trans({}, 'forms') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
