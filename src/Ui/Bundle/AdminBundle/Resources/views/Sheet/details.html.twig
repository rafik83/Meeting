{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.sheet.details.title'|trans ~ ': ' ~ details.title %}

{% block content %}
    <h1>
        <a href="{{ path('admin_sheet', { event: event.id }) }}" class="btn btn-link btn-sm" data-toggle="tooltip" title="{{ 'admin.sheet.go_back_to_list'|trans }}"><span class="glyphicon glyphicon-list"></span></a>
        {{ details.title }}

        {% spaceless %}
            <span class="label label-info label-sheet-type"
                {% if details.meetingIndicator.meetings > 0 %}
                    data-toggle="tooltip" data-placement="top" title="{{ 'admin.sheet.change.type.hasMeeting'|trans }}"
                {% endif %}
            >
                {{ sheetTypeTitle }}

                {% if changeTypeForm is not null %}
                    <a href="#" data-toggle="modal" data-target="#changeType" title="{{ 'admin.sheet.change.type.link'|trans }}">
                        <span class="glyphicon glyphicon-edit"></span>
                    </a>
                {% endif %}
            </span>

            <span class="label label-default">
                {{ ('event.sheet.state.' ~ details.state)|trans }}
            </span>

            {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                <a href="{{ path('admin_sheet_attend', {'event': event.id, 'sheet': sheet.id}) }}"
                    class="label label-{{ sheet.attend ? 'success' : 'danger' }}">
            {% else %}
                <span class="label label-{{ sheet.attend ? 'success' : 'danger' }}">
            {% endif %}

                {{ ('event.sheet.attend.' ~ (sheet.attend ? 'present' : 'cancel'))|trans }}

            {% if not is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                </span>
            {% else %}
                </a>
            {% endif %}

            {% if sheet.inCatalog %}
                <span class="label label-success">
                    {{ 'admin.sheet.inCatalog'|trans }}
                </span>
            {% endif %}

            {% if is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                <span class="label label-{{ details.remainingToPay == 0 ? 'success' : 'danger' }}" data-toggle="tooltip" title="{{ 'admin.sheet.details.remainingToPay'|trans }}">
                    {{ details.remainingToPay|format_amount|localizedcurrency(event.currency) }}
                </span>
            {% endif %}
            <span class="label label-{{ details.completenessStatus }}" data-toggle="tooltip" title="{{ 'admin.sheet.details.completeness'|trans }}">
                {{ details.completeness }}%
            </span>

            {% if sheet.spot != null %}
                <span class="label label-default">
                    <i class="glyphicon glyphicon-map-marker"></i> {{ sheet.spot.reference }}
                </span>
            {% endif %}
        {% endspaceless %}
    </h1>

    <div class="row">
        <div class="col-md-9">
            <ul class="nav nav-tabs" role="tablist" data-switch-to-tab="anchor">
                <li role="presentation" class="active"><a href="#sheetDashboard" aria-controls="home" role="tab" data-toggle="tab">{{ 'admin.sheet.details.dashboard.title'|trans }}</a></li>
                {% if is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                    <li role="presentation">
                        <a href="#sheetOrders" aria-controls="profile" role="tab" data-toggle="tab">{{ 'admin.sheet.details.orders_and_transactions.title'|trans }}</a>
                    </li>
                {% endif %}
                <li role="presentation">
                    <a href="#sheetTraces" aria-controls="profile" role="tab"
                       data-toggle="tab">{{ 'admin.sheet.details.historic.title'|trans }}</a>
                </li>
            </ul>

            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="sheetDashboard">
                    {{ include('AdminBundle:Sheet/Partial:participants.html.twig', { event: event, sheet: sheet, details: details }, false) }}

                    <hr>

                    {{ include('AdminBundle:Sheet/Partial:meetings.html.twig', { details: details }, false) }}
                </div>

                {% if is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                    <div role="tabpanel" class="tab-pane" id="sheetOrders">
                        {{ include('AdminBundle:Sheet/Partial:orders.html.twig', { event: event, sheet: sheet, orderVatViews: details.orderVatViews, 'hasInvoice': details.invoiceViews|length > 0 }, false) }}

                        {{ include('AdminBundle:Sheet/Partial:transactions.html.twig', { event: event, sheet: sheet, transactions: details.transactions }, false) }}

                        {{ include('AdminBundle:Sheet/Partial:invoices.html.twig', { event: event, sheet: sheet, invoiceViews: details.invoiceViews }, false) }}
                    </div>
                {% endif %}

                <div role="tabpanel" class="tab-pane" id="sheetTraces">
                    {{ include('AdminBundle:Sheet/Partial:traces.html.twig', { event: event, sheet: sheet, traces: details.traces }, false) }}
                </div>
            </div>
        </div>

        <div class="col-md-3">
            {{ include('AdminBundle:Sheet/Partial:records.html.twig', {
                addCommentForm: addCommentForm,
                records: details.recordViews,
                event: event,
                sheet: sheet
            }, false) }}
        </div>
    </div>

    {{ include('AdminBundle:Sheet/Partial:change_type_form.html.twig', { changeTypeForm: changeTypeForm }, false) }}
    <div class="modal fade clear-on-hidden-modal" id="edit_agenda_confirmation_status" tabindex="-1" role="dialog" aria-labelledby="edit_agenda_confirmation_status" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>
{% endblock %}
