{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1>{{ event.title }}</h1>

    <h2>{{ details.title }} <span class="label label-default">{{ ('event.sheet.state.' ~ details.state)|trans }}</span></h2>

    <h3>Participants</h3>
    <table class="table table-bordered">
        <tr>
            <th>Participants</th>
            <td>
                <table class="table">
                    <thead>
                    <tr>
                        {% for label, value in details.participants|first %}
                            <th>{{ label }}</th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for participant in details.participants %}
                        <tr>
                            {% for label, value in participant %}
                                <td>{{ value }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <th>Email du propriétaire</th>
            <td>{{ details.ownerEmail }}</td>
        </tr>
        <tr>
            <th>Téléphone du propriétaire</th>
            <td>{{ details.ownerPhone }}</td>
        </tr>
    </table>


    <h3>Informations de facturation</h3>
    <p>Organisation: {{ details.billing.organization|default('-') }}</p>
    <p>Contact: {{ details.billing.name|default('-') }}</p>
    <p>Adresse:
        {{ details.billing.address|default('-') }}<br>
        {{ details.billing.zipcode }} {{ details.billing.city }}<br>
        {% if details.billing.country %}{{ details.billing.country|country }}{% endif %}
    </p>
    <p>N° de TVA intracommunautaire : {{ details.billing.vat_number|default('-') }}</p>


    <div class="row">
        <div class="col-md-6">
            <h3>Forfait</h3>
            {{ details.package }}
        </div>
        <div class="col-md-6">
            <h3>Commandes</h3>
            <a href="{{ path('admin_sheet_billing', { 'event': event.id, 'sheet': sheet.id }) }}" class="btn btn-primary btn-sm">Commandes et transactions</a>
        </div>
    </div>

    {% for key, block in details.blocks %}
        <h3>{{ block.title }}</h3>
        <table class="table table-condensed">
            {% for row in block.rows %}
                <tr>
                    <th class="col-md-3">{{ row.label }}</th>
                    <td class="col-md-9">{{ row.value }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endfor %}

    <h3>Demandes de Rendez-vous</h3>

    <div class="row">
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    Demandes validées
                </div>
                <div class="panel-body text-center h1">
                    {{ details.approvedRequests }}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    Demandes en attente
                </div>
                <div class="panel-body text-center h1">
                    {{ details.pendingRequests }}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    Demandes refusées
                </div>
                <div class="panel-body text-center h1">
                    {{ details.refusedRequests }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    Propositions validées
                </div>
                <div class="panel-body text-center h1">
                    {{ details.approvedPropositions }}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    Propositions en attente
                </div>
                <div class="panel-body text-center h1">
                    {{ details.pendingPropositions }}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    Propositions refusées
                </div>
                <div class="panel-body text-center h1">
                    {{ details.refusedPropositions }}
                </div>
            </div>
        </div>
    </div>

    {% if details.traces %}
    <h3>{{ 'admin.sheet.details.historic.title'|trans }}</h3>
    <div class="row">
        <ul>
            {% for trace in details.traces %}
                <li>{{ ('admin.sheet.trace.' ~ trace.action)|trans({'%at%': trace.date|date('d/m/Y H:i')}) }}
                    {% if trace.author != '' %}{{ 'admin.sheet.trace.author'|trans({'%by%': trace.author}) }}{% else %}{{ 'admin.sheet.trace.auto'|trans }}{% endif %}
                    {% if trace.comment != '' %}{{ 'admin.sheet.trace.comment'|trans({'%comment%': trace.comment}) }}{% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <h3>{{ 'admin.sheet.details.comments.title'|trans }}</h3>
    <div class="row">
        {% for comment in details.comments %}
            <blockquote>
                {{ comment.text|nl2br }}
                <br>
            <span class="label label-default">
                {{ 'admin.sheet.details.comments.author'|trans({
                    '%firstname%': comment.author.firstname,
                    '%lastname%': comment.author.lastname,
                    '%date%': comment.createdAt|date('d/m/Y H:i')
                }) }}
            </span>
            </blockquote>
        {% endfor %}
    </div>

    <div class="row">
        {{ form_start(form) }}
        <div class="col-xs-10">
            {{ form_row(form.text) }}
        </div>
        <div class="col-xs-2">
            {{ form_row(form.submit) }}
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
