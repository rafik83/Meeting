{% extends 'AdminBundle::base.html.twig' %}

{% block title 'login.title'|trans %}

{% block content %}
    <div class="row">
        <div class="col-md-6 col-md-offset-3">
            <div class="panel panel-default">
                <div class="panel-heading">{{ 'login.title'|trans }}</div>
                <div class="panel-body">
                    {% block form %}
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {{ form_start(form) }}
                    {{ form_row(form.username) }}
                    {{ form_row(form.password) }}

                    <div class="row">
                        <div class="col-md-6 col-md-offset-3">
                            {{ form_row(form.rememberMe, {inline: true}) }}
                        </div>
                        <div class="col-md-3 text-right">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>

                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                    {% endblock %}
                </div>
            </div>

            <div class="text-center">
                <a href="{{ path('admin_forgot_password') }}" class="btn btn-link">{{ 'login.forgotPassword'|trans }}</a>
            </div>

            {% if admins is not empty %}
                <div class="well">
                    <h3>1-click login</h3>
                    <ul>
                        {% for admin in admins %}
                            <li><a href="{{ path('admin_login_user', { 'admin': admin.id }) }}">{{ admin.username }} ({{ admin.roles|join(', ')|replace({ 'ROLE_': '', '_': ' ' }) }})</a></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
