{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title 'admin.package.title'|trans %}

{% block form_content %}
    {{ form_row(form.title) }}
    <div class="well">
        {{ form_row(form.plans) }}
    </div>
    <div class="well">
        {{ form_row(form.participantAndPlanning) }}
    </div>
    <div class="well">
        {{ form_row(form.options) }}
    </div>
{% endblock form_content %}

{% block goback_link event is defined ? path('admin_event_template_package', {'event': event.id}) : path('admin_package_list') %}
