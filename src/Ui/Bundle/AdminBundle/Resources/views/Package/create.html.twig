{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.package_create.title'|trans %}

{% block form_title 'admin.package_create.title'|trans %}

{% block form_content %}
    {{ form_row(form.name) }}
    {{ form_row(form.translations) }}
    {{ form_row(form.file) }}
    {{ form_row(form.unitPrice) }}
    {{ form_row(form.features) }}
    {{ form_row(form.availabilityCurrent) }}
    {{ form_row(form.availabilityMax) }}
    {{ form_row(form.participantIncluded) }}
    {{ form_row(form.productIncluded) }}
{% endblock %}

{% block goback_link path('admin_package', {event: event.id}) %}
