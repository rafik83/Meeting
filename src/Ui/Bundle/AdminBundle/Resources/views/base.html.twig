<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% if event is defined and event is not null %}{{ event.title }} &gt; {% endif %}{% block title '' %}</title>
        <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
        <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
        <![endif]-->
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('assets/css/adminStyle.css') }}">
        {% endblock %}
    </head>
    <body>
        {% block body %}
            {{ include('AdminBundle:Common:menu.html.twig') }}
            <div class="container-fluid">
                {{ include('AdminBundle::flashes.html.twig') }}
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
        {% block javascripts %}
            <script src="{{ asset('assets/js/admin.js') }}"></script>
        {% endblock %}
    </body>
</html>
