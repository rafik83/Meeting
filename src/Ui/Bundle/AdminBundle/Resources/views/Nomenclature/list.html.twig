{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <h1 class="page-header">{{ 'admin.nomenclature.title'|trans }}</h1>

    <div>
        <a href="#createModal" data-toggle="modal" class="btn btn-success">{{ 'admin.nomenclature.create.button'|trans }}</a>
    </div>

    <div class="modal fade" id="createModal">
        {{ form_start(form) }}
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="configure-modal-label">{{ 'admin.nomenclature.create.modal.title'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_row(form.title) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.nomenclature.create.modal.close'|trans }}</button>
                        {{ form_row(form.submit) }}
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>{{ 'admin.nomenclature.table.title'|trans }}</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for nomenclature in nomenclatures %}
                <tr>
                    <td>
                        <a href="{{ path('admin_nomenclature_read', { 'nomenclature': nomenclature.id }) }}">
                            {{ nomenclature.title }}
                        </a>
                    </td>
                    <td>
                        {{ 'admin.nomenclature.table.depth'|transchoice(nomenclature.depth, { '%depth%': nomenclature.depth }) }}
                    </td>
                    <td class="text-right">
                        <a href="{{ path('admin_nomenclature_read', { 'nomenclature': nomenclature.id }) }}" class="btn btn-primary btn-sm">
                            {{ 'admin.nomenclature.table.read'|trans }}
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">
                        {{ 'admin.zero-result'|trans }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
