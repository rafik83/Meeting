{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ nomenclature.title }}</h1>

    <div class="row with-submit-section">
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
            <ul>
                {% for child_one in nomenclature.children %}
                    <li>
                        {{ child_one.label(app.request.locale) }}
                        <ul>
                            {% for child_two in child_one.children %}
                                <li>
                                    {{ child_two.label(app.request.locale) }}
                                    <ul>
                                        {% for child_three in child_two.children %}
                                            <li>{{ child_three.label(app.request.locale) }}</li>
                                        {% endfor %}
                                    </ul>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
            <div class="well">
                {{ form(update_form) }}
            </div>
            <div class="well">
                {{ form(import_form) }}
            </div>
        </div>
    </div>

    <div class="form">
        <div class="form-group submit-section">
            <div class="col-sm-3">
                <a href="{{ path('admin_nomenclature_list') }}" class="btn btn-link">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                    {{ 'admin.goback.link'|trans }}
                </a>
            </div>
            <div class="col-sm-9 text-right">

            </div>
        </div>
    </div>

{% endblock %}
