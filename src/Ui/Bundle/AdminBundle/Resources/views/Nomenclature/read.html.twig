{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ nomenclature.title }}</h1>

    {% set locales = nomenclature.locales %}

    <div class="row with-submit-section">
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">

            <ul class="nav nav-tabs" role="tablist">
                {% for locale in locales %}
                    <li role="presentation"{% if loop.first %} class="active"{% endif %}><a href="#nomenclature-{{ locale }}" aria-controls="home" role="tab" data-toggle="tab">{{ locale }}</a></li>
                {% endfor %}
            </ul>

            <div class="tab-content">
                {% for locale in locales %}
                    <div role="tabpanel" class="tab-pane{% if loop.first %} active{% endif %}" id="nomenclature-{{ locale }}">
                        {{ include('AdminBundle:Nomenclature:tree.html.twig', { 'nomenclature': nomenclature, 'locale': locale }, false) }}
                    </div>
                {% endfor %}
            </div>

        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="well">
                <h3>{{ 'admin.nomenclature.read.configuration.title'|trans }}</h3>
                {{ form(update_form) }}
            </div>
            <div class="well">
                <h3>{{ 'admin.nomenclature.read.import.title'|trans }}</h3>
                {{ form_start(import_form) }}
                    {{ form_errors(import_form) }}
                    {{ form_row(import_form.file) }}
                    <button type="submit" class="btn btn-primary">
                        <i class="glyphicon glyphicon-upload"></i>
                        {{ 'admin.nomenclature.read.import.button'|trans }}
                    </button>
                {{ form_end(import_form) }}
            </div>
            <div class="well">
                <h3>{{ 'admin.nomenclature.read.export.title'|trans }}</h3>
                <p class="help-block">{{ 'admin.nomenclature.read.export.help'|trans }}</p>
                <a href="{{ path('admin_nomenclature_export', { 'nomenclature': nomenclature.id }) }}" class="btn btn-primary">
                    <i class="glyphicon glyphicon-download"></i>
                    {{ 'admin.nomenclature.read.export.button'|trans }}
                </a>
            </div>
        </div>
    </div>

    <div class="form">
        <div class="form-group submit-section">
            <div class="col-sm-3">
                <a href="{{ path('admin_nomenclature_list') }}" class="btn btn-link">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                    {{ 'admin.goback.link'|trans }}
                </a>
            </div>
            <div class="col-sm-9 text-right">

            </div>
        </div>
    </div>

{% endblock %}
