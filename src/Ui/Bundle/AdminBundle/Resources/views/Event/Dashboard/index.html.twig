{% extends 'AdminBundle::base.html.twig' %}

{% block title %}
    [{{ event.title }}] {{ 'admin.event.dashboard.title'|trans }}
{% endblock %}

{% block content %}
    <h1>{{ 'admin.event.dashboard.title'|trans }}</h1>

    {{ include('AdminBundle:Dashboard:orders.html.twig', {
        dashboard: dashboard.transactionView,
        event: event
    }, false) }}

    {{ include('AdminBundle:Dashboard:sheets.html.twig', {
        dashboard: dashboard.dashboardSheetView,
        event: event
    }, false) }}
{% endblock %}
