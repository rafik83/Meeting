    <div class="dropdown">
        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown">
            Actions
            <span class="caret"></span>
        </button>
        <ul class="dropdown-menu">
            {{ include('AdminBundle:Event:links.html.twig', {event: event}) }}
        </ul>
    </div>
{% endblock %}
