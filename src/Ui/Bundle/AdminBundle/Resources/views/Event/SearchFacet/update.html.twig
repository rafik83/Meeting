{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title 'admin.event.search_facet.title'|trans %}

{% block form_content %}
    {% for searchFacet in form.searchFacets %}
        {{ form_label(searchFacet) }}
        {{ form_row(searchFacet.enabled, {'label': 'admin.event.search_facet.enabled.label'|trans }) }}
        {{ form_row(searchFacet.translations, {widget_columns: 8}) }}
    {% endfor %}
{% endblock form_content %}

{% block goback_link path('admin_event_list') %}
