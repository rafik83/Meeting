{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
        <div class="text-right">
            <a href="{{ path('admin_event_create') }}" class="btn btn-primary">
                {{ 'admin.event.create.title'|trans }}
            </a>
        </div>
    {% endif %}
    <div id="eventList" style="margin-bottom: 600px;">
        <h1 class="content-header">{{ 'admin.event.list.currents.title'|trans }}</h1>
        {% include 'AdminBundle:Event:list.html.twig' %}
    </div>
{% endblock %}
