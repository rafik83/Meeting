{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title %}
    [{{ event.title }}] {{ 'admin.event.update.title'|trans  }}
{% endblock %}

{% block form_title %}
{{ 'admin.event.update.title'|trans }}
    {% if event.duplicatedFrom is not null and is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
        <span class="text-center label label-info">
                {{ 'admin.event.update.origin'|trans }} {{ event.duplicatedFrom.title }}
        </span>
    {% endif %}
{% endblock form_title %}

{% block form_content %}

    {{ form_row(form.title) }}
    {{ form_row(form.visible) }}
    {{ form_row(form.organiserName, {widget_columns: 4}) }}
    {{ form_row(form.domain) }}
    {{ form_row(form.emailTeam) }}
    {{ form_row(form.timeZone, {widget_columns: 4}) }}
    {{ form_row(form.translations) }}
    {{ form_row(form.locales, {widget_columns: 3}) }}
    {{ form_row(form.fallback, {widget_columns: 3}) }}
    {{ form_row(form.country, {widget_columns: 3}) }}

    <hr>

    {{ form_row(form.mode, {inline: true}) }}
    {{ form_row(form.vat, {widget_columns: 2}) }}
    {{ form_row(form.currency, {widget_columns: 2}) }}
    {{ form_row(form.invoicePrefix, {widget_columns: 3}) }}
    {{ form_row(form.analyticsCode, {widget_columns: 2}) }}

    <hr>

    {{ form_row(form.welcomeEnabled) }}
    {{ form_row(form.disabledEmailChanging) }}
    {{ form_row(form.disabledPasswordChanging) }}
    {{ form_row(form.googleLoginEnabled) }}
    {{ form_row(form.linkedinLoginEnabled) }}

    <hr>
    {{ form_row(form.displayParticipantNameOnPlanning) }}
    {{ form_row(form.displayParticipantPositionOnPlanning) }}
{% endblock form_content %}

{% block goback_link path('admin_event_list') %}
