<tr>
    <td>
        <div class="dropdown">
            <a href="#" class="dropdown-toggle" type="button" data-toggle="dropdown">
                {{ event.title }}
                <span class="caret"></span>
            </a>
            <ul class="dropdown-menu">
                {{ include('AdminBundle:Event:links.html.twig', {event: event}) }}
            </ul>
        </div>
    </td>
    <td>
        {% for locale in event.locales %}
            {{ locale|language ~ (not loop.last ? ',' : '') }}
        {% endfor %}
    </td>
    <td>{{ event.fallback|language }}</td>
    <td>
        <a href="{{ app.request.scheme ~ '://' ~ event.domain ~ app.request.baseUrl }}" target="_blank">
            {{ 'admin.event.see_on_front.link'|trans }}
        </a>
    </td>
</tr>
