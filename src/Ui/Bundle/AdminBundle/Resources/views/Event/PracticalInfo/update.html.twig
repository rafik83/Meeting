{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title %}
    [{{ event.title }}] {{ 'admin.event.practicalInfo.update.title'|trans  }}
{% endblock %}

{% block form_title 'admin.event.practicalInfo.update.title'|trans %}

{% block form_content %}
    {{ form_row(form.organiserName, {widget_columns: 3}) }}
    {{ form_row(form.contactFirstName, {widget_columns: 3}) }}
    {{ form_row(form.contactLastName, {widget_columns: 3}) }}
    {{ form_row(form.organiserPhone, {widget_columns: 3}) }}
    {{ form_row(form.organiserEmail, {widget_columns: 3}) }}
    {{ form_row(form.organiserWebsite, {widget_columns: 3}) }}
{% endblock form_content %}

{% block goback_link path('admin_event_list') %}
