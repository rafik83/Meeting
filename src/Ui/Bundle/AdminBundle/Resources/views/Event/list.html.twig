{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
        <div class="text-right">
            <a href="{{ path('admin_event_create') }}" class="btn btn-primary">{{ 'admin.event.create.title'|trans }}</a>
        </div>
    {% endif %}
    <div class="row">
        <div class="col-md-12">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="{% if not orderTabActive %}active{% endif %}">
                    <a href="#eventList" aria-controls="home" role="tab" data-toggle="tab">{{ 'admin.event.page.list.title'|trans }}</a>
                </li>
                <li role="presentation" class="{% if orderTabActive %}active{% endif %}">
                    <a href="#orderFinder" aria-controls="profile" role="tab"
                       data-toggle="tab">{{ 'admin.event.page.orderFinder.title'|trans }}</a>
                </li>
            </ul>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane {% if not orderTabActive %}active{% endif %}" id="eventList">
                    <table class="table">
                        <thead>
                        <tr>
                            <th>{{ 'admin.event.title'|trans }}</th>
                            <th>{{ 'admin.event.languages'|trans }}</th>
                            <th>{{ 'admin.event.fallback'|trans }}</th>
                            <th>{{ 'admin.event.see_on_front.link'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for event in events %}
                            <tr>
                                <td>
                                    <div class="dropdown">
                                        <a href="#" class="dropdown-toggle" type="button" data-toggle="dropdown">
                                            {{ event.title }}
                                            <span class="caret"></span>
                                        </a>
                                        <ul class="dropdown-menu">
                                            {{ include('AdminBundle:Event:links.html.twig', {event: event}) }}
                                        </ul>
                                    </div>
                                </td>
                                <td>
                                    {% for locale in event.locales %}
                                        {{ locale|language ~ (not loop.last ? ',' : '') }}
                                    {% endfor %}
                                </td>
                                <td>{{ event.fallback|language }}</td>
                                <td>
                                    <a href="{{ app.request.scheme ~ '://' ~ event.domain ~ app.request.baseUrl }}" target="_blank">
                                        {{ 'admin.event.see_on_front.link'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if orderForm is defined and orderForm is not null %}
                    <div role="tabpanel" class="tab-pane {% if orderTabActive %}active{% endif %}" id="orderFinder">
                    {{ 'admin.event.page.orderFinder.explanation'|trans }}
                        {{ form_start(orderForm) }}
                            <div class="col-md-9">
                                {{ form_label(orderForm.numero) }}
                                {{ form_widget(orderForm.numero) }}
                                {{ form_errors(orderForm.numero) }}
                            </div>
                            <div class="col-md-3" style="margin-top: 25px;">
                                {{ form_widget(orderForm.submit) }}
                            </div>
                        {{ form_end(orderForm) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
