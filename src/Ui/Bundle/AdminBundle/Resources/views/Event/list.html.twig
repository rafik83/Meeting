{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
        <div class="text-right">
            <a href="{{ path('admin_event_create') }}" class="btn btn-primary">
                {{ 'admin.event.create.title'|trans }}
            </a>
        </div>
    {% endif %}
    <div class="row">
        <div class="col-md-12">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="{% if not orderTabActive %}active{% endif %}">
                    <a href="#eventList" aria-controls="home" role="tab" data-toggle="tab">
                        {{ 'admin.event.page.list.title'|trans }}
                    </a>
                </li>
                {% if orderForm is defined and orderForm is not null %}
                    <li role="presentation" class="{% if orderTabActive %}active{% endif %}">
                        <a href="#orderFinder" aria-controls="profile" role="tab" data-toggle="tab">
                            {{ 'admin.event.page.orderInvoiceFinder.title'|trans }}
                        </a>
                    </li>
                {% endif %}

                {% if transactionForm is defined and transactionForm is not null %}
                    <li role="presentation">
                        <a href="#transaction" aria-controls="transactions" role="tab" data-toggle="tab">
                            {{ 'admin.event.page.transactions.title'|trans }}
                        </a>
                    </li>
                {% endif %}

                {% if invoiceExportForm is defined and invoiceExportForm is not null %}
                    <li role="presentation">
                        <a href="#invoice" aria-controls="profile" role="tab" data-toggle="tab">
                            {{ 'admin.event.page.invoice.title'|trans }}
                        </a>
                    </li>
                {% endif %}
            </ul>
            <div class="tab-content">
                <div role="tabpanel"
                     class="tab-pane {{ not orderTabActive ? 'active' : '' }}"
                     id="eventList"
                     style="margin-bottom: 600px;" {# margin bottom to avoid issue when dropdown menu is opened #}
                >
                    <h3>{{ 'admin.event.list.currents.title'|trans }}</h3>

                    {% if events.currentsEventListView is empty %}
                        <div class="alert alert-info">{{ 'admin.zero-result'|trans }}</div>
                    {% else %}
                        <table class="table table-striped table-condensed">
                            <thead>
                            <tr>
                                <th class="col-md-4">{{ 'admin.event.title'|trans }}</th>
                                <th class="col-md-2">{{ 'admin.event.languages'|trans }}</th>
                                <th class="col-md-3">{{ 'admin.event.days'|trans }}</th>
                                <th class="col-md-3">{{ 'admin.event.see_on_front.link'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for event in events.currentsEventListView %}
                                {{ include('AdminBundle::Event/_eventListRow.html.twig') }}
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}

                    <hr>

                    <h3>{{ 'admin.event.list.pasts.title'|trans }}</h3>

                    {% if events.pastsEventListView is empty %}
                        <div class="alert alert-info">{{ 'admin.zero-result'|trans }}</div>
                    {% else %}
                        <table class="table table-striped table-condensed">
                            <thead>
                            <tr>
                                <th class="col-md-4">{{ 'admin.event.title'|trans }}</th>
                                <th class="col-md-2">{{ 'admin.event.languages'|trans }}</th>
                                <th class="col-md-3">{{ 'admin.event.days'|trans }}</th>
                                <th class="col-md-3">{{ 'admin.event.see_on_front.link'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for event in events.pastsEventListView %}
                                {{ include('AdminBundle::Event/_eventListRow.html.twig') }}
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>

                {% if orderForm is defined and orderForm is not null %}
                    <div role="tabpanel" class="tab-pane {% if orderTabActive %}active{% endif %}" id="orderFinder">
                        {{ 'admin.event.page.orderInvoiceFinder.explanation'|trans }}

                        {{ form_start(orderForm) }}
                            {{ form_row(orderForm.type, {inline: true}) }}
                            {{ form_row(orderForm.numero) }}
                            <div class="row">
                                <div class="col-md-9 col-md-offset-3">
                                    {{ form_row(orderForm.submit) }}
                                </div>
                            </div>
                        {{ form_end(orderForm) }}

                        {% if multipleSheetsView is not null %}
                            <div class="alert alert-success mg-tp">
                                {{ 'admin.event.page.orderInvoiceFinder.multipleSheetFound.explanation'|trans({'%numero%' : multipleSheetsView.numero}) }}
                                <ul>
                                    {% for sheet in multipleSheetsView.sheets %}
                                        <li><a href="{{ path('admin_sheet_details', {'event': sheet.eventId, 'sheet': sheet.sheetId, '_fragment': 'sheetOrders'}) }}">{{ sheet.eventTitle }}: {{ sheet.sheetTitle }}</a></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% if transactionForm is defined and transactionForm is not null %}
                    <div role="tabpanel" class="tab-pane" id="transaction">
                        {{ include('AdminBundle:Event/TransactionExport:form.html.twig', {'form': transactionForm}) }}
                    </div>
                {% endif %}

                {% if invoiceExportForm is defined and invoiceExportForm is not null %}
                    <div role="tabpanel" class="tab-pane" id="invoice">
                        {{ form_start(invoiceExportForm) }}
                            {{ form_errors(invoiceExportForm) }}
                            {{ form_row(invoiceExportForm.beginDate, {widget_columns: 2}) }}
                            {{ form_row(invoiceExportForm.endDate, {widget_columns: 2}) }}

                            <div class="row">
                                <div class="col-md-9 col-md-offset-3">
                                    {{ form_row(invoiceExportForm.submit) }}
                                </div>
                            </div>

                        {{ form_end(invoiceExportForm) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
