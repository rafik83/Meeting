<div class="well">
    <div class="text-center">
        {{ questionView.title|html }}
        <a href="#" title="{{ 'admin.type.registrationPath.updateQuestion'|trans }}"><i class="glyphicon glyphicon-edit"></i></a>
        <hr>
    </div>

    <div class="row">
        {% for answerView in questionView.answerViews %}
            <div class="col-md-{{ 12 / questionView.answerViews|length }}">
                <div class="text-center">
                    {{ answerView.title|html }}
                </div>

                <div class="text-center"><i class="glyphicon glyphicon-arrow-down"></i></div>

                {% if not answerView.nextQuestionView %}
                    <div style="margin: 0 auto; width: 132px;">
                        <div class="dropdown">
                            <button id="dropdown-answer-{{ answerView.id }}" type="button" data-toggle="dropdown"
                                    aria-haspopup="true" aria-expanded="false">
                                {{ 'admin.type.registrationPath.nextStep'|trans }}
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdown-answer-{{ answerView.id }}">
                                <li><a href="{{ path('admin_type_registration_path_assign_participation_type_to_answer', {event: event.id, answer: answerView.id}) }}" class="btn">{{ 'admin.type.registrationPath.assignParticipationTypes'|trans }}</a></li>
                                <li>
                                    <a href="{{ path('admin_type_registration_path_add_question_to_answer', {event: event.id, answer: answerView.id}) }}"
                                       class="btn">{{ 'admin.type.registrationPath.assignNewQuestion'|trans }}</a></li>
                            </ul>
                        </div>
                    </div>
                {% else %}
                    {{ include('@Admin/Type/RegistrationPath/questionView.html.twig', { questionView: answerView.nextQuestionView }) }}
                {% endif %}

            </div>
        {% endfor %}
    </div>
</div>
