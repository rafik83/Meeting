{{ questionView.title }}

<div class="row">
    {% for answerView in questionView.answerViews %}
        <div class="col-md-{{ 12 / questionView.answerViews|length }} text-center">

            <div class="well">
                {{ answerView.title }}

                {% if not answerView.nextQuestionView %}
                    <div class="dropdown">
                        <button id="dLabel" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Configurer étape suivante
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dLabel">
                            <li><a href="#" class="btn">Choisir un ou plusieurs types de participation</a></li>
                            <li><a href="{{ path('admin_type_registration_path_add_question_to_answer', {event: event.id, answer: answerView.id}) }}" class="btn">Créer nouvelle question</a></li>
                        </ul>
                    </div>
                {% else %}
                    <div><i class="glyphicon glyphicon-arrow-down"></i></div>
                    {{ include('@Admin/Type/RegistrationPath/questionView.html.twig', { questionView: answerView.nextQuestionView }) }}
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>
