<div class="well">
    <div class="text-center">
        {{ questionView.title|html }}
        <a href="{{ path('admin_type_registration_path_update_question', {event: event.id, question: questionView.id}) }}"
           title="{{ 'admin.type.registrationPath.updateQuestion'|trans }}"><i
                    class="glyphicon glyphicon-edit"></i></a>
        <a href="{{ path('admin_type_registration_path_remove_question', {event: event.id, question: questionView.id}) }}"
           class="btn btn-link delete-button"
           data-confirm="{{ 'admin.type.registrationPath.removeQuestion.confirmation'|trans }}"
           title="{{ 'admin.type.registrationPath.removeQuestion.title'|trans }}">
            <i class="glyphicon glyphicon-remove"></i>
        </a>
        <hr>
    </div>

    <div class="row">
        {% for answerView in questionView.answerViews %}
            <div class="col-md-{{ 12 / questionView.answerViews|length }}">
                <div class="text-center">
                    {{ answerView.title|html }}
                </div>

                <div class="text-center"><i class="glyphicon glyphicon-arrow-down"></i></div>

                {% if not answerView.hasNextStep %}
                    <div style="margin: 0 auto; width: 132px;">
                        <div class="dropdown">
                            <button id="dropdown-answer-{{ answerView.id }}" type="button" data-toggle="dropdown"
                                    class="btn btn-danger btn-sm"
                                    aria-haspopup="true" aria-expanded="false">
                                {{ 'admin.type.registrationPath.nextStep'|trans }}
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdown-answer-{{ answerView.id }}">
                                <li>
                                    <a href="{{ path('admin_type_registration_path_assign_participation_type_to_answer', {event: event.id, answer: answerView.id}) }}"
                                       class="btn btn-sm">{{ 'admin.type.registrationPath.assignParticipationTypes'|trans }}</a>
                                </li>
                                <li>
                                    <a href="{{ path('admin_type_registration_path_add_question_to_answer', {event: event.id, answer: answerView.id}) }}"
                                       class="btn btn-sm">{{ 'admin.type.registrationPath.assignNewQuestion'|trans }}</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                {% else %}
                    {% if answerView.hasNextQuestion %}
                        {{ include('@Admin/Type/RegistrationPath/questionView.html.twig', { questionView: answerView.nextQuestionView }) }}
                    {% elseif answerView.hasTypes %}
                        <div class="text-center">
                            {% for typeView in answerView.typeViews %}
                                <span class="badge">{{ typeView.title }}</span>
                            {% endfor %}

                            <a href="{{ path('admin_type_registration_path_remove_assignation_type', {event: event.id, answer: answerView.id}) }}"
                               data-confirm="{{ 'admin.type.registrationPath.removeTypes.confirmation'|trans }}"
                               title="{{ 'admin.type.registrationPath.removeTypes.title'|trans }}"><i
                                        class="glyphicon glyphicon-remove"></i></a>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
