{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.type.registrationPath.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.type.registrationPath.title'|trans }}</h1>

    {% if eventRegistrationPathView.questionView %}
        <h2>{{ eventRegistrationPathView.questionView.title }}</h2>
        <ul>
            {% for answerView in eventRegistrationPathView.questionView.answerViews %}
                <li>
                    {{ answerView.title }}

                    <div class="dropdown">
                        <button id="dLabel" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Configurer étape suivante
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dLabel">
                            <li><a href="#" class="btn">Choisir un ou plusieurs types de participation</a></li>
                            <li><a href="{{ path('admin_type_registration_path_add_question_to_answer', {event: event.id, answer: answerView.id}) }}" class="btn">Créer nouvelle question</a></li>
                        </ul>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <a href="{{ path('admin_type_registration_path_add_question', {event: event.id}) }}">add question</a>
    {% endif %}
{% endblock %}
