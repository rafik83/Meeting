{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.type.registrationPath.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.type.registrationPath.title'|trans }}</h1>

    {% if eventRegistrationPathView.questionView %}
        <h2>{{ eventRegistrationPathView.questionView.title }}</h2>
        <ul>
            {% for answerView in eventRegistrationPathView.questionView.answerViews %}
                <li>{{ answerView.title }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <a href="{{ path('admin_type_registration_path_add_question', {event: event.id}) }}">add question</a>
    {% endif %}
{% endblock %}
