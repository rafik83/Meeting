{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title 'admin.type.update.title'|trans %}

{% block form_content %}
    {{ form_row(form.translations) }}

    {% if form.sheetTemplate is defined %}
        {{ form_row(form.sheetTemplate) }}
    {% endif %}

    {% if form.registrationTemplate is defined %}
        {{ form_row(form.registrationTemplate) }}
    {% endif %}

    {% if form.package is defined %}
        {{ form_row(form.package) }}
    {% endif %}

    {{ form_row(form.formTemplates) }}

    <div class="form-group">
        {{ form_label(form.hidden, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.hidden) }}
        </div>

        {{ form_label(form.enableUnavailabilityManagement, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.enableUnavailabilityManagement) }}
        </div>
    </div>

    {{ form_row(form.rank, {widget_columns: 1}) }}
    {{ form_row(form.validationCriteria) }}

{% endblock form_content %}

{% block goback_link path('admin_type_list', { 'event': event.id }) %}
