{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title 'admin.type.update.title'|trans %}

{% block form_content %}
    {{ form_row(form.translations) }}

    {% if form.sheetTemplate is defined %}
        {{ form_row(form.sheetTemplate) }}
    {% endif %}

    {% if form.registrationTemplate is defined %}
        {{ form_row(form.registrationTemplate) }}
    {% endif %}

    {% if form.package is defined %}
        {{ form_row(form.package) }}
    {% endif %}

    {{ form_row(form.formTemplates) }}

    <div class="form-group">
        {{ form_label(form.hidden, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.hidden) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.canMoveMeeting, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.canMoveMeeting) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.canRemoveMeeting, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.canRemoveMeeting) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.canScanParticipant, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.canScanParticipant) }}
        </div>
    </div>

    {{ form_row(form.availabilityType) }}
    {{ form_row(form.rank, {widget_columns: 2}) }}
    {{ form_row(form.numberOfMeetingsPerPlanning, {widget_columns: 2}) }}
    {{ form_row(form.numberMaxOfMeetingsPerSheet, {widget_columns: 2}) }}
    {{ form_row(form.priorityMeetingRequestsNumber, {widget_columns: 2}) }}

    <div class="form-group">
        {{ form_label(form.areAllSheetParticipantsAssignedToMeeting, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.areAllSheetParticipantsAssignedToMeeting) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.isPackageRequired, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.isPackageRequired) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.isPaymentRequired, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.isPaymentRequired) }}
            {{ form_errors(form.isPaymentRequired) }}
        </div>
    </div>

    {{ form_row(form.numberMaxOfHappeningsPerUser, {widget_columns: 2}) }}

    {{ form_row(form.validationCriteria) }}
    <hr>
    <div class="form-group">
        {{ form_label(form.canEvaluateMeeting, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.canEvaluateMeeting) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.mustEvaluateMeeting, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.mustEvaluateMeeting) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.submitValidationSheet, null, { label_attr: { class: 'control-label col-md-3' }}) }}
        <div class="col-md-9 checkbox">
            {{ form_widget(form.submitValidationSheet) }}
        </div>
    </div>

{% endblock form_content %}

{% block goback_link path('admin_type_list', { 'event': event.id }) %}
