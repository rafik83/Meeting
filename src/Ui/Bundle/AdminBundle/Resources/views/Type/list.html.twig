{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.type.list.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.type.list.title'|trans }}</h1>

    <a href="{{ path('admin_type_create', { 'event': event.id }) }}" class="btn btn-primary">{{ 'admin.type.create.link'|trans }}</a>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>{{ 'admin.type.id'|trans }}</th>
                <th>{{ 'admin.type.title'|trans }}</th>
                <th>{{ 'admin.type.position'|trans }}</th>
                <th>{{ 'admin.type.registration.template'|trans }}</th>
                <th>{{ 'admin.type.sheet.template'|trans }}</th>
                <th>{{ 'admin.type.package'|trans }}</th>
                <th>{{ 'admin.type.form.template'|trans }}</th>
                <th class="col-md-1"></th>
            </tr>
        </thead>
        <tbody>
        {% for type in types.types %}
            <tr>
                <td>{{ type.id }}</td>
                <td>
                    {{ type.title }}

                    <a href="{{ app.request.scheme ~ '://' ~ event.domain ~ path('event_register', {'typeView': type.id }) }}"
                       title="{{ 'admin.type.register.link'|trans }}"
                       target="_blank"
                    >
                        <i class="glyphicon glyphicon-link"></i>
                    </a>

                    {% if type.hasSpecificPaymentConditions %}
                        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                            <a href="{{ path('admin_type_payment_conditions', {'event': event.id, 'type': type.id}) }}" class="label label-info">
                                {{ 'admin.type.specificPaymentConditions'|trans }}
                            </a>
                        {% else %}
                            <span class="label label-info">
                                {{ 'admin.type.specificPaymentConditions'|trans }}
                            </span>
                        {% endif %}
                        &nbsp;
                    {% endif %}

                    {% if type.canUpdateMeeting %}
                        <span class="label label-info">
                            {{ 'admin.type.canUpdateMeeting'|trans }}
                        </span>
                    {% endif %}

                    {% if type.canRemoveMeeting %}
                        <span class="label label-info">
                            {{ 'admin.type.canRemoveMeeting'|trans }}
                        </span>
                    {% endif %}

                    {% if type.hasSpecificTermsOfSale %}
                        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                            <a href="{{ path('admin_type_content_define_terms_of_sale', {'event': event.id, 'type': type.id}) }}" class="label label-info">
                                <i class="glyphicon glyphicon-education"></i> {{ 'admin.type.content.specificTermsOfSale'|trans }}
                            </a>
                        {% else %}
                            <span class="label label-info">
                                <i class="glyphicon glyphicon-education"></i> {{ 'admin.type.content.specificTermsOfSale'|trans }}
                            </span>
                        {% endif %}
                        &nbsp;
                    {% endif %}
                    {% if type.hidden %}
                        <span class="label label-default">
                            <i class="glyphicon glyphicon-eye-close"></i> {{ 'admin.type.hidden'|trans }}
                        </span>
                    {% endif %}

                </td>
                <td>{{ type.position }}</td>
                <td>{{ type.registrationTemplate }}</td>
                <td>{{ type.sheetTemplate }}</td>
                <td>{{ type.package }}</td>
                <td>
                    <ul>
                        {% for formTemplateView in type.formTemplateViews %}
                            <li>{{ formTemplateView.title }}
                                <span class="label label-{{ formTemplateView.isPublished ? 'success' : 'danger' }}">
                                    {{ (formTemplateView.isPublished ? 'admin.type.form.template.status.published' : 'admin.type.form.template.status.draft')|trans }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </td>
                <td class="text-right">
                    <div class="btn-group">
                        <a class="btn btn-default btn-sm" href="{{ path('admin_type_update', { 'event': event.id, 'type': type.id }) }}">
                            {{ 'admin.type.update.link'|trans }}
                        </a>
                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                                <li>
                                    <a href="{{ path('admin_type_payment_conditions', {'event': event.id, 'type': type.id}) }}" class="btn-sm">
                                        {{ 'admin.type.paymentConditions.link'|trans }}
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ path('admin_type_content_define_terms_of_sale', {'event': event.id, 'type': type.id}) }}"
                                       class="btn-sm"
                                    >
                                        {{ 'admin.type_content_define_terms_of_sale.link'|trans }}
                                    </a>
                                </li>
                            {% endif %}
                            <li>
                                <a href="{{ path('admin_type_badge_configuration', {'event': event.id, 'type': type.id}) }}"
                                   class="btn-sm"
                                >
                                    {{ 'admin.type.badge.configuration.link'|trans }}
                                </a>
                            </li>
                            <li>
                                {{ macro.delete_button(
                                path('admin_type_remove', { 'event': event.id, 'type': type.id }),
                                'admin.type.remove.link'|trans,
                                { 'class': 'btn btn-default btn-sm', 'data-confirm': 'admin.type.action.confirmDelete'|trans }) }}
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': types.results }) }}
{% endblock %}
