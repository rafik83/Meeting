{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">Types de participation</h1>

    <a href="{{ path('admin_type_create', { 'event': event.id }) }}" class="btn btn-primary">{{ 'admin.type.create.link'|trans }}</a>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>{{ 'admin.type.title'|trans }}</th>
                <th>{{ 'admin.type.position'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for type in types.results %}
            <tr>
                <td>{{ type.title }}</td>
                <td>{{ type.position }}</td>
                <td class="text-right">
                    <a href="{{ path('admin_type_update', { 'event': event.id, 'type': type.id }) }}" class="btn btn-default btn-sm">{{ 'admin.type.update.link'|trans }}</a>
                    <a href="{{ path('admin_type_template_field_list', { 'event': event.id, 'type': type.id }) }}" class="btn btn-default btn-sm">Formulaire</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': types}) }}
{% endblock %}
