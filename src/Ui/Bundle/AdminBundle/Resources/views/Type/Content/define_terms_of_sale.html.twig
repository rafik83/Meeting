{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title (typeTitle ~ ': ' ~ 'admin.type_content_define_terms_of_sale.title'|trans) %}

{% block form_content %}
    {{ form_row(form.enabled) }}
    <hr/>
    {{ form_row(form.translations) }}
{% endblock %}

{% block goback_link path('admin_type_list', {'event': event.id}) %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/tinymce/tinymce.js') }}"></script>
    <script src="{{ asset('assets/tinymce/tip/tip.js') }}"></script>
{% endblock %}
