{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.purchasing_funnel.title'|trans }}</h1>

    <p>
        <button type="button" class="btn btn-primary btn-success" data-toggle="modal" data-target="#create-modal">
            {{ 'admin.purchasing_funnel.create'|trans }}
        </button>
    </p>

    {{ form_start(form) }}
        <div class="modal fade" id="create-modal" tabindex="-1" role="dialog" aria-labelledby="create-modal-label">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="create-modal-label">{{ 'admin.purchasing_funnel.create'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_errors(form) }}
                        {{ form_row(form.title) }}
                        {{ form_row(form.event) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">
                            {{ 'admin.cancel'|trans }}
                        </button>
                        {{ form_widget(form.submit) }}
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}

    <table class="table">
        <thead>
            <tr>
                <th>{{ 'admin.purchasing_funnel.table.column.title'|trans }}</th>
                <th>{{ 'admin.purchasing_funnel.table.column.event'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for purchasing_funnel in purchasing_funnels %}
            <tr>
                <td>{{ purchasing_funnel.title }}</td>
                <td>{{ purchasing_funnel.event.title }}</td>
                <td class="text-right">
                    <a href="{{ path('admin_purchasing_funnel_update', { 'purchasingFunnel': purchasing_funnel.id }) }}" class="btn btn-default btn-sm">
                        {{ 'admin.purchasing_funnel.update'|trans }}
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">
                    {{ 'admin.zero-result'|trans }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
