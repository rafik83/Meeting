{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block title 'Formulaire type de participation' %}

{% block content %}
    <h1><a href="{{ path('admin_type_list', { 'event': event.id }) }}">{{ event.title }}</a></h1>
    <h2>{{ typeView.title }}</h2>

    <ul>
        {% for templateName, template in templates %}
            <li><a href="#{{ templateName }}">{{ ('template.name.' ~ templateName)|trans }}</a></li>
        {% endfor %}
    </ul>

    <table class="table table-striped table-hover">
        {% for templateName, template in templates %}
            <tr>
                <th colspan="6">
                    <h3 id="{{ templateName }}">{{ ('template.name.' ~ templateName)|trans }}</h3>
                </th>
            </tr>
            {% if templateName != 'package' %}
                {% for group in template.groups %}
                    {% if group.name != 'default' %}
                        <tr>
                            <th colspan="6" class="info">
                                {{ group.label(locale) }}
                            </th>
                        </tr>
                    {% endif %}

                    {% include 'AdminBundle:TypeTemplateField:row.html.twig' with {
                        typeId: typeView.id,
                        locale: locale,
                        templateName: templateName,
                        types: group.types,
                        group: group
                    } %}

                    <tr>
                        <td colspan="6">
                            {% include 'AdminBundle:TypeTemplateField:addLinks.html.twig' with {
                                event: event,
                                type: typeView,
                                templateName: templateName,
                                group: group,
                                position: group.types|length + 1
                            } %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucun groupe de champ</td>
                    </tr>
                {% endfor %}
            {% elseif packageObject %}
                {% for step in packageObject.steps %}
                    <tr>
                        <th colspan="6" class="info">
                            {{ step.label(locale) }}
                        </th>
                    </tr>

                    {% include 'AdminBundle:TypeTemplateField:packageRow.html.twig' with {
                        step: step,
                        locale: locale
                    } %}
                {% endfor %}
            {% endif %}
        {% endfor %}
    </table>
{% endblock %}
