{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.spot.import.preview'|trans }}</h1>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>{{ 'admin.spot.import.column.reference'|trans }}</th>
                <th>{{ 'admin.spot.import.column.size'|trans }}</th>
                <th>{{ 'admin.spot.import.column.meetingCapacity'|trans }}</th>
                <th>{{ 'admin.spot.import.column.seatCapacity'|trans }}</th>
                <th>{{ 'admin.spot.import.column.priority'|trans }}</th>
                <th>{{ 'admin.spot.import.column.active'|trans }}</th>
                <th>{{ 'admin.spot.import.column.visio'|trans }}</th>
                <th>{{ 'admin.spot.import.column.sheets'|trans }}</th>
                <th>{{ 'admin.spot.import.column.errors'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for spotImportView in spotImportViews %}
            <tr class="{% if spotImportView.errorMessages is not empty %} danger {% endif %}">
                <td class="text-center">{{ spotImportView.spot.reference }}</td>
                <td class="text-center">{{ spotImportView.spot.size }}</td>
                <td class="text-center">{{ spotImportView.spot.meetingCapacity }}</td>
                <td class="text-center">{{ spotImportView.spot.seatCapacity }}</td>
                <td class="text-center">{{ spotImportView.spot.priority }}</td>
                <td class="text-center">{{ spotImportView.spot.active ? 'admin.spot.active.yes'|trans : 'admin.spot.active.no'|trans }}</td>
                <td class="text-center">{{ spotImportView.spot.visio ? 'admin.spot.visio.yes'|trans : 'admin.spot.visio.no'|trans }}</td>
                <td>
                    <ul>
                    {% for sheetView in spotImportView.sheetViews %}
                        <li>
                            {{ sheetView.id }} - {{ sheetView.title }}
                        </li>
                    {% endfor %}
                    </ul>
                </td>
                <td>
                    {% if spotImportView.errorMessages is not empty %}
                       {{ include('AdminBundle:Spot/Import:spotImportErrors.html.twig', {'errors': spotImportView.errorMessages}) }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ form(form) }}
{% endblock %}
