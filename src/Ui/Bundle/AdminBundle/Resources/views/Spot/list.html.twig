{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle:Common:list_macros.html.twig' as list_macros %}

{% block content %}
    <h1 class="page-header">{{ 'admin.spot.title'|trans }}</h1>

    {% if spots|length %}
        <div class="row">
            <div class="col-md-offset-2 col-md-8">
                <div class="row">
                    {{ form_start(filter_form) }}
                    <div class="col-md-2 text-right">
                        <strong>{{ 'admin.filter_by'|trans }}</strong>
                    </div>
                    {{ form_row(filter_form.reference, { 'group_attr': { 'class': 'col-md-2' } }) }}
                    {{ form_row(filter_form.meetingCapacity, { 'group_attr': { 'class': 'col-md-2' } }) }}
                    {{ form_row(filter_form.seatCapacity, { 'group_attr': { 'class': 'col-md-2' } }) }}
                    {{ form_row(filter_form.size, { 'group_attr': { 'class': 'col-md-2' } }) }}
                    {{ form_row(filter_form.active, { 'group_attr': { 'class': 'hide' } }) }}
                    {{ form_row(filter_form.submit, { 'attr': { 'class': 'hide' } }) }}
                    {{ form_end(filter_form) }}
                </div>
            </div>
        </div>
    {% endif %}

    <form action="{{ path('admin_spot_batch', { 'event': event.id }) }}" method="POST" data-batch="1">

        <div class="row filters">
            <div class="col-md-4">
                {% embed 'AdminBundle:Common:batch.html.twig' %}
                    {% block new_actions %}
                        <a href="{{ path('admin_spot_create', { 'event': event.id }) }}" class="btn btn-success">
                            {{ 'admin.spot.listSpot.add'|trans }}
                        </a>
                        <a href="{{ path('admin_spot_batch_create', { 'event': event.id }) }}" class="btn btn-success">
                            {{ 'admin.spot.batch_create.title'|trans }}
                        </a>
                    {% endblock new_actions %}

                    {% block actions %}
                        <li>
                            <button name="delete" value="1" type="submit">{{ 'admin.spot.delete'|trans }}</button>
                        </li>
                        <li>
                            <button name="enable" value="1" type="submit">{{ 'admin.spot.enable'|trans }}</button>
                        </li>
                        <li>
                            <button name="disable" value="1" type="submit">{{ 'admin.spot.disable'|trans }}</button>
                        </li>
                    {% endblock actions %}
                {% endembed %}
            </div>
            <div class="col-md-4">
                {{ include('AdminBundle:Common:filters_summary.html.twig', {
                    filters:   filters_summary,
                    resetLink: path('admin_spot_list', { 'event': event.id })
                }) }}
            </div>
        </div>

        {% if spots|length %}
        <table class="table table-hover selectable-row filterable">
            <thead>
                <tr>
                    <th class="minwidth">
                        <input type="checkbox" data-batch-all="tbody input[type=checkbox]" title="{{ 'admin.check-all'|trans }}" />
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.reference'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.size'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.meetingCapacity'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.seatCapacity'|trans }}
                    </th>
                    <th>
                        {{ list_macros.choice_as_dropdown(filter_form.active, false, true) }}
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for spot in spots %}
                    <tr>
                        <td><input type="checkbox" id="batch_checkbox_{{ spot.id }}" name="ids[]" value="{{ spot.id }}" /></td>
                        <td class="updatable" data-type="string" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'reference', 'value': spot.reference }|json_encode }}">{{ spot.reference }}</td>
                        <td class="updatable" data-type="float" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'size', 'value': spot.size }|json_encode }}">{{ spot.size }}</td>
                        <td class="updatable" data-type="int" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'meetingCapacity', 'value': spot.meetingCapacity }|json_encode }}">{{ spot.meetingCapacity }}</td>
                        <td class="updatable" data-type="int" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'seatCapacity', 'value': spot.seatCapacity }|json_encode }}">{{ spot.seatCapacity }}</td>
                        <td>{{ spot.active ? 'admin.spot.active.yes'|trans : 'admin.spot.active.no'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </form>

{% endblock %}
