{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle:Common:list_macros.html.twig' as list_macros %}
{% import '@Admin/macro.html.twig' as form_macros %}

{% block title 'admin.spot.title'|trans %}

{% block content %}

    <h1 class="page-header">{{ 'admin.spot.title'|trans }}</h1>

    {% if canExport %}
        {{ form_macros.button(
            path('admin_spot_schedule_export', { 'event': event.id }),
            'POST',
            'admin.spot.commexposium.export.title'|trans,
            {'class': 'btn btn-info'},
            {'class': 'alert alert-info text-center'}
        ) }}
    {% endif %}

    {% if filtered or spotsList.hasSpot %}
        <div class="row well">
            {{ form_start(filter_form) }}
                <div class="pull-right filter-buttons">
                    {{ form_widget(filter_form.submit) }}
                </div>
                {{ form_row(filter_form.reference, { 'group_attr': { 'class': 'col-md-3' } }) }}
                {{ form_row(filter_form.meetingCapacity, { 'group_attr': { 'class': 'col-md-3' } }) }}
                {{ form_row(filter_form.seatCapacity, { 'group_attr': { 'class': 'col-md-3' } }) }}
                {{ form_row(filter_form.size, { 'group_attr': { 'class': 'col-md-3' } }) }}
                {{ form_row(filter_form.active, { 'group_attr': { 'class': 'hide' } }) }}
            {{ form_end(filter_form) }}
        </div>
    {% endif %}

    <form action="{{ path('admin_spot_batch', { 'event': event.id }) }}" method="POST" data-batch="1">

        <div class="row filters">
            <div class="col-md-4">
                {% embed 'AdminBundle:Common:batch.html.twig' %}
                    {% block new_actions %}
                        <a href="{{ path('admin_spot_create', { 'event': event.id }) }}" class="btn btn-success">
                            {{ 'admin.spot.listSpot.add'|trans }}
                        </a>
                        <a href="{{ path('admin_spot_batch_create', { 'event': event.id }) }}" class="btn btn-success">
                            {{ 'admin.spot.batch_create.title'|trans }}
                        </a>
                        <a href="{{ path('admin_spot_import', {'event': event.id}) }}" class="btn btn-info">
                            {{ 'admin.spot.import.title'|trans }}
                        </a>
                    {% endblock new_actions %}

                    {% block actions %}
                        <li>
                            <button name="delete" value="1" type="submit">{{ 'admin.spot.delete'|trans }}</button>
                        </li>
                        <li>
                            <button name="enable" value="1" type="submit">{{ 'admin.spot.enable'|trans }}</button>
                        </li>
                        <li>
                            <button name="disable" value="1" type="submit">{{ 'admin.spot.disable'|trans }}</button>
                        </li>
                        <li>
                            <button name="spotUnavailability" value="1" type="submit">{{ 'admin.spot.unavailability'|trans }}</button>
                        </li>
                    {% endblock actions %}
                {% endembed %}
            </div>
            <div class="col-md-4">
                {{ include('AdminBundle:Common:filters_summary.html.twig', {
                    filters:   filters_summary,
                    resetLink: path('admin_spot_list', { 'event': event.id })
                }) }}
            </div>
        </div>

        {% if spotsList.hasSpot %}
        <table class="table table-hover selectable-row filterable">
            <thead>
                <tr>
                    <th class="minwidth">
                        <input type="checkbox" data-batch-all="tbody input[type=checkbox]" title="{{ 'admin.check-all'|trans }}" />
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.reference'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.size'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.meetingCapacity'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.seatCapacity'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.priority'|trans }}
                    </th>
                    <th>
                        {{ 'admin.spot.listSpot.visio'|trans }}
                    </th>
                    <th>{{ 'admin.spot.listSpot.sheet'|trans }}</th>
                    <th>{{ 'admin.spot.listSpot.hasUnavailability'|trans }}</th>
                    <th>
                        {{ list_macros.choice_as_dropdown(filter_form.active, false, true) }}
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for spot in spotsList.spots %}
                    <tr id="spot-{{ spot.id }}">
                        <td><input type="checkbox" id="batch_checkbox_{{ spot.id }}" name="ids[]" value="{{ spot.id }}" /></td>
                        <td class="updatable" data-type="string" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'reference', 'value': spot.reference }|json_encode }}">{{ spot.reference }}</td>
                        <td class="updatable" data-type="float" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'size', 'value': spot.size }|json_encode }}">{{ spot.size }}</td>
                        <td class="updatable" data-type="int" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'meetingCapacity', 'value': spot.meetingCapacity }|json_encode }}">{{ spot.meetingCapacity }}</td>
                        <td class="updatable" data-type="int" data-url="{{ update_url }}" data-update="{{ { 'id': spot.id, 'property': 'seatCapacity', 'value': spot.seatCapacity }|json_encode }}">{{ spot.seatCapacity }}</td>
                        <td class="updatable" data-type="int" data-url="{{ update_url }}"  data-update="{{ { 'id': spot.id, 'property': 'priority', 'value': spot.priority }|json_encode }}">
                            {{ spot.priority }}
                        </td>
                        <td style="width: 100px;">
                            {% if spot.visio is defined and spot.visio == true %}
                                <div class="btn-group stopPropagation" role="group" aria-label="visio">
                                    <a href="#" class="btn btn-success active" data-toggle="tooltip" title="{{ 'admin.spot.listSpot.spot.visio'|trans }}">
                                        <i class="glyphicon glyphicon-facetime-video"></i>
                                    </a>
                                    <a href="{{ path('admin_spot_update_un_visio', { 'event': event.id, 'spot': spot.id }) }}" class="btn btn-default" data-toggle="tooltip" title="{{ 'admin.spot.listSpot.spot.un-visio'|trans }}">
                                        <i class="glyphicon glyphicon-map-marker"></i>
                                    </a>
                                </div>
                            {% else %}
                                <div class="btn-group stopPropagation" role="group" aria-label="visio">
                                    <a href="{{ path('admin_spot_update_visio', { 'event': event.id, 'spot': spot.id }) }}" class="btn btn-default" data-toggle="tooltip" title="{{ 'admin.spot.listSpot.spot.visio'|trans }}">
                                        <i class="glyphicon glyphicon-facetime-video"></i>
                                    </a>
                                    <a href="#" class="btn btn-info active" data-toggle="tooltip" title="{{ 'admin.spot.listSpot.spot.un-visio'|trans }}">
                                        <i class="glyphicon glyphicon-map-marker"></i>
                                    </a>
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <ul>
                            {% for sheet in spot.sheets %}
                                <li>
                                    <a href="{{ path('admin_sheet_details', {event: event.id, sheet: sheet.id}) }}">{{ sheet.name }}</a>
                                </li>
                            {% endfor %}
                            </ul>
                        </td>
                        <td>{{ spot.hasUnavailability ? '✓' : '' }}</td>
                        <td>{{ spot.active ? 'admin.spot.active.yes'|trans : 'admin.spot.active.no'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
            <div class="alert alert-danger text-center">
                {{ 'admin.zero-result'|trans }}
            </div>
        {% endif %}
    </form>

{% endblock %}
