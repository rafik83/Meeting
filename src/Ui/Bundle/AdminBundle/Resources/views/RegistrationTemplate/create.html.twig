{{ form_start(form) }}
    {{ form_errors(form) }}
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <h4 class="modal-title">{{ 'admin.event.template.registration.create.form.title'|trans() }}</h4>
</div>
<div class="modal-body">
    {{ form_row(form.title) }}
    {{ form_errors(form.title) }}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.common.close'|trans }}</button>
    {{ form_widget(form.submit) }}
</div>
{{ form_end(form) }}
