{% extends 'AdminBundle::base.html.twig' %}

{% block body %}
    {{ include('AdminBundle:Common:menu.html.twig') }}

    <div class="container-fluid template-builder-container">
        <div class="template-builder-header">
            <h1>{{ 'admin.template.registration.update'|trans }} "{{ registrationTemplate.title }}"</h1>
        </div>

        <div class="template-builder-body">
            <div class="template-container container-fluid block-inner" id="template-container">
                {% for uid, item in registrationTemplate.value|default([]) %}
                    {% if item.component == 'block' %}
                        {{ include('AdminBundle:Template/Block:' ~ item.type ~ '.html.twig', {
                            'uid': uid, 'children': item.children, 'config': item.config, 'locale': locale,
                            'fallback': registrationTemplate.fallback, 'nomenclatures': nomenclatures,
                            'sheet_tags': sheetTags, 'products': []
                        }, false) }}
                    {% elseif item.component == 'object' %}
                        {{ include('AdminBundle:Template/Object:' ~ item.type ~ '.html.twig', {
                            'uid': uid, 'config': item.config, 'locale': locale,
                            'fallback': registrationTemplate.fallback, 'nomenclatures': nomenclatures,
                            'sheet_tags': sheetTags, 'products': []
                        }, false) }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
