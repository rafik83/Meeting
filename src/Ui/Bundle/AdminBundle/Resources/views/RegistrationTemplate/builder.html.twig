{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.template.registration.update'|trans %}

{% block body %}
    {{ include('AdminBundle:Common:menu.html.twig') }}

    <div
        class="container-fluid template-builder-container"
        data-registration-template-builder="registration-builder"
        data-save-url-template-builder="{{ path('admin_template_registration_save', {
            'registrationTemplate': registrationTemplate.id,
            'locale': locale
        }) }}"
        data-locale="{{ locale }}"
    >
        <div class="template-builder-header">
            <h1 class="pull-left">{{ registrationTemplate.title }}</h1>

            <div class="btn-toolbar" role="toolbar" aria-label="Template actions">
                {{ include('AdminBundle:RegistrationTemplate:addLocale.html.twig', {
                    template: registrationTemplate,
                    locale: locale,
                    add_locale_form: addLocaleForm,
                    completeness: completeness,
                    routeName: 'admin_template_registration_build',
                }, false) }}

                <button
                    class="btn btn-success"
                    id="template-save-button"
                    data-loading-button="{{ ('<i class="glyphicon glyphicon-refresh spin"></i> ' ~ ('admin.template.action.updating'|trans))|e }}"
                >
                    {{ 'admin.template.action.save'|trans }}
                </button>
            </div>
        </div>

        <button data-template-add-block class="btn btn-primary hide">
            {{ 'admin.template.registration.addBlock'|trans }}
        </button>

        <div data-template-block class="hide">
            {{ include('AdminBundle:Template/Form:block.html.twig') }}
        </div>

        <div class="template-builder-body">
            <div class="template-container container-fluid block-inner">
                {% for uid, item in registrationTemplate.value|default([]) %}
                    {% if item.component == 'block' %}
                        {{ include('AdminBundle:Template/Form:block.html.twig', {
                            'uid': uid,
                            'children': item.children,
                            'config': item.config,
                            'locale': locale,
                            'fallback': registrationTemplate.fallback,
                            'nomenclatures': nomenclatures,
                            'templateTagView': registrationTemplateTagView,
                            'uploadFormats': uploadFormats,
                        }, false) }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="template-builder-menu slide-menu-container-open" id="template-menu">
            <div class="template-builder-menu-wrapper">
                <div class="tab-content">
                    <div id="object-list" class="object-list">
                        {{ include('AdminBundle:Template/Object:text.html.twig', { 'locale': locale }, false) }}
                        {{ include('AdminBundle:Template/Object:editable-text.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:telephone.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:country.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:url.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:boolean.html.twig', {
                            'locale': locale,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:gender.html.twig', {
                            'locale': locale,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:upload.html.twig', {
                            'locale': locale,
                            'uploadFormats': uploadFormats|default([]),
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:image.html.twig', {
                            'locale': locale,
                            'isFormTemplate': true,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:nomenclature.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'nomenclatures': nomenclatures,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:datetime.html.twig', {
                            'locale': locale,
                            'isFormTemplate': true,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:checkbox.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': registrationTemplateTagView,
                        }, false) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
