{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.availabilityTimeRange.list.title'|trans %}

{% block content %}
        <h1 class="page-header">
            {{ 'admin.availabilityTimeRange.list.title'|trans }}
        </h1>
        <a href="{{ path('admin_event_availability_time_range_create', {'event': event.id}) }}" class="btn btn-primary pull-right">
            {{ 'admin.availabilityTimeRange.create.title'|trans }}
        </a>

    <table class="table table-striped table-condensed">
        <thead>
        <tr>
            <th class="col-md-4">{{ 'admin.availabilityTimeRange.list.column.name'|trans }}</th>
            <th class="col-md-4">{{ 'admin.availabilityTimeRange.list.column.begin'|trans }}</th>
            <th class="col-md-4">{{ 'admin.availabilityTimeRange.list.column.end'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for availabilityTimeRangeView in list.availabilityTimeRangeViews if list.availabilityTimeRangeViews is not empty %}
            <tr>
                <td>{{ availabilityTimeRangeView.name }}</td>
                <td>{{ availabilityTimeRangeView.begin|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                <td>{{ availabilityTimeRangeView.end|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="alert alert-info text-center">
                    {{ 'admin.zero-result'|trans }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
