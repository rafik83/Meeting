{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.sheets_group.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.sheets_group.title'|trans }}
    </h1>

    <div>
        <a href="{{ path('admin_sheets_group_pre_create', {'event': event.id}) }}" class="btn btn-primary new-action">
            {{ 'admin.sheets_group.create'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>{{ 'admin.sheets_group.column.title'|trans }}</th>
                <th>{{ 'admin.sheets_group.column.email_manager'|trans }}</th>
                <th>{{ 'admin.sheets_group.column.sheet_list'|trans }}</th>
                <th>{{ 'admin.sheets_group.column.created_at'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for groupView in groupViews %}
            <tr>
                <td>{{ groupView.title }}</td>
                <td>{{ groupView.emailManager }}</td>
                <td>
                    <ul>
                        {% for sheetView in groupView.sheetViews %}
                            <li>{{ sheetView.title }}</li>
                        {% endfor %}
                    </ul>
                </td>
                <td>
                    {{ groupView.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
                </td>
                <td>
                    <a class="btn btn-default btn-sm" href="{{ path('admin_sheets_group_update', {'event': event.id, 'sheetGroup': groupView.id}) }}">{{ 'admin.sheets_group.update.link'|trans }}</a>
                    <a class="btn btn-default btn-sm" target="_blank" href="{{ groupView.impersonateLink }}">{{ 'admin.sheet.impersonate'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">{{ 'admin.sheets_group.no_result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
