{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title %}
    {{ sheet_info }}
    <small>/ {{ 'admin.order.edit'|trans }} {{ order.numero }}</small>
{% endblock form_title %}

{% block form_content %}
    <h4>{{ 'admin.order_edit.update_line'|trans }}</h4>

    {{ form_row(form.label, {widget_columns: 6}) }}
    {{ form_row(form.price, {widget_columns: 6}) }}
    {{ form_row(form.quantity, {widget_columns: 6}) }}
{% endblock form_content %}

{% block goback_link path('admin_sheet_order_edit', {'event': event.id, 'order': order.id}) %}
