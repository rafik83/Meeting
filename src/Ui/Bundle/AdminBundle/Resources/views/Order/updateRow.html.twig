{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title %}
    Commande {{ order.id }} de {{ sheet_info }}
{% endblock form_title %}

{% block form_content %}
    <h4>Modifier une ligne</h4>

    {{ form_row(form.label, {widget_columns: 6}) }}
    {{ form_row(form.price, {widget_columns: 6}) }}
    {{ form_row(form.quantity, {widget_columns: 6}) }}
{% endblock form_content %}

{% block goback_link path('admin_event_list') %}
