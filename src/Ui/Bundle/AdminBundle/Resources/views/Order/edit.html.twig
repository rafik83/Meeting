{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <h1><a href="{{ path('admin_event_read', {event: event.id}) }}">{{ event.title }}</a></h1>

    <h2>{{ sheet_info }}</h2>

    <h3>Commande {{ order.id }}</h3>

    <table class="table table-condensed">
        <thead>
            <tr>
                <th colspan="2">Produit</th>
                <th class="text-right">Prix unitaire</th>
                <th class="text-right">Quantité</th>
                <th class="text-right">Total</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>

            {% for group in order_view.groups.groups %}
                <tr class="active">
                    <th colspan="5">{{ group.label }}</th>
                    <td class="text-right">
                        {% if group.groupId %}
                            <a href="{{ path('admin_sheet_order_add_row_to_group', { 'event': event.id, 'order': order.id, 'group': group.groupId }) }}"><i class="glyphicon glyphicon-plus"></i></a>
                        {% endif %}
                    </td>
                </tr>

                {% for product in group.products %}
                    <tr>
                        <td>&nbsp;</td>
                        <td>{{ product.label }}</td>
                        <td class="text-right">{{ product.price|number_format(2, ',', ' ') }} €</td>
                        <td class="text-right">{{ product.quantity }}</td>
                        <td class="text-right">{{ product.total|number_format(2, ',', ' ') }} €</td>
                        <td class="text-right">

                            {% if product.id is null %}
                                {#<a href="{{ path('admin_sheet_order_edit_row', { 'event': event.id, 'order': order.id, 'group': group.type, 'row': product.id, 'groupId': group.groupId }) }}"><i class="glyphicon glyphicon-edit"></i></a>#}
                                {#<a href="{{ path('admin_sheet_order_remove_row', { 'event': event.id, 'order': order.id, 'group': group.type, 'row': product.id }) }}"><i class="glyphicon glyphicon-remove"></i></a>#}
                            {% endif %}
                        </td>
                    </tr>
                    {% if product.includedProducts is not empty %}
                        <tr>
                            <td>&nbsp;</td>
                            <th colspan="5">Inclus :</th>
                        </tr>
                    {% endif %}
                    {% for included in product.includedProducts %}
                        <tr>
                            <td>&nbsp;</td>
                            <td>&gt; {{ included.label }}</td>
                            <td class="text-right">{{ included.price|number_format(2, ',', ' ') }} €</td>
                            <td class="text-right">{{ included.quantity }}</td>
                            <td class="text-right">{{ included.total|number_format(2, ',', ' ') }} €</td>
                            <td></td>
                        </tr>
                    {% endfor %}
                {% endfor %}
                {% for customRow in group.customRows %}
                    <tr>
                        <td>&nbsp;</td>
                        <td>{{ customRow.label }}</td>
                        <td class="text-right">{{ customRow.price|number_format(2, ',', ' ') }} €</td>
                        <td class="text-right">{{ customRow.quantity }}</td>
                        <td class="text-right">{{ customRow.total|number_format(2, ',', ' ') }} €</td>
                        <td class="text-right">

                        <a href="{{ path('admin_sheet_order_edit_row', { 'event': event.id, 'order': order.id, 'row': customRow.id }) }}"><i class="glyphicon glyphicon-edit"></i></a>
                        <a href="{{ path('admin_sheet_order_remove_row', { 'event': event.id, 'order': order.id, 'group': group.groupId, 'row': customRow.id }) }}"><i class="glyphicon glyphicon-remove"></i></a>
                        </td>
                    </tr>
                {% endfor %}
            {% endfor %}

            <tr class="info">
                <th colspan="2"></th>
                <th colspan="2">Total HT</th>
                <th class="text-right">{{ order_view.total|number_format(2, ',', ' ') }} €</th>
                <th></th>
            </tr>
            {% if order_view.vatApplicable %}
                <tr>
                    <th colspan="2"></th>
                    <th colspan="2">TVA</th>
                    <th class="text-right">{{ order_view.vat }}%</th>
                    <th></th>
                </tr>
                <tr>
                    <th colspan="2"></th>
                    <th colspan="2">Total TTC</th>
                    <th class="text-right">{{ order_view.totalPlusVat|number_format(2, ',', ' ') }} €</th>
                    <th></th>
                </tr>
            {% endif %}
        </tbody>
    </table>
{% endblock %}

