{% extends 'AdminBundle::base.html.twig' %}

{% from 'AdminBundle::macro.html.twig' import delete_button %}

{% block title 'admin.order.edit'|trans %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}

    <h1 class="page-header">
        <a href="{{ path('admin_sheet_order_list', {event: event.id}) }}" class="btn btn-link btn-sm" data-toggle="tooltip" title="{{ 'admin.order_edit.list_command.label'|trans }}"><span class="glyphicon glyphicon-list"></span></a>
        <a href="{{ path('admin_sheet_details', { event: event.id, sheet: order.sheet.id}) }}">{{ sheet_info }}</a>
        <small>/ {{ 'admin.order.edit'|trans }} {{ order.numero }}</small>
    </h1>

    <table class="table table-condensed">
        <thead>
            <tr>
                <th colspan="2">{{ 'admin.order_edit.columns.product'|trans }}</th>
                <th class="text-right">{{ 'admin.order_edit.columns.unitPrice'|trans }}</th>
                <th class="text-right">{{ 'admin.order_edit.columns.vatRate'|trans }}</th>
                <th class="text-right">{{ 'admin.order_edit.columns.quantity'|trans }}</th>
                <th class="text-right">{{ 'admin.order_edit.columns.total'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>

            {% for group in order_view.groups.groups %}
                <tr class="active">
                    <th colspan="6">{{ group.label }}</th>
                    <td class="text-right">
                        {% if group.groupId %}
                            <a href="{{ path('admin_sheet_order_add_row_to_group', { 'event': event.id, 'order': order.id, 'group': group.groupId }) }}"><i class="glyphicon glyphicon-plus"></i></a>
                        {% endif %}
                    </td>
                </tr>

                {% for product in group.products %}
                    <tr>
                        <td>&nbsp;</td>
                        <td>{{ product.label }}</td>
                        <td class="text-right">{{ product.price|localizedcurrency(product.currency) }}</td>
                        <td class="text-right">{{ product.vatRate }}%</td>
                        <td class="text-right">{{ product.quantity }}</td>
                        <td class="text-right">{{ product.total|localizedcurrency(product.currency) }}</td>
                        <td class="text-right">
                            <a href="{{ path('admin_sheet_order_add_row_to_product', { 'event': event.id, 'order': order.id, 'row': product.id }) }}"><i class="glyphicon glyphicon-plus"></i></a>
                        </td>
                    </tr>

                    {% if product.includedProducts is not empty %}
                        <tr>
                            <td>&nbsp;</td>
                            <th colspan="5">{{ 'admin.order_edit.includedProduct'|trans }} :</th>
                        </tr>
                    {% endif %}

                    {% for included in product.includedProducts %}
                        <tr>
                            <td>&nbsp;</td>
                            <td>&gt; {{ included.label }}</td>
                            <td class="text-right">{{ included.price|localizedcurrency(included.currency) }}</td>
                            <td></td>
                            <td class="text-right">{{ included.quantity }}</td>
                            <td class="text-right">{{ included.total|localizedcurrency(included.currency) }}</td>
                            <td></td>
                        </tr>
                    {% endfor %}

                    {% for customRow in product.customRows %}
                        <tr>
                            <td>&nbsp;</td>
                            <td>{{ customRow.label }}</td>
                            <td class="text-right">{{ customRow.price|localizedcurrency(customRow.currency) }}</td>
                            <td class="text-right">{{ customRow.vatRate }}%</td>
                            <td class="text-right">{{ customRow.quantity }}</td>
                            <td class="text-right">{{ customRow.total|localizedcurrency(customRow.currency) }}</td>
                            <td class="text-right">
                                <a href="{{ path('admin_sheet_order_update_row', { 'event': event.id, 'order': order.id, 'row': customRow.id }) }}"><i class="glyphicon glyphicon-edit"></i> {{ 'admin.order_edit.edit_custom_row'|trans }}</a>
                                <a href="{{ path('admin_sheet_order_remove_row', { 'event': event.id, 'order': order.id, 'row': customRow.id }) }}"><i class="glyphicon glyphicon-remove"></i> {{ 'admin.order_edit.remove_custom_row'|trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endfor %}

                {% for customRow in group.customRows %}
                        <tr>
                            <td>&nbsp;</td>
                            <td>{{ customRow.label }}</td>
                            <td class="text-right">{{ customRow.price|localizedcurrency(customRow.currency) }}</td>
                            <td class="text-right">{{ customRow.vatRate }}%</td>
                            <td class="text-right">{{ customRow.quantity }}</td>
                            <td class="text-right">{{ customRow.total|localizedcurrency(customRow.currency) }}</td>
                            <td class="text-right">
                                <a href="{{ path('admin_sheet_order_update_row', { 'event': event.id, 'order': order.id, 'row': customRow.id }) }}"> {{ "admin.order_edit.edit_custom_row"|trans }} <i class="glyphicon glyphicon-edit"></i></a>
                                <a href="{{ path('admin_sheet_order_remove_row', { 'event': event.id, 'order': order.id, 'row': customRow.id }) }}"> {{ "admin.order_edit.remove_custom_row"|trans }} <i class="glyphicon glyphicon-remove"></i></a>
                            </td>
                        </tr>
                {% endfor %}
            {% endfor %}

            {% if order_view.promotionCodes.promotionCodes is not empty %}
                <tr class="active">
                    <th colspan="7">{{ 'admin.order_edit.promotionCodes'|trans }}</th>
                </tr>
            {% endif %}

            {% for promotionCode in order_view.promotionCodes.promotionCodes %}
                <tr>
                    <td>&nbsp;</td>
                    <td class="text-left">
                        {{ promotionCode.label }}<br>
                        {{ promotionCode.description }}
                    </td>
                    <td></td>
                    <td></td>
                    <td class="text-right">{{ promotionCode.quantity }}</td>
                    <td class="text-right">{{ promotionCode.total|localizedcurrency(promotionCode.currency) }}</td>
                    <td class="text-right">
                        <a href="{{ path('admin_order_remove_promotion_code', {
                            'event': event.id,
                            'order': order.id,
                            'promotionCode': promotionCode.id,
                            '_token': csrf_token(constant('Proximum\\Vimeet\\Domain\\Intention\\IntentionType::INTENTION_REMOVE_PROMOTION_CODE_FROM_ORDER'))
                        }) }}"><i class="glyphicon glyphicon-remove"></i></a>
                    </td>
                </tr>
            {% endfor %}

            <tr class="info">
                <th colspan="3"></th>
                <th colspan="2">{{ 'admin.order_edit.total.withoutVAT'|trans }}</th>
                <th class="text-right">{{ order_view.totalWithoutVat|format_amount|localizedcurrency(order_view.currency) }}</th>
                <th></th>
            </tr>

            {% if order_view.vatApplicable %}
                {% for vatView in order_view.vatListView.vatViews %}
                    <tr>
                        <th colspan="3"></th>
                        <th colspan="2">{{ 'admin.order_edit.totalByVAT'|trans({'%vat%': vatView.vatRate}) }}</th>
                        <th class="text-right">{{ vatView.total|format_amount|localizedcurrency(order_view.currency) }}</th>
                        <th></th>
                    </tr>
                    <tr>
                        <th colspan="3"></th>
                        <th colspan="1">{{ 'admin.order_edit.VAT'|trans }}</th>
                        <th colspan="1">{{ vatView.vatRate }}%</th>
                        <th class="text-right">{{ vatView.totalVat|format_amount|localizedcurrency(order_view.currency) }}</th>
                        <th></th>
                    </tr>
                {% endfor %}
                <tr>
                    <th colspan="3"></th>
                    <th colspan="2">{{ 'admin.order_edit.total.withVAT'|trans }}</th>
                    <th class="text-right">{{ order_view.totalWithVat|format_amount|localizedcurrency(order_view.currency) }}</th>
                    <th></th>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <div class="well">
        {{ form_start(promotion_code_choice_form) }}
        {{ form_errors(promotion_code_choice_form) }}
        <div class="row">
            <div class="col-md-6">{{ form_row(promotion_code_choice_form.promotionCode) }}</div>
            <div class="col-md-6">{{ form_row(promotion_code_choice_form.submit) }}</div>
        </div>
        {{ form_end(promotion_code_choice_form) }}
    </div>
{% endblock %}

