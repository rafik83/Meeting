{% extends 'AdminBundle::base.html.twig' %}

{% block title %}
    [{{ event.title }}] {{ 'admin.order.title'|trans }}
{% endblock %}

{% block list_title 'admin.order.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ block('list_title') }}</h1>

    {{ form_start(filterForm) }}
    {{ form_row(filterForm.product, { 'group_attr': { 'class': 'col-md-8' } }) }}

    <div class="col-md-2">
        <button type="submit" id="submit" name="submit" class="btn btn-primary">{{ 'admin.filter'|trans }}</button>
    </div>

    {{ form_end(filterForm) }}

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ 'admin.order.id'|trans }}</th>
            <th>{{ 'admin.order.sheet'|trans }}</th>
            <th>{{ 'admin.order.type'|trans }}</th>
            <th>{{ 'admin.order.follower'|trans }}</th>
            <th>{{ 'admin.order.createdAt'|trans }}</th>
            <th class="text-right">{{ 'admin.order.total'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td>
                    {{ order.id }}
                </td>
                <td>
                    {{ order.title }}
                </td>
                <td>
                    {{ order.type }}
                </td>
                <td>
                    {{ order.follower }}
                </td>
                <td>
                    {{ order.createdAt|localizeddate('medium', 'short') }}
                </td>
                <td class="text-right">
                    {{ order.total|localizedcurrency(order.currency) }} {{ ('admin.event.vatMode.' ~ order.vatMode)|trans }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9" class="text-danger text-center">{{ 'admin.zero-result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', { 'paginator': orders }) }}
{% endblock content %}
