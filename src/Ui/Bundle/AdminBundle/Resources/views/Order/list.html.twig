{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.order.title'|trans %}

{% block list_title 'admin.order.title'|trans %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <h1 class="page-header">
        {{ block('list_title') }}
        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
        <form action="{{ path('admin_order_export', { 'event': event.id }) }}" method="GET" class="pull-right" style="margin-left: 10px;">
            <input type="submit" value="{{ 'admin.order.export.button.label'|trans }}" class="btn btn-sm btn-default"/>
        </form>
        {% endif %}
    </h1>

    {{ form_start(filterPartForm) }}
        {{ form_row(filterPartForm.product, { 'group_attr': { 'class': 'col-md-7' } }) }}
        {{ form_row(filterPartForm.enabled) }}
        {{ form_row(filterPartForm.cancelled, { 'group_attr': { 'class': 'col-md-3' } }) }}

        <div class="col-md-2">
            <button type="submit" id="submit" name="submit" class="btn btn-primary">{{ 'admin.filter'|trans }}</button>
        </div>
    {{ form_end(filterPartForm) }}

    {{ form_start(filterForm) }}
    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ 'admin.order.id'|trans }}</th>
            <th>{{ macro.choice_as_dropdown(filterForm.enabled, false, false, false, false) }}</th>
            <th>{{ 'admin.order.type'|trans }}</th>
            <th>{{ 'admin.order.follower'|trans }}</th>
            <th>{{ 'admin.order.createdAt'|trans }}</th>
            <th class="text-right">{{ 'admin.order.totalWithoutVat'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td>
                    {{ order.numero }}
                </td>
                <td>
                    <a href="{{ path('admin_sheet_details', { event: event.id, sheet: order.sheetId }) }}">
                        {{ order.sheetTitle }}
                    </a>
                </td>
                <td>
                    {{ order.sheetType }}
                </td>
                <td>
                    {{ order.follower }}
                </td>
                <td>
                    {{ order.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
                </td>
                <td class="text-right">
                    {{ order.totalWithoutVat|localizedcurrency(order.currency) }}
                </td>
                <td class="text-right">
                    {% if not order.isInvoiced and not order.isCancelled %}
                        <a class="btn btn-default btn-sm" href="{{ path('admin_sheet_order_edit', { 'event': event.id, 'order': order.id }) }}">{{ 'admin.order_edit.link'|trans }}</a>
                    {% endif %}

                    {% if order.isInvoiced %}
                        <span class="label label-success">{{ 'admin.order.invoiced'|trans }}</span>
                    {% endif %}

                    {% if order.isCancelled %}
                        <span class="label label-danger">{{ 'admin.order.cancelled'|trans }}</span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9" class="text-danger text-center">{{ 'admin.zero-result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ form_end(filterForm, {'render_rest': false}) }}
    {{ include('AdminBundle:Paginator:paginate.html.twig', { 'paginator': orders }) }}
{% endblock content %}
