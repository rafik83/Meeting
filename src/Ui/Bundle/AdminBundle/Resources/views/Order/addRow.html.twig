{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title %}
    {{ 'admin.order_edit.command_name'|trans({'%id%': order.id, '%sheetName%': sheet_info }) }}
{% endblock form_title %}

{% block form_content %}
    <h4>
        {{ 'admin.order_edit.add_line'|trans }}
        {% if row_label is defined %}
            {{ 'admin.order_edit.after'|trans }}
            "{{ row_label }}"
        {% endif %}
    </h4>

    {{ form_row(form.label, {widget_columns: 6}) }}
    {{ form_row(form.price, {widget_columns: 6}) }}
    {{ form_row(form.quantity, {widget_columns: 6}) }}
{% endblock form_content %}

{% block goback_link path('admin_event_list') %}
