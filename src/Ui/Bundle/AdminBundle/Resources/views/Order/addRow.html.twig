{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_content %}
    <h1 class="page-header">Commande {{ order.id }} de {{ sheet_info }}</h1>

    <h4>
        Ajouter une ligne
        {% if row_label is defined %}
            après "{{ row_label }}"
        {% endif %}
    </h4>

    {{ form_row(form.label) }}
    {{ form_row(form.price) }}
    {{ form_row(form.quantity) }}
{% endblock form_content %}

{% block goback_link path('admin_event_list') %}
