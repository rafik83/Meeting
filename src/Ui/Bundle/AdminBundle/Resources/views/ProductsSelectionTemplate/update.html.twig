{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title 'admin.template.productsSelection.title'|trans %}

{% block form_content %}
    {{ form_row(form.title) }}

    {% for block in form.templateData.blocks %}
        <div class="well">
            {{ form_row(block) }}
        </div>
    {% endfor %}
{% endblock form_content %}

{% block goback_link path('admin_template_products_selection_list') %}
