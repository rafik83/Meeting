{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.unavailability.category.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.unavailability.category.title'|trans }}
        <div class="pull-right">
            <a class="btn btn-info" href="{{ path('admin_unavailability_mass_list', {event: event.id}) }}">
                {{ 'admin.unavailability.button.mass'|trans }}
            </a>
        </div>
    </h1>

    <div>
        <a href="{{ path('admin_unavailability_category_create', { 'event': event.id }) }}" class="btn btn-sm btn-primary new-action">
            {{ 'admin.unavailability.category.add'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.unavailability.category.table.column.title'|trans }}</th>
            <th>{{ 'admin.unavailability.category.table.column.picto'|trans }}</th>
            <th>{{ 'admin.unavailability.category.table.column.color'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.title }}</td>
                <td><i class="icon-{{ category.picto }}"></i></td>
                <td style="background-image: linear-gradient(to right, {{ category.leftColor }}, {{ category.rightColor }});"></td>
                <td class="text-right">
                    <a href="{{ path('admin_unavailability_category_update', {event: event.id, category: category.id}) }}" class="btn btn-default">
                        {{ 'admin.unavailability.category.table.content.update'|trans }}
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
