{% extends 'AdminBundle::base.html.twig' %}

{% block title 'event.meeting.request.details.title'|trans %}

{% block content %}

    <h2>{{ 'event.meeting.request.details.title'|trans }}</h2>
    <table class="table table-bordered">
        <thead>
        <th>{{ 'event.meeting.request.details.from'|trans }}</th>
        <th>{{ 'event.meeting.request.details.fromParticipant'|trans }}</th>
        <th>{{ 'event.meeting.request.details.to'|trans }}</th>
        <th>{{ 'event.meeting.request.details.toParticipant'|trans }}</th>
        <th>{{ 'event.meeting.request.details.state'|trans }}</th>
        <th>{{ 'event.meeting.request.details.createdAt'|trans }}</th>
        <th>{{ 'event.meeting.request.details.updatedAt'|trans }}</th>
        </thead>
        <tbody>
        {% set state = { approved: 'success', sent: 'info', refused: 'danger', cancelled: 'warning' } %}
        <tr>
            <td>{{ meetingRequestView.fromSheetName }}</td>
            <td>
                {% for fromParticipantName in meetingRequestView.fromParticipantNames %}
                    {{ fromParticipantName }}
                {% endfor %}
            </td>
            <td>{{ meetingRequestView.toSheetName }}</td>
            <td>
                {% for toParticipantName in meetingRequestView.toParticipantNames %}
                    {{ toParticipantName }}
                {% endfor %}
            </td>
            <td>
                <span class="btn-xs alert-{{ state[meetingRequestView.state] }}">
                    {{ ('event.meeting.request.state.to.' ~ meetingRequestView.state)|trans }}
                </span>
            </td>
            <td>{{ meetingRequestView.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
            <td>{{ meetingRequestView.stateUpdatedAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
        </tr>
        </tbody>
    </table>

    <h3>{{ 'event.meeting.request.details.message'|trans }}</h3>
    {% for message in meetingRequestView.messages %}
        {% if message.from.id == meetingRequestView.fromSheetId %}
            <h5>{{ meetingRequestView.fromSheetName }}</h5>
        {% else %}
            <h5>{{ meetingRequestView.toSheetName }}</h5>
        {% endif %}
        <blockquote>
            {{ message.content }}
            <br>
            <span class="label label-default">
                {{ message.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
            </span>
        </blockquote>
    {% endfor %}

{% endblock %}
