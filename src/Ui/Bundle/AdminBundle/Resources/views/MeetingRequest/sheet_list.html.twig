{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">Demandes de rendez-vous et rendez-vous par fiche de participation</h1>

    <a href="{{ path('admin_transform_requests_to_meetings', { 'event': event.id }) }}" class="btn btn-success">
        Générer les rendez-vous
    </a>

    <table class="table table-hover sortable">
        <thead>
            <tr>
                <th>{{ sheets|length }} fiches de participation</th>
                <th>Type</th>
                <th class="text-right">Demandes acceptées</th>
                <th class="text-right">Demandes transformées</th>
                <th class="text-right">%</th>
                <th class="text-right">Propositions acceptées</th>
                <th class="text-right">Propositions transformées</th>
                <th class="text-right">%</th>
                <th class="text-right">Total demandes</th>
                <th class="text-right">Total RDV</th>
                <th class="text-right">%</th>
                <th class="text-right">% RDV demandés / Total</th>
                <th class="text-right">% remplissage planning</th>
            </tr>
        </thead>

        <tbody>
        {% for sheet in sheets %}
            <tr>
                <td>
                    <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}">
                        {{ sheet.title }}
                    </a>
                </td>
                <td>
                    {{ sheet.type }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.meetingsRequestsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsTransformation|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.propositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.meetingsPropositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.propositionsTransformation|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsNumber + sheet.propositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.meetingsRequestsNumber + sheet.meetingsPropositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.transformationTotal|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsPropositionsTransformation|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.filling|number_format }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
