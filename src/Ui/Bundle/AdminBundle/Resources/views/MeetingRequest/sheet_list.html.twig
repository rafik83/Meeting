{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">Demandes de rendez-vous et rendez-vous par fiche de participation</h1>

    <p>
        <a href="{{ path('admin_transform_requests_to_meetings', { 'event': event.id }) }}" class="btn btn-success" data-loading-link="{{ '<i class="glyphicon glyphicon-refresh spin"></i> Génération des RDV en cours...'|e }}">
            Générer les rendez-vous
        </a>
    </p>

    <div class="row">
        <div class="col-md-3">
            <div class="panel panel-default">
                <div class="panel-heading text-center">Demandes de RDV</div>
                <div class="panel-body text-center">
                    <h2>{{ requests_total }}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-default">
                <div class="panel-heading text-center">RDV</div>
                <div class="panel-body text-center">
                    <h2>{{ meetings_total }} <span class="label label-default">{{ transformation_total|number_format }} %</span></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-default">
                <div class="panel-heading text-center">Moyenne part des RDV demandés</div>
                <div class="panel-body text-center">
                    <h2>{{ average_requests_propositions_transformation|number_format }} %</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-default">
                <div class="panel-heading text-center">Moyenne utilisation des slots</div>
                <div class="panel-body text-center">
                    <h2>{{ average_filling|number_format }} %</h2>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-hover sortable">
        <thead>
            <tr>
                <th>{{ sheets|length }} fiches de participation</th>
                <th>Type</th>
                <th class="text-right">Demandes acceptées</th>
                <th class="text-right">Demandes transformées</th>
                <th class="text-right">%</th>
                <th class="text-right">Propositions acceptées</th>
                <th class="text-right">Propositions transformées</th>
                <th class="text-right">%</th>
                <th class="text-right">Total demandes</th>
                <th class="text-right">Total RDV</th>
                <th class="text-right">%</th>
                <th class="text-right">Part des RDV demandés / Total RDV</th>
                <th class="text-right">Slots</th>
                <th class="text-right">% utilisation slots</th>
            </tr>
        </thead>

        <tbody>
        {% for sheet in sheets %}
            <tr>
                <td>
                    <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}">
                        {{ sheet.title }}
                    </a>
                </td>
                <td>
                    {{ sheet.type }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.meetingsRequestsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsTransformation|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.propositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.meetingsPropositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.propositionsTransformation|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsNumber + sheet.propositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.meetingsRequestsNumber + sheet.meetingsPropositionsNumber }}
                </td>
                <td class="text-right">
                    {{ sheet.transformationTotal|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.requestsPropositionsTransformation|number_format }}
                </td>
                <td class="text-right">
                    {{ sheet.availableSlots }}
                </td>
                <td class="text-right">
                    {{ sheet.filling|number_format }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
