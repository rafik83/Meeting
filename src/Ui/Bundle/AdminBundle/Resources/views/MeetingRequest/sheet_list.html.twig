{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">Demandes de rendez-vous et rendez-vous par fiche de participation</h1>

    <table class="table table-hover">
        <tr>
            <th>Fiche de participation</th>
            <th>Type</th>
            <th>Demandes de RDV</th>
            <th>RDV</th>
            <th>% transformation</th>
        </tr>

        {% for sheet in sheets %}
            <tr>
                <td>
                    <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}">
                        {{ sheet.title }}
                    </a>
                </td>
                <td>
                    {{ sheet.type }}
                </td>
                <td>
                    {{ sheet.requestsNumber }}
                </td>
                <td>
                    {{ sheet.meetingsNumber }}
                </td>
                <td>
                    {{ sheet.requestsTranformation|number_format(2) }}
                </td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
