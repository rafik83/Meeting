{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.meeting_request.link'|trans %}

{% block content %}
    <div class="page-header-tools pull-right">
        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
            <a href="{{ path('admin_meeting_request_lock_update', {'event': event.id}) }}" class="btn btn-info">
                {{ 'admin.meeting_request.action.lock'|trans }}
            </a>
            <a href="{{ path('admin_meeting_request_import', {'event': event.id}) }}" class="btn btn-default">
                {{ 'admin.meeting_request.action.import'|trans }}
            </a>
            <form action="{{ path('admin_meeting_request_export', {'event': event.id}) }}" method="GET">
                <button type="submit" class="btn btn-default">
                    {{ 'admin.meeting_request.action.export'|trans }}
                </button>
            </form>
        {% endif %}
    </div>

    <h1 class="page-header">
        {{ 'admin.meeting_request.title'|transchoice(meeting_requests.total, {'%count%': meeting_requests.total}) }}
    </h1>

    {{ include('AdminBundle:Common:filters_summary.html.twig', {
        filters:   filters_summary,
        resetLink: path('admin_meeting_request_list', { 'event': event.id })
    }) }}

    <div class="col-md-offset-8 col-md-4 text-right">
        {{ macro.choice_as_dropdown(filter_form.orderBy, true, true, false, false, false) }}
    </div>

    <table class="table table-hover filterable">
        <thead>
        <tr>
            <th>{{ 'admin.meeting_request.from'|trans }}</th>
            <th>{{ 'admin.meeting_request.to'|trans }}</th>
            <th>{{ 'admin.meeting_request.stateUpdatedAt'|trans }}</th>
            <th>{{ 'admin.meeting_request.createdAt'|trans }}</th>
            <th>{{ macro.choice_as_dropdown(filter_form.state) }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for meeting_request in meeting_requests.results %}
            <tr>
                <td>
                    <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': meeting_request.sheetFromId }) }}">
                        {{ meeting_request.sheetNameFrom }}
                    </a>
                </td>
                <td>
                    <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': meeting_request.sheetToId }) }}">
                        {{ meeting_request.sheetNameTo }}
                    </a>
                </td>
                <td>{{ meeting_request.stateUpdatedAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                <td>{{ meeting_request.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                <td>
                    {{ macro.state_label(
                        ('admin.meeting_request.state.' ~ meeting_request.state)|trans,
                        meeting_request.state,
                        {
                            'sent': 'info',
                            'approved': 'success',
                            'refused': 'danger',
                            'cancelled': 'danger',
                            'planned': 'primary'
                        }
                    ) }}
                </td>
                <td class="text-right">
                    {{ macro.btnGroupAndRightMenuDropdown({
                        ('admin.meeting_request.details'|trans): path('admin_meeting_request_details', {'event': event.id, 'meetingRequest': meeting_request.id}),
                    }) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">
                    {{ 'admin.zero-result'|trans }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': meeting_requests}) }}
{% endblock %}
