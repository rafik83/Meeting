{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.rule.list.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.rule.list.add.title'|trans }}</h1>

    {{ form(form) }}

    <h2>{{ 'admin.rule.list.title'|trans }}</h2>
    <table class="table">
        <thead>
            <tr>
                <th>{{ 'admin.rule.list.column.who'|trans }}</th>
                <th>{{ 'admin.rule.list.column.see'|trans }}</th>
                <th>{{ 'admin.rule.list.column.priority'|trans }}</th>
                <th>{{ 'admin.rule.list.column.restrictions'|trans }}</th>
                <th>{{ 'admin.rule.list.column.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in rules %}
                <tr>
                    <td>
                        {% if rule.seerType %}
                            {{ 'admin.rule.list.content.type'|trans }} "{{ rule.seerType.getTitle(locale) }}"
                        {% elseif rule.seerCategory %}
                            {{ 'admin.rule.list.content.category'|trans }} "{{ rule.seerCategory.getTitle(locale) }}"
                        {% endif %}
                    </td>
                    <td>
                        {% if rule.seeableType %}
                            {{ 'admin.rule.list.content.type'|trans }} "{{ rule.seeableType.getTitle(locale) }}"
                        {% elseif rule.seeableCategory %}
                            {{ 'admin.rule.list.content.category'|trans }} "{{ rule.seeableCategory.getTitle(locale) }}"
                        {% endif %}
                    </td>
                    <td>{{ rule.priority }}</td>
                    <td>
                        {% if rule.phoneAccessMinEvaluation %}
                            <span class="badge">
                                <i class="icon-Appeler"></i>
                                {% if rule.phoneAccessMinEvaluation < 5 %}
                                &gt; {{ rule.phoneAccessMinEvaluation }}
                                {% else %}
                                <i class="icon-Fermer_1"></i>
                                {% endif %}
                            </span>
                        {% endif %}
                        {% if rule.emailAccessMinEvaluation %}
                            <span class="badge">@
                                {% if rule.emailAccessMinEvaluation < 5 %}
                                &gt; {{ rule.emailAccessMinEvaluation }}
                                {% else %}
                                <i class="icon-Fermer_1"></i>
                                {% endif %}
                            </span>
                        {% endif %}
                        {% if rule.sendEmailMinEvaluation %}
                            <span class="badge">
                                <i class="icon-Transferer"></i>
                                {% if rule.sendEmailMinEvaluation < 5 %}
                                &gt; {{ rule.sendEmailMinEvaluation }}
                                {% else %}
                                <i class="icon-Fermer_1"></i>
                                {% endif %}
                            </span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('admin_rule_see_what', { 'event': event.id, 'rule': rule.id }) }}" class="btn btn-primary btn-sm">{{ 'admin.rule.list.action.seeWhat'|trans }}</a>
                        <form action="{{ path('admin_rule_delete', { 'event': event.id, 'rule': rule.id }) }}" method="POST" style="display: inline">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-danger btn-sm">{{ 'admin.rule.list.action.delete'|trans }}</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
