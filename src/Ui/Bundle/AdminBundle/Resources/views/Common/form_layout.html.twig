{% extends 'AdminBundle::base.html.twig' %}

{% block title block('form_title')|striptags %}

{% block content %}
    <h1 class="page-header">
        {% block goback %}
            <a href="{% block goback_link '#' %}" class="btn btn-link" title="{{ 'admin.goback.link'|trans }}">
                <span class="glyphicon glyphicon-arrow-left"></span>
            </a>
        {% endblock goback %}
        {% block form_title '' %}
    </h1>

    {% block pre_form %}{% endblock pre_form %}

    {{ form_start(form, { 'attr': { 'class': 'with-submit-section' } }) }}
    {{ form_errors(form) }}

    {% block form_content %}{% endblock form_content %}

    {% block submit_section %}
        <div class="form-group submit-section">
            <div class="text-right">
                {% block form_submit %}
                    {{ form_row(form.submit) }}
                {% endblock form_submit %}
            </div>
        </div>
    {% endblock submit_section %}

    {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
