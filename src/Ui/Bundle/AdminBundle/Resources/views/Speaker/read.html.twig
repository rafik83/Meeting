{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title %}Intevenant {{ speaker.name }}{% endblock %}

{% block content %}
    <h1 class="page-header">{{ block('title') }}</h1>
    <div>
        <a href="{{ path('admin_happening_speaker_update', { 'event': event.id, 'speaker': speaker.id }) }}" class="btn btn-sm btn-primary">{{ 'admin.happening_speaker.action.edit'|trans }}</a>
        {{ macro.delete_button(
        path('admin_happening_speaker_delete', { 'event': event.id, 'speaker': speaker.id }),
        'admin.happening_speaker.action.delete'|trans,
        { 'class': 'btn btn-sm btn-danger', 'data-confirm': 'admin.happening_speaker.action.confirmDelete'|trans }
        ) }}
    </div>

    <table class="table">
        <tr>
            <th>{{ 'admin.happening_speaker.table.column.name'|trans }}</th>
            <td>{{ speaker.name }}</td>
        </tr>
        <tr>
            <th>{{ 'admin.happening_speaker.table.column.function'|trans }}</th>
            <td>{{ speaker.function }}</td>
        </tr>
        <tr>
            <th>{{ 'admin.happening_speaker.table.column.company'|trans }}</th>
            <td>{{ speaker.organization }}</td>
        </tr>
        <tr>
            <th>{{ 'admin.happening_speaker.table.column.logoCompany'|trans }}</th>
            <td>{% if speaker.logo %}<img src="{{ speaker.logo }}" class="img-responsive" />{% endif %}</td>
        </tr>
        <tr>
            <th>{{ 'admin.happening_speaker.table.column.photo'|trans }}</th>
            <td>{% if speaker.photo %}<img src="{{ speaker.photo }}" class="img-responsive" />{% endif %}</td>
        </tr>
        <tr>
            <th>{{ 'admin.happening_speaker.table.column.subEvent'|trans }}</th>
            <td>
                <ul>
                    {% for happening in happenings %}
                        <li>
                            {% if happening.canUpdate %}
                                <a href="{{ path('admin_happening_update', { 'event': event.id, 'happening': happening.id }) }}">{{ happening.title }}</a>
                            {% else %}
                                {{ happening.title }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </td>
        </tr>
    </table>

    <div>
        <a href="{{ path('admin_happening_speaker_list', { 'event': event.id }) }}" class="btn btn-link">← Retour à la liste</a>
    </div>

{% endblock %}
