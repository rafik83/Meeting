{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.happening_speaker.updateTitle'|trans %}

{% block form_title 'admin.happening_speaker.update'|trans %}

{% block form_content %}
    {{ form_row(form.firstname) }}
    {{ form_row(form.lastname) }}
    {{ form_row(form.translations) }}
    {{ form_row(form.organization) }}

    {{ form_row(form.logo) }}
    {% if speaker.logo %}
        <div class="row">
            <div class="col-md-offset-3 col-md-3">
                <img src="{{ speaker.logo }}" class="img-responsive" />
            </div>
        </div>
    {% endif %}

    {{ form_row(form.photo) }}
    {% if speaker.photo %}
        <div class="row">
            <div class="col-md-offset-3 col-md-3">
                <img src="{{ speaker.photo }}" class="img-responsive" />
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block goback_link path('admin_happening_speaker_list', {event: event.id}) %}
