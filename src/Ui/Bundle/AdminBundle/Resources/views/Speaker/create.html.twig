{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.happening_speaker.addTitle'|trans %}

{% block form_title 'admin.happening_speaker.add'|trans %}

{% block form_content %}
    {{ form_row(form.firstname) }}
    {{ form_row(form.lastname) }}
    {{ form_row(form.translations) }}
    {{ form_row(form.organization) }}
    {{ form_row(form.logo) }}
    {{ form_row(form.photo) }}
{% endblock %}

{% block goback_link path('admin_happening_speaker_list', {event: event.id}) %}
