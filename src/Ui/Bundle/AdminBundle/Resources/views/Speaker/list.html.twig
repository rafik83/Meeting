{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.happening_speaker.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.happening_speaker.title'|trans }}
        <div class="pull-right">
            <a class="btn btn-info" href="{{ path('admin_happening_list', {event: event.id}) }}">
                {{ 'admin.happening_speaker.button.happening'|trans }}
            </a>
            <a class="btn btn-info" href="{{ path('admin_happening_category_list', {event: event.id}) }}">
                {{ 'admin.happening_speaker.button.happening_category'|trans }}
            </a>
        </div>
    </h1>

    <div>
        <a href="{{ path('admin_happening_speaker_create', { 'event': event.id }) }}" class="btn btn-sm btn-primary new-action">
            {{ 'admin.happening_speaker.add'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.happening_speaker.table.column.name'|trans }}</th>
            <th>{{ 'admin.happening_speaker.table.column.function'|trans }}</th>
            <th>{{ 'admin.happening_speaker.table.column.company'|trans }}</th>
            <th>{{ 'admin.happening_speaker.happenings'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
            {% for speaker in speakers %}
                <tr>
                    <td>{{ speaker.name }}</td>
                    <td>
                        <ul>
                            {% for translation in speaker.translations%}
                                <li>{{ translation.locale|locale(app.request.locale)|capitalize  }}: {{ translation.position }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>{{ speaker.organization }}</td>
                    <td>
                        <ul>
                            {% for happening in speaker.happenings %}
                                <li><a href="{{ path('admin_happening_update', { 'event': event.id, 'happening': happening.id }) }}">{{ happening.title(app.request.locale) }}</a></li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td class="text-right">
                        <div class="btn-group">
                        <a href="{{ path('admin_happening_speaker_read', { 'event': event.id, 'speaker': speaker.id }) }}" class="btn btn-default btn-sm">{{ 'admin.happening_speaker.action.see'|trans }}</a>
                            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="caret"></span>
                                <span class="sr-only">Toggle Dropdown</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-right">
                                <li><a href="{{ path('admin_happening_speaker_update', { 'event': event.id, 'speaker': speaker.id }) }}">{{ 'admin.happening_speaker.action.edit'|trans }}</a></li>
                                <li>
                                    {{ macro.delete_button(
                                    path('admin_happening_speaker_delete', { 'event': event.id, 'speaker': speaker.id }),
                                    'admin.happening_speaker.action.delete'|trans,
                                    { 'class': '', 'data-confirm': 'admin.happening_speaker.action.confirmDelete'|trans }
                                    ) }}
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">
                        {{ 'admin.happening_speaker.no-result'|trans }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
