{% extends 'AdminBundle::base.html.twig' %}

{% block content %}

    <h1 class="page-header">Templates de fiche</h1>

    <button type="button" class="btn btn-primary btn-success" data-toggle="modal" data-target="#create-modal">
        Créer un template
    </button>

    {{ form_start(form) }}
        <div class="modal fade" id="create-modal" tabindex="-1" role="dialog" aria-labelledby="create-modal-label">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="create-modal-label">Créer un template</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_errors(form) }}
                        {{ form_row(form.title) }}
                        {{ form_row(form.locale) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">
                            {{ 'form.sheet_template_create.children.close.label'|trans({}, 'forms') }}
                        </button>
                        {{ form_widget(form.submit) }}
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}

    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th class="text-right">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for template in templates %}
                <tr>
                    <td>{{ template.title }}</td>
                    <td class="text-right">
                        <a href="{{ path('admin_template_duplicate', { 'template': template.id }) }}" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#duplicate-modal">Dupliquer</a>
                        <a href="{{ path('admin_template_builder', { 'template': template.id, 'locale': template.fallback }) }}" class="btn btn-primary btn-sm">Modifier</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="modal fade clear-on-hidden-modal" id="duplicate-modal" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>

{% endblock %}

