<div data-index="{{ index|default('__TAGS__') }}" id="tags-item-{{ uid|default('__UID__') }}-{{ index|default('__TAGS__') }}" class="tags-item-{{ uid|default('__UID__') }} row" style="margin-left:-15px;margin-bottom: 10px;">
    {% if label is same as (true) %}
        <div class="col-md-5">
            <input type="text" class="form-control" name="tags[{{ index|default('__TAGS__') }}][label][{{ locale }}]" placeholder="{{ (locale != fallback|default(locale) and not tag['label'][locale]|default) ? tag['label'][fallback]|default('Label') : 'Label' }}"/>
        </div>
    {% endif %}
    <div class="{{ label is same as (true) ? 'col-md-5' : 'col-md-10' }}">
        <select class="form-control" name="tags[{{ index|default('__TAGS__') }}][tag]">
            {% for tag in sheet_tags %}
                <option value="{{ tag }}">{{ ('template.tag.' ~ tag)|trans({}, 'templates') }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-md-2 text-right">
        <button type="button" class="btn btn-danger btn-sm" data-collection-delete="tags-item-{{ uid|default('__UID__') }}-{{ index|default('__TAGS__') }}">&times;</button>
    </div>
</div>
