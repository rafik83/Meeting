{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.template.form.title'|trans %}

{% block body %}
    {{ include('AdminBundle:Common:menu.html.twig') }}

    <div
        class="container-fluid template-builder-container"
        data-form-template-builder="form-builder"
        data-save-url-template-builder="{{ path('admin_template_form_save', {
            'event': event.id,
            'template': template.id,
            'locale': locale
        }) }}"
        data-locale="{{ locale }}"
    >
        <div class="template-builder-header">
            <h1 class="pull-left">
                <a href="{{ path('admin_template_form_list', {'event': event.id}) }}" class="btn btn-link" title="{{ 'admin.goback.link'|trans }}">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                </a>
                {{ template.title }}
            </h1>

            <div class="btn-toolbar" role="toolbar" aria-label="Template actions">
                <div class="btn-group dropdown">
                    <button class="btn btn-default dropdown-toggle" type="button" id="locale-dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        {{ locale|locale }}
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="locale-dropdown">
                        {% for template_locale in template.enabledLocales %}
                            <li{% if template_locale == locale %} class="active"{% endif %}>
                                <a href="{{ path('admin_template_form_builder', { 'event': event.id, 'template': template.id, 'locale': template_locale }) }}">
                                    <span class="badge pull-right">{{ completeness[template_locale] is defined ? completeness[template_locale]|number_format(0) : '-' }}%</span>
                                    <span class="template-locale{% if template_locale == template.fallback %} template-fallback{% endif %}">{{ template_locale|locale }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <button
                    class="btn btn-success"
                    id="template-save-button"
                    data-loading-button="{{ ('<i class="glyphicon glyphicon-refresh spin"></i> ' ~ ('admin.template.action.updating'|trans))|e }}"
                >
                    {{ 'admin.template.action.save'|trans }}
                </button>
            </div>
            {{ include('AdminBundle::flashes.html.twig') }}
        </div>

        <button data-template-add-block class="btn btn-primary hide">
            {{ 'admin.template.form.addBlock'|trans }}
        </button>

        <div data-template-block class="hide">
            {{ include('AdminBundle:Template/Form:block.html.twig') }}
        </div>

        <div class="template-builder-body">
            <div class="template-container container-fluid block-inner">
                {% for uid, item in template.value|default([]) %}
                    {% if item.component == 'block' %}
                        {{ include('AdminBundle:Template/Form:block.html.twig', {
                            'uid': uid,
                            'children': item.children,
                            'config': item.config,
                            'locale': locale,
                            'fallback': template.fallback,
                            'nomenclatures': nomenclatures,
                            'templateTagView': templateTagView,
                            'uploadFormats': uploadFormats,
                            'enableVisibility': true
                        }, false) }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="template-builder-menu slide-menu-container-open" id="template-menu">
            <div class="template-builder-menu-wrapper">
                <div class="tab-content">
                    <div id="object-list" class="object-list">
                        {{ include('AdminBundle:Template/Object:text.html.twig', { 'locale': locale }, false) }}
                        {{ include('AdminBundle:Template/Object:editable-text.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:telephone.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:country.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:url.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:boolean.html.twig', {
                            'locale': locale,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:gender.html.twig', {
                            'locale': locale,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:upload.html.twig', {
                            'locale': locale,
                            'uploadFormats': uploadFormats|default([]),
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:nomenclature.html.twig', {
                            'isFormTemplate': true,
                            'locale': locale,
                            'nomenclatures': nomenclatures,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                        {{ include('AdminBundle:Template/Object:datetime.html.twig', {
                            'locale': locale,
                            'isFormTemplate': true,
                            'templateTagView': templateTagView,
                            'enableVisibility': true
                        }, false) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
