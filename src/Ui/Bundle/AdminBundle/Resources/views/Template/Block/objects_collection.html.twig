{% trans_default_domain 'templates' %}

{% set config = {
    style: null,
    label: { (locale): '' },
    maxItems: 10
}|merge(config|default({})) %}

<div class="block" data-block="objects_collection" data-uid="{{ uid|default('__UID__') }}" data-config="{{ config|json_encode }}">
    {# configure #}
    <div class="block-buttons">
        <ul class="list-unstyled">
            <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
            </li>
            <li>
                <button class="btn btn-link delete-button" data-confirmation-message="{{ 'template.block.remove_confirm'|trans }}">
                    <i class="glyphicon glyphicon-remove"></i>
                </button>
            </li>
            <li>
                <button class="btn btn-link configure-button">
                    <i class="glyphicon glyphicon-cog"></i>
                </button>
                <div class="modal fade configure-modal" tabindex="-1" role="dialog">
                    <form action="#" method="GET">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button
                                            type="button"
                                            class="close"
                                            data-dismiss="modal"
                                            aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                    <h4 class="modal-title">{{ 'template.block.configure.objects_collection.title'|trans }}</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="form-group">
                                        <label class="form-label">{{ 'template.block.configure.title'|trans }}</label>
                                        <input type="text" class="form-control" name="label" />
                                        {% if fallback|default(false) and locale != fallback and config.label[fallback] is defined %}
                                            <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                        {% endif %}
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">{{ 'template.block.configure.style'|trans }}</label>
                                        <select class="form-control" name="style" title="Style">
                                            <option value="style-1">Style 1</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">{{ 'template.block.configure.objects_collection.maxItems'|trans }}</label>
                                        <input type="number" class="form-control" name="maxItems" min="1" required />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button
                                            type="button"
                                            class="btn btn-default"
                                            data-dismiss="modal"
                                    >{{ 'template.action.close'|trans }}</button>
                                    <button
                                            type="button"
                                            class="btn btn-primary save-configuration"
                                    >{{ 'template.action.save'|trans }}</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </li>
        </ul>
    </div>
    {# /configure #}

    <div class="row">
        <div class="col-md-12">
            <div class="block-inner block-collection">
                {% for uid, item in children[0]|default([]) %}
                    {{ include('AdminBundle:Template/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', {
                        'uid': uid,
                        'config': item.config,
                        'children': item.children|default([]),
                        'locale': locale,
                        'fallback': fallback|default(false),
                        'nomenclatures': nomenclatures,
                        'sheet_tags': sheet_tags,
                        'products': products,
                        'sheet_template_tags': sheet_template_tags|default([]),
                        'uploadFormats': uploadFormats|default([]),
                    }, false) }}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
