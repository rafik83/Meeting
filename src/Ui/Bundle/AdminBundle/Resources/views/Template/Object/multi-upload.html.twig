{% trans_default_domain 'templates' %}

{% set config = {
    label: { (locale): 'template.object.multi-upload'|trans },
    required: false,
    help: { (locale): '' },
    tags: [],
    formats: [],
    titlePlaceholder: { (locale): '' },
    default: 3,
    max: 3
}|merge(config|default({})) %}

<div
    class="object"
    data-object="multi-upload"
    data-uid="{{ uid|default('__UID__') }}" data-config="{{ config|json_encode }}"
    data-upload-format-required-message="{{ 'template.registration.uploadFormatRequired'|trans }}"
>
    <ul class="block-buttons list-inline">
        <li class="object-title">{{ 'template.object.multi-upload'|trans }}</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <div class="modal fade configure-modal" tabindex="-1" role="dialog">
                <form action="#" method="GET">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title">{{ 'template.object.multi-upload'|trans }}</h4>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.label.title'|trans }}</label>
                                    <input class="form-control" type="text" name="label"/>
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.media.placeholder.title'|trans }}</label>
                                    <input class="form-control" type="text" name="titlePlaceholder" />
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.titlePlaceholder[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.media.default'|trans }}</label>
                                    <input class="form-control" type="number" name="default" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.media.max'|trans }}</label>
                                    <input class="form-control" type="number" name="max" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.upload.formats.title'|trans }}</label>
                                    <select class="form-control select2-builder" name="formats" title="Formats" multiple="multiple">
                                        {% for format in uploadFormats %}
                                            <option value="{{ format }}">{{ ('template.upload.formats.choice.' ~ format)|trans }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">
                                        <input type="checkbox" name="required" />
                                        {{ 'template.required.title'|trans }}
                                    </label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'template.action.close'|trans }}</button>
                                <button type="button" class="btn btn-primary save-configuration">{{ 'template.action.save'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </li>
    </ul>
    <div data-bind="label">{{ config.label[locale] }}</div>
</div>
