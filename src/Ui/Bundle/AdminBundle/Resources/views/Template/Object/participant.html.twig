{% set config = {
    label: { (locale): 'Participant' },
    numberOfParticipantShown: 1,
    style: ''
}|merge(config|default({})) %}

<div class="object" data-object="participant"{% if uid is defined %} data-uid="{{ uid }}"{% endif %} data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">Les participants</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <div class="modal fade configure-modal" tabindex="-1" role="dialog">
                <form action="#" method="GET">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title">Les participants</h4>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">Style</label>
                                    <select class="form-control" name="style" title="Style">
                                        <option value="style-1">Style 1</option>
                                        <option value="style-2">Style 2</option>
                                        <option value="style-3">Style 3</option>
                                    </select>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <label class="form-label">Label</label>
                                    <input class="form-control" type="text" name="label" />
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Nombre de participants affichés sur la fiche</label>
                                    <input class="form-control" type="number" name="numberOfParticipantShown" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
                                <button type="button" class="btn btn-primary save-configuration">Enregistrer</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </li>
    </ul>
    <div data-bind="participant">{{ config.label[locale] }}</div>
</div>
