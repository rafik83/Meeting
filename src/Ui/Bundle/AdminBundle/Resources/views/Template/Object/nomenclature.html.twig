{% trans_default_domain 'templates' %}

{% set nomenclature_mode = isFormTemplate is not defined ? 'checkboxes' : 'singles' %}

{% set config = {
    label: { (locale): 'template.object.nomenclature'|trans },
    help: { (locale): '' },
    nomenclature: '',
    mode: nomenclature_mode,
    visibility: 'editable',
    objective: 'none',
    style: '',
    required: false,
    tags: [],
}|merge(config|default({})) %}

<div class="object" data-object="nomenclature" data-uid="{{ uid|default('__UID__') }}" data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">{{ 'template.object.nomenclature'|trans }}</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <div class="modal fade configure-modal" tabindex="-1" role="dialog">
                <form action="#" method="GET">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title">{{ 'template.object.nomenclature'|trans }}</h4>
                            </div>
                            <div class="modal-body">
                                {% if isFormTemplate is not defined %}
                                    <div class="form-group">
                                        <label class="form-label">{{ 'template.style.title'|trans }}</label>
                                        <select class="form-control" name="style" title="Style">
                                            <option value="style-1">Style 1</option>
                                            <option value="style-2">Style 2</option>
                                            <option value="style-3">Style 3</option>
                                        </select>
                                    </div>
                                    <hr />
                                {% endif %}
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.label.title'|trans }}</label>
                                    <input class="form-control" type="text" name="label" />
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                    {% endif %}
                                </div>
                                {% if enableVisibility is defined and enableVisibility == true %}
                                    {{ include('@Admin/Template/Object/_fieldVisibility.html.twig') }}
                                {% endif %}
                                {% if isFormTemplate is not defined %}
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.help.title'|trans }}</label>
                                    <textarea class="form-control" name="help"></textarea>
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.help[fallback] }}</div>
                                    {% endif %}
                                </div>
                                {% endif %}
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.nomenclature.title'|trans }}</label>
                                    <select class="form-control" name="nomenclature">
                                        {% if nomenclatures is defined %}
                                            {% for nomenclature in nomenclatures %}
                                                <option value="{{ nomenclature.id }}">{{ nomenclature.title }}</option>
                                            {% endfor %}
                                        {% endif %}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.required.title'|trans }}</label>
                                    <input type="checkbox" name="required" />
                                </div>
                                <div class="form-group">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="mode" value="checkboxes">
                                            {{ 'template.nomenclature.choice.checkboxes'|trans }}
                                        </label>
                                    </div>
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="mode" value="singles">
                                            {{ 'template.nomenclature.choice.singles'|trans }}
                                        </label>
                                    </div>
                                </div>
                                {% if isFormTemplate is not defined %}
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.nomenclature.objective.title'|trans }}</label>
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="objective" value="none">
                                            {{ 'template.nomenclature.objective.none'|trans }}
                                        </label>
                                    </div>
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="objective" value="supply">
                                            {{ 'template.nomenclature.objective.supply'|trans }}
                                        </label>
                                    </div>
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="objective" value="need">
                                            {{ 'template.nomenclature.objective.need'|trans }}
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="tags">
                                        {{ 'template.sheet_template.tags'|trans }}
                                    </label>
                                    <select class="form-control select2-builder" name="tags" multiple="multiple">
                                        {% for tag in sheet_template_tags|default([]) %}
                                            <option value="{{ tag }}" {% if tag in config.tags %}selected="selected"{% endif %}>
                                                {{ ('template.tag.' ~ tag)|trans({}, 'templates') }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                {% endif %}
                                {% if isFormTemplate is defined and templateTagView is defined %}
                                    {{ include('AdminBundle:Template/Form:tagsSelect.html.twig', {
                                        'config': config,
                                        'templateTagView': templateTagView,
                                    }, false) }}
                                {% endif %}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'template.action.close'|trans }}</button>
                                <button type="button" class="btn btn-primary save-configuration">{{ 'template.action.save'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </li>
    </ul>
    <div data-bind="label">{{ config.label[locale] }}</div>
</div>
