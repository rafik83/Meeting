{% set config = {
label: { (locale): 'Nomenclature' },
help: { (locale): '' },
nomenclature: '',
}|merge(config|default({})) %}

<div class="object" data-object="nomenclature"{% if uid is defined %} data-uid="{{ uid }}"{% endif %} data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">Nomenclature</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <form action="#" method="GET" class="modal fade configure-modal" tabindex="-1" role="dialog" aria-labelledby="configure-modal-label">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="configure-modal-label">Nomenclature</h4>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">Label</label>
                                <input class="form-control" type="text" name="label" />
                                {% if fallback|default(false) and locale != fallback %}
                                    <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <label class="form-label">Aide</label>
                                <textarea class="form-control" name="help"></textarea>
                                {% if fallback|default(false) and locale != fallback %}
                                    <div class="help-block">{{ fallback|locale }} : {{ config.help[fallback] }}</div>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <label class="form-label">Nomenclature</label>
                                <select class="form-control" name="nomenclature">
                                    {% if nomenclatures is defined %}
                                        {% for nomenclature in nomenclatures %}
                                            <option value="{{ nomenclature.id }}">{{ nomenclature.label }}</option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary save-configuration">Enregistrer</button>
                        </div>
                    </div>
                </div>
            </form>
        </li>
    </ul>
    <div data-bind="label">{{ config.label[locale] }}</div>
</div>
