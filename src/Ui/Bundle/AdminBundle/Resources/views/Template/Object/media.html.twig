{% trans_default_domain 'templates' %}

{% set config = {
    'label': { (locale): 'template.object.media'|trans },
    'titlePlaceholder': { (locale): '' },
    'linkPlaceholder': { (locale): '' },
    'translatable': false,
    'max': 3,
    'default': 3,
    'products': []
}|merge(config|default({})) %}

<div class="object" data-object="media" data-uid="{{ uid|default('__UID__') }}" data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">{{ 'template.object.media'|trans }}</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <form action="#" method="GET" class="modal fade configure-modal" tabindex="-1" role="dialog" aria-labelledby="configure-modal-label">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="configure-modal-label">{{ 'template.object.media'|trans }}</h4>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">{{ 'template.label.title'|trans }}</label>
                                <input class="form-control" type="text" name="label" />
                                {% if fallback|default(false) and locale != fallback %}
                                    <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <label class="form-label">{{ 'template.media.placeholder.title'|trans }}</label>
                                <input class="form-control" type="text" name="titlePlaceholder" />
                                {% if fallback|default(false) and locale != fallback %}
                                    <div class="help-block">{{ fallback|locale }} : {{ config.titlePlaceholder[fallback] }}</div>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <label class="form-label">{{ 'template.media.placeholder.link'|trans }}</label>
                                <input class="form-control" type="text" name="linkPlaceholder" />
                                {% if fallback|default(false) and locale != fallback %}
                                    <div class="help-block">{{ fallback|locale }} : {{ config.linkPlaceholder[fallback] }}</div>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <label class="form-label">{{ 'template.translatable.title'|trans }}</label>
                                <input type="checkbox" name="translatable" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">{{ 'template.media.default'|trans }}</label>
                                <input class="form-control" type="number" name="default" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">{{ 'template.media.max'|trans }}</label>
                                <input class="form-control" type="number" name="max" />
                            </div>
                            {% if products is defined and products is not empty %}
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.products.title'|trans }}</label>
                                    <select class="form-control select2-builder" name="products" multiple="multiple">
                                        {% for product in products %}
                                            <option value="{{ product.id }}" {% if product.id in config.products %}selected="selected"{% endif %}>
                                                {{ product.name }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'template.action.close'|trans }}</button>
                            <button type="button" class="btn btn-primary save-configuration">{{ 'template.action.save'|trans }}</button>
                        </div>
                    </div>
                </div>
            </form>
        </li>
    </ul>
    <div data-bind="label">{{ config.label[locale] }}</div>
</div>
