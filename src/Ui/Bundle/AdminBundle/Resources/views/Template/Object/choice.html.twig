{% set config = {
    label: { (locale): 'Choix' },
    placeholder: { (locale): '' },
    type: null,
    required: false,
    choices: {}
}|merge(config|default({})) %}

<div class="object" data-object="choice"{% if uid is defined %} data-uid="{{ uid }}"{% endif %} data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">Choix</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <form action="#" method="GET" class="modal fade configure-modal" tabindex="-1" role="dialog">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title">Choix</h4>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">Label</label>
                                <input class="form-control" type="text" name="label" />
                                {% if fallback|default(false) and locale != fallback %}
                                    <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <label class="form-label">Type:</label><br>

                                <label>
                                    <input type="radio" name="type" value="select"> SELECT
                                </label><br>
                                <label>
                                    <input type="radio" name="type" value="radio"> RADIO
                                </label><br>
                                <label>
                                    <input type="radio" name="type" value="checkbox"> CHECKBOX
                                </label>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Placeholder</label>
                                <input type="text" class="form-control" name="placeholder">
                                {% if fallback|default(false) and locale != fallback %}
                                    <div class="help-block">{{ fallback|locale }} : {{ config.placeholder[fallback] }}</div>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <label class="form-label">Requis</label>
                                <input type="checkbox" name="required" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Choix</label>
                                <span>Split the choices with a coma ','</span>
                                <textarea class="form-control" name="choices"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary save-configuration">Enregistrer</button>
                        </div>
                    </div>
                </div>
            </form>
        </li>
    </ul>
    <div data-bind="choice">{{ config.label[locale] }}</div>
</div>
