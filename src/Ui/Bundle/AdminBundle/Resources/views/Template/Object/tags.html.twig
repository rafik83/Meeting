{% trans_default_domain 'templates' %}

{% set config = {
    label: { (locale): 'template.object.tags'|trans },
    placeholder: { (locale): '' },
    help: { (locale): '' },
    default: 1,
    collection: true,
    required: false,
    translatable: false,
    style: 'style-1',
    tags: []
}|merge(config|default({})) %}

<div class="object" data-object="tags" data-uid="{{ uid|default('__UID__') }}" data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">{{ 'template.object.tags'|trans }}</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <div class="modal fade configure-modal" tabindex="-1" role="dialog">
                <form action="#" method="GET">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title">{{ 'template.object.tags'|trans }}</h4>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.style.title'|trans }}</label>
                                    <select class="form-control" name="style" title="Style">
                                        <option value="style-1">Style 1</option>
                                        <option value="style-2">Style 2</option>
                                        <option value="style-3">Style 3</option>
                                    </select>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.label.title'|trans }}</label>
                                    <input class="form-control" type="text" name="label" />
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.placeholder.title'|trans }}</label>
                                    <textarea class="form-control" name="placeholder"></textarea>
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.placeholder[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.help.title'|trans }}</label>
                                    <textarea class="form-control" name="help"></textarea>
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.help[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox" name="collection"> {{ 'template.collection.title'|trans }}
                                    </label>
                                </div>
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox" name="required" /> {{ 'template.required.title'|trans }}
                                    </label>
                                </div>
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox" name="translatable" /> {{ 'template.translatable.title'|trans }}
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.defaultElement.title'|trans }}</label>
                                    <input class="form-control" type="number" step="1" name="default" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.tags.title'|trans }}</label>
                                    <fieldset
                                        id="tags-{{ uid|default('__UID__') }}"
                                        data-collection-bind="__TAGS__"
                                        data-collection-add="tags-add-{{ uid|default('__UID__') }}"
                                        data-collection-delete="tags-delete-{{ uid|default('__UID__') }}"
                                        data-prototype="{{ include('AdminBundle:Template:tags_select.html.twig', {
                                            'sheet_tags': sheet_tags,
                                            'uid': uid|default('__UID__'),
                                            'locale': locale,
                                            'label': true
                                        }, false)|e }}"
                                    >
                                        {% for tag in config.tags %}
                                            {{ include('AdminBundle:Template:tags_select.html.twig', {
                                                'sheet_tags': sheet_tags,
                                                'uid': uid|default('__UID__'),
                                                'locale': locale,
                                                'fallback': fallback,
                                                'index': loop.index0,
                                                'tag': tag,
                                                'label': true
                                            }, false) }}
                                        {% endfor %}
                                    </fieldset>
                                    <button type="button" id="tags-add-{{ uid|default('__UID__') }}" class="btn btn-success btn-sm">+</button>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'template.action.close'|trans }}</button>
                                <button type="button" class="btn btn-primary save-configuration">{{ 'template.action.save'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </li>
    </ul>
    <div data-bind="label">{{ config.label[locale] }}</div>
</div>
