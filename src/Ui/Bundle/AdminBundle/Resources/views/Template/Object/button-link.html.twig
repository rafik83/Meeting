{% trans_default_domain 'templates' %}

{% set config = {
    label: { (locale): 'Lien' },
    help: { (locale): '' },
    required: false,
    style: ''
}|merge(config|default({})) %}

<div class="object" data-object="button-link" data-uid="{{ uid|default('__UID__') }}" data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">{{ 'template.object.button-link'|trans }}</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <div class="modal fade configure-modal" tabindex="-1" role="dialog">
                <form action="#" method="GET">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title">{{ 'template.object.button-link'|trans }}</h4>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.style.title'|trans }}</label>
                                    <select class="form-control" name="style" title="Style">
                                        <option value="default" selected="selected">{{ 'template.style.default'|trans }}</option>
                                    </select>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.label.title'|trans }}</label>
                                    <input class="form-control" type="text" name="label" />
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.help.title'|trans }}</label>
                                    <textarea class="form-control" name="help"></textarea>
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.help[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.required.title'|trans }}</label>
                                    <input type="checkbox" name="required" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'template.action.close'|trans }}</button>
                                <button type="button" class="btn btn-primary save-configuration">{{ 'template.action.save'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </li>
    </ul>
    <div>
        <a href="#" class="btn btn-primary" data-bind="link">{{ config.label[locale] }}</a>
    </div>
</div>
