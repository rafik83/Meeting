{% trans_default_domain 'templates' %}

{% set config = {
    label: { (locale): 'template.object.editable-text'|trans },
    placeholder: { (locale): '' },
    hideLabel: false,
    help: { (locale): '' },
    maxLength: null,
    required: false,
    type: 'title',
    style: '',
    visibility: 'editable',
    translatable: false,
    tag: null,
    tags: [],
}|merge(config|default({})) %}

<div class="object" data-object="editable-text" data-uid="{{ uid|default('__UID__') }}" data-config="{{ config|json_encode }}">
    <ul class="block-buttons list-inline">
        <li class="object-title">{{ 'template.object.editable-text'|trans }}</li>
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <div class="modal fade configure-modal" tabindex="-1" role="dialog">
                <form action="#" method="GET">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title">{{ 'template.object.editable-text'|trans }}</h4>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.style.title'|trans }}</label>
                                    <select class="form-control" name="style" title="Style">
                                        <option value="default" selected="selected">{{ 'template.style.default'|trans }}</option>
                                    </select>
                                </div>
                                <hr />
                                {% if enableVisibility is defined and enableVisibility == true %}
                                    {{ include('@Admin/Template/Object/_fieldVisibility.html.twig') }}
                                {% endif %}
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.label.title'|trans }}</label>
                                    <input class="form-control" type="text" name="label" />
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.label[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.placeholder.title'|trans }}</label>
                                    <textarea class="form-control" name="placeholder"></textarea>
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.placeholder[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.help.title'|trans }}</label>
                                    <textarea class="form-control" name="help"></textarea>
                                    {% if fallback|default(false) and locale != fallback %}
                                        <div class="help-block">{{ fallback|locale }} : {{ config.help[fallback] }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">
                                        <input type="checkbox" name="required" />
                                        {{ 'template.required.title'|trans }}
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">
                                        <input type="checkbox" name="translatable" />
                                        {{ 'template.translatable.title'|trans }}
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.maxLength.title'|trans }}</label>
                                    <input class="form-control" type="number" step="1" name="maxLength" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">
                                        <input type="checkbox" name="hideLabel"/>
                                        {{ 'template.hideLabel.title'|trans }}
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">{{ 'template.type.title'|trans }}</label>
                                    <select class="form-control" name="type">
                                        {% if isFormTemplate is defined %}
                                            {% set types = { 'Textarea': 'textarea', 'Texte': 'text' } %}
                                        {% else %}
                                            {% set types = { 'Title': 'title', 'Texte': 'text' } %}
                                        {% endif %}
                                        {% for label, value in types %}
                                            <option value="{{ value }}">{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                {% if isFormTemplate is defined and templateTagView is defined %}
                                    {{ include('AdminBundle:Template/Form:tagsSelect.html.twig', {
                                        'config': config,
                                        'templateTagView': templateTagView,
                                    }, false) }}
                                {% else %}
                                    <div class="form-group">
                                        <label class="form-label">{{ 'template.object.tag'|trans }}</label>
                                        <select class="form-control" name="tag">
                                            <option value=""></option>
                                            {% for tag in sheet_tags %}
                                                <option value="{{ tag }}">{{ ('template.tag.' ~ tag)|trans }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="tags">
                                            {{ 'template.sheet_template.tags'|trans }}
                                        </label>
                                        <select class="form-control select2-builder" name="tags" multiple="multiple">
                                            {% for tag in sheet_template_tags|default([]) %}
                                                <option value="{{ tag }}" {% if tag in config.tags %}selected="selected"{% endif %}>
                                                    {{ ('template.tag.' ~ tag)|trans({}, 'templates') }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'template.action.close'|trans }}</button>
                                <button type="button" class="btn btn-primary save-configuration">{{ 'template.action.save'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </li>
    </ul>
    <div data-bind="label">{{ config.label[locale] }}</div>
</div>
