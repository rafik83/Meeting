@import "bootstrap-sass/assets/stylesheets/bootstrap";

$bg-body-color: #FFFFFF;
$bg-container-color: #E8E8E9;
$bg-container-darkened-color: #D8D8D8;
$bg-success-color: #67BB1F;
$bg-fail-color: #FF4902;
$gradient-text-color: #FFFFFF;
$color-primary: #2F2F2F;
$color-notification: #FF4902;
$button-text-color: #FFFFFF;
$button-bg-color-inactive: rgba(#FFFFFF, .15);
$button-bg-color-inactive-hover: rgba(#FFFFFF, .3);

$gradient-left-color: {{ gradientLeftColor }};
$gradient-right-color: {{ gradientRightColor }};
$color-high-lighted: {{ colorHighLighted }};

@import "{{ guideline_path }}/base/mixins";
@import "{{ guideline_path }}/base/fonts";
@import "{{ guideline_path }}/base/layout";
@import "{{ guideline_path }}/base/responsive";

@import "{{ guideline_path }}/generic/links";
@import "{{ guideline_path }}/generic/titles";
@import "{{ guideline_path }}/generic/lists";
@import "{{ guideline_path }}/generic/buttons";
@import "{{ guideline_path }}/generic/form";

@import "{{ guideline_path }}/objects/header";
@import "{{ guideline_path }}/objects/section";
@import "{{ guideline_path }}/objects/tabs";
@import "{{ guideline_path }}/objects/profile";

.required:after {
content: '*';
}

.btn-np {
padding: 0px;
}

.notification-not-read {
font-weight: bold;
}
