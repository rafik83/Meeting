$bg-body-color: #FFFFFF;
$bg-container-color: #E8E8E9;
$bg-container-darkened-color: #D8D8D8;
$bg-success-color: #67BB1F;
$bg-fail-color: #FF4902;
$gradient-text-color: #FFFFFF;
$color-primary: #2F2F2F;
$color-notification: #FF4902;
$button-text-color: #FFFFFF;
$button-bg-color-inactive: rgba(#FFFFFF, .15);
$button-bg-color-inactive-hover: rgba(#FFFFFF, .3);
$gray-base: #000 !default;
$gray-light: lighten($gray-base, 46.7%) !default; // #777
$gray-lighter: lighten($gray-base, 93.5%) !default; // #eee

$image-path: '{{ imagePath }}';
$gradient-header-button-left-color: {{ gradientHeaderButtonLeftColor }};
$gradient-header-button-right-color: {{ gradientHeaderButtonRightColor }};
$gradient-header-button-text-color: {{ gradientHeaderButtonTextColor }};
$gradient-header-left-color: {{ gradientHeaderLeftColor }};
$gradient-header-right-color: {{ gradientHeaderRightColor }};
$gradient-left-color: {{ gradientLeftColor }};
$gradient-right-color: {{ gradientRightColor }};
$color-highlighted: {{ colorHighLighted }};

@import "base/mixins";
@import "base/layout";

@import "generic/links";
@import "generic/lists";
@import "generic/buttons";
@import "generic/form";
@import "generic/modals";

@import "blocks/style";

@import "objects/chat";
@import "objects/header";
@import "objects/section";
@import "objects/tabs";
@import "objects/profile";
@import "objects/carousel";
@import "objects/choice";
@import "objects/collection";
@import "objects/editable-text";
@import "objects/image";
@import "objects/video";
@import "objects/media";
@import "objects/nomenclature";
@import "objects/tag";
@import "objects/text";
@import "objects/product";
@import "objects/tunnel-step";
@import "objects/catalog";
@import "objects/videoConferenceQuestions";
@import "objects/videoConferencePolls";
@import "objects/videoConferenceSidebarLoading";

.text-highlighted {
  color: $color-highlighted;
}

.bg-highlighted {
  background-color: $color-highlighted !important;
}

body {
  background: {% if backgroundImage %}url("{{ backgroundImage }}") no-repeat fixed center{% endif %} {{ backgroundColor }};
}
