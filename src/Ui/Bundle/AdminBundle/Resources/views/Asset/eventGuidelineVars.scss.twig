.text-highlighted {
  color: $color-highlighted;
}

.bg-highlighted {
  background-color: $color-highlighted !important;
}

body {
  background: {% if backgroundImage %}url("{{ backgroundImage }}") no-repeat fixed center{% endif %} {{ backgroundColor }};
}
