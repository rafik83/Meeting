{% extends 'AdminBundle::base.html.twig' %}
{% from 'AdminBundle::macro.html.twig' import delete_button %}
{% block title 'admin.operator_list.title'|trans %}

{% block content %}
    <h2>{{ 'admin.operator_list.title'|trans }}</h2>
    <div class="col-xs-12">
        {{ form_start(filter_form) }}
        <div class="col-xs-4">
            {{ form_row(filter_form.event) }}
        </div>
        <div class="col-xs-4">
            {{ form_row(filter_form.submit) }}
            {% if filtered %}
                <a href="{{ path('admin_list_operator') }}" class="btn btn-link">{{ 'admin.operator_list.filter.empty_filter'|trans }}</a>
            {% endif %}
        </div>
        {{ form_rest(filter_form) }}
        {{ form_end(filter_form) }}
    </div>
    {% if  is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
        <div class="col-xs-12">
            <a href="{{ path('admin_create_operator') }}" class="btn btn-primary">{{ 'admin.operator_list.action.create'|trans }}</a>
            <a href="{{ path('admin_create_partner') }}" class="btn btn-primary">{{ 'admin.operator_list.action.create.partner'|trans }}</a>
        </div>
    {% endif %}
    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.operator_list.table.title.lastname'|trans }}</th>
            <th>{{ 'admin.operator_list.table.title.firstname'|trans }}</th>
            <th>{{ 'admin.operator_list.table.title.email'|trans }}</th>
            <th>{{ 'admin.operator_list.table.title.lastLoginAt'|trans }}</th>
            <th>{{ 'admin.operator_list.table.title.events'|trans }}</th>
            <th>{{ 'admin.operator_list.table.title.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for operator in operatorList.operatorViews %}
            <tr>
                <td>{{ operator.lastName }}</td>
                <td>{{ operator.firstName }}</td>
                <td>{{ operator.email }}</td>
                <td>
                    {% if operator.hasNeverLoggedIn %}
                        {{ 'admin.operator_list.column.lastLoginAt.never'|trans }}
                    {% else %}
                        {{ operator.lastLoginAt|localizeddate('medium', 'short', app.request.locale) }}
                    {% endif %}
                </td>
                <td>
                    <ul>
                        {% for eventTitle in operator.events %}
                            <li>{{ eventTitle }}</li>
                        {% endfor %}
                    </ul>
                </td>
                <td>
                    {% if operator.isPartner %}
                        <a class="btn btn-default" href="{{ path('admin_update_partner', {
                            'partner': operator.id
                        }) }}">{{ 'admin.operator_list.table.content.update'|trans }}</a>
                    {% else %}
                        <a class="btn btn-default" href="{{ path('admin_update_operator', {'operator': operator.id}) }}">{{ 'admin.operator_list.table.content.update'|trans }}</a>
                    {% endif %}
                    {{ delete_button(
                        path('admin_delete_admin', {'admin': operator.id, 'type': 'operator'}),
                        'admin.remove'|trans,
                        {
                            'class' : 'btn btn-danger btn-sm',
                            'data-confirm': 'admin.remove.confirmation'|trans
                        },
                        constant('Proximum\\Vimeet\\Domain\\Intention\\IntentionType::INTENTION_REMOVE_ADMIN')
                    ) }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
