{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.messaging.message.create.title'|trans %}

{% block form_title 'admin.messaging.message.create.title'|trans %}

{% block form_content %}
    {{ form_row(form.name) }}
    {{ form_row(form.subject) }}
    {{ form_row(form.content) }}
{% endblock %}

{% block goback_link path('admin_messaging_message_list', {event: event.id}) %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/tinymce/tinymce.js') }}"></script>
    <script src="{{ asset('assets/js/pages/messaging-message-tinymce.js') }}"></script>
{% endblock %}
