{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.messaging.campaign.message.title'|trans %}

{% block content %}

    <h1 class="page-header">{{ 'admin.messaging.campaign.message.title'|trans }}</h1>

    <div class="row">
        <div class="col-md-5 well">
            <form method="post">
                {{ form_row(form.message, {'label': false}) }}
                {{ form_rest(form) }}
            </form>
        </div>
        <div class="col-md-7">
            <h2>{{ 'admin.messaging.campaign.message_preview.title'|trans }}</h2>
            <p class="text-warning" id="no_preview_text">{{ 'admin.messaging.campaign.no_message_preview'|trans }}</p>
            <iframe id="message_preview_iframe" src="about:blank" style="display:none; width:610px; height: 600px; border: none;"></iframe>
        </div>
    </div>

{% endblock %}
