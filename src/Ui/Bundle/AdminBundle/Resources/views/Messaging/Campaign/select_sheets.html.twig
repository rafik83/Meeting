{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.messaging.campaign.sheet_list.title'|trans %}

{% block content %}

    <h1 class="page-header">{{ 'admin.messaging.campaign.sheet_list.title'|trans }} ({{ sheets|length }})</h1>

    <div class="row">

        {% if filters_summary|length %}
            <div class="col-md-12 well">
                {{ include('AdminBundle:Common:filters_summary.html.twig', {
                    filters:   filters_summary,
                    resetLink: path('admin_messaging_campaign_select_sheets', { 'event': event.id })
                }) }}
            </div>
        {% endif %}

    </div>

    <div class="row">

        <div class="col-md-6">
            {% if sheets|length %}
                {{ form_start(create_campaign_form, { 'attr': { 'data-batch': true } }) }}
                    {{ form_errors(create_campaign_form.sheetIds) }}
                    <div class="col-md-6">
                        {{ form_widget(create_campaign_form.name, { 'label': false, 'attr': {'placeholder': 'form.sheet.messaging_campaign.create.name.label'|trans({}, 'forms')} }) }}
                    </div>
                    <div class="col-md-6">
                        <input type="submit" value="{{ 'form.sheet.messaging_campaign.create.submit.label'|trans({}, 'forms') }}" class="btn btn-primary"/>
                    </div>

                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th><input type="checkbox" data-batch-all="tbody input[type=checkbox]" title="{{ 'admin.check-all'|trans }}" /></th>
                                <th>{{ 'admin.messaging.campaign.sheet_list.columns.name'|trans }}</th>
                                <th>{{ 'admin.messaging.campaign.sheet_list.columns.ownerEmail'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for sheet in sheets %}
                                <tr>
                                    <td>{{ form_widget(create_campaign_form.sheetIds[sheet.id]) }}</td>
                                    <td>{{ sheet.name }}</td>
                                    <td>{{ sheet.ownerEmail }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <input type="submit" value="{{ 'form.sheet.messaging_campaign.create.submit.label'|trans({}, 'forms') }}" class="btn btn-primary"/>
                {{ form_end(create_campaign_form) }}
            {% else %}
                <p class="text-warning">{{ 'admin.messaging.campaign.sheet_list.no_data'|trans }}</p>
            {% endif %}

        </div>

        <div class="col-md-6 well">
            {{ form_start(filter_form) }}
                <div class="filter-form">
                    <div class="col-md-12">
                        <input type="hidden" name="rules" id="rules"/>
                        <div id="builder"
                             data-locale="{{ locale }}"
                             data-rules="{{ rules }}"
                             data-filters="{{ filters|json_encode }}">
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="pull-right">
                            <button type="submit" class="btn btn-primary" id="submit-rules">{{ 'admin.filter'|trans }}</button>
                        </div>
                    </div>
                </div>
                {{ form_row(filter_form.country) }}
                {{ form_row(filter_form.validationState, {'inline': true}) }}
                {{ form_row(filter_form.state, {'inline': true}) }}
                {{ form_row(filter_form.completed, {'inline': true}) }}
                {{ form_row(filter_form.inCatalog, {'inline': true}) }}
                {{ form_row(filter_form.cancelAttendance, {'inline': true}) }}
                {{ form_row(filter_form.hasGroup, {'inline': true}) }}
                {{ form_row(filter_form.hasSpot, {'inline': true}) }}
                {{ form_row(filter_form.type) }}

                {% if filter_form.categories is defined %}
                    {{ form_row(filter_form.categories) }}
                {% endif %}

                {{ form_row(filter_form.follower) }}
                {{ form_row(filter_form.commercialStatus) }}
                {{ form_row(filter_form.registeredAt, {'inline': true}) }}
                {{ form_row(filter_form.imported) }}
                {{ form_row(filter_form.hasHappeningParticipation) }}

                <hr>

                {{ form_row(filter_form.hasRemainingToPay, {'inline': true}) }}
                {{ form_row(filter_form.order_status, {'inline': true}) }}
                {{ form_row(filter_form.has_cart, {'inline': true}) }}
                {{ form_row(filter_form.hasInvoice, {'inline': true}) }}

                <hr>

                {{ form_row(filter_form.hasScheduledMeeting, {'inline': true}) }}
                {{ form_row(filter_form.agendaConfirmedStatus) }}
                {{ form_row(filter_form.phoneValidationStatus) }}
                {{ form_row(filter_form.availabilityConfirmationStatus) }}
                {{ form_row(filter_form.hasPendingMeetingPropositions, {'inline': true}) }}
                {{ form_row(filter_form.hasNoMeetingRequest, {'inline': true}) }}
                {{ form_row(filter_form.reminderDate) }}

                {% if filter_form.boolean_filters is defined %}
                    <hr>
                    {% for boolean_filter in filter_form.boolean_filters.children %}
                        {{ form_row(boolean_filter, {'inline': true}) }}
                    {% endfor %}
                {% endif %}

                <div class="form-group">
                    <div class="col-sm-offset-3 col-sm-9">{{ form_widget(filter_form.submit) }}</div>
                </div>
            {{ form_end(filter_form) }}
        </div>

    </div>

{% endblock %}
