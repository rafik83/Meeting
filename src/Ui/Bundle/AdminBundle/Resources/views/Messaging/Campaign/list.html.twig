{% extends 'AdminBundle::base.html.twig' %}

{% block content %}

    <h1 class="page-header">{{ 'admin.messaging.campaign.list.title'|trans }}</h1>

    {% if campaigns|length %}

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{ 'admin.messaging.campaign.list.columns.title'|trans }}</th>
                    <th>{{ 'admin.messaging.campaign.list.columns.createdAt'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for campaign in campaigns %}
                    <tr>
                        <td>{{ campaign.title }}</td>
                        <td>{{ campaign.createdAt|localizeddate('medium', 'short', app.request.locale) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    {% else %}

        <p class="text-warning">{{ 'admin.messaging.campaign.list.no_data'|trans }}</p>

    {% endif %}

{% endblock %}
