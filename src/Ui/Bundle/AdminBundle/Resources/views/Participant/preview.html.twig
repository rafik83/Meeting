<div class="user clearfix">
    <div class="user__avatar">
        <span class="bullet"></span>

        <div class="avatar">
            {% if participant.avatar != null %}
                <img {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %} src="{{ participant.avatar|imagine_filter('user_avatar') }}" alt="{{ participant.initials }} avatar">
            {% else %}
                <p {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %}>{{ participant.initials }}</p>
            {% endif %}
        </div>
    </div>
    <div class="user__infos">
        <p class="name">{{ participant.firstname|capitalize }} {{ participant.lastname|upper }}</p>
        <p class="job">{{ participant.position }}</p>
    </div>
</div>

