{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.tip.list.title'|trans }}</h1>

    <a href="{{ path('admin_tip_create') }}" class="btn btn-primary">{{ 'admin.tip.create.link'|trans }}</a>

    {% if tipListView.results is not empty %}
        <table class="table table-hover">
            <thead>
            <tr>
                <th class="col-md-4">{{ 'admin.tip.column.title'|trans }}</th>
                <th class="col-md-2">{{ 'admin.tip.column.translation'|trans }}</th>
                <th class="col-md-3">{{ 'admin.tip.visible'|trans }}</th>
                <th class="col-md-3">{{ 'admin.tip.events'|trans }}</th>
            </tr>
            </thead>
                <tbody>
                {% for tip in tipListView.results %}
                    <tr>
                        <td>{{ tip.title }}</td>
                        <td>
                            {% for translation in tip.translations %}
                                <span>
                                    {{ translation.locale|locale|capitalize }}{{ not loop.last ? ', ' : '' }}
                                </span>
                            {% endfor %}
                        </td>
                        <td>
                            {% for page in tip.pagesTranslations %}
                                {{ page|trans }}{{ not loop.last ? ', ' : '' }}
                            {% endfor %}
                        </td>
                        <td>
                            <ul>
                                {% for event in tip.unduplicatedEvents %}
                                    <li>
                                        {{ event.title }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                        <td class="text-right">
                            <div class="btn-group">
                                <a class="btn btn-default btn-sm" href="{{ path('admin_tip_update', {'tip': tip.id}) }}">
                                    {{ 'admin.tip.update.link'|trans }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info">
                <p class="center">{{ 'admin.tip.empty'|trans }}</p>
            </div>
        {% endif %}

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': tipListView.results }) }}
{% endblock %}
