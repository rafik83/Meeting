{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.tip.list.title'|trans }}</h1>

    <a href="{{ path('admin_tip_create') }}" class="btn btn-primary">{{ 'admin.tip.create.link'|trans }}</a>

    {% if tips.results is not empty %}
        <table class="table table-hover">
            <thead>
            <tr>
                <th>{{ 'admin.tip.column.title'|trans }}</th>
                <th>{{ 'admin.tip.column.translation'|trans }}</th>
                <th>{{ 'admin.tip.column.visible.meeting_management'|trans }}</th>
                <th>{{ 'admin.tip.column.visible.catalog'|trans }}</th>
                <th>{{ 'admin.tip.column.visible.print_planning'|trans }}</th>
                <th></th>
            </tr>
            </thead>
                <tbody>
                {% for tip in tips.results %}
                    <tr>
                        <td>{{ tip.title }}</td>
                        <td>
                            <table class="table">
                                <tr>
                                    <th>{{ 'admin.tip.column.locale'|trans }}</th>
                                    <th>{{ 'admin.tip.column.content'|trans }}</th>
                                </tr>
                                {% for translation in tip.translations %}
                                <tr>
                                    <td>{{ translation.locale }}</td>
                                    {% if translation.content|length > 100 %}
                                        <td>{{ translation.content|slice(0, 100) ~ '...' }}</td>
                                    {% else %}
                                        <td>{{ translation.content }}</td>
                                    {% endif %}
                                </tr>
                                {% endfor %}
                            </table>
                        </td>
                        <td>{{ tip.isOnMeetingManagement ? 'admin.tip.visible'|trans : 'admin.tip.invisible'|trans }}</td>
                        <td>{{ tip.isOnCatalog ? 'admin.tip.visible'|trans : 'admin.tip.invisible'|trans }}</td>
                        <td>{{ tip.isOnPrintPlanning ? 'admin.tip.visible'|trans : 'admin.tip.invisible'|trans  }}</td>
                        <td class="text-right">
                            <div class="btn-group">
                                <a class="btn btn-default btn-sm" href="{{ path('admin_tip_update', {'tip': tip.id}) }}">
                                    {{ 'admin.tip.update.link'|trans }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info">
                <p class="center">{{ 'admin.tip.empty'|trans }}</p>
            </div>
        {% endif %}

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': tips.results }) }}
{% endblock %}
