{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.tip.event.affect.title'|trans %}

{% block form_title 'admin.tip.event.affect.form.title'|trans %}

{% block form_content %}

    {% if form.tipViews is defined %}
        {{ form_row(form.tipViews) }}
    {% endif %}

    <div class="form-group">
        <label for="tip_title" class="col-md-3 control-label">
            {{ 'form.tip_event_affect.children.title.label'|trans({}, 'forms') }}
        </label>
        <div class="col-md-9">
            <input id="tip_title" value="" class="form-control" disabled>
        </div>
    </div>

    <div class="form-group">
        <label for="tip_content" class="col-md-3 control-label">
            {{ 'form.tip_event_affect.children.content.label'|trans({}, 'forms') }}
        </label>
        <div class="col-md-9">
            <input id="tip_content" value="" class="form-control" disabled>
        </div>
    </div>

    {% if form.typeViews is defined %}
        {{ form_row(form.typeViews) }}
    {% endif %}

{% endblock %}

{% block goback_link path('admin_tip_event_list', {event: event.id}) %}
