{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.tip.event.affect.form.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.tip.event.affect.form.title'|trans }}</h1>
    <div class="row">
        <div class="col-md-6">
            {{ form_start(form, { 'attr': { 'class': 'with-submit-section' } }) }}
            {{ form_errors(form) }}
            {{ form_row(form.tip) }}
            {{ form_row(form.types) }}
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="tip_title" class="col-md-3 control-label">
                    {{ 'form.tip_event_affect.children.preview.label'|trans({}, 'forms') }}
                </label>
                <div class="col-md-9">
                    <div class="well" id="tip_preview"></div>
                </div>
            </div>
            <div class="form-group">
                <label for="tip_pages" class="col-md-3 control-label">
                    {{ 'form.tip_event_affect.children.pages.label'|trans({}, 'forms') }}
                </label>
                <div class="col-md-9">
                    <div class="well" id="tip_pages"></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
