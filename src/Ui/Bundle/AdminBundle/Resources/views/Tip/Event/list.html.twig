{% extends '@Admin/base.html.twig' %}

{% from 'AdminBundle::macro.html.twig' import delete_button %}

{% block title '[' ~ event.title ~ '] ' ~  'admin.tip.list.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.tip.list.title'|trans }}</h1>
    <a href="{{ path('admin_tip_event_affect', { 'event': event.id }) }}" class="btn btn-primary">
        {{ 'admin.tip.event.affect.link'|trans }}
    </a>
    <a href="{{ path('admin_tip_event_create', {'event': event.id}) }}" class="btn btn-success">
        {{ 'admin.tip.event.create.button'|trans }}
    </a>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>{{ 'admin.tip.event.title'|trans }}</th>
                <th>{{ 'admin.tip.event.types'|trans }}</th>
                <th>{{ 'admin.tip.event.pages'|trans }}</th>
                <th class="text-right">{{ 'admin.tip.event.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for tip in tipListView.results %}
                <tr>
                    <td>{{ tip.title }}</td>
                    <td>
                        <ul>
                            {% for type in tip.types %}
                                <li>{{ type.title(locale) }}</li>
                            {% else %}
                                <li>{{ 'admin.tip.event.no_types'|trans }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        <ul>
                            {% for page in tip.PagesTranslations %}
                                <li>{{ page|trans }}</li>
                            {% else %}
                                <li>{{ 'admin.tip.event.no_pages'|trans }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td class="text-right">
                        <a href="{{ path('admin_tip_event_update', {'event': event.id, 'tip': tip.id }) }}"
                            class="btn btn-default"
                        >
                            {{ 'admin.tip.event.update.button'|trans }}
                        </a>
                        {{ delete_button(
                            path('admin_tip_event_remove', {'event': event.id, 'tip': tip.id}),
                            'admin.tip.event.remove.link'|trans,
                            {'class' : 'btn btn-danger', 'data-confirm': 'admin.tip.event.remove.action.confirm'|trans})
                        }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">
                        {{ 'admin.tip.event.empty'|trans }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': tipListView.results }) }}
{% endblock %}
