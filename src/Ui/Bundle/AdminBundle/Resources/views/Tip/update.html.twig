{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block form_title 'admin.tip.update.title'|trans %}

{% block form_content %}
    {{ form_row(form.title) }}
    {{ form_row(form.onCatalog) }}
    {{ form_row(form.onMeetingManagement) }}
    {{ form_row(form.onPrintPlanning) }}
    {{ form_row(form.translations) }}
{% endblock form_content %}

{% block goback_link path('admin_tip_list') %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/tinymce/tinymce.js') }}"></script>
    <script src="{{ asset('assets/js/tip/tip.js') }}"></script>
{% endblock %}
