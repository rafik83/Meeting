{% if planning.tipTranslationViews is defined and planning.tipTranslationViews is not empty %}
    {% for translation in planning.tipTranslationViews %}
        <div class="tip-message">
            <p>{{ translation.title }}</p>
            <p>{{ translation.content|html }}</p>
        </div>
    {% endfor %}
{% endif %}
<div class="participant-name">
    <h1>{{ planning.sheetTitle }} {% if planning.spotReference is not null %} - {{ planning.spotReference }}{% endif %}</h1>
    <h2>{{ planning.participantName }}</h2>
</div>
<div class="planning">
    {{ planning.planning|html }}
</div>
