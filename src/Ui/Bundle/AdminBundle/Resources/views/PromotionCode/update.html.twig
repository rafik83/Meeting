{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.promotion_code.update'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.promotion_code.update'|trans }} : {{ promotion_code.title }}</h1>

    {{ form_start(form, { 'attr': { 'class': 'with-submit-section' } }) }}
        {{ form_errors(form) }}

        {% for name, child in form.children if name != 'submit' %}
            {{ form_row(child) }}
        {% endfor %}

        <div class="form-group submit-section">
            <div class="col-sm-3">
                <a href="{{ path('admin_promotion_code_list', { 'event': event.id }) }}" class="btn btn-link">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                    {{ 'admin.goback.link'|trans }}
                </a>
            </div>
            <div class="col-sm-9 text-right">
                {{ form_row(form.submit) }}
            </div>
        </div>

    {{ form_end(form) }}

{% endblock %}
