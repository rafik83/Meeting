{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ promotion_code.title }}</h1>

    {{ form_start(update_form) }}
        {{ form_errors(update_form) }}

        {% for name, child in update_form.children if name != 'submit' %}
            {{ form_row(child) }}
        {% endfor %}

        <div class="form-group submit-section">
            <div class="col-sm-3">
                <a href="{{ path('admin_promotion_code_list', { 'event': event.id }) }}" class="btn btn-link">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                    {{ 'admin.goback.link'|trans }}
                </a>
            </div>
            <div class="col-sm-9 text-right">
                {{ form_row(update_form.submit) }}
            </div>
        </div>

    {{ form_end(update_form) }}

{% endblock %}
