{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.promotion_code.title'|trans }}</h1>

    <p>
        <button class="btn btn-success" data-toggle="modal" data-target="#create-modal">{{ 'admin.promotion_code.new'|trans }}</button>
    </p>

    <div class="modal fade" id="create-modal" tabindex="-1" role="dialog">
        {{ form_start(create_form) }}
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">{{ 'admin.promotion_code.new'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_row(create_form.title) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.promotion_code.action.close'|trans }}</button>
                        {{ form_widget(create_form.submit) }}
                    </div>
                </div>
            </div>
        {{ form_end(create_form) }}
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.promotion_code.table.column.title'|trans }}</th>
            <th>{{ 'admin.promotion_code.table.column.stock'|trans }}</th>
            <th>{{ 'admin.promotion_code.table.column.validUntil'|trans }}</th>
            <th class="text-right">{{ 'admin.promotion_code.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for promotion_code in promotion_codes %}
            <tr>
                <td>{{ promotion_code.title }}</td>
                <td>{{ promotion_code.stock }}</td>
                <td>{{ promotion_code.validUntil|localizeddate('medium', 'short', app.request.locale) }}</td>
                <td class="text-right">
                    <a href="{{ path('admin_promotion_code_update', { 'event': event.id, 'promotionCode': promotion_code.id }) }}" class="btn btn-primary btn-sm">{{ 'admin.promotion_code.table.action.edit'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center">
                    {{ 'admin.promotion_code.table.no_result'|trans }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
