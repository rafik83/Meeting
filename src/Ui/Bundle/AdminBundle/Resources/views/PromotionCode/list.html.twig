{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.promotion_code.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.promotion_code.title'|trans }}</h1>

    <p>
        <a href="{{ path('admin_promotion_code_create', { 'event': event.id }) }}"
           class="btn btn-info">{{ 'admin.promotion_code.new'|trans }}</a>

        <a href="{{ path('admin_promotion_code_batch_create', { 'event': event.id }) }}"
           class="btn btn-default">{{ 'admin.promotion_code.batch.new'|trans }}</a>
    </p>

    <ul class="nav nav-tabs">
        <li role="presentation" class="active"><a href="#">{{ 'admin.promotion_code.subtitle.code'|trans }}</a></li>
        <li role="presentation"><a href="{{ path('admin_promotion_code_batch_list', { event: event.id }) }}">{{ 'admin.promotion_code.subtitle.batch'|trans }}</a></li>
    </ul>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.promotion_code.table.column.title'|trans }}</th>
            <th>{{ 'admin.promotion_code.table.column.code'|trans }}</th>
            <th>{{ 'admin.promotion_code.table.column.stock'|trans }}</th>
            <th>{{ 'admin.promotion_code.table.column.validUntil'|trans }}</th>
            <th class="text-right">{{ 'admin.promotion_code.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for promotion_code in promotion_codes %}
            <tr>
                <td>{{ promotion_code.title }}</td>
                <td>{{ promotion_code.code }}</td>
                <td>{{ promotion_code.stock }}</td>
                <td>
                    {% if promotion_code.validUntil is not null %}
                        {{ promotion_code.validUntil|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
                    {% endif %}
                </td>
                <td class="text-right">
                    <a href="{{ path('admin_promotion_code_update', { 'event': event.id, 'promotionCode': promotion_code.id }) }}"
                       class="btn btn-primary btn-sm">{{ 'admin.promotion_code.table.action.edit'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">
                    {{ 'admin.promotion_code.table.no_result'|trans }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
