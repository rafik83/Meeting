{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <div>
        <h1 class="page-header">{{ ('gender.' ~ user.account.gender)|trans }} {{ user.account.completeName }}
            - {{ user.account.position }}</h1>
        <div class="col-md-4">
            {% if user.account.avatar is not empty %}
                    <img src="{{ user.account.avatar|imagine_filter('user_avatar') }}">
            {% endif %}
            <div>
                <div class="coordinates">
                    <h4>{{ 'admin.user.contact-information'|trans }} :</h4>
                    <ul>
                        {% if user.account.zipCode is not empty and user.account.address is not empty %}
                            <li>
                                <i class="glyphicon glyphicon-home"></i>
                                {{ user.account.address }}, {{ user.account.zipCode }}
                            </li>
                        {% endif %}
                        <li><i class="glyphicon glyphicon-envelope"></i> {{ user.email }}</li>
                        <li><i class="glyphicon glyphicon-earphone"></i> {{ user.account.phone }}</li>
                        <li><i class="glyphicon glyphicon-phone"></i> {{ user.account.mobile }}</li>
                        {% if user.account.website is not empty %}
                            <li>{{ user.account.website }}</li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            <div class="coordinates">
                <h4>{{ 'admin.user.company-information'|trans }}:</h4>
                <ul>
                    <li>{{ user.account.company }}</li>
                    <li>{{ user.account.companyAddress }}</li>
                    <li>{{ user.account.companyZipCode }} - {{ user.account.companyCity }}
                        , {{ user.account.companyCountry }}</li>
                    <li>{{ user.account.companyWebsite }}</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="form-group submit-section">
        <div class="col-sm-3">
            <a href="{{ path('admin_users', {'event': event.id}) }}" class="btn btn-link">
                <span class="glyphicon glyphicon-arrow-left"></span>
                {{ 'admin.goback.link'|trans }}
            </a>
        </div>
    </div>
{% endblock %}
