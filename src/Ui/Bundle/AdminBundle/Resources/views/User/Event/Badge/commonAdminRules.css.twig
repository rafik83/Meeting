body {
    margin: 0;
    padding: 0;
    font-family: 'Roboto', sans-serif;
}

.page {
    page-break-after: always;
    clear: both;
    position: relative;
}

.badge {
    width: 50%;
    height: 50%;
    margin: 0;
    padding: 0;
    position: relative;
}

.text {
    margin: 0 5mm;
}

.badge-content {
    margin: 0 auto;
}

.badge-content .company-participant {
    height: 15mm;
    overflow: hidden;
    color: #2F2F2F;
    font-size: 24px;
    margin: 0;
    font-weight: 700;
    position: absolute;
    top: 32mm;
    text-align: center;
    width: 100%;
}

.badge-content .qrcode {
    font-size: 16px;
    text-align: center;
    top: 50mm;
    position: absolute;
    width: 100%;
    color: #555555;
}

.badge-content .qrcode-border {
    border: solid 1px #ddd;
    margin: 0 auto;
    width: 34mm;
    padding: 2mm;
}

.badge-content .qrcode img {
    height: 30mm;
    width: 30mm;
}

.badge-content .info-participant {
    max-height: 28mm;
    height: 26mm;
    margin: 0;
    position: absolute;
    top: 94mm;
    overflow: hidden;
    text-align: center;
    width: 100%;
}

.badge-content .info-participant .name-participant {
    color: #2F2F2F;
    font-size: 20px;
    font-weight: 400;
    margin: 0;
    max-height: 14mm;
    overflow: hidden;
}

.badge-content .info-participant .name-participant .last-name-participant {
    text-transform: uppercase;
}

.badge-content .info-participant .position-participant {
    color: #1518E7;
    font-size: 20px;
    font-weight: 700;
    max-height: 21mm;
    overflow: hidden;
    text-align: center;
    width: 100%;
}

.type-participant {
    color: #2F2F2F;
    font-size: 24px;
    font-weight: 400;
    text-transform: uppercase;
    position: absolute;
    top: 133mm;
    text-align: center;
    width: 100%;
}

.badge-planning .badge-planning-content ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
}

.text-center {
    margin: 0 auto;
    text-align: center;
}

.company-zone-without-qrcode {
    top: 36mm !important;
}

.participant-zone-without-qrcode {
    margin-top: -27mm !important;
    max-height: 42mm !important;
    height: 42mm !important;
}

.text-participant-without-qrcode {
    font-size: 24px !important;
    max-height: 21mm !important;
}

