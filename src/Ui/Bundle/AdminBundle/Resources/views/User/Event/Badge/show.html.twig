<html>
<head>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Roboto', sans-serif;
        }

        .page {
            page-break-after: always;
            clear: both;
            position: relative;
        }

        .badge {
            width: 50%;
            height: 50%;
            margin: 0;
            padding: 0;
            position: relative;
        }

        .text {
            margin: 0 5mm;
        }

        .badge-content {
            margin: 0 auto;
        }

        .badge-content .company-participant {
            height: 15mm;
            overflow: hidden;
            color: #2F2F2F;
            font-size: 24px;
            margin: 0;
            font-weight: 700;
            position: absolute;
            top: 32mm;
            text-align: center;
            width: 100%;
        }

        .badge-content .qrcode {
            font-size: 16px;
            text-align: center;
            top: 50mm;
            position: absolute;
            width: 100%;
            color: #555555;
        }

        .badge-content .qrcode-border {
            border: solid 1px #ddd;
            margin: 0 auto;
            width: 34mm;
            padding: 2mm;
        }

        .badge-content .qrcode img {
            height: 30mm;
            width: 30mm;
        }

        .badge-content .info-participant {
            max-height: 28mm;
            height: 26mm;
            margin: 0;
            position: absolute;
            top: 94mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .badge-content .info-participant .name-participant {
            color: #2F2F2F;
            font-size: 20px;
            font-weight: 400;
            margin: 0;
            max-height: 14mm;
            overflow: hidden;
        }

        .badge-content .info-participant .name-participant .last-name-participant {
            text-transform: uppercase;
        }

        .badge-content .info-participant .position-participant {
            color: #1518E7;
            font-size: 20px;
            font-weight: 700;
            max-height: 21mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .type-participant {
            color: #2F2F2F;
            font-size: 24px;
            font-weight: 400;
            text-transform: uppercase;
            position: absolute;
            top: 133mm;
            text-align: center;
            width: 100%;
        }

        .badge-planning .badge-planning-content ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
        }

        .text-center {
            margin: 0 auto;
            text-align: center;
        }

        .company-zone-without-qrcode {
            top: 36mm !important;
        }

        .participant-zone-without-qrcode {
            margin-top: -27mm !important;
            max-height: 42mm !important;
            height: 42mm !important;
        }

        .text-participant-without-qrcode {
            font-size: 24px !important;
            max-height: 21mm !important;
        }

        .badge-planning {
            width: 50%;
            margin-left: 50%;
            margin-top: -71%;
            padding: 0;
            position: relative;
        }

        .badge-planning .badge-planning-content {
            margin: 15px;
            margin-left: 25px;
            font-size: 9pt;
        }

        .quarterSection-container {
            clear: both;
            width: 105mm;
            height: 148mm;
        }

        .halfXSection-container {
            page-break-after: always;
            clear: both;
            width: 105mm;
            height: 297mm;
        }

        .quarterSection {
            position: relative;
            width: 98mm;
            height: 141mm;
            margin: 0;
        }

        .halfXSection {
            position: relative;
            width: 98mm;
            height: 297mm;
            margin: 0;
        }

        .quarterSection-container--upRight {
            position: absolute;
            left: 105mm;
            top: 0;
        }

        .quarterSection-container--upRight .quarterSection {
            margin-left: 7mm;
        }

        .quarterSection-container--downLeft {
            position: absolute;
            top: 148mm;
        }

        .quarterSection-container--downLeft .quarterSection {
            margin-top: 7mm;
        }

        .quarterSection-container--downRight {
            position: absolute;
            left: 105mm;
            top: 148mm;
        }

        .quarterSection-container--downRight .quarterSection {
            margin-top: 7mm;
            margin-left: 7mm;
        }

        .halfXSection-container--right {
            position: absolute;
            left: 105mm;
            top: 0;
        }

        .halfXSection-container--right .halfXSection {
            margin-left: 7mm;
        }

        .badge-image {
            max-width: 100%;
            max-height: 100%;
            margin: 0 auto;
            text-align: center;
            display: block;
        }

        .badge-image--logo {
            max-height: 44mm;
        }

        .printZone-fix {
            width: 210mm;
            height: 297mm;
            position: absolute;
        }
    </style>
</head>

<body>
    <div class="printZone-fix"></div>
    {% include '@Admin/User/Event/Badge/content.html.twig' with {
        'userBadgeByEventView' : userBadgeAndPlanningByEventView.userBadgeByEventView,
        'planning': userBadgeAndPlanningByEventView.planning
    } %}
    <script>
        window.print();
        window.close();
    </script>
</body>
</html>
