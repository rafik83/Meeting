<html>
<head>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Roboto', sans-serif;
        }

        .page {
            page-break-after: always;
            clear: both;
        }

        .badge {
            width: 50%;
            height: 50%;
            margin: 0;
            padding: 0;
            position: relative;
        }

        .badge-planning {
            width: 50%;
            margin-left: 50%;
            margin-top: -71%;
            padding: 0;
            position: relative;
        }

        .badge .badge-content {
            margin: 0 auto;
        }

        .badge-planning .badge-planning-content {
            margin: 15px;
            margin-left: 25px;
            font-size: 9pt;
        }

        .text {
            margin: 0 5mm;
        }

        .badge .badge-content .company-participant {
            height: 15mm;
            overflow: hidden;
            color: #2F2F2F;
            font-size: 24px;
            margin: 0;
            font-weight: 700;
            position: absolute;
            top: 32mm;
            text-align: center;
            width: 100%;
        }

        .badge .badge-content .qrcode {
            font-size: 16px;
            text-align: center;
            top: 50mm;
            position: absolute;
            width: 100%;
            color: #555555;
        }

        .badge .badge-content .qrcode-border {
            border: solid 1px #ddd;
            margin: 0 auto;
            width: 34mm;
            padding: 2mm;
        }

        .badge .badge-content .qrcode img {
            height: 30mm;
            width: 30mm;
        }

        .badge .badge-content .info-participant {
            max-height: 28mm;
            height: 26mm;
            margin: 0;
            position: absolute;
            top: 94mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .badge .badge-content .info-participant .name-participant {
            color: #2F2F2F;
            font-size: 20px;
            font-weight: 400;
            margin: 0;
            max-height: 14mm;
            overflow: hidden;
        }

        .badge .badge-content .info-participant .name-participant .last-name-participant {
            text-transform: uppercase;
        }

        .badge .badge-content .info-participant .position-participant {
            color: #1518E7;
            font-size: 20px;
            font-weight: 700;
            max-height: 21mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .badge .type-participant {
            color: #2F2F2F;
            font-size: 24px;
            font-weight: 400;
            text-transform: uppercase;
            position: absolute;
            top: 133mm;
            text-align: center;
            width: 100%;
        }

        .badge-planning .badge-planning-content ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
        }

        .text-center {
            margin: 0 auto;
            text-align: center;
        }

        .company-zone-without-qrcode {
            top: 36mm !important;
        }

        .participant-zone-without-qrcode {
            margin-top: -27mm !important;
            max-height: 42mm !important;
            height: 42mm !important;
        }

        .text-participant-without-qrcode {
            font-size: 24px !important;
            max-height: 21mm !important;
        }
    </style>
</head>

<body>
    <div class="page">
        <div class="badge">
            <div class="badge-content">
                <div class="company-participant {% if not userBadgeAndPlanningByEventView.userBadgeByEventView.qrCodeIdentifier %}company-zone-without-qrcode{% endif %}">
                    <div class="text">{{ userBadgeAndPlanningByEventView.userBadgeByEventView.sheetTitle }}</div>
                </div>

                {% if userBadgeAndPlanningByEventView.userBadgeByEventView.qrCodeIdentifier %}
                    <div class="qrcode">
                        <div class="qrcode-border">
                            <img src="{{ userBadgeAndPlanningByEventView.userBadgeByEventView.qrCodeImage }}"/><br>
                            ID {{ userBadgeAndPlanningByEventView.userBadgeByEventView.qrCodeIdentifier }}<br>
                        </div>
                    </div>
                {% endif %}

                <div class="info-participant {% if not userBadgeAndPlanningByEventView.userBadgeByEventView.qrCodeIdentifier %}participant-zone-without-qrcode{% endif %}">
                    <div class="name-participant {% if not userBadgeAndPlanningByEventView.userBadgeByEventView.qrCodeIdentifier %}text-participant-without-qrcode{% endif %}">
                        <div class="text">
                            {{ userBadgeAndPlanningByEventView.userBadgeByEventView.firstName }}
                            <span class="last-name-participant">{{ userBadgeAndPlanningByEventView.userBadgeByEventView.lastName }}</span>
                        </div>
                    </div>

                    <div class="position-participant {% if not userBadgeAndPlanningByEventView.userBadgeByEventView.qrCodeIdentifier %}text-participant-without-qrcode{% endif %}">
                        <div class="text">
                            {{ userBadgeAndPlanningByEventView.userBadgeByEventView.position }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="type-participant">
                {% if userBadgeAndPlanningByEventView.userBadgeByEventView.participationTypeOrCategoryLabel %}
                    {{ userBadgeAndPlanningByEventView.userBadgeByEventView.participationTypeOrCategoryLabel }}<br>
                {% endif %}
            </div>
        </div>

        <div class="badge-planning">
            <div class="badge-planning-content">
                <div class="text-center">
                    <b>PLANNING</b>
                </div>
                {{ userBadgeAndPlanningByEventView.planning|markdown_to_html }}
            </div>
        </div>
    </div>

    <script>
        window.print();
        window.close();
    </script>
</body>
</html>
