<div class="page">
    <div class="badge">
        <div class="badge-content">
            <div class="company-participant {% if not userBadgeByEventView.qrCodeIdentifier %}company-zone-without-qrcode{% endif %}">
                <div class="text">{{ userBadgeByEventView.sheetTitle }}</div>
            </div>

            {% if userBadgeByEventView.qrCodeIdentifier %}
                <div class="qrcode">
                    <div class="qrcode-border">
                        <img src="{{ userBadgeByEventView.qrCodeImage }}"/><br>
                        ID {{ userBadgeByEventView.qrCodeIdentifier }}<br>
                    </div>
                </div>
            {% endif %}

            <div class="info-participant {% if not userBadgeByEventView.qrCodeIdentifier %}participant-zone-without-qrcode{% endif %}">
                <div class="name-participant {% if not userBadgeByEventView.qrCodeIdentifier %}text-participant-without-qrcode{% endif %}">
                    <div class="text">
                        {{ userBadgeByEventView.firstName }}
                        <span class="last-name-participant">{{ userBadgeByEventView.lastName }}</span>
                    </div>
                </div>

                <div class="position-participant {% if not userBadgeByEventView.qrCodeIdentifier %}text-participant-without-qrcode{% endif %}">
                    <div class="text">
                        {{ userBadgeByEventView.position }}
                        {% if userBadgeByEventView.country %}
                            <br/>{{ userBadgeByEventView.country|upper }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="type-participant">
            {% if userBadgeByEventView.participationTypeOrCategoryLabel %}
                {{ userBadgeByEventView.participationTypeOrCategoryLabel }}<br>
            {% endif %}
        </div>
    </div>

    {% if planning is not empty %}
        <div class="badge-planning">
            <div class="badge-planning-content">
                <div class="text-center">
                    <b>PLANNING</b>
                </div>
                {{ planning|markdown_to_html }}
            </div>
        </div>
    {% endif %}
</div>
