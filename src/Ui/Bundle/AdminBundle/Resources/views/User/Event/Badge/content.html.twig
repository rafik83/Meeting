{% import '@Admin/User/Event/Badge/macros.html.twig' as macro -%}

<div class="page">
{{ macro.write_badge(userBadgeByEventView, 'left') }}
{% if userBadgeByEventView.isMirrored %}
    {{ macro.write_badge(userBadgeByEventView, 'right') }}
{% endif %}
{% if userBadgeByEventView.leftImage %}
    {{ macro.write_image(userBadgeByEventView.leftImage, 'left') }}
{% endif %}
{% if userBadgeByEventView.rightImage %}
    {{ macro.write_image(userBadgeByEventView.rightImage, 'right', userBadgeByEventView.isRightImageFullHeight) }}
{% endif %}

{% if planning is not empty and not userBadgeByEventView.rightImage and not userBadgeByEventView.isMirrored%}
    <div class="badge-planning">
        <div class="badge-planning-content">
            <div class="text-center">
                <b>PLANNING</b>
            </div>
            {{ planning|markdown_to_html }}
        </div>
    </div>
{% endif %}
</div>
