{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.users.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.users.title'|trans }}</h1>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ 'admin.users.id'|trans }}</th>
            <th>{{ 'admin.users.email'|trans }}</th>
            <th>{{ 'admin.users.lastName'|trans }}</th>
            <th>{{ 'admin.users.firstName'|trans }}</th>
            <th>{{ 'admin.users.locale'|trans }}</th>
            <th>{{ 'admin.sheet.title'|trans }}</th>
            <th>{{ 'admin.sheet.type'|trans }}</th>
            <th>{{ 'admin.sheet.category'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for userEventListView in userEventListViews %}
            {% set rowSpanValue = userEventListView.userEventSheetsListViews|length %}
            <tr>
                <td rowspan="{{ rowSpanValue }}">{{ userEventListView.userId }}</td>
                <td rowspan="{{ rowSpanValue }}"><a href="{{ path('admin_users_details', {'event': event.id, 'user': userEventListView.userId }) }}">{{ userEventListView.email }}</a></td>
                <td rowspan="{{ rowSpanValue }}">{{ userEventListView.lastName }}</td>
                <td rowspan="{{ rowSpanValue }}">{{ userEventListView.firstName }}</td>
                <td rowspan="{{ rowSpanValue }}">{{ userEventListView.locale|language }}</td>

                {% for userEventSheetsListView in userEventListView.userEventSheetsListViews %}
                    {% if not loop.first %}<tr>{% endif %}
                        <td>
                            <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': userEventSheetsListView.id }) }}">{{ userEventSheetsListView.title }}</a>

                            {% if userEventSheetsListView.isOwner %}
                                <span class="label label-default">{{ 'admin.sheet.isOwner'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{{ userEventSheetsListView.typeTitle }}</td>
                        <td>{{ userEventSheetsListView.categoriesTitle }}</td>
                    {% if not loop.first %}</tr>{% endif %}
                {% endfor %}
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-danger">{{ 'admin.zero-result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
