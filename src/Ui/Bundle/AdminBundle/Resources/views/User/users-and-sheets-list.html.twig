{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.users.title'|trans %}

{% block content %}
    {% set users = userEventListViews.paginatedResult %}
    <h1 class="page-header">{{ users.total }} {{ 'admin.users.title'|trans }}</h1>

    <div class="row">
        <form class="filter-form" method="get">
            <div class="col-md-12">
                <input type="hidden" name="rules" id="rules"/>
                <div id="builder"
                     data-locale="{{ locale }}"
                     data-rules="{{ rules }}"
                     data-filters="{{ filters|json_encode }}">
                </div>
            </div>
            <div class="col-md-12">
                <div class="pull-right">
                    <a class="btn btn-link" href="{{ path('admin_users_list', {'event': event.id, 'reset': 1 }) }}">{{ 'admin.filters.reset'|trans }}</a>
                    <button type="submit" class="btn btn-primary" id="submit-rules">{{ 'admin.filter'|trans }}</button>
                </div>
            </div>
        </form>
    </div>
    <br/>
    {{ include('AdminBundle:Paginator:paginate.html.twig', { 'paginator': users }) }}

    {% set usersLimit = (users.results|length < users.limit) ? users.results|length : users.limit %}
    {{ form_start(batchForm, { 'attr': { 'data-batch': true, 'data-page-items': usersLimit }}) }}
    {{ form_errors(batchForm) }}

    <div class="row filters">
        <div class="col-md-4">
            {% embed 'AdminBundle:Common:batch.html.twig' %}
                {% block actions %}
                    <li>
                        <a href="#" data-toggle="modal" data-target="#sendMail">
                            {{ 'admin.users.batch.sendMail'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="#" data-toggle="modal" data-target="#exportFormTemplate">
                            {{ 'admin.users.batch.exportFormTemplate'|trans }}
                        </a>
                    </li>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    <div id="batch-selection-helper" class="batch-helper alert alert-info text-center hide no-select" role="alert" data-page-items="{{ usersLimit }}" data-all-items="{{ users.total }}">
        <p>
            <span class="batch-helper-message"
                  data-all-selected-label="{{ 'admin.user.batch.allSelected.label'|trans({'%users%': users.total})|html }}"
                  data-page-selected-label="{{ 'admin.user.batch.selection.label'|trans({'%users%': usersLimit})|html }}">
                {{ 'admin.user.batch.selection.label'|trans({'%users%': usersLimit})|html }}
            </span>
            <span id="batch-select-all" class="batch-helper-select-all"
                  data-is-select-all-enabled="{{ users.total > users.limit ? 1 : 0 }}"
                  data-all-label="{{ 'admin.user.batch.selectionAll.label'|trans({'%allUsers%': users.total})|html }}"
                  data-cancel-label="{{ 'admin.user.batch.cancelSelection.label'|trans }}">
                {% if users.total > users.limit %}
                    {{ 'admin.user.batch.selectionAll.label'|trans({'%allUsers%': users.total})|html }}
                {% endif %}
            </span>
        </p>
    </div>

    {% if users.total > 0 %}
        <table class="table table-hover">
            <thead>
            <tr>
                <th class="minwidth">
                    <input type="checkbox" data-batch-all="tbody input[type=checkbox]" title="{{ 'admin.check-all'|trans }}"/>
                </th>
                <th>{{ 'admin.users.id'|trans }}</th>
                <th>{{ 'admin.users.user'|trans }}</th>
                <th>{{ 'admin.users.locale'|trans }}</th>
                <th>{{ 'admin.sheet.title'|trans }}</th>

                {% if userEventListViews.eventHasCategories %}
                    <th>{{ 'admin.sheet.category'|trans }}</th>
                {% endif %}

                <th>{{ 'admin.sheet.type'|trans }}</th>
                <th>{{ 'admin.sheet.validationState'|trans }}</th>
                <th>{{ 'admin.sheet.state'|trans }}</th>
                <th>{{ 'admin.sheet.follower'|trans }}</th>
                <th>{{ 'admin.sheet.commercialStatus'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for userEventListView in users.results %}
                {% set rowSpanValue = userEventListView.userEventSheetsListViews|length %}
                <tr>
                    <td rowspan="{{ rowSpanValue }}">
                        {{ form_widget(batchForm.ids[userEventListView.userId], { 'attr': { 'title': userEventListView.lastName } }) }}
                    </td>
                    <td rowspan="{{ rowSpanValue }}">
                        <small><a href="{{ path('admin_users_details', {'event': event.id, 'user': userEventListView.userId }) }}" target="_blank">{{ userEventListView.userId }}</a></small>
                    </td>
                    <td rowspan="{{ rowSpanValue }}" nowrap>
                        <strong>{{ userEventListView.lastName }}</strong> {{ userEventListView.firstName }}

                        {% if userEventListView.isVisio %}
                            <span class="label {{ userEventListView.visioTested ? 'label-success' : 'label-info' }}">
                                <i class="glyphicon glyphicon glyphicon-facetime-video" data-toggle="tooltip" data-placement="top" title="{{ ('admin.sheet.user.' ~ (userEventListView.visioTested ? 'test_performed' : 'test_not_performed'))|trans }}"></i>
                            </span>
                        {% endif %}

                        <br>

                        <small>
                            <a href="mailto:{{ userEventListView.email }}">{{ userEventListView.email }}</a>
                        </small>
                    </td>

                    <td rowspan="{{ rowSpanValue }}">{{ userEventListView.locale|language }}</td>

                    {% for userEventSheetListView in userEventListView.userEventSheetsListViews %}
                        {% if not loop.first %}<tr>{% endif %}
                            <td>
                                <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': userEventSheetListView.id }) }}" target="_blank">{{ userEventSheetListView.title }}</a>

                                {% if not userEventSheetListView.isEnabled %}
                                    <span class="label label-danger">{{ 'admin.sheet.disable'|trans }}</span>
                                {% endif %}

                                {% if userEventSheetListView.hasGroup %}
                                    <span class="label label-success">
                                        <i class="glyphicon glyphicon-duplicate" data-toggle="tooltip" data-placement="top" title="{{ userEventSheetListView.groupTitle }}"></i>
                                    </span>
                                {% endif %}

                                {% if not userEventSheetListView.attend %}
                                    <span class="label label-danger">{{ 'event.sheet.attend.cancel'|trans }}</span>
                                {% endif %}

                                {% if userEventSheetListView.isOwner %}
                                    <span class="label label-default">{{ 'admin.sheet.isOwner'|trans }}</span>
                                {% endif %}
                            </td>

                            {% if userEventListViews.eventHasCategories %}
                                <td>{{ userEventSheetListView.categoriesTitle }}</td>
                            {% endif %}

                            <td>{{ userEventSheetListView.typeTitle }}</td>

                            <td>
                                {{ macro.state_label(
                                    ('event.sheet.validationState.' ~ userEventSheetListView.validationState)|trans,
                                    userEventSheetListView.validationState,
                                    {
                                        'draft': 'default',
                                        'pending': 'warning',
                                        'validated': 'success'
                                    }
                                ) }}
                                <div class="progress progress-completeness" data-toggle="tooltip" title="{{ 'form.sheet_filter.children.completed.label'|trans({}, 'forms') }}">
                                    <div class="progress-bar progress-bar-{{ userEventSheetListView.completenessStatus }}" role="progressbar" aria-valuenow="{{ userEventSheetListView.completeness }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ userEventSheetListView.completeness }}%;">
                                        {{ userEventSheetListView.completeness }}%
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div>
                                    {{ macro.state_label(
                                        ('event.sheet.state.' ~ userEventSheetListView.state)|trans,
                                        userEventSheetListView.state,
                                        {
                                            'pending': 'default',
                                            'accepted': 'warning',
                                            'validated': 'success',
                                            'refused': 'danger',
                                        }
                                    ) }}
                                </div>
                                {% if userEventSheetListView.isInCatalog %}
                                    <div class="label label-info">
                                        {{ 'admin.sheet.inCatalog'|trans }}
                                    </div>
                                {% endif %}
                            </td>

                            <td>{{ userEventSheetListView.followerName }}</td>

                            <td>
                                {% if userEventSheetListView.commercialStatus %}
                                    <div class="label label-{{ userEventSheetListView.commercialStatusLabel }}">
                                        {{ ('admin.sheet.details.crm.record.trace.set_commercial_status.' ~ userEventSheetListView.commercialStatus)|trans }}
                                    </div>
                                {% endif %}
                            </td>
                        {% if not loop.first %}</tr>{% endif %}
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="text-danger">{{ 'admin.zero-result'|trans }}</div>
    {% endif %}

    <div class="modal fade" tabindex="-1" role="dialog" id="sendMail">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">{{ 'admin.users.batch.sendMail'|trans }}</h4>
                </div>
                <div class="modal-body">
                    {{ form_row(batchForm.campaignTitle) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.cancel'|trans }}</button>
                    {{ form_widget(batchForm.sendMail) }}
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" tabindex="-1" role="dialog" id="exportFormTemplate">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">{{ 'admin.users.batch.exportFormTemplate'|trans }}</h4>
                </div>
                <div class="modal-body">
                    {{ form_row(batchForm.formTemplate) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.cancel'|trans }}</button>
                    {{ form_widget(batchForm.exportFormTemplate) }}
                </div>
            </div>
        </div>
    </div>
    {{ form_end(batchForm) }}

    {{ include('AdminBundle:Paginator:paginate.html.twig', { 'paginator': users }) }}
{% endblock %}
