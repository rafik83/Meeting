{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.users.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.users.title'|trans }}</h1>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ 'admin.users.id'|trans }}</th>
            <th>{{ 'admin.users.email'|trans }}</th>
            <th>{{ 'admin.users.lastName'|trans }}</th>
            <th>{{ 'admin.users.firstName'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for userEventView in userEventViews %}
            <tr>
                <td>{{ userEventView.userId }}</td>
                <td><a href="{{ path('admin_users_details', {'event': event.id, 'user': userEventView.userId }) }}">{{ userEventView.email }}</a></td>
                <td>{{ userEventView.lastName }}</td>
                <td>{{ userEventView.firstName }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-danger">{{ 'admin.zero-result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
