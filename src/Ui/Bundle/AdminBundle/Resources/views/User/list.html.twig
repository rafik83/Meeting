{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <h1 class="page-header">Liste des utilisateurs</h1>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ 'admin.users.type'|trans }}</th>
            <th>{{ 'admin.users.email'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for user in users.results %}
            <tr>
                <td>
                {% for type in user.types %}
                    {{ type.getTitle(locale) }}
                {% endfor %}
                </td>
                <td>{{ user.email }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': users}) }}
{% endblock %}
