{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.users.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ paginatedResult.total }} {{ 'admin.users.title'|trans }}</h1>

    <div class="row filters">
        <div class="col-md-offset-4 col-md-4">
            {{ form_start(filter_part_form) }}

            <div class="input-group col-md-12">
                {{ form_widget(filter_part_form.text) }}
            </div>

            {{ form_end(filter_part_form) }}
        </div>
    </div>

    <div class="row filters">
        <div class="col-md-4 col-md-offset-4">
            {{ include('AdminBundle:Common:filters_summary.html.twig', {
                filters:   filters_summary,
                resetLink: path('admin_users', { 'event': event.id })
            }) }}
        </div>
    </div>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ macro.choice_as_dropdown(filter_form.type) }}</th>
            <th>{{ 'admin.users.email'|trans }}</th>
            <th>{{ 'admin.users.lastName'|trans }}</th>
            <th>{{ 'admin.users.firstName'|trans }}</th>
            <th class="text-right">{{ macro.choice_as_dropdown(filter_form.participation, false, true, false, false) }}</th>
        </tr>
        </thead>
        <tbody>
        {% for userListView in paginatedResult %}
            <tr>
                <td>{{ userListView.typeTitle }}</td>
                <td><a href="mailto:{{ userListView.email }}">{{ userListView.email }}</a></td>
                <td>{{ userListView.lastName }}</td>
                <td>{{ userListView.firstName }}</td>
                <td class="text-right">
                    {% if userListView.sheetId %}
                        <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': userListView.sheetId }) }}" class="btn btn-default btn-sm">{{ 'admin.users.see-sheet'|trans }}</a>
                    {% endif %}
                    <a href="{{ path('admin_users_details', {'event': event.id, 'user': userListView.userId }) }}" class="btn btn-default btn-sm">{{ 'admin.users.details'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-danger">{{ 'admin.zero-result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': paginatedResult}) }}
{% endblock %}
