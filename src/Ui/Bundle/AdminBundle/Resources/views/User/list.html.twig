{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <h1 class="page-header">Liste des utilisateurs</h1>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ macro.choice_as_dropdown(filter_form.type) }}</th>
            <th>{{ 'admin.users.email'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for result in users.results %}
            <tr>
                <td>
                    {{ result.type.getTitle(locale) }}
                </td>
                <td>{{ result.user.email }}</td>
                <td><a href="{{ path('admin_users_details', {'event': event.id, 'user': result.user.id }) }}">{{ 'admin.users.details'|trans }}</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': users}) }}
{% endblock %}
