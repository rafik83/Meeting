{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    {% set locale = event.availableLocale(app.request.locale) %}
    <h1 class="page-header">{{ 'admin.users.title'|trans }}</h1>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ macro.choice_as_dropdown(filter_form.type) }}</th>
            <th>{{ 'admin.users.email'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for userEvent in userEvents %}
            <tr>
                <td>
                    {{ userEvent.type.getTitle(locale) }}
                </td>
                <td>{{ userEvent.user.email }}</td>
                <td><a href="{{ path('admin_users_details', {'event': event.id, 'user': userEvent.user.id }) }}">{{ 'admin.users.details'|trans }}</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': userEvents}) }}
{% endblock %}
