{% extends 'AdminBundle::base.html.twig' %}

{% from 'AdminBundle::macro.html.twig' import delete_button %}

{% block title 'admin.linked_sheets.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.linked_sheets.title'|trans }}
    </h1>

    <div>
        <a href="{{ path('admin_linked_sheets_create', {'event': event.id}) }}" class="btn btn-primary new-action">
            {{ 'admin.linked_sheets.create'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>{{ 'admin.linked_sheets.column.sheets'|trans }}</th>
                <th>{{ 'admin.linked_sheets.column.created_at'|trans }}</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
        {% for linkedSheetsView in linkedSheetsListView.linkedSheetsView %}
            <tr>
                <td>
                    <ul>
                        {% for sheetTitle in linkedSheetsView.titles %}
                            <li>
                                {{ sheetTitle }}
                            </li>
                        {% endfor %}
                    </ul>
                </td>
                <td>{{ linkedSheetsView.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                <td>
                    {% if linkedSheetsView.isRemovable %}
                        {{ delete_button(
                            path('admin_linked_sheets_delete', {'event': event.id, 'linkedSheets': linkedSheetsView.id}),
                            'admin.linked_sheets.delete'|trans,
                            { 'class': 'btn btn-danger btn-sm', 'data-confirm': 'admin.linked_sheets.delete_confirm_message'|trans })
                        }}
                    {% else %}
                        <button type="button" class="btn btn-danger btn-sm disabled" data-toggle="tooltip" title="{{ 'admin.linked_sheets.disabled_deletion'|trans }}">{{ 'admin.linked_sheets.delete'|trans }}</button>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="text-center">{{ 'admin.linked_sheets.no_result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
