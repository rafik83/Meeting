{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.rooming.menu.title'|trans %}
{% from 'AdminBundle::macro.html.twig' import delete_button %}
{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <h1 class="page-header">
        <a href="{{ path('admin_event_rooming_list_prepare_export', {'event': event.id}) }}" class="btn btn-default pull-right">{{ 'admin.rooming.list.export'|trans }}</a>
        {{ 'admin.rooming.title'|trans({'%count%': roomingListView.listCount}) }}
    </h1>
    {{ form_start(form) }}

    <div class="well">
        {{ form_row(form.types) }}
        {{ form_row(form.states, {'inline': true}) }}

        <div class="row">
            <div class="col-md-3 col-md-offset-3">
                <button type="submit" id="submit" name="submit"
                        class="btn btn-primary">{{ 'admin.filter'|trans }}</button>
                <a href="{{ path('admin_event_rooming_list', {'event': event.id, 'reset': true }) }}"
                   class="btn btn-link">{{ 'admin.reset.filter'|trans }}</a>
            </div>
        </div>
    </div>
    {{ form_end(form) }}

    <h2>{{ roomingListView.listDetailViews|length }} {{ 'admin.users.title'|trans }}</h2>

    <table class="table table-striped table-hover table-condensed">
        <thead>
        <tr>
            <th>{{ 'admin.rooming.list.sheet'|trans }}</th>
            <th>{{ 'admin.rooming.list.fullName'|trans }}</th>
            <th class="col-md-4">{{ 'admin.rooming.list.arrivalDateAndDepartureDate'|trans }}</th>
            <th class="col-md-2">{{ 'admin.rooming.list.comment'|trans }}</th>
            <th class="col-md-1">{{ 'admin.rooming.list.tasting'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for detailView in roomingListView.listDetailViews %}
            <tr id="user_{{ detailView.userId }}">
                <td>
                    <ul class="list-unstyled">
                    {% for sheetView in detailView.sheetViews %}
                        <li>
                            <a href="{{ path('admin_sheet_details', { event: event.id, sheet: sheetView.id }) }}" target="_blank">{{ sheetView.title }}</a>
                            <span class="label label-info">{{ sheetView.typeTitle }}</span>
                            {{ macro.state_label(
                                ('event.sheet.state.' ~ sheetView.sheetState)|trans,
                                sheetView.sheetState,
                                {
                                    'pending': 'default',
                                    'accepted': 'warning',
                                    'validated': 'success',
                                    'refused': 'danger',
                                },
                                ''
                            ) }}
                            {% if sheetView.spotReference %}
                                <span class="label label-default"><i class="glyphicon glyphicon-map-marker"></i> {{ sheetView.spotReference }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                    </ul>
                </td>
                <td>
                    <a href="{{ path('admin_users_details', { event: event.id, user: detailView.userId  }) }}" target="_blank">
                        <b>{{ detailView.lastName|upper }}</b>
                        {{ detailView.firstName|capitalize }}
                    </a>
                </td>
                <td>
                    {% if detailView.userStayViews or detailView.arrivalDate or detailView.departureDate %}
                        <table class="table table-condensed table-bordered">
                            <tr>
                                <th class="text-center" colspan="{{ detailView.userStayViews|length }}">
                                    {% if detailView.areDatesFilledByUser and detailView.arrivalDate is not null %}
                                        {{ detailView.arrivalDate|localizeddate('short', detailView.hasArrivalHours ? 'short' : 'none', app.request.locale, event.timeZone) }}
                                    {% endif %}
                                    {% if detailView.areDatesFilledByUser and detailView.departureDate is not null %}
                                        ➡ {{ detailView.departureDate|localizeddate('short', detailView.hasDepartureHours ? 'short' : 'none', app.request.locale, event.timeZone) }}
                                    {% endif %}
                                    {% if not detailView.areDatesFilledByUser %}
                                        {{ 'admin.rooming.stay.no-dates'|trans }}
                                    {% endif %}
                                </th>
                            </tr>
                            <tr>
                                {% for userStayView in detailView.userStayViews %}
                                    <td class="text-center">
                                        {% if not userStayView.isAssigned %}
                                            <a class="btn btn-small btn-default" href="{{ path('admin_event_rooming_assign_accommodation_stay', {
                                                'event': event.id,
                                                'user': detailView.userId,
                                                'arrivalDate': userStayView.begin|date('d/m/Y'),
                                                'departureDate': userStayView.end|date('d/m/Y')
                                            }) }}">
                                                {{ 'admin.rooming.list.assignAccommodation'|trans }}
                                            </a>
                                        {% else %}
                                            <small>
                                                {{ userStayView.begin|localizeddate('short', 'none', app.request.locale) }}
                                                ➡
                                                {{ userStayView.end|localizeddate('short', 'none', app.request.locale) }}</small>
                                            <br>
                                            {{ userStayView.accommodationTitle }}
                                            <span class="label label-default">{{ userStayView.roomType }}</span>
                                            <span
                                                class="label label-info updatable stay_view_room_number_{{ userStayView.stayId }}"
                                                title="{{ 'admin.rooming.list.roomNumberAssigned'|trans }}"
                                                data-type="string"
                                                data-url="{{ path('admin_event_rooming_stay_assign_room_number', {
                                                    'event': event.id,
                                                    'stay': userStayView.stayId,
                                                }) }}"
                                                data-update-and-reconcile="{{ { 'value': userStayView.roomNumber }|json_encode }}"
                                                data-to-reconcile=".stay_view_room_number_{{ userStayView.stayId }}"
                                            >
                                                {{ userStayView.roomNumber }}
                                            </span>&nbsp;

                                            {% if userStayView.roommateView %}
                                                <br><b>{{ userStayView.roommateView.lastName|upper }}</b>
                                                {{ userStayView.roommateView.firstName|capitalize }}
                                            {% endif %}

                                            {{ delete_button(
                                                path('admin_event_rooming_remove_stay', {
                                                    'event': event.id,
                                                    'stay': userStayView.stayId,
                                                    'user': detailView.userId
                                                }),
                                                'admin.remove'|trans,
                                                {
                                                    'class': 'btn btn-danger btn-xs',
                                                    'data-confirm': 'admin.rooming.stay.remove.confirm'|trans
                                                },
                                                constant('Proximum\\Vimeet\\Domain\\Intention\\IntentionType::INTENTION_REMOVE_STAY')
                                            ) }}
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        </table>
                    {% endif %}
                </td>
                <td
                    class="updatable"
                    data-type="string"
                    data-input-type="textarea"
                    data-url="{{ path('admin_event_rooming_add_comment', {'event': event.id, 'user': detailView.userId }) }}"
                    data-update="{{ { 'value': detailView.comment }|json_encode }}"
                >
                    {{ detailView.comment }}
                </td>
                <td
                    class="updatable"
                    data-type="string"
                    data-input-type="textarea"
                    data-url="{{ path('admin_event_rooming_add_tasting', {'event': event.id, 'user': detailView.userId }) }}"
                    data-update="{{ { 'value': detailView.tasting }|json_encode }}"
                >
                    {{ detailView.tasting }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
