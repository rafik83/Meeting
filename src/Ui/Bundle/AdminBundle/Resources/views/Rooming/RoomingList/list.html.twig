{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.rooming.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.rooming.title'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.rooming.list.sheet'|trans }}</th>
            <th>{{ 'admin.rooming.list.firstName'|trans }}</th>
            <th>{{ 'admin.rooming.list.lastName'|trans }}</th>
            <th>{{ 'admin.rooming.list.arrivalDateAndDepartureDate'|trans }}</th>
            <th>{{ 'admin.rooming.list.comment'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for detailView in roomingListView.listDetailViews %}
            <tr>
                <td>
                    <ul>
                    {% for sheetView in detailView.sheetViews  %}
                        <li>
                            {{ sheetView.title }}
                            <span class="label label-info">{{ sheetView.typeTitle }}</span>

                            {% if sheetView.spotReference %}
                                <span class="label label-default"><i class="glyphicon glyphicon-map-marker"></i> {{ sheetView.spotReference }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                    </ul>
                </td>
                <td>
                    {{ detailView.firstName }}
                </td>
                <td>
                    {{ detailView.lastName }}
                </td>
                <td>
                    {% if detailView.arrivalDate is not null %}
                        {{ detailView.arrivalDate|date('d/m/Y H:i') }}
                    {% endif %}
                    {% if detailView.departureDate is not null %}
                        - {{ detailView.departureDate|date('d/m/Y H:i') }}
                    {% endif %}
                    <ul>
                    {% for userOvernightAccommodation in detailView.userOvernightAccommodationViews %}
                        <li>
                            {{ userOvernightAccommodation.accommodationTitle }}
                            {{ userOvernightAccommodation.roomType }}
                            {{ userOvernightAccommodation.arrivalDate|date('d/m/Y') }} - {{ userOvernightAccommodation.departureDate|date('d/m/Y') }}
                            {% if userOvernightAccommodation.roommateView %}
                                {{ userOvernightAccommodation.roommateView.firstName }}
                                {{ userOvernightAccommodation.roommateView.lastName }}
                            {% endif %}
                        </li>
                    {% endfor %}
                    </ul>
                </td>
                <td>
                    {{ detailView.comment }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
