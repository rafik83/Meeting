{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.rooming.title'|trans %}
{% from 'AdminBundle::macro.html.twig' import delete_button %}

{% block content %}
    <h1 class="page-header">{{ 'admin.rooming.title'|trans }}</h1>

    <table class="table table-striped table-hover table-condensed">
        <thead>
        <tr>
            <th>{{ 'admin.rooming.list.sheet'|trans }}</th>
            <th>{{ 'admin.rooming.list.fullName'|trans }}</th>
            <th class="col-md-4">{{ 'admin.rooming.list.arrivalDateAndDepartureDate'|trans }}</th>
            <th class="col-md-2">{{ 'admin.rooming.list.comment'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for detailView in roomingListView.listDetailViews %}
            <tr id="user_{{ detailView.userId }}">
                <td>
                    <ul class="list-unstyled">
                    {% for sheetView in detailView.sheetViews %}
                        <li>
                            <a href="{{ path('admin_sheet_details', { event: event.id, sheet: sheetView.id }) }}" target="_blank">{{ sheetView.title }}</a>
                            <span class="label label-info">{{ sheetView.typeTitle }}</span>

                            {% if sheetView.spotReference %}
                                <span class="label label-default"><i class="glyphicon glyphicon-map-marker"></i> {{ sheetView.spotReference }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                    </ul>
                </td>
                <td>
                    <a href="{{ path('admin_users_details', { event: event.id, user: detailView.userId  }) }}" target="_blank">
                        <b>{{ detailView.lastName|upper }}</b>
                        {{ detailView.firstName|capitalize }}
                    </a>
                </td>
                <td>
                    {% if detailView.userStayViews or detailView.arrivalDate or detailView.departureDate %}
                        <table class="table table-condensed table-bordered">
                            <tr>
                                <th class="text-center" colspan="{{ detailView.userStayViews|length }}">
                                    {% if detailView.arrivalDate is not null %}
                                        {{ detailView.arrivalDate|localizeddate('short', detailView.hasArrivalHours ? 'short' : 'none', app.request.locale, event.timeZone) }}
                                    {% endif %}
                                    {% if detailView.departureDate is not null %}
                                        ➡ {{ detailView.departureDate|localizeddate('short', detailView.hasDepartureHours ? 'short' : 'none', app.request.locale, event.timeZone) }}
                                    {% endif %}
                                </th>
                            </tr>
                            <tr>
                                {% for userStayView in detailView.userStayViews %}
                                    <td class="text-center">
                                        {% if not userStayView.isAssigned %}
                                            <a class="btn btn-small btn-default" href="{{ path('admin_event_rooming_assign_accommodation_stay', {
                                                'event': event.id,
                                                'user': detailView.userId,
                                                'arrivalDate': userStayView.begin|date('d/m/Y'),
                                                'departureDate': userStayView.end|date('d/m/Y')
                                            }) }}">
                                                {{ 'admin.rooming.list.assignAccommodation'|trans }}
                                            </a>
                                        {% else %}
                                            <small>
                                                {{ userStayView.begin|localizeddate('short', 'none', app.request.locale, event.timeZone) }}
                                                ➡
                                                {{ userStayView.end|localizeddate('short', 'none', app.request.locale, event.timeZone) }}</small>
                                            <br>
                                            {{ userStayView.accommodationTitle }}
                                            <span class="label label-default">{{ userStayView.roomType }}</span>

                                            {% if userStayView.roommateView %}
                                                <br><b>{{ userStayView.roommateView.lastName|upper }}</b>
                                                {{ userStayView.roommateView.firstName|capitalize }}
                                            {% endif %}

                                            {{ delete_button(
                                                path('admin_event_rooming_remove_stay', {
                                                    'event': event.id,
                                                    'stay': userStayView.stayId,
                                                    'user': detailView.userId
                                                }),
                                                'admin.remove'|trans,
                                                {
                                                    'class': 'btn btn-danger btn-xs',
                                                    'data-confirm': 'admin.rooming.stay.remove.confirm'|trans
                                                },
                                                constant('Proximum\\Vimeet\\Domain\\Intention\\IntentionType::INTENTION_REMOVE_STAY')
                                            ) }}
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        </table>
                    {% endif %}
                </td>
                <td
                    class="updatable"
                    data-type="string"
                    data-input-type="textarea"
                    data-url="/fr/toto"
                    data-update="{{ { 'value': detailView.comment }|json_encode }}"
                >
                    {{ detailView.comment }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
