<div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
    <div class="panel panel-default">
        <div class="panel-heading" role="tab" id="headingOne">
            <h4 class="panel-title text-center">
                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#advancedFilters" aria-expanded="true" aria-controls="advancedFilters">
                    {{ 'admin.sheet.list.filters.label'|trans }} <span class="glyphicon glyphicon-chevron-down"></span>
                </a>
            </h4>
        </div>
        <div id="advancedFilters"
             class="panel-collapse {% if not form.vars.valid %}in{% endif %}"
             role="tabpanel"
             {% if not form.vars.valid %}aria-expanded="true"{% endif %}
             aria-labelledby="headingOne"
        >
            <div class="panel-body">
                <div class="col-md-6">
                    {{ form_row(form.states, {'inline': true}) }}
                </div>
                <div class="col-md-12">
                    <div class="form-group pull-right">
                        <button type="submit" id="submit" name="submit" class=" btn btn-primary">
                            {{ 'form.admin.sheet.filter.children.submit.label'|trans({}, 'forms') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
