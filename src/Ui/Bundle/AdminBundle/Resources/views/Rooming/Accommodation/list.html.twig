{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.rooming.accommodation.list.title'|trans %}

{% block content %}
    <h1 class="page-header">
        <a href="{{ path('admin_event_rooming_accommodation_add', {'event': event.id}) }}" class="btn btn-primary pull-right">
            {{ 'admin.rooming.accommodation.add.link'|trans }}
        </a>
        {{ 'admin.rooming.accommodation.list.title'|trans }}
    </h1>

    <table class="table table-striped table-hover table-condensed">
        <thead>
        <tr>
            <th>{{ 'admin.rooming.accommodation.list.column.title'|trans }}</th>
            {% for overnight in accommodationListView.overnights %}
                <th class="text-center">
                    {{ overnight.date|date('d/m/Y') }}
                </th>
            {% endfor %}
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for accommodation in accommodationListView.accommodations %}
            <tr id="accommodation_{{ accommodation.id }}">
                <td>
                    {{ accommodation.title }}
                </td>
                {% for key, overnight in accommodationListView.overnights %}
                    <td class="text-center">
                        {% if accommodation.overnightCapacityViews[key] is defined %}
                            {% set overnightCapacityView = accommodation.overnightCapacityViews[key] %}
                            {{ overnightCapacityView.remaining }} / {{ overnightCapacityView.total }}
                        {% endif %}
                    </td>
                {% endfor %}
                <td class="text-right">
                    <a class="btn btn-default btn-sm" href="{{ path('admin_event_rooming_accommodation_update', { 'event': event.id, 'accommodation':  accommodation.id }) }}">
                        {{ 'admin.rooming.accommodation.update.link'|trans }}
                    </a>
                </td>
            </tr>
        {% endfor %}
        <tr class="info">
            <td>{{ 'admin.rooming.accommodation.list.column.total'|trans }}</td>
            {% for overnight in accommodationListView.overnights %}
                <td class="text-center">
                    {{ overnight.remaining }} / {{ overnight.total }}
                </td>
            {% endfor %}
            <td></td>
        </tr>
        </tbody>
    </table>
{% endblock %}
