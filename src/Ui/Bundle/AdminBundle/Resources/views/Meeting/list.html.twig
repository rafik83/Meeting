{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.meeting.list.title'|trans %}

{% block content %}
    <h2>
        {{ meetings.total }} {{ 'admin.meeting.list.title'|trans }}
        {% if is_granted('ROLE_SUPER_ADMIN') %}
        <span class="pull-right" style="margin-left: 10px;">
            {{ macro.delete_button(
                path('admin_meeting_delete_all', {'event': event.id}),
                'admin.meeting.action.deleteAll.title'|trans,
                {'class': 'btn btn-danger', 'data-confirm': 'admin.meeting.action.deleteAll.confirm'|trans}
            ) }}
        </span>
        {% endif %}
        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
            <form action="{{ path('admin_meeting_export', { 'event': event.id }) }}" method="GET" class="pull-right">
                <input type="submit" value="{{ 'admin.sheet.export.meetings.button.label'|trans }}" class="btn btn-sm btn-default"/>
            </form>
        {% endif %}
    </h2>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>{{ 'admin.meeting.list.column.head.from'|trans }}</th>
                <th>{{ 'admin.meeting.list.column.head.to'|trans }}</th>
                <th>{{ 'admin.meeting.list.column.head.slot'|trans }}</th>
                <th>{{ 'admin.meeting.list.column.head.createdAt'|trans }}</th>
                <th>{{ 'admin.meeting.list.column.head.isCreatedByParticipants'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for meeting in meetings.results %}
                <tr>
                    <td>
                        {% if not is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                            {{ meeting.sheetNameFrom }}
                        {% else %}
                            <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': meeting.sheetFromId }) }}" target="_blank">
                                {{ meeting.sheetNameFrom }}
                            </a>
                        {% endif %}
                    </td>
                    <td>
                        {% if not is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                            {{ meeting.sheetNameTo }}
                        {% else %}
                            <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': meeting.sheetToId }) }}" target="_blank">
                                {{ meeting.sheetNameTo }}
                            </a>
                        {% endif %}
                    </td>
                    <td>
                        {{ meeting.slotBegin|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}
                        -
                        {{ meeting.slotEnd|localizeddate('none', 'short', app.request.locale, event.timeZone) }}
                    </td>
                    <td>{{ meeting.createdAt|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                    <td>{{ meeting.isCreatedByParticipants ? '✓' : '' }}</td>
                    <td>
                        {{ macro.btnGroupAndRightMenuDropdown({('admin.meeting.list.details'|trans): path('admin_meeting_details', {'event': event.id, 'meeting': meeting.id})}) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">
                         {{ 'admin.meeting.list.noResult'|trans }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': meetings}) }}
{% endblock %}
