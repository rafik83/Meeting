{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.meeting.list.title'|trans %}

{% block content %}
    <h2>
        {{ view.getNumberOfMeetingsOnThisSlot }} / {{ view.totalMeetings }}<br>
    </h2>

    {{ form_start(form, {'attr': {'data-select-mover-form': 'data-select-mover-form'}}) }}
    <div class="input-group">
        <span class="input-group-btn">
            <button data-select-mover-previous="data-select-mover-previous"
                    class="btn btn-default"
                    {% if not hasPrevious %}disabled{% endif %}
            >
                ←
            </button>
        </span>

        {{ form_widget(form.slot, {
            'attr': {
                'onChange': 'document.getElementsByName("slot_choice")[0].submit();',
                'data-select-mover': 'data-select-mover'
            }
        }) }}

        <span class="input-group-btn">
            <button data-select-mover-next="data-select-mover-next"
                    class="btn btn-default"
                    {% if not hasNext %}disabled{% endif %}
            >
                →
            </button>
        </span>
    </div>
    {{ form_end(form) }}

    {% if view.meetingViews|length == 0 %}
        <br>
        <div class="alert alert-danger">{{ 'admin.meeting.list.noResult'|trans }}</div>
    {% else %}
        <table class="table table-hover" data-participant-presence-endpoint="{{ path('admin_meeting_participants_presence', { 'event': event.id, 'meetingSlot': currentSlot.id }) }}">
            <thead>
                <tr>
                    <th>{{ 'admin.meeting.list.column.head.spot'|trans }}</th>
                    <th>{{ 'admin.meeting.list.column.head.from'|trans }}</th>
                    <th>{{ 'admin.meeting.list.column.head.to'|trans }}</th>
                    <th></th>
                    <th class="col-sm-2 col-md-2"></th>
                </tr>
            </thead>
            <tbody>
                {% for meeting in view.meetingViews %}
                    <tr>
                        <td>
                            {{ meeting.spotReference }}
                        </td>
                        <td>
                            {% if not is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                                {{ meeting.fromSheetTitle }}
                            {% else %}
                                <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': meeting.fromSheetId }) }}" target="_blank">
                                    {{ meeting.fromSheetTitle }}
                                </a>
                            {% endif %}
                            <ul>
                                {% for participant in meeting.fromParticipants %}
                                    <li>
                                        {% include '@Admin/Meeting/participantDetail.html.twig' with {participant: participant} %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                        <td>
                            {% if not is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                                {{ meeting.toSheetTitle }}
                            {% else %}
                                <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': meeting.toSheetId }) }}" target="_blank">
                                    {{ meeting.toSheetTitle }}
                                </a>
                            {% endif %}
                            <ul>
                                {% for participant in meeting.toParticipants %}
                                    <li>
                                        {% include '@Admin/Meeting/participantDetail.html.twig' with {participant: participant} %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                        <td>
                            <a href="{{ path('admin_meeting_details', {'event': event.id, 'meeting': meeting.id}) }}" class="btn btn-default btn-sm">
                                <i class="glyphicon glyphicon-eye-open"></i>
                            </a>
                        </td>
                        <td>
                            <div class="btn-group pull-right" data-toggle="buttons"
                                 data-btn-group-default-state="group"
                                 data-radio-group-ajax="{{ path('admin_meeting_update_status', {'event': event.id, 'meeting': meeting.id}) }}"
                            >
                                <label class="btn btn-default {% if meeting.status == 'canceled' %}active btn-danger{% endif %}"
                                       data-btn-group-default-state-item="btn-danger"
                                >
                                    <input
                                        type="radio"
                                        name="status_{{ meeting.id }}"
                                        value="canceled"
                                        {% if meeting.status == 'canceled' %}checked{% endif %}
                                    >
                                    X
                                </label>
                                <label class="btn btn-default {% if meeting.status == 'not_confirmed' %}active{% endif %}">
                                    <input
                                        type="radio"
                                        name="status_{{ meeting.id }}"
                                        value="not_confirmed"
                                        {% if meeting.status == 'not_confirmed' %}checked{% endif %}
                                    >
                                    &nbsp;
                                </label>
                                <label class="btn btn-default {% if meeting.status == 'confirmed' %}active btn-success{% endif %}"
                                    data-btn-group-default-state-item="btn-success"
                                >
                                    <input
                                        type="radio"
                                        name="status_{{ meeting.id }}"
                                        value="confirmed"
                                        {% if meeting.status == 'confirmed' %}checked{% endif %}
                                    >
                                    ✔
                                </label>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
