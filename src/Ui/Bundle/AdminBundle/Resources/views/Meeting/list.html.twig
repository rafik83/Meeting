{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.meeting.list.title'|trans %}

{% block content %}
    <h2>
        {{ view.getNumberOfMeetingsOnThisSlot }} / {{ view.totalMeetings }}<br>
    </h2>
    <p>
        {{ form_start(form, {'attr': {'data-select-mover-form': 'data-select-mover-form'}}) }}
            <div>
                <div class="col-md-2">
                    <button data-select-mover-previous="data-select-mover-previous" class="btn btn-default pull-right">
                        <
                    </button>
                </div>
                <div class="col-md-8">
                    {{ form_widget(form.slot, {
                        'attr': {
                            'onChange': 'document.getElementsByName("slot_choice")[0].submit();',
                            'data-select-mover': 'data-select-mover'
                        }
                    }) }}
                </div>
                <div class="col-md-2">
                    <button data-select-mover-next="data-select-mover-next" class="btn btn-default">
                        >
                    </button>
                </div>
            </div>
        {{ form_end(form) }}
    </p>

    <table class="table table-hover">
        <thead>
            <tr>
                <th class="col-md-1">{{ 'admin.meeting.list.column.head.spot'|trans }}</th>
                <th class="col-md-2">{{ 'admin.meeting.list.column.head.from'|trans }}</th>
                <th class="col-md-2">{{ 'admin.meeting.list.column.head.fromParticipants'|trans }}</th>
                <th class="col-md-2">{{ 'admin.meeting.list.column.head.to'|trans }}</th>
                <th class="col-md-2">{{ 'admin.meeting.list.column.head.toParticipants'|trans }}</th>
                <th class="col-md-1"></th>
            </tr>
        </thead>
        <tbody>
            {% for meeting in view.meetingViews %}
                <tr>
                    <td>
                        {{ meeting.spotReference }}
                    </td>
                    <td>
                        {% if not is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                            {{ meeting.fromSheetTitle }}
                        {% else %}
                            <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': meeting.fromSheetId }) }}" target="_blank">
                                {{ meeting.fromSheetTitle }}
                            </a>
                        {% endif %}
                    </td>
                    <td>
                        <ul>
                            {% for participant in meeting.fromParticipants %}
                                <li>{{ participant.completeName }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        {% if not is_granted('ROLE_ALLOWED_TO_ADMIN') %}
                            {{ meeting.toSheetTitle }}
                        {% else %}
                            <a href="{{ path('admin_sheet_details', {'event': event.id, 'sheet': meeting.toSheetId }) }}" target="_blank">
                                {{ meeting.toSheetTitle }}
                            </a>
                        {% endif %}
                    </td>
                    <td>
                        <ul>
                            {% for participant in meeting.toParticipants %}
                                <li>{{ participant.completeName }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        {{ macro.btnGroupAndRightMenuDropdown({('admin.meeting.list.details'|trans): path('admin_meeting_details', {'event': event.id, 'meeting': meeting.id})}) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">
                         {{ 'admin.meeting.list.noResult'|trans }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
