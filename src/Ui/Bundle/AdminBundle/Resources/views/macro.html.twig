{% macro button(url, method, label, attributes) %}
    {% set attributes = attributes|default({})|merge({'type': 'submit'}) %}

    {% if method|upper not in ['POST', 'GET'] %}
        {% set _method = method %}
        {% set method  = 'POST' %}
    {% endif %}

    <form action="{{ url }}" method="{{ method }}" style="display: inline;">
        {% if _method is defined %}
            <input type="hidden" name="_method" value="{{ _method }}" />
        {% endif %}
        <button {% for attribute, value in attributes %} {{ attribute }}="{{ value }}"{% endfor %}>{{ label|html }}</button>
    </form>
{% endmacro %}

{% macro delete_button(url, label, attributes) %}
    {{ _self.button(url, 'DELETE', label, attributes) }}
{% endmacro %}

{% macro more(values, limit) %}
    {% if values|length > limit %}
        {{ values|slice(0, limit)|join(', ') }} <a href="#" data-container="body" data-toggle="popover" data-placement="bottom" data-html="true" data-trigger="hover" data-content="{{ '<ul class="list-unstyled"><li>' ~ values|slice(limit, values|length - 1)|join('</li><li>') ~ '<li></ul>' }}">{{ 'and_more'|transchoice(values|length - limit, { '%count%': values|length - limit }) }}</a>
    {% else %}
        {{ values|slice(0, values|length - 1)|join(', ') }} {{ 'and'|trans }} {{ values|last }}
    {% endif %}
{% endmacro %}
