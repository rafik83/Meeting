{% macro button(url, method, label, attributes, formAttributes, csrf_intention) %}
    {% set attributes = attributes|default({})|merge({'type': 'submit'}) %}
    {% set formAttributes = formAttributes|default({'style': 'display: inline'}) %}

    {% if method|upper not in ['POST', 'GET'] %}
        {% set _method = method %}
        {% set method  = 'POST' %}
    {% endif %}

    <form action="{{ url }}" method="{{ method }}" {% for attribute, value in formAttributes %} {{ attribute }}="{{ value }}"{% endfor %}>
        {% if _method is defined %}
            <input type="hidden" name="_method" value="{{ _method }}" />
        {% endif %}
        {% if csrf_intention is not null %}
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_intention) }}">
        {% endif %}
        <button {% for attribute, value in attributes %} {{ attribute }}="{{ value }}"{% endfor %}>
            {{ label|html }}
        </button>
    </form>
{% endmacro %}

{% macro delete_button(url, label, attributes, csrf_intention) %}
    {% import _self as macros %}
    {{ macros.button(url, 'DELETE', label, attributes, {}, csrf_intention) }}
{% endmacro %}

{% macro more(values, limit) %}
    {% if values|length == 1 %}
        {{ values|first }}
    {% elseif values|length > limit %}
        {{ values|slice(0, limit)|join(', ') }} <a href="#" data-container="body" data-toggle="popover" data-placement="bottom" data-html="true" data-trigger="hover" data-content="{{ '<ul class="list-unstyled"><li>' ~ values|slice(limit, values|length - 1)|join('</li><li>') ~ '<li></ul>' }}">{{ 'and_more'|transchoice(values|length - limit, { '%count%': values|length - limit }) }}</a>
    {% else %}
        {{ values|slice(0, values|length - 1)|join(', ') }} {{ 'and'|trans }} {{ values|last }}
    {% endif %}
{% endmacro %}

{% macro btnGroupAndRightMenuDropdown(links) %}
    <div class="btn-group">
        {% for label, link in links %}
            {% if loop.first %}
                <a href="{{ link }}" class="btn btn-default btn-sm">
                    {{ label }}
                </a>
            {% elseif loop.index == 2 %}
                <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
            {% endif %}

            {% if loop.index > 1 %}
                <li>
                    <a href="{{ link }}">{{ label }}</a>
                </li>
            {% endif %}

            {% if loop.last %}
                </ul>
            {% endif %}
        {% endfor %}
    </div>
{% endmacro %}

{% macro choice_as_dropdown(choice, btn_style = false, dropdown_menu_right = false, input_group = false, allFilterEnabled = true) %}
    <div class="{{ input_group ? 'input-group-btn' : 'dropdown' }}">
        <a href="#" id="{{ choice.vars.id }}-dropdown" {{ btn_style ? 'class="btn btn-default"' : '' }} data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            {{ choice.vars.label|trans({}, choice.vars.translation_domain) }}
            <span class="caret"></span>
        </a>
        <ul class="dropdown-menu {{ dropdown_menu_right ? 'dropdown-menu-right' : '' }}" aria-labelledby="{{ choice.vars.id }}-dropdown">
            {% set selectedValue = choice.vars.value %}

            {% if selectedValue != null and allFilterEnabled == true %}
                <li>
                    <a href="?{{ app.request.query.all|merge({(choice.vars.id): '', 'page': 1})|url_encode }}">
                        {{ 'admin.filters.all'|trans }}
                    </a>
                </li>
            {% endif %}

            {% for item in choice.vars.choices %}
                <li {{ selectedValue == item.value ? 'class="active"' : '' }}>
                    <a href="?{{ app.request.query.all|merge({(choice.vars.id): item.value, 'page': 1})|url_encode }}">
                        {{ choice.vars.choice_translation_domain|default(false) is same as(false) ? item.label : item.label|trans }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endmacro %}

{% macro state_label(label, value, states, title) %}
    <span class="label label-{{ states[value]|default('default') }}" data-toggle="tooltip" data-placement="top" title="{{ title|default }}">{{ label }}</span>
{% endmacro %}
