{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.product_create.planning.title'|trans %}

{% block form_title 'admin.product_create.planning.title'|trans %}

{% block form_content %}
    {{ form_row(form.name) }}
    {{ form_row(form.translations) }}
    {{ form_row(form.unitPrice) }}
    {% if form.vat is defined %}
        {{ form_row(form.vat) }}
    {% endif %}
    {{ form_row(form.quantityMax) }}
{% endblock %}

{% block goback_link path('admin_product', {event: event.id}) %}
