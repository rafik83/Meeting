{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.product_update.option.title'|trans %}

{% block form_title 'admin.product_update.option.title'|trans %}

{% block form_content %}
    {{ form_row(form.name) }}
    {{ form_row(form.translations) }}
    {% if product.image is defined and product.image is not null and product.image is not empty %}
        <div class="col-md-offset-4 cold-md-3">
            <img src="{{ product.image }}" width="250" class="img-responsive img-thumbnail" />
        </div>
    {% endif %}
    {{ form_row(form.file) }}

    {% if form.unitPrice is defined %}
        {{ form_row(form.unitPrice) }}
    {% endif %}
    {% if form.vat is defined %}
        {{ form_row(form.vat) }}
    {% else %}
        <div class="form-group">
            <label class="col-lg-3 col-md-3 col-sm-3 text-right">
                {{ 'admin.product_update.info.vat'|trans }}
            </label>
            <div class="col-lg-9 col-md-9 col-sm-9">
                {{ product.vat }}%
            </div>
        </div>
    {% endif %}

    {{ form_row(form.quantityMax) }}
    {{ form_row(form.availabilityCurrent) }}
    {{ form_row(form.availabilityMax) }}
    {{ form_row(form.updatable) }}<br>
    {{ form_row(form.buyableUntil) }}
    {{ form_row(form.deletableUntil) }}
    {{ form_row(form.subjectedToValidation) }}<br>
    {{ form_row(form.attributable) }}<br>
    <div id="happenings-block">
        {{ form_row(form.happenings) }}
    </div>
    <br>
{% endblock %}

{% block goback_link path('admin_product', {event: event.id}) %}
