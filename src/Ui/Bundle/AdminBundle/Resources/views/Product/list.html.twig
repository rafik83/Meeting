{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.product.title'|trans %}

{% block list_title 'admin.product.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ block('list_title') }}
        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
            <form action="{{ path('admin_product_export', { 'event': event.id }) }}" method="GET" class="pull-right" style="margin-left: 10px;">
                <input type="submit" value="{{ 'admin.product.export.button.label'|trans }}" class="btn btn-sm btn-default"/>
            </form>
        {% endif %}
    </h1>

    <p>
        <a href="{{ path('admin_product_create_option', {'event': event.id}) }}" class="btn btn-primary">
            <i class="glyphicon glyphicon-product-option"></i>
            {{ 'admin.product_create.option.title'|trans }}
        </a>
        <a href="{{ path('admin_product_create_plan', {'event': event.id}) }}" class="btn btn-primary">
            <i class="glyphicon glyphicon-product-plan"></i>
            {{ 'admin.product_create.plan.title'|trans }}
        </a>
        <a href="{{ path('admin_product_create_participant', {'event': event.id}) }}" class="btn btn-primary">
            <i class="glyphicon glyphicon-product-participant"></i>
            {{ 'admin.product_create.participant.title'|trans }}
        </a>
        <a href="{{ path('admin_product_create_planning', {'event': event.id}) }}" class="btn btn-primary">
            <i class="glyphicon glyphicon-product-planning"></i>
            {{ 'admin.product_create.planning.title'|trans }}
        </a>
        <a href="{{ path('admin_product_template_import', {'event': event.id}) }}"
           class="pull-right"
           data-toggle="modal" data-target="#import-modal">
            <i class="glyphicon glyphicon-download"></i>
            {{ 'admin.package.import.link'|trans }}
        </a>
    </p>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>{{ 'admin.product.id'|trans }}</th>
            <th>{{ 'admin.product.name'|trans }}</th>
            <th class="text-center col-md-1">{{ 'admin.product.bought'|trans }}</th>
            <th class="text-center col-md-1">{{ 'admin.product.boughtIncluded'|trans }}</th>
            <th class="text-center col-md-1">{{ 'admin.product.availabilityCurrentMax'|trans }}</th>
            <th class="text-center">{{ 'admin.product.unitPrice'|trans }}</th>
            <th class="text-center">{{ 'admin.product.quantityMax'|trans }}</th>
            <th class="text-center">{{ 'admin.product.buyableUntil'|trans }}</th>
            <th class="text-center">{{ 'admin.product.updatable'|trans }}</th>
            <th class="text-center">{{ 'admin.product.deletableUntil'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% set availabilityCssClass = {'default': 'success', 'warning': 'warning', 'alert': 'danger'} %}
        {% set currentType = null %}

        {% for product in products %}
            {% if currentType is null or currentType != product.type %}
                {% set currentType = product.type %}
                <tr class="info">
                    <th colspan="11">
                        <i class="glyphicon glyphicon-product-{{ product.type }}"></i>
                        {{ ('admin.product.type.' ~ product.type)|trans }}
                    </th>
                </tr>
            {% endif %}
            <tr>
                <td>{{ product.id }}</td>
                <td>
                    <i class="glyphicon glyphicon-product-{{ product.type }}"></i>
                    {{ product.name }}
                    {% if product.hasHappenings %}
                        <i class="icon-PresFlash_2" data-toggle="tooltip" title="{{ "admin.product.happenings.tooltip"|trans }}"></i>
                    {% endif %}

                    {% if product.subjectedToValidation %}
                        <span class="label label-warning">
                            {{ 'admin.product.subjectedToValidation'|trans }}
                        </span>
                    {% endif %}
                    {% if product.hasAvailabilityTimeRanges %}
                        <span class="label label-default">
                            {{ 'admin.product.hasAvailabilityTimeRanges'|trans }}
                        </span>
                    {% endif %}
                    {% if product.isAttributable %}
                        <span class="label label-info" data-toggle="tooltip" data-placement="top" title="{{ 'admin.product.isAttributable'|trans }}">
                            <i class="icon-Profil_1"></i>
                        </span>
                    {% endif %}

                    {% if product.hasIncludedProducts %}
                        <ul>
                            {% for includedProduct in product.includedProducts %}
                                <li>
                                    <i class="glyphicon glyphicon-product-{{ includedProduct.type }}"></i>
                                    {{ includedProduct.quantity }} &times; {{ includedProduct.name }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
                <td class="text-center">
                    {% if product.bought > 0 %}
                        <a href="{{ path('admin_sheet_order_list', {'event': event.id, 'product': product.id}) }}">
                            <span class="label label-{{ availabilityCssClass[product.availabilityStatus] }}">
                                {{ product.bought }}
                            </span>
                        </a>
                    {% endif %}

                </td>
                <td>
                    {% if product.productIncludedBought > 0 %}
                        <span class="label label-{{ availabilityCssClass[product.availabilityStatus] }}">
                            {{  product.productIncludedBought }}
                        </span>
                    {% endif %}
                </td>
                <td>
                    {% if product.availabilityManaged %}
                        <div class="progress" data-toggle="tooltip" data-placement="top" title="{{ product.availabilityCurrent }} / {{ product.availabilityMax }}" style="margin-bottom: 0">
                            {% if product.availabilityCurrent > 0 %}
                                <div class="progress-bar progress-bar-success" role="progressbar" aria-valuenow="{{ product.availabilityCurrent }}" aria-valuemin="0" aria-valuemax="{{ product.availabilityMax }}" style="width: {{ (100 * product.availabilityCurrent / product.availabilityMax)|round }}%;"></div>
                            {% else %}
                                <div class="progress-bar progress-bar-danger" role="progressbar" aria-valuenow="{{ product.availabilityCurrent }}" aria-valuemin="0" aria-valuemax="{{ product.availabilityMax }}" style="width: 100%;"></div>
                            {% endif %}
                        </div>
                    {% endif %}
                </td>
                <td class="text-right">{{ product.unitPrice|localizedcurrency(event.currency) }}</td>
                <td class="text-right">{{ product.quantityMax }}</td>
                <td class="text-center">{{ product.buyableUntil ? product.buyableUntil|localizeddate('medium', 'short', app.request.locale, event.timeZone) : '-' }}</td>
                <td class="text-center">{{ product.updatable ? '✓' : '' }}</td>
                <td class="text-center">{{ product.deletableUntil ? product.deletableUntil|localizeddate('medium', 'short', app.request.locale, event.timeZone) : '-' }}</td>
                <td class="text-right col-md-1">
                    <div class="btn-group">
                        <a href="{{ path('admin_product_update_' ~ product.type|lower, {'event': event.id, 'product': product.id}) }}" class="btn btn-default btn-sm">
                            {{ 'admin.product.update.action'|trans }}
                        </a>
                        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
                            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-right">
                                {% if product.removable %}
                                    <li>
                                        {{ macro.delete_button(
                                            path('admin_product_remove', { 'event': event.id, 'product': product.id }),
                                            'admin.product.remove.link'|trans,
                                            { 'class': 'btn btn-default btn-sm', 'data-confirm': 'admin.product.action.confirmDelete'|trans })
                                        }}
                                    </li>
                                {% else %}
                                    <li>
                                        <button class="btn disabled btn-default btn-sm" title="{{ 'admin.product.removeUnAvailable.title'|trans }}">
                                            {{ 'admin.product.remove.link'|trans }}
                                        </button>
                                    </li>
                                {% endif %}
                            </ul>
                        {% endif %}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10" class="text-danger text-center">{{ 'admin.zero-result'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="modal fade clear-on-hidden-modal" id="import-modal" tabindex="-1" role="dialog"
         data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>
{% endblock content %}
