{% extends 'AdminBundle:Common:form_layout.html.twig' %}

{% block title 'admin.product_update.plan.title'|trans %}

{% block form_title 'admin.product_update.plan.title'|trans %}

{% block form_content %}
    {{ form_row(form.name) }}
    {{ form_row(form.translations) }}
    {% if plan.image is defined and plan.image is not null and plan.image is not empty %}
        <div class="col-md-offset-4 cold-md-3">
            <img src="{{ plan.image }}" width="250" class="img-responsive img-thumbnail" />
        </div>
    {% endif %}
    {{ form_row(form.file) }}

    {% if form.unitPrice is defined %}
        {{ form_row(form.unitPrice) }}
    {% endif %}
    {% if form.vat is defined %}
        {{ form_row(form.vat) }}
    {% else %}
        <div class="form-group">
            <label class="col-lg-3 col-md-3 col-sm-3 text-right">
                {{ 'admin.product_update.info.vat'|trans }}
            </label>
            <div class="col-lg-9 col-md-9 col-sm-9">
                {{ plan.vat }}%
            </div>
        </div>
    {% endif %}

    {{ form_row(form.availabilityCurrent) }}
    {{ form_row(form.availabilityMax) }}
    {{ form_row(form.features) }}
    {{ form_row(form.productIncluded) }}
{% endblock %}

{% block goback_link path('admin_product', {event: event.id}) %}

