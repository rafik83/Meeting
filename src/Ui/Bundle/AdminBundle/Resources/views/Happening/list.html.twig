{% extends 'AdminBundle::base.html.twig' %}

{% import '@Admin/macro.html.twig' as form_macros %}

{% block title 'admin.happening.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.happening.title'|trans }}
        <div class="pull-right">
            <a class="btn btn-info" href="{{ path('admin_happening_category_list', {event: event.id}) }}">
                {{ 'admin.happening.button.category'|trans }}
            </a>
            <a class="btn btn-info" href="{{ path('admin_happening_speaker_list', {event: event.id}) }}">
                {{ 'admin.happening.button.speaker'|trans }}
            </a>

            {{ form_macros.button(
                path('admin_happening_participant_export', { 'event': event.id }),
                'POST',
                'admin.happening.participations.button.export'|trans,
                {'class': 'btn btn-info'}
            ) }}

            {% if event.locales|length > 1 %}
                <div class="dropdown pull-right" style="margin: 0 10px;">
                    <button class="btn btn-info dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        {{ 'admin.happening.button.export'|trans }}
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right export_localize">
                        {% for locale in event.locales %}
                        <li>
                            <a href="{{ path('admin_happening_export', {event: event.id, locale: locale}) }}">
                                {{ locale|locale(app.request.locale)|capitalize }}
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <a class="btn btn-info export_localize" href="{{ path('admin_happening_export', {event: event.id, locale: event.locales|first}) }}">
                    {{ 'admin.happening.button.export'|trans }}
                </a>
            {% endif %}
        </div>
    </h1>

    <div>
        <a href="{{ path('admin_happening_create', { 'event': event.id }) }}" class="btn btn-primary new-action">
            {{ 'admin.happening.add'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.happening.list.title'|trans }}</th>
            <th>{{ 'admin.happening.list.category'|trans }}</th>
            <th>{{ 'admin.happening.list.speaker'|trans }}</th>
            <th>{{ 'admin.happening.list.begin'|trans }}</th>
            <th>{{ 'admin.happening.list.end'|trans }}</th>
            <th>{{ 'admin.happening.list.question'|trans }}</th>
            <th>{{ 'admin.happening.list.participation'|trans }}</th>
            <th>{{ 'admin.happening.list.limit'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for happening in list.happenings %}
            <tr>
                <td>
                    {{ happening.title }}

                    {% if happening.hasProducts %}
                        <i class="glyphicon glyphicon-product-option" data-toggle="tooltip" title="{{ "admin.happening.products.tooltip"|trans }}"></i>
                    {% endif %}

                    {% if happening.isPrivate %}
                        <span class="label label-default">
                            <i class="glyphicon glyphicon-eye-close"></i> {{ 'admin.happening.private'|trans }}
                        </span>
                    {% endif %}

                    {% if happening.isWebinar %}
                        <span class="label label-info">
                            {{ happening.isVideoWebinar ? 'admin.happening.type.videoWebinar'|trans : (happening.isInteractiveWebinar ? 'admin.happening.type.interactiveWebinar'|trans : 'admin.happening.type.webinar'|trans) }}
                            {% if happening.isWebinarRecorded %}
                                <i class="icon-Video_2"></i>
                            {% endif %}
                        </span>
                    {% endif %}
                </td>
                <td>{{ happening.categoryTitle }}</td>
                <td>
                    {% for speaker in happening.speakers %}
                        {{ speaker.fullName }}{% if loop.index < loop.length %}, {% endif %}
                    {% endfor %}
                </td>
                <td>{{ happening.begin|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                <td>{{ happening.end|localizeddate('medium', 'short', app.request.locale, event.timeZone) }}</td>
                <td>{{ happening.questionAllowed ? '✓' : '' }}</td>
                <td>{{ happening.participations }}</td>
                <td>{{ happening.hasLimit ? happening.limit : 'admin.happening.list.no-limit'|trans}}</td>
                <td class="text-right">
                    {% set updateBtn %}
                        <a href="{{ path('admin_happening_update', { 'event': event.id, 'happening': happening.id }) }}" class="btn btn-default btn-sm">
                            {{ 'admin.happening.update'|trans }}
                        </a>
                    {% endset %}

                    {% if happening.isWebinarRecorded %}
                    <div class="dropdown btn-group pull-right" data-toggle="tooltip" data-placement="top">
                        {{ updateBtn }}
                        <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <span class="caret"></span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a href="{{ path('admin_happening_download', { 'event': event.id, 'happening': happening.id }) }}">
                                    {# todo change translation key #}
                                    {{ 'download'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                    {% else %}
                        {{ updateBtn }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
