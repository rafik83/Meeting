{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1><a href="{{ path('admin_event_read', {event: event.id}) }}">{{ event.title }}</a></h1>

    <h2>{{ 'admin.happening.title'|trans }}</h2>

    <div class="text-right">
        <a href="{{ path('admin_happening_create', { 'event': event.id }) }}" class="btn btn-success">
            {{ 'admin.happening.add'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>Titre</th>
            <th>Intervenants</th>
            <th>Début</th>
            <th>Fin</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        {% for happening in happenings %}
            <tr>
                <td>{{ happening.title }}</td>
                <td>{{ happening.speakers|join(', ') }}</td>
                <td>{{ happening.begin|date('d/m/Y h\\hi') }}</td>
                <td>{{ happening.end|date('d/m/Y h\\hi') }}</td>
                <td>
                    {% if happening.canUpdate %}
                        <a href="{{ path('admin_happening_update', { 'event': event.id, 'happening': happening.id }) }}" class="btn btn-default">
                            {{ 'admin.happening.update'|trans }}
                        </a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="text-left">
        <a href="{{ path('admin_event_list') }}" class="btn btn-link">&larr; Retour aux événements</a>
    </div>
{% endblock %}
