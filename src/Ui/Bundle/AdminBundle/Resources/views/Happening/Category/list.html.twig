{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
<h1 class="page-header">{{ 'admin.happening_category.title'|trans }}</h1>

    <div>
        <a href="{{ path('admin_happening_category_create', { 'event': event.id }) }}" class="btn btn-sm btn-primary new-action">
            {{ 'admin.happening_category.add'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.happening_category.table.column.position'|trans }}</th>
            <th>{{ 'admin.happening_category.table.column.title'|trans }}</th>
            <th>{{ 'admin.happening_category.table.column.picto'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.position }}</td>
                <td>{{ category.title }}</td>
                <td>{{ category.picto }}</td>
                <td class="text-right">
                    <a href="{{ path('admin_happening_category_update', { 'event': event.id, 'category': category.id }) }}" class="btn btn-default">
                        {{ 'admin.happening_category.update'|trans }}
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
