{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.happening_category.title'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.happening_category.title'|trans }}
        <div class="pull-right">
            <a class="btn btn-info" href="{{ path('admin_happening_list', {event: event.id}) }}">
                {{ 'admin.happening_category.button.happening'|trans }}
            </a>
            <a class="btn btn-info" href="{{ path('admin_happening_speaker_list', {event: event.id}) }}">
                {{ 'admin.happening_category.button.speaker'|trans }}
            </a>
        </div>
    </h1>

    <div>
        <a href="{{ path('admin_happening_category_create', { 'event': event.id }) }}" class="btn btn-primary new-action">
            {{ 'admin.happening_category.add'|trans }}
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.happening_category.table.column.title'|trans }}</th>
            <th>{{ 'admin.happening_category.table.column.picto'|trans }}</th>
            <th>{{ 'admin.happening_category.table.column.rank'|trans }}</th>
            <th>{{ 'admin.happening_category.table.column.color'|trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.title }}</td>
                <td><i class="icon-{{ category.picto }}"></i></td>
                <td>{{ category.rank }}</td>
                <td style="background-image: linear-gradient(to right, {{ category.leftColor }}, {{ category.rightColor }});"></td>
                <td class="text-right">
                    <a href="{{ path('admin_happening_category_update', { 'event': event.id, 'category': category.id }) }}" class="btn btn-sm btn-default">
                        {{ 'admin.happening_category.update'|trans }}
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
