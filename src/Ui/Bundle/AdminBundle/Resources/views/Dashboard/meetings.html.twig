<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-DemandeRDV"></i> {{ 'admin.meeting.dashboard.request'|trans }}
            </div>
            <div class="panel-body text-center">
                <h1>{{ dashboard.request }}</h1>
                <ul class="list-unstyled">
                    <li>{{ 'admin.meeting.dashboard.approvedRequest'|trans }}: {{ dashboard.approvedRequest }}</li>
                    <li>{{ 'admin.meeting.dashboard.pendingRequest'|trans }}: {{ dashboard.pendingRequest }}</li>
                    <li>{{ 'admin.meeting.dashboard.refusedRequest'|trans }}: {{ dashboard.refusedRequest }}</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-RDV"></i> {{ 'admin.meeting.dashboard.meeting'|trans }}
            </div>
            <div class="panel-body text-center">
                <h1>{{ dashboard.meeting }}</h1>
                <ul class="list-unstyled">
                    <li>{{ 'admin.meeting.dashboard.createdByPlanner'|trans }}: {{ dashboard.meetingCreatedByPlanner }}</li>
                    <li>{{ 'admin.meeting.dashboard.plannedMeeting'|trans }}: {{ dashboard.meetingCreatedUpstreamByAdmin }}</li>
                    <li>{{ 'admin.meeting.dashboard.createdDayD.admin'|trans }}: {{ dashboard.meetingCreatedDayDByAdmin }}</li>
                    <li>{{ 'admin.meeting.dashboard.createdDayD.participant'|trans }}: {{ dashboard.meetingCreatedByParticipant }}</li>
                    <li>{{ 'admin.meeting.dashboard.callVisio'|trans }}: {{ dashboard.meetingCallVisio }}</li>
                </ul>
            </div>
        </div>
    </div>
</div>
