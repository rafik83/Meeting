<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-Document_1"></i> {{ 'admin.sheet.dashboard.sheets_participants_meetings'|trans }}
            </div>
            <div class="panel-body text-center">
                <table class="table table-striped table-condensed table-hover">
                    <thead>
                    <tr>
                        <th>{{ 'admin.sheet.dashboard.by_type.type'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.sheets'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.participants'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.requests'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.requests_accepted'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.requests_refused'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.meetings'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.meetings_evaluated_5_stars'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.meetings_evaluated_4_stars'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.meetings_evaluated_3_stars'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.meetings_evaluated_2_stars'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.meetings_evaluated_1_stars'|trans }}</th>
                        <th>{{ 'admin.sheet.dashboard.by_type.meetings_not_evaluated'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                        {% for idType, sheetType in dashboard.sheetsType %}
                            <tr>
                                <td>{{ sheetType.title }}</td>
                                <td>{{ sheetType.total }}</td>
                                <td>{{ dashboard.participantsTypeView[idType].total }}</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                                <td>x</td>
                            </tr>
                        {% endfor %}
                    </tbody>

                    <tfoot>
                        <tr>
                            <th>{{ 'admin.sheet.dashboard.by_type.total'|trans }}</th>
                            <td>{{ dashboard.totalEnabledSheets }}</td>
                            <td>{{ dashboard.totalParticipants }}</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                            <td>x</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
