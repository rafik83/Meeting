<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-Document_1"></i> {{ 'admin.sheet.dashboard.totalSheet'|trans }}
            </div>
            <div class="panel-body text-center">
                <h1>{{ dashboard.totalEnabledSheets }}</h1>
                <ul class="list-unstyled">
                    {% for sheetType in dashboard.sheetsType %}
                        <li>{{ sheetType.title ~ ': ' ~ sheetType.total }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-Profil_1"></i> {{ 'admin.sheet.dashboard.totalParticipants'|trans }}
            </div>
            <div class="panel-body text-center">
                <h1>{{ dashboard.totalParticipants }}</h1>
                <ul class="list-unstyled">
                    {% for participantType in dashboard.participantsTypeView %}
                        <li>{{ participantType.title ~ ': ' ~ participantType.total }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
