{% extends 'AdminBundle::base.html.twig' %}
{% from 'AdminBundle::macro.html.twig' import delete_button %}
{% block title 'admin.admin_list.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.admin_list.title'|trans }}</h1>

    <div class="col-xs-12">
        {{ form_start(filter_form) }}
        <div class="col-xs-4">
            {{ form_row(filter_form.role) }}
        </div>
        <div class="col-xs-4">
            {{ form_row(filter_form.event) }}
        </div>
        <div class="col-xs-4">
            {{ form_row(filter_form.submit) }}
            {% if filtered %}
                <a href="{{ path('admin_list_admin') }}" class="btn btn-link">{{ 'admin.admin_list.filter.empty_filter'|trans }}</a>
            {% endif %}
        </div>
        {{ form_rest(filter_form) }}
        {{ form_end(filter_form) }}
    </div>
    <a href="{{ path('admin_create_admin') }}" class="btn btn-primary">{{ 'admin.admin_list.action.create'|trans }}</a>
    <a href="{{ path('admin_create_partner') }}" class="btn btn-primary">{{ 'admin.operator_list.action.create.partner'|trans }}</a>
    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.admin_list.table.title.lastname'|trans }}</th>
            <th>{{ 'admin.admin_list.table.title.firstname'|trans }}</th>
            <th>{{ 'admin.admin_list.table.title.email'|trans }}</th>
            <th>{{ 'admin.admin_list.table.title.role'|trans }}</th>
            <th>{{ 'admin.admin_list.table.title.events'|trans }}</th>
            <th>{{ 'admin.admin_list.table.title.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for admin in admins %}
            <tr>
                <td>{{ admin.lastname }}</td>
                <td>{{ admin.firstname }}</td>
                <td>{{ admin.email }}</td>
                <td>{{ ('admin.role.' ~ admin.role)|trans }}</td>
                <td>
                    {% if admin.isSuperAdmin %}
                        {% if admin.events|length == 0 %}
                            {{ 'admin.admin_list.table.content.super_admin.events.all'|trans }}
                        {% else %}
                            <ul>
                                {% for event in admin.events %}
                                    <li>{{ event.title }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% else %}
                        {% if admin.events|length == 0 %}
                            {{ 'admin.admin_list.table.content.admin.events.none'|trans }}
                        {% else %}
                            <ul>
                                {% for event in admin.events %}
                                    <li>{{ event.title }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endif %}
                </td>
                <td>
                    {% if admin.partner %}
                        <a href="{{ path('admin_update_partner', {'partner': admin.id}) }}" class="btn btn-default">{{ 'admin.admin_list.table.content.update'|trans }}</a>
                    {% else %}
                        <a href="{{ path('admin_update_admin', {'admin': admin.id}) }}" class="btn btn-default">{{ 'admin.admin_list.table.content.update'|trans }}</a>
                    {% endif %}
                    {{ delete_button(
                        path('admin_delete_admin', {'admin': admin.id, 'type': 'admin'}),
                        'admin.remove'|trans,
                        {
                            'class' : 'btn btn-danger btn-sm',
                            'data-confirm': 'admin.remove.confirmation'|trans
                        },
                        constant('Proximum\\Vimeet\\Domain\\Intention\\IntentionType::INTENTION_REMOVE_ADMIN')
                    ) }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': admins}) }}
{% endblock %}
