{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.template.sheet.link'|trans %}

{% block content %}

    <h1 class="page-header">{{ 'admin.template.sheet.link'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.template.sheet.table.column.title'|trans }}</th>
            <th>{{ 'admin.template.sheet.table.column.eventType'|trans }}</th>
            <th class="text-right">{{ 'admin.template.sheet.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for template in templates %}
            <tr>
                <td>{{ template.title }}</td>
                <td>
                    {{ template.event.title }}
                    {% if template.types is not null %}
                        <ul>
                            {% for type in template.types %}
                                <li>{{ type.getTitle(type.event.getAvailableLocale(app.request.locale)) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
                <td class="text-right">
                    <div class="btn-group">
                        <a href="{{ path('admin_template_sheet_builder', {
                            'template': template.id, 'locale': template.fallback
                        }) }}" class="btn btn-sm btn-default">
                            {{ 'admin.template.action.edit'|trans }}
                        </a>
                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a href="{{ path('admin_template_sheet_preview_update', {
                                    'template': template.id
                                }) }}">{{ 'admin.template.action.preview'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_template_sheet_print_template_builder', {
                                    'template': template.id
                                }) }}">{{ 'admin.template.action.print'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_organizer_template_sheet_duplicate', { 'template': template.id }) }}"
                                   data-toggle="modal" data-target="#duplicate-modal">
                                    {{ 'admin.template.action.duplicate'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="modal fade clear-on-hidden-modal" id="duplicate-modal" tabindex="-1" role="dialog"
         data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>

{% endblock %}
