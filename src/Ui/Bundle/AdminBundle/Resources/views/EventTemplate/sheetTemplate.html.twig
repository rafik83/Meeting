{% extends 'AdminBundle::base.html.twig' %}

{% block content %}

    <h1 class="page-header">{{ 'admin.template.sheet.link'|trans }}</h1>

    <h3 class="page-header">{{ 'admin.template.sheet.titleBase'|trans }}</h3>
    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.template.sheet.table.column.title'|trans }}</th>
            <th class="text-right">{{ 'admin.template.sheet.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for baseTemplate in baseTemplates %}
            <tr>
                <td>{{ baseTemplate.title }}</td>
                <td class="text-right">
                    <a href="{{ path('admin_template_sheet_duplicate', { 'template': baseTemplate.id }) }}"
                       class="btn btn-primary btn-sm" data-toggle="modal"
                       data-target="#duplicate-modal">{{ 'admin.template.action.duplicate'|trans }}</a>
                    <a href="{{ path('admin_template_sheet_builder', { 'template': baseTemplate.id, 'locale': baseTemplate.fallback }) }}"
                       class="btn btn-primary btn-sm">{{ 'admin.template.action.edit'|trans }}</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h3 class="page-header">{{ 'admin.template.sheet.titleEvent'|trans }}</h3>
    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.template.sheet.table.column.title'|trans }}</th>
            <th>{{ 'admin.template.sheet.table.column.eventType'|trans }}</th>
            <th class="text-right">{{ 'admin.template.sheet.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for template in templates %}
            <tr>
                <td>{{ template.title }}</td>
                <td>
                    {{ template.event.title }}
                    {% if template.types is not null %}
                        <ul>
                            {% for type in template.types %}
                                <li>{{ type.getTitle(type.event.getAvailableLocale(app.request.locale)) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
                <td class="text-right">
                    <a href="{{ path('admin_template_sheet_duplicate', { 'template': template.id }) }}"
                       class="btn btn-primary btn-sm" data-toggle="modal"
                       data-target="#duplicate-modal">{{ 'admin.template.action.duplicate'|trans }}</a>
                    <a href="{{ path('admin_template_sheet_builder', { 'template': template.id, 'locale': template.fallback }) }}"
                       class="btn btn-primary btn-sm">{{ 'admin.template.action.edit'|trans }}</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
