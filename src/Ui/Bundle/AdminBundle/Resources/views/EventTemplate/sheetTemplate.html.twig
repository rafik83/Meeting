{% extends 'AdminBundle::base.html.twig' %}

{% block content %}

    <h1 class="page-header">{{ 'admin.template.sheet.link'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.template.sheet.table.column.title'|trans }}</th>
            <th>{{ 'admin.template.sheet.table.column.eventType'|trans }}</th>
            <th class="text-right">{{ 'admin.template.sheet.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for template in templates %}
            <tr>
                <td>{{ template.title }}</td>
                <td>
                    {{ template.event.title }}
                    {% if template.types is not null %}
                        <ul>
                            {% for type in template.types %}
                                <li>{{ type.getTitle(type.event.getAvailableLocale(app.request.locale)) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
                <td class="text-right">
                    <a href="{{ path('admin_organizer_template_sheet_duplicate', { 'template': template.id }) }}"
                       class="btn btn-primary btn-sm" data-toggle="modal"
                       data-target="#duplicate-modal">{{ 'admin.template.action.duplicate'|trans }}</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="modal fade clear-on-hidden-modal" id="duplicate-modal" tabindex="-1" role="dialog"
         data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>

{% endblock %}
