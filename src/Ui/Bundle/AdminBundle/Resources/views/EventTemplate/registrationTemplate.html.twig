{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.template.registration.link'|trans %}

{% block content %}
    <h1 class="page-header">
        {{ 'admin.template.registration.title'|trans }}
        <div class="pull-right">
            <a href="{{ path('admin_template_registration_create', {'event': event.id}) }}"
               class="btn btn-primary"
               data-toggle="modal"
               data-target="#duplicate-modal"
            >
                {{ 'admin.template.registration.table.content.create'|trans }}
            </a>
        </div>
    </h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.template.registration.table.column.title'|trans }}</th>
            <th>{{ 'admin.template.registration.table.column.eventType'|trans }}</th>
            <th>{{ 'admin.template.registration.table.column.createdAt'|trans }}</th>
            <th class="text-right">{{ 'admin.template.registration.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for template in templates %}
            <tr>
                <td>{{ template.title }}</td>
                <td>
                    {{ template.event.title }}
                    {% if template.types is not null %}
                        <ul>
                            {% for type in template.types %}
                                <li>{{ type.getTitle(type.event.getAvailableLocale(app.request.locale)) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
                <td>{{ template.createdAt|localizeddate('medium', 'short', app.request.locale) }}</td>
                <td class="text-right">
                    <div class="btn-group">
                        <a href="{{ path('admin_template_registration_build', { 'registrationTemplate': template.id, 'locale': template.fallback }) }}" class="btn btn-default btn-sm">
                            {{ 'admin.template.registration.table.content.edit'|trans }}
                        </a>
                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a href="{{ path('admin_template_registration_json', { 'registrationTemplate': template.id, 'locale': template.fallback }) }}" class="btn-sm">
                                    {{ 'admin.template.registration.table.content.editJson'|trans }}
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_template_registration_duplicate', { 'template': template.id }) }}"
                                   class="btn-sm"
                                   data-toggle="modal"
                                   data-target="#duplicate-modal"
                                >
                                    {{ 'admin.template.registration.table.content.duplicate'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="modal fade clear-on-hidden-modal" id="duplicate-modal" tabindex="-1" role="dialog"
         data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>

{% endblock %}
