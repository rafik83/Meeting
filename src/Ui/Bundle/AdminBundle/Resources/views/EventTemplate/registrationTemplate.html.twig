{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.template.registration.title'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.template.registration.table.column.title'|trans }}</th>
            <th>{{ 'admin.template.registration.table.column.createdAt'|trans }}</th>
            <th class="text-right">{{ 'admin.template.registration.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for template in templates %}
            <tr>
                <td>{{ template.title }}</td>
                <td>{{ template.createdAt|localizeddate('medium', 'short', app.request.locale) }}</td>
                <td class="text-right">
                    <a href="{{ path('admin_template_registration_builder', { 'template': template.id, 'locale': template.fallback }) }}" class="btn btn-primary btn-sm">{{ 'admin.template.registration.table.content.edit'|trans }}</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
