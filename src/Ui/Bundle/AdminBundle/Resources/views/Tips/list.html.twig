{% extends 'AdminBundle::base.html.twig' %}

{% block content %}
    <h1 class="page-header">{{ 'admin.tips.list.title'|trans }}</h1>

    <a href="{{ path('admin_tips_create') }}" class="btn btn-primary">{{ 'admin.tips.create.link'|trans }}</a>

    {% if tips.results is not empty %}
        <table class="table table-hover">
            <thead>
            <tr>
                <th>{{ 'admin.tips.column.title'|trans }}</th>
                <th>{{ 'admin.tips.column.lang'|trans }}</th>
                <th>{{ 'admin.tips.column.content'|trans }}</th>
                <th>{{ 'admin.tips.column.visible.meeting_management'|trans }}</th>
                <th>{{ 'admin.tips.column.visible.catalog'|trans }}</th>
                <th>{{ 'admin.tips.column.visible.print_planning'|trans }}</th>
                <th></th>
            </tr>
            </thead>
                <tbody>
                {% for tip in tips %}
                    <tr>
                        <td>{{ tip.title }}</td>
                        <td>{{ tip.lang }}</td>
                        <td>{{ tip.content|slice(0, 42) ~ '...' }}</td>
                        <td>{{ tip.isOnMeetingManagement ? 'admin.tips.visible'|trans : 'admin.tips.invisible'|trans }}</td>
                        <td>{{ tip.isOnCatalog ? 'admin.tips.visible'|trans : 'admin.tips.invisible'|trans }}</td>
                        <td>{{ tip.isOnPrintPlanning ? 'admin.tips.visible'|trans : 'admin.tips.invisible'|trans  }}</td>
                        <td class="text-right">
                            <div class="btn-group">
                                <a class="btn btn-default btn-sm" href="{{ path('') }}">
                                    {{ 'admin.tips.update.link'|trans }}
                                </a>
                                <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="caret"></span>
                                </button>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info">
                <p class="center">{{ 'admin.tips.empty'|trans }}</p>
            </div>
        {% endif %}

    {{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': tips.results }) }}
{% endblock %}
