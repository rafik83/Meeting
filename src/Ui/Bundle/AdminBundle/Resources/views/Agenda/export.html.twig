{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.agenda.export.link'|trans %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block content %}
    <h1 class="page-header">{{ 'admin.agenda.export.title'|trans }}</h1>

    <div class="row">
        <div class="col-md-6 text-center">
            <div class="panel panel-default">
                <div class="panel-heading">{{ 'admin.agenda.export.omz'|trans }}</div>
                <div class="panel-body">
                    <form action="{{ path('admin_agenda_export_participant_export', { 'event': event.id }) }}" method="POST">
                        <input type="submit" class="btn btn-default" value="{{ 'admin.agenda.export.participant_schedules.title'|trans }}" />
                    </form>
                </div>
            </div>
        </div>

        {% if is_granted('ROLE_ALLOWED_TO_ORGANIZE') %}
            <div class="col-md-6 text-center">
                <div class="panel panel-default">
                    <div class="panel-heading">{{ 'admin.sheet.export.meetings.button.label'|trans }}</div>
                    <div class="panel-body">
                        <form action="{{ path('admin_meeting_export', { 'event': event.id }) }}" method="POST">
                            <input type="submit" value="{{ 'admin.sheet.export.meetings.button.label'|trans }}" class="btn btn-default"/>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6 text-center">
                <div class="panel panel-default">
                    <div class="panel-heading">{{ 'admin.user.export.title'|trans }}</div>
                    <div class="panel-body">
                        <form action="{{ path('admin_user_contact_evaluation_stats_export', { 'event': event.id }) }}" method="POST">
                            <input type="submit" value="{{ 'admin.user.export.contact.evaluation'|trans }}" class="btn btn-default"/>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <div class="col-md-6 text-center">
                <div class="panel panel-default">
                    <div class="panel-heading">{{ 'admin.meeting.action.deleteAll.title'|trans }}</div>
                    <div class="panel-body">
                        {{ macro.delete_button(
                            path('admin_meeting_delete_all', {'event': event.id}),
                            'admin.meeting.action.deleteAll.title'|trans,
                            {'class': 'btn btn-danger', 'data-confirm': 'admin.meeting.action.deleteAll.confirm'|trans}
                        ) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
