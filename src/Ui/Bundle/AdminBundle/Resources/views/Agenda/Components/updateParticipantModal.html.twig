<script type="x/template" id="update-participant-modal">
    <modal :show="show" v-on:close-modal="$emit('close-modal')" v-on:refresh-list="refreshList">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'admin.common.close'|trans }}" v-on:click="$emit('close-modal')">
                <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title" id="filterSheetModalLabel">{{ 'admin.agenda.request.updateParticipant.title.label'|trans }}</h4>
        </div>
        <div class="modal-body">
            <update-participant-form :data="formData"></update-participant-form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal" v-on:click="$emit('close-modal')">
                {{ 'admin.common.close'|trans }}
            </button>
            <button type="button" class="btn btn-primary" v-on:click="save()">
                {{ 'admin.agenda.request.updateParticipant.submit.label'|trans }}
            </button>
        </div>
    </modal>
</script>
