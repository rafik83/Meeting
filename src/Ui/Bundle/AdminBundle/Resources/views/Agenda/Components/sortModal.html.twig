<script type="x/template" id="sort-modal">
    <modal :show="show" v-on:close-modal="$emit('close-modal')">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'admin.common.close'|trans }}" v-on:click="$emit('close-modal')">
                <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title">{{ 'admin.agenda.sort.title.label'|trans }}</h4>
        </div>
        <div class="modal-body">
            <sort-sheet-form :sort="formSort" :sheets="sheets"></sort-sheet-form>
        </div>
        <div class="modal-footer">
            <a href="#" class="btn btn-link" data-dismiss="modal" v-on:click="$emit('close-modal')">
                {{ 'admin.common.close'|trans }}
            </a>
            <button type="button" class="btn btn-primary" v-on:click="save()">
                {{ 'admin.agenda.sort.submit.label'|trans }}
            </button>
        </div>
    </modal>
</script>
