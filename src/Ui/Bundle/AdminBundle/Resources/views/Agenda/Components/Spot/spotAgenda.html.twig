<script type="x/template" id="spot-agenda">
    <div class="panel panel-default agenda-panel">
        <div class="panel-heading text-center">
            <a href="#" class="pull-right" v-on:click="close()">
                <span class="glyphicon glyphicon-remove"></span>
            </a>
            <strong>${ spot.reference }</strong>
        </div>
        <div class="panel-body">
            <table class="table-agenda table-condensed">
                <tr>
                    <td v-for="day in spot.days">
                        <div class="text-center">{{ 'admin.agenda.dayPrefix'|trans }}${ day.day + 1 }</div>
                        <table class="table-agenda-day table table-bordered table-condensed">
                            <tr v-for="slot in day.slots"
                                class="table-agenda-day-slot table-slot-spot"
                                v-bind:class="{ 'slot meeting' : slot.type === 'meeting_unavailability'}">
                                <spot-slot-agenda v-bind:agendaSlot="slot"></spot-slot-agenda>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</script>
