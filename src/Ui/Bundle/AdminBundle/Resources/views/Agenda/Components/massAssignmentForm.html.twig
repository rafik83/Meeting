<script type="x/template" id="mass-assignment-form">
    <form>
        <div class="form-group">
            <label for="massAssignmentBegin">{{ 'admin.schedule.days.startTime'|trans }}</label>
            <input
                    type="text"
                    name="mass_assignment[begin]"
                    id="massAssignmentBegin"
                    data-datetimepicker="beginTime"
                    autocomplete="off"
                    data-allow-dates="data-allow-dates"
                    data-allow-hours="data-allow-hours"
                    class="form-control"
                    v-model="beginTime">
        </div>
        <div class="form-group">
            <label for="massAssignmentBegin">{{ 'admin.schedule.days.endTime'|trans }}</label>
            <input
                    type="text"
                    name="mass_assignment[end]"
                    id="massAssignmentEnd"
                    data-datetimepicker="endTime"
                    autocomplete="off"
                    data-allow-dates="data-allow-dates"
                    data-allow-hours="data-allow-hours"
                    class="form-control"
                    v-model="endTime">
        </div>
        <div class="form-group">
            <label for="enabled">
                <input type="checkbox" id="enabled" v-model="enabled">
                {{ 'admin.agenda.mass_assignment.enabled.label'|trans }}
            </label>
        </div>
    </form>
</script>
