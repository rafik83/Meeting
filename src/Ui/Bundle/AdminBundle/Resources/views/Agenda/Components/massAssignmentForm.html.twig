<script type="x/template" id="mass-assignment-form">
    <form>
        <div class="form-group">
            <label for="selectedTypes">{{ 'admin.schedule.days.startTime'|trans }}</label>
            <input
                    type="text"
                    name="mass_assignment[begin]"
                    data-datatimepicker="fr"
                    autocomplete="off"
                    data-allow-hours="data-allow-hours"
                    class="form-control form-control">
        </div>
        <div class="form-group">
            <label for="selectedTypes">{{ 'admin.schedule.days.endTime'|trans }}</label>
            <input
                    type="text"
                    name="mass_assignment[end]"
                    data-datatimepicker="fr"
                    autocomplete="off"
                    data-allow-hours="data-allow-hours"
                    class="form-control form-control">
        </div>
    </form>
</script>
