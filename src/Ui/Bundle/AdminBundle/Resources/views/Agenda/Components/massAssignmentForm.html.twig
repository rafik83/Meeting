<script type="x/template" id="mass-assignment-form">
    <form>
        <div class="form-group">
            <label for="massAssignmentBegin">{{ 'admin.schedule.days.startTime'|trans }}</label>
            <input
                    type="text"
                    name="mass_assignment[begin]"
                    id="massAssignmentBegin"
                    data-datatimepicker="fr"
                    autocomplete="off"
                    data-allow-hours="data-allow-hours"
                    class="form-control">
        </div>
        <div class="form-group">
            <label for="massAssignmentBegin">{{ 'admin.schedule.days.endTime'|trans }}</label>
            <input
                    type="text"
                    name="mass_assignment[end]"
                    id="massAssignmentEnd"
                    data-datatimepicker="fr"
                    autocomplete="off"
                    data-allow-hours="data-allow-hours"
                    class="form-control">
        </div>
        <div class="form-group">
            <label for="deactivate">
                <input type="checkbox" id="deactivate">
                {{ 'admin.agenda.mass_assignment.deactivate.label'|trans }}
            </label>
        </div>
    </form>
</script>
