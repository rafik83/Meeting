<script type="x/template" id="sheet-agenda">
    <div class="panel panel-default agenda-panel">
        <div v-bind:class="{ 'agenda-sheet-focus': sheet == focusedSheet }" class="panel-heading">
            <a href="#" class="pull-right" v-on:click="close()"><span class="glyphicon glyphicon-remove"></span></a>
            <a v-bind:href="sheet.url" target="_blank" title="{{ 'admin.agenda.sheet.see'|trans }}" class="link-to-sheet"><span class="glyphicon"></span></a>
            <a v-bind:href="routeToUpdateSheetAttendance" target="_blank" title="{{ 'admin.agenda.sheet.attend'|trans }}">
                <span class="glyphicon glyphicon-minus-sign"></span>
            </a>
            <a href="#" v-on:click="focus()">${ sheet.title }</a>
        </div>
        <div class="panel-body">
            <table class="table-agenda table-condensed">
                <tr>
                    <td v-for="participant in sheet.participants">
                        <div >

                        </div>
                        <p class="text-center">
                            ${ participant.fullname }
                            <span v-if="participant.isAttending === true && participant.isSmsActivateDatePassed === true && participant.isPhoneValidated === true">
                                <button
                                    v-if="!participant.stopSMS"
                                    class="btn btn-default btn-xs pull-right text-center"
                                    v-on:click="$store.commit('OPEN_USER_AGENDA_VERSION_MODAL', participant.id)"
                                >
                                    <i class="icon-Smartphone"></i>
                                </button>
                                <span class="label label-danger" v-if="participant.stopSMS">
                                    {{ 'admin.agenda.stopSMS'|trans }}
                                </span>
                            </span>
                        </p>
                        <table class="table">
                            <tr>
                                <td v-for="day in participant.days" class="col-xs-6">
                                    <div class="text-center">{{ 'admin.agenda.dayPrefix'|trans }}${ day.day+1 }</div>
                                    <table class="table-agenda-day table table-bordered table-condensed">
                                        <tr v-for="slot in day.slots">
                                            <slot-agenda
                                                ref="childSlotAgenda"
                                                v-bind:agendaSlot="slot"
                                                v-bind:sheet="sheet"
                                                v-bind:isAvailableForMeeting="isAvailableForMeeting(slot)"
                                                v-bind:participant="participant"
                                                v-bind:highlight="slot.highlight"
                                                v-bind:slotToBeMoved="slotToBeMoved"
                                                v-on:show-meeting-update-modal="showMeetingUpdateModal"
                                                v-on:refresh-agenda="refreshAgenda"
                                                v-on:meeting-removed="handleMeetingRemoved"
                                                v-on:meeting-removing="handleMeetingRemoving"
                                                v-on:meeting-moved="handleMeetingMoved"
                                                v-on:show-agenda-for-sheet-id="showAgendaForSheetId"
                                                v-on:schedule-meeting="scheduleMeeting"
                                                v-on:show-available-meeting-slot="loadSlotsForMeeting"
                                                v-on:meeting-moving="handleMeetingMoving"
                                                v-on:meeting-removed-error="handleMeetingRemovedError"
                                                v-on:show-mass-assignment="showMassAssignment(slot.massAssignmentId)">
                                            >
                                            </slot-agenda>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</script>
