<script type="x/template" id="filter-sheet-form">
    <form>
        <div class="form-group">
            <label for="selectedTypes">{{ 'admin.agenda.filters.type'|trans }}</label>
            <div class="checkbox" v-for="type in types">
                <label>
                    <input name="selectedTypes" type="checkbox" v-model:value="filters.selectedTypes" :value="type">
                    ${ type }
                </label>
            </div>
        </div>
        <div class="form-group">
            <label for="selectedTypes">{{ 'admin.agenda.filters.indicators.label'|trans }}</label>
            <div class="checkbox">
                <label>
                    <input name="selectedTypes" type="checkbox" v-model:value="filters.hasSentMeetingRequest" v-bind:value="true">
                    {{ 'admin.agenda.filters.hasSentMeetingRequest.label'|trans }}
                </label>
            </div>
            <div class="checkbox">
                <label>
                    <input name="selectedTypes" type="checkbox" v-model:value="filters.hasMeetingToApprove" v-bind:value="true">
                    {{ 'admin.agenda.filters.hasMeetingToApprove.label'|trans }}
                </label>
            </div>
            <div class="checkbox">
                <label>
                    <input name="selectedTypes" type="checkbox" v-model:value="filters.hasNotEnoughAvailableSlot" v-bind:value="true">
                    {{ 'admin.agenda.filters.hasNotEnoughtAvailableSlot.label'|trans }}
                </label>
            </div>
            </ul>
        </div>
    </form>
</script>
