<script type="x/template" id="filter-sheet-form">
<div class="row">
    <div class="col-md-12">
        <form>
            <div class="form-group">
                <div class="col-md-6 btn-np">
                    <label for="selectedTypes">
                        {{ 'admin.agenda.filters.type'|trans }}
                    </label>
                </div>
                <div class="col-md-6" id="typesList">
                    <div v-for="type in types" class="checkbox">
                        <label>
                            <input name="selectedTypes" type="checkbox" v-model:value="filters.selectedTypes" v-bind:value="type">
                            ${ type }
                        </label>
                    </div>
                </div>
            </div>
            <b>{{ 'admin.agenda.filters.indicators.label'|trans }}</b>
            <div class="form-group row radio">
                <div class="col-md-6">
                    {{ 'admin.agenda.filters.hasSentMeetingRequest.label'|trans }}
                </div>
                <div class="col-md-6">
                    <label class="radio-inline">
                        <input name="hasSentMeetingRequest" type="radio" v-model:value="filters.hasSentMeetingRequest">
                        {{ 'admin.agenda.filters.hasSentMeetingRequest.all'|trans }}
                    </label>
                    <label class="radio-inline">
                        <input name="hasSentMeetingRequest" type="radio" v-model:value="filters.hasSentMeetingRequest" v-bind:value="true">
                        {{ 'admin.agenda.filters.hasSentMeetingRequest.yes'|trans }}
                    </label>
                    <label class="radio-inline">
                        <input name="hasSentMeetingRequest" type="radio" v-model:value="filters.hasSentMeetingRequest" v-bind:value="false">
                        {{ 'admin.agenda.filters.hasSentMeetingRequest.no'|trans }}
                    </label>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    {{ 'admin.agenda.filters.hasScheduledMeeting.label'|trans }}
                </div>
                <div class="col-md-6">
                    <label class="radio-inline">
                        <input name="hasScheduledMeeting" type="radio" v-model:value="filters.hasScheduledMeetings">
                        {{ 'admin.agenda.filters.hasScheduledMeeting.all'|trans }}
                    </label>
                    <label class="radio-inline">
                        <input name="hasScheduledMeeting" type="radio" v-model:value="filters.hasScheduledMeetings" v-bind:value="true">
                        {{ 'admin.agenda.filters.hasScheduledMeeting.yes'|trans }}
                    </label>
                    <label class="radio-inline">
                        <input name="hasScheduledMeeting" type="radio" v-model:value="filters.hasScheduledMeetings" v-bind:value="false">
                        {{ 'admin.agenda.filters.hasScheduledMeeting.no'|trans }}
                    </label>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    {{ 'admin.agenda.filters.hasMeetingToApprove.label'|trans }}
                </div>
                <div class="col-md-6">
                    <input name="hasMeetingToApprove" type="checkbox" v-model:value="filters.hasMeetingToApprove" v-bind:value="true">
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    {{ 'admin.agenda.filters.hasNotEnoughtAvailableSlot.label'|trans }}
                </div>
                <div class="col-md-6">
                    <input name="hasNotEnoughtAvailableSlot" type="checkbox" v-model:value="filters.hasNotEnoughAvailableSlot" v-bind:value="true">
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    {{ 'admin.agenda.filters.hasAvailableSlot.label'|trans }}
                </div>
                <div class="col-md-6">
                    <input name="hasAvailableSlot" type="checkbox" v-model:value="filters.hasAvailableSlots" v-bind:value="true">
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    {{ 'admin.agenda.filters.hasValidatedRequestNotScheduled.label'|trans }}
                </div>
                <div class="col-md-6">
                    <input name="hasValidatedRequestNotScheduled" type="checkbox" v-model:value="filters.hasValidatedRequestNotScheduled" v-bind:value="true">
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    {{ 'admin.agenda.filters.hasParticipantUnavailableWithMeetingRequest.label'|trans }}
                </div>
                <div class="col-md-6">
                    <input name="hasParticipantUnavailableWithMeetingRequest" type="checkbox" v-model:value="filters.hasParticipantUnavailableWithMeetingRequest" v-bind:value="true">
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-6 btn-np">
                    <label for="selectedFollower">
                        {{ 'admin.agenda.filters.follower.label'|trans }}
                    </label>
                </div>
                <div class="col-md-6">
                    <div class="checkbox">
                        <label>
                            <input name="selectedFollower" type="checkbox" v-model:value="filters.selectedFollowers" v-bind:value="follower_unassigned">
                            {{ 'admin.agenda.filters.follower.unassigned.label'|trans }}
                        </label>
                    </div>
                    <div class="checkbox" v-for="follower in followers">
                        <label>
                            <input name="selectedFollower" type="checkbox" v-model:value="filters.selectedFollowers" v-bind:value="follower.id">
                            ${ follower.fullname }
                        </label>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
</script>
