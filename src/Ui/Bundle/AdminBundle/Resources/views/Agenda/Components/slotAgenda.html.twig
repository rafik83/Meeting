<script type="x/template" id="slot-agenda">
    <td>
        <div class="slot empty-slot" v-bind:class="{ 'available': isAvailableForMeeting }" v-if="agendaSlot.type === 'slot_available'">
            <a href="#" v-on:click="scheduleMeeting()" class="pull-right" v-show="isAvailableForMeeting">
                <span class="glyphicon glyphicon-ok"></span>
            </a>
            <div class="slot-label slot-time">${ agendaSlot.beginEndHour }</div>
        </div>

        <div class="slot unavailability" v-if="agendaSlot.type === 'unavailability'">
            <div class="slot-label slot-time">${ agendaSlot.beginEndHour }</div>
        </div>

        <div class="slot happening" v-if="agendaSlot.type === 'happening_unavailability'">
            <div class="slot-label slot-time">${ agendaSlot.beginEndHour }</div>
        </div>

        <div class="slot meeting" v-bind:class="{ 'meeting-common': highlight, 'meeting-to-be-moved': isAvailableForMeeting }"
             v-if="agendaSlot.type === 'meeting_unavailability'">
            <a href="#" title="{{ 'admin.agenda.meeting.update'|trans }}" class="pull-right" v-on:click="loadMeetingUpdateSpot()" v-show="isActionButtonsEnabled">
                <span class="glyphicon glyphicon-cog"></span>
            </a>

            <a href="#" class="pull-right"
               v-show="!agendaSlot.blockedSlot && isActionButtonsEnabled"
               v-on:click="removeMeeting('{{ 'admin.agenda.remove.confirm'|trans }}')">
                <span class="glyphicon glyphicon-remove"></span>
            </a>

            <a href="#" title="{{ 'admin.agenda.meeting.move'|trans }}" class="pull-right"
               v-on:click="loadSlotsForMeeting()"
               v-show="!agendaSlot.blockedSlot && isActionButtonsEnabled">
                <span class="glyphicon glyphicon-move"></span>
            </a>

            <a href="#" title="{{ 'admin.agenda.meeting.selectSlot'|trans }}" class="pull-right"
               v-on:click="updateMeetingSlot()" v-show="isAvailableForMeeting">
                <span class="glyphicon glyphicon-ok"></span>
            </a>

            <div class="slot-label slot-time">
                <span class="glyphicon glyphicon-lock" v-show="agendaSlot.blockedSlot === true"></span>
                ${ agendaSlot.beginEndHour }
            </div>

            <div class="slot-label">
                <span class="glyphicon glyphicon-question-sign" title="{{ 'admin.agenda.noPreference'|trans }}"
                      v-show="agendaSlot.hasNoPreference === true"></span>
                <a v-bind:title="agendaSlot.sheetMetTitle" v-on:click="showAgendaForSheetId(agendaSlot.sheetMetId)" href="#">${ agendaSlot.sheetMetTitle }</a>
            </div>

            <div class="slot-label">
                <small>
                    <span class="glyphicon glyphicon-lock" v-show="agendaSlot.blockedSpot === true"></span>
                    <span class="glyphicon glyphicon-map-marker"></span>
                    <a href="#spot" aria-controls="spot" role="tab" data-toggle="tab" v-on:click="loadSpotDetail(agendaSlot.spotId)">${ agendaSlot.spotReference }</a>
                </small>
            </div>
        </div>

        <div class="slot mass-unavailability"
             v-if="agendaSlot.type === 'mass_unavailability'"
             v-bind:class="{ 'available': isAvailableForMeeting }"
        >
            <a href="#" v-on:click="scheduleMeeting()" class="pull-right" v-show="isAvailableForMeeting">
                <span class="glyphicon glyphicon-ok"></span>
            </a>
            <div class="slot-label slot-time">${ agendaSlot.beginEndHour }</div>
        </div>

        <div class="slot mass-unavailability" v-if="agendaSlot.type === 'mass_assignment_unavailability'">
            <a href="#"
               title="{{ 'admin.agenda.meeting.mass_assignment.update'|trans }}"
               class="pull-right"
               v-on:click="showMassAssignment(agendaSlot.massAssignmentId)">
                <span class="glyphicon glyphicon-cog"></span>
            </a>
            <div class="slot-label slot-time">${ agendaSlot.beginEndHour }</div>
        </div>

        <div class="slot meeting-on-other-sheet" v-if="agendaSlot.type === 'meeting_on_other_sheet'">
            <div class="slot-label slot-time">${ agendaSlot.beginEndHour }</div>
            <div class="slot-label">
                <span class="glyphicon glyphicon-question-sign" title="{{ 'admin.agenda.noPreference'|trans }}"
                      v-show="agendaSlot.hasNoPreference === true"></span>
                <a v-bind:title="agendaSlot.sheetTitle" v-on:click="showAgendaForSheetId(agendaSlot.sheetId)" href="#">${ agendaSlot.sheetTitle }</a>
            </div>
        </div>

    </td>
</script>
