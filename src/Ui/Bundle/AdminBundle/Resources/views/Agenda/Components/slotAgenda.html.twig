<script type="x/template" id="slot-agenda">
    <td>
        <div v-bind:class="{ 'slot': true, 'empty-slot': true, 'available': isAvailableForMeeting(slot) }"
             v-if="slot-agenda.type === 'slot_available'">
            <a href="#" v-on:click="selectSlot(slot-agenda)" class="pull-right" v-show="isAvailableForMeeting(slot-agenda)">
                <span class="glyphicon glyphicon-ok"></span>
            </a>
            <div class="slot-label slot-time">${ slot-agenda.beginEndHour }</div>
        </div>

        <div class="slot unavailability" v-if="slot-agenda.type === 'unavailability'">
            <div class="slot-label slot-time">${ slot-agenda.beginEndHour }</div>
        </div>

        <div class="slot happening" v-if="slot-agenda.type === 'happening_unavailability'">
            <div class="slot-label slot-time">${ slot-agenda.beginEndHour }</div>
        </div>

        <div v-bind:class="{ 'slot': true, 'meeting': true, 'meeting-common': slot-agenda.highlight === true, 'meeting-to-be-moved': isAvailableForMeeting(slot-agenda) }"
             v-if="slot-agenda.type === 'meeting_unavailability'">
            <a href="#" title="{{ 'admin.agenda.meeting.update'|trans }}" class="pull-right"
               v-on:click="loadMeetingUpdateSpot(sheet, slot-agenda)" v-show="isAvailableAction && !sheet.isAgendaLoading">
                <span class="glyphicon glyphicon-cog"></span>
            </a>

            <a href="#" class="pull-right" v-show="isAvailableAction && !sheet.isAgendaLoading && !slot-agenda.blockedSlot"
               v-on:click="removeMeeting(sheet, slot-agenda, '{{ 'admin.agenda.remove.confirm'|trans }}')">
                <span class="glyphicon glyphicon-remove"></span>
            </a>

            <a href="#" title="{{ 'admin.agenda.meeting.move'|trans }}" class="pull-right"
               v-on:click="loadSlotsForMeeting(sheet, participant, slot-agenda)"
               v-show="isAvailableAction && !sheet.isAgendaLoading && !slot-agenda.blockedSlot">
                <span class="glyphicon glyphicon-move"></span>
            </a>

            <a href="#" title="{{ 'admin.agenda.meeting.selectSlot'|trans }}" class="pull-right"
               v-on:click="selectSlot(slot-agenda)" v-show="isAvailableForMeeting(slot-agenda) && !sheet.isAgendaLoading">
                <span class="glyphicon glyphicon-ok"></span>
            </a>

            <div class="slot-label slot-time">
                <span class="glyphicon glyphicon-lock" v-show="slot-agenda.blockedSlot === true"></span>
                ${ slot-agenda.beginEndHour }
            </div>

            <div class="slot-label">
                <span class="glyphicon glyphicon-question-sign" title="{{ 'admin.agenda.noPreference'|trans }}"
                      v-show="slot-agenda.hasNoPreference === true"></span>
                <a v-bind:title="slot-agenda.sheetMetTitle" v-on:click="showAgendaForSheetId(slot-agenda.sheetMetId)" href="#">${
                    slot-agenda.sheetMetTitle }</a>
            </div>

            <div class="slot-label">
                <small>
                    <span class="glyphicon glyphicon-lock" v-show="slot-agenda.blockedSpot === true"></span>
                    <span class="glyphicon glyphicon-map-marker"></span>
                    ${ slot-agenda.spotReference }
                </small>
            </div>
        </div>

        <div class="slot mass-unavailability" v-if="slot-agenda.type === 'mass_unavailability'">
            <div class="slot-label slot-time">${ slot-agenda.beginEndHour }</div>
        </div>
    </td>
</script>