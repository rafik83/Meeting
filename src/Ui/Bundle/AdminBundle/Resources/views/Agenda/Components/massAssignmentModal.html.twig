<script type="x/template" id="mass-assignment-modal-template">
    <modal :show="show" v-on:close-modal="$emit('close-modal')">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'admin.common.close'|trans }}" v-on:click="$emit('close-modal')">
                <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title" id="massAssignmentModalLabel">{{ 'admin.agenda.mass_assignment.title.label'|trans }}</h4>
        </div>
        <div class="modal-body">
            <mass-assignment-form ref="massAssignmentForm"></mass-assignment-form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal" v-on:click="$emit('close-modal')">
                {{ 'admin.common.close'|trans }}
            </button>
            <button type="button" class="btn btn-primary" v-on:click="save()">
                {{ 'admin.agenda.mass_assignment.submit.label'|trans }}
            </button>
        </div>
    </modal>
</script>
