<script type="x/template" id="meetings-agenda">
    <div role="tabpanel" class="tab-pane active" id="sheet">
        <div class="row" v-cloak>
            <div class="col-xs-2" style="margin: 0; padding: 0;">
                <div class="sheets-header">
                    <table class="table-no-margin-bottom table">
                        <thead>
                        <tr>
                            <td>
                                <div class="btn-group">
                                    <button class="btn btn-default btn-xs" v-on:click="showSheetFilter">
                                        <i class="glyphicon glyphicon-filter"></i> {{ 'admin.agenda.filters.title.label'|trans }}
                                        <span class="badge">${ countFilteredSheets }</span>
                                    </button>
                                    <button class="btn btn-default btn-xs" v-on:click="showSort">
                                        <i class="glyphicon glyphicon-sort"></i>  {{ 'admin.agenda.sort.title.label'|trans }}
                                    </button>
                                    <button class="btn btn-default btn-xs" v-on:click="resetSheetFilter" title="{{ 'admin.agenda.filters.reset.label'|trans }}">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <input class="col-xs-12" type="text" placeholder="{{ 'admin.agenda.filters.search'|trans }}" v-model:value="filterBySheetOrParticipantValue" v-on:keyup="filterBySheetOrParticipant" v-bind:value="filterBySheetOrParticipantValue" autofocus>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                {{ 'admin.agenda.indicators-caption'|trans }}
                                <br>

                                <small class="text-muted">
                                    <span class="glyphicon glyphicon-info-sign"></span> {{ 'admin.agenda.indicators-help'|trans }}
                                </small>
                                <br>

                                <table class="table-no-margin-bottom table table-condensed table-bordered">
                                    <tr>
                                        <td class="text-center col-custom-7">
                                            <a href="#" title="{{ 'admin.agenda.countRequest'|trans }}"><span class="glyphicon glyphicon-arrow-right"></span></a>
                                        </td>
                                        <td class="text-center col-custom-7">
                                            <a href="#" title="{{ 'admin.agenda.countProposition'|trans }}"><span class="glyphicon glyphicon-arrow-left"></span></a>
                                        </td>
                                        <td class="text-center col-custom-7">
                                            <a href="#" title="{{ 'admin.agenda.countValidatedRequest'|trans }}"><span class="glyphicon glyphicon-resize-horizontal"></span></a>
                                        </td>
                                        <td class="text-center col-custom-7">
                                            <a href="#" title="{{ 'admin.agenda.countSlots'|trans }}"><span class="glyphicon glyphicon-align-justify"></span></a>
                                        </td>
                                        <td class="text-center col-custom-7">
                                            <a href="#" title="{{ 'admin.agenda.usableSlots'|trans }}"><span class="glyphicon glyphicon-tasks"></span></a>
                                        </td>
                                        <td class="text-center col-custom-7">
                                            <a href="#" title="{{ 'admin.agenda.countPlacedMeetings'|trans }}"><span class="glyphicon glyphicon-ok-circle"></span></a>
                                        </td>
                                        <td class="text-center col-custom-7">
                                            <a href="#" title="{{ 'admin.agenda.countPendingProposition'|trans }}"><span class="glyphicon glyphicon-question-sign"></span></a>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        </thead>
                    </table>
                </div>
                <div class="sheets-list">
                    <table class="table-no-margin-bottom table table-condensed table-hover table-striped">
                        <tbody>
                        <tr v-if="noSheets">
                            <td>
                                <div class="alert alert-warning">{{ 'admin.agenda.sheet.loader'|trans }}</div>
                            </td>
                        </tr>
                        <tr v-for="sheet in sheetsIterator" v-on:refresh-list="refreshList">
                            <td v-bind:class="{ 'sheet-cancelled-attendance': false === sheet.attend }">
                                <span class="label label-info pull-right" v-if="sheet.countParticipant > 1"><i class="icon icon-Profil_1"></i> ${ sheet.countParticipant }</span>

                                <a v-bind:href="sheet.url" target="_blank" title="{{ 'admin.agenda.sheet.see'|trans }}" class="link-to-sheet"><span class="glyphicon"></span></a>
                                <a href="#" class="sheet-title" v-bind:title="sheet.title" v-on:click="showAndFocusAgenda(sheet)">${ sheet.title }</a>

                                <small>${ sheet.type }</small>

                                <div v-if="sheet.hasFollower === true">
                                    <small>
                                        <span class="glyphicon glyphicon-arrow-right"></span>
                                        &nbsp;${ sheet.follower.firstName } ${ sheet.follower.lastName }
                                    </small>
                                </div>

                                <table class="table-no-margin-bottom table table-condensed table-bordered">
                                    <tr v-bind:class="{ 'sheet-cancelled-attendance': false === sheet.attend }">
                                        <td class="text-center col-custom-7">${ sheet.countRequest }</td>
                                        <td class="text-center col-custom-7">${ sheet.countProposition }</td>
                                        <td class="text-center col-custom-7">${ sheet.countValidatedRequest }
                                        </td>
                                        <td class="text-center col-custom-7">${ sheet.countSlots }</td>
                                        <td class="text-center col-custom-7">${ sheet.usableSlots }</td>
                                        <td class="text-center col-custom-7">${ sheet.countPlacedMeetings }</td>
                                        <td class="text-center col-custom-7">${ sheet.countPendingPropositions }
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-xs-10">
                {% if isMeetingRequestUpdateLocked == true %}
                    <div style="height: 50px" class="bg-danger alert alert-danger">
                        {{ 'admin.agenda.event.configuration.isMeetingRequestLocked'|trans }}
                    </div>
                {% endif %}
                <div class="requests-list" v-if="focusedSheet" ref="focusedSheetRequestList">
                    <p>
                        <b>${ focusedSheet.title }</b>
                        <span v-if="focusedSheet.indicators != undefined" v-bind:class="{ 'label label-success': focusedSheet.indicators.countPlacedMeeting <= focusedSheet.indicators.maxMeetingAvailable, 'label label-danger': focusedSheet.indicators.countPlacedMeeting > focusedSheet.indicators.maxMeetingAvailable }">
                            ${ focusedSheet.indicators.countPlacedMeeting } / ${ focusedSheet.indicators.maxMeetingAvailable }
                        </span>
                        <br>{{ 'admin.agenda.requestsList.title'|trans }}
                    </p>

                    <div class="requests-list-scrollable">
                        <table class="table-no-margin-bottom table table-condensed table-hover table-striped">
                        <tbody>
                            <tr v-show="focusedSheet.requests && focusedSheet.requests.length === 0">
                                <td>{{ 'admin.agenda.requestsList.zeroResult'|trans }}</td>
                            </tr>
                            <tr v-for="request in focusedSheet.requests">
                                <td v-bind:class="{ 'request-to-be-placed': meetingRequestToTransformIntoMeeting === request, 'sheet-cancelled-attendance': request.isOneOfSheetsNotAttend, 'not-transformable-into-meeting': !request.isTransformableIntoMeeting }">
                                    <a href="#" title="{{ 'admin.agenda.request.updateParticipant.label'|trans }}" class="pull-right" v-on:click="showParticipants(request)">
                                        <span class="glyphicon glyphicon-cog"></span>
                                    </a>
                                    <a href="#"
                                       title="{{ 'admin.agenda.request.transformIntoMeeting.label'|trans }}"
                                       class="pull-right"
                                       v-on:click="loadSlotsForRequest(request)"
                                       v-show="request.isTransformableIntoMeeting && !focusedSheet.isAgendaLoading && null === meetingRequestToTransformIntoMeeting">
                                        <span class="glyphicon glyphicon-move"></span>
                                    </a>

                                    <a href="#" title="{{ 'admin.agenda.request.transformIntoMeeting.cancel'|trans }}"
                                       v-on:click="cancelSlotAction()" class="pull-right"
                                       v-show="request.isTransformableIntoMeeting && meetingRequestToTransformIntoMeeting === request">
                                        <span class="glyphicon glyphicon-remove"></span>
                                    </a>

                                    <a href="#" v-on:click="showAgendaForSheetId(request.sheetMetId)" v-show="!request.isOneOfSheetsNotAttend">
                                        ${ request.sheetMetTitle }
                                    </a>
                                    <span v-show="request.isOneOfSheetsNotAttend" title="{{ 'event.sheet.attend.cancel'|trans }}">
                                        ${ request.sheetMetTitle } <i class="glyphicon glyphicon-remove-circle"></i>
                                    </span>
                                    <br>

                                    <i class="icon icon-Profil_1"></i>
                                    ${ request.participantsName }

                                    <a href="#" title="{{ 'admin.agenda.request.updateParticipant.label'|trans }}" v-on:click="showParticipants(request)" v-show="request.isOneOfSheetsHasNoPreference">
                                        <span class="label label-danger">
                                            {{ 'admin.agenda.requestsList.noPreference'|trans }}
                                        </span>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                        </table>
                    </div>
                </div>

                <div class="agenda-horizontal">
                    <ul>
                        {% set table = 1 %}
                        <li v-for="sheet in openedSheets">
                            <sheet-agenda
                                    ref="childSheetAgenda"
                                    v-bind:sheet="sheet"
                                    v-bind:focused-sheet="focusedSheet"
                                    v-on:close-sheet-agenda="closeAgenda"
                                    v-on:load-sheets="loadSheets"
                                    v-on:focus-sheet="focusSheet"
                                    v-on:show-meeting-update-modal="showMeetingUpdateModal"
                                    v-on:refresh-agenda="refreshAgenda"
                                    v-on:refresh-both-agenda="handleRefreshBothAgenda"
                                    v-on:show-agenda-for-sheet-id="showAgendaForSheetId"
                                    v-on:schedule-meeting="transformRequestIntoMeeting"
                                    v-on:load-spot-detail="loadSpotDetail"
                                    v-on:show-mass-assignment="showMassAssignment">
                                >
                            </sheet-agenda>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <mass-assignment-modal :show="showMassAssignmentModal" v-on:mass-assignment-updated="handleUpdateMassAssignment" v-on:close-modal="showMassAssignmentModal = false" ref="massAssignmentModal"></mass-assignment-modal>

        <sort-modal :sheets="sheets" :show="showSortModal" v-on:sort-sheets="sortSheets" v-on:refresh-list="refreshList" v-on:close-modal="showSortModal = false" ref="sortModal"></sort-modal>

        <filter-modal v-bind:sheets="sheets" v-show="showFilterModal" v-on:filter-sheets="filterSheets" v-on:refresh-list="refreshList" v-on:close-modal="showFilterModal = false" ref="sheetFilterModal"></filter-modal>

        <update-participant-modal v-show="showParticipantModal" v-on:close-modal="showParticipantModal = false" ref="updateParticipantModal" v-on:refresh-request-list-of-sheet="refreshRequestListOfSheet"></update-participant-modal>

        <agenda-version-modal></agenda-version-modal>

        <meeting-update-modal
                v-bind:meeting-to-update="meetingToUpdate"
                v-on:close-modal="clearMeetingToUpdate"
                v-on:meeting-updated="meetingUpdated"
                v-on:meeting-updating="handleMeetingUpdating"
                v-on:meeting-updated-error="handleMeetingUpdatedError">
        </meeting-update-modal>
    </div>
</script>
