{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.agenda.title'|trans %}

{% block content %}
    <div id="agenda" class="agenda-container">
        <meeting-update-modal
                v-bind:meeting-to-update="meetingToUpdate"
                v-on:close-modal="clearMeetingToUpdate"
                v-on:meeting-updated="meetingUpdated"
                v-on:meeting-updating="handleMeetingUpdating"
                v-on:meeting-updated-error="handleMeetingUpdatedError">
        </meeting-update-modal>

        <!-- Nav tabs -->
        <tabs inline-template>
            <div>
                <ul class="nav nav-tabs">
                    <li v-for="tab in tabs" v-bind:class="{ active: tab.isActive }" v-on:click="selectTab(tab)">
                        <a href="#" aria-controls="sheet">${ tab.name }</a>
                    </li>
                </ul>
                <tab name="{{ 'admin.agenda.tab.sheet.title.label'|trans }}" v-bind:selected="true">
                </tab>
                <tab-spot name="{{ 'admin.agenda.tab.spot.title.label'|trans }}">
                </tab-spot>
            </div>
        </tabs>

        <!-- Tab panes -->
        <div class="tab-content">
            {{ include('AdminBundle:Agenda/Tabs:sheets.html.twig') }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {{ include('AdminBundle:Agenda:modal.html.twig') }}
    {{ include('AdminBundle:Agenda:meetingUpdateModal.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:filterModal.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:filterSheetForm.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:updateParticipantModal.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:updateParticipantForm.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:sheetAgenda.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:slotAgenda.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:massAssignmentModal.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:massAssignmentForm.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:sortModal.html.twig') }}
    {{ include('AdminBundle:Agenda/Components:sortSheetForm.html.twig') }}

    {{ include('AdminBundle:Agenda/Tabs:spots.html.twig') }}
    {{ include('AdminBundle:Agenda/Components/Spot:spotAgenda.html.twig') }}
    {{ include('AdminBundle:Agenda/Components/Spot:slotAgenda.html.twig') }}

    <!-- template for the Modal component -->
    <script type="x/template" id="modal-template">
        <div class="modal-mask" v-on:click="close()" v-show="show">
            <div class="modal-dialog" role="document" v-on:click.stop>
                <div class="modal-content">
                    <slot></slot>
                </div>
            </div>
        </div>
    </script>

    <script src="{{ asset('assets/js/agenda.js') }}"></script>
{% endblock %}
