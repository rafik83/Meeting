{% extends 'AdminBundle::base.html.twig' %}

{% block title %}Agenda{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .table-kpi {
            margin-bottom: 0
        }
        .table-agenda {
            margin-right: 10px;
        }
        .table-agenda td {
            vertical-align: top;
        }
        .agenda-container {
            overflow-x: scroll;
        }
        .agenda-horizontal {
            width: 10000000px;
        }
        .table-agenda-day td {
            padding: 0 !important;
        }
        .agenda-sheet-focus {
            background: #32b5fc;
        }
        .meeting {
            background: #32b5fc;
        }
        .meeting-common {
            background: #ffe237;
        }
        .slot {
            padding: 4px;
            height: 65px;
        }
        .slot-label {
            width:100px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
        .slot-label-small {
            font-size: 85%;
        }
        .sheets-list {
            position: fixed;
            top: 50px;
            left: 0px;
            height: 100%;
            overflow-y: scroll;
            padding: 10px 0 100px 10px;
        }
        .happening {
            background: #000000;
            color: #ffffff;
        }
        .unavailability {
            background: #999999;
            color: #ffffff;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-xs-2">
            <div class="sheets-list">
                <table class="table-kpi table table-condensed table-hover table-striped">
                    <thead>
                        <tr>
                            <th>
                                Légende
                                <table class="table table-condensed table-bordered">
                                    <tr>
                                        <td class="text-center"><a href="#" title="Nombre de demandes" data-toggle="tooltip">A</a></td>
                                        <td class="text-center"><a href="#" title="Nombre de propositions" data-toggle="tooltip">B</a></td>
                                        <td class="text-center"><a href="#" title="Nombre de demandes et propositions acceptées" data-toggle="tooltip">C</a></td>
                                        <td class="text-center"><a href="#" title="Nombre de slots en tenant du nombre de participants" data-toggle="tooltip">D</a></td>
                                        <td class="text-center"><a href="#" title="Nombre de slots utilisables" data-toggle="tooltip">E</a></td>
                                        <td class="text-center"><a href="#" title="Nombre de RDV" data-toggle="tooltip">F</a></td>
                                    </tr>
                                </table>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for sheet in sheets.results %}
                        <tr id="sheet-{{ sheet.id }}">
                            <td>
                                {% if sheet.countParticipant > 1 %}
                                    <span class="label label-info pull-right"><i class="icon icon-Profil_1"></i> {{ sheet.countParticipant }}</span>
                                {% endif %}

                                <a href="#">{{ sheet.title }}</a>

                                <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}" target="_blank" title="Voir la fiche"><span class="glyphicon glyphicon-link"></span></a>

                                <br><small>{{ sheet.type }}</small>

                                {% if sheet.follower %}
                                    <br><small><span class="glyphicon glyphicon-arrow-right"></span> {{ sheet.follower }}</small>
                                {% endif %}

                                <table class="table-kpi table table-condensed table-bordered">
                                    <tr>
                                        <td class="text-center">109</td>
                                        <td class="text-center">45</td>
                                        <td class="text-center">66</td>
                                        <td class="text-center">35</td>
                                        <td class="text-center">32</td>
                                        <td class="text-center">8</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-xs-10">
            <div style="position: fixed; bottom: 0;right: 0;width: 83%; background: #ccc; padding: 10px">
                <p><b>Fiche #1</b> : demandes de RDV</p>
                <ul class="list-group" style="margin-bottom: 0">
                    <li class="list-group-item">
                        <a href="#"><span class="glyphicon glyphicon-cog"></span></a>
                        Nom autre fiche 1 - Michel DUPOND
                    </li>
                    <li class="list-group-item">
                        <a href="#"><span class="glyphicon glyphicon-cog"></span></a>
                        Nom autre fiche 2 - Thierry HENRY, Martine PIERRE
                    </li>
                    <li class="list-group-item">
                        <a href="#"><span class="glyphicon glyphicon-cog"></span></a>
                        Nom autre fiche 3 - Pas de préférence
                    </li>
                </ul>
            </div>

            <div class="agenda-container">
                <div class="agenda-horizontal">
                    {% for table in 1..3 %}
                        <table class="table-agenda table-bordered table-condensed pull-left">
                            <thead>
                                <tr>
                                    <td colspan="4" class="text-center {% if table == 1 %}agenda-sheet-focus{% endif %}">
                                        <a href="#" class="pull-right"><span class="glyphicon glyphicon-remove"></span></a>
                                        {% if table == 1 %}
                                            <b>Fiche #{{ table }}</b>
                                        {% else %}
                                            <a href="#">Fiche #{{ table }}</a>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th colspan="2" class="text-center">Richard HANNA</th>
                                    <th colspan="2" class="text-center">Dimitri FRUIT</th>
                                </tr>
                                <tr>
                                    <th class="text-center">J1</th>
                                    <th class="text-center">J2</th>
                                    <th class="text-center">J1</th>
                                    <th class="text-center">J2</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    {% for j in 1..4 %}
                                    <td>
                                        <table class="table-agenda-day table table-condensed">
                                            {% for i in 1..12 if not (j%2 and i == 12) %}
                                                <tr>
                                                    <td>
                                                        {% if j==1 and i in [2,5] or j==2 and i == 4 %}
                                                            <div class="slot {{ i in [2,5] ? 'meeting' : '' }}{{ i == 4 ? 'meeting meeting-common' : '' }}">
                                                                <a href="#" class="pull-right"><span class="glyphicon glyphicon-cog"></span></a>

                                                                <div class="slot-label slot-label-small">{{ i+8+j%2 }}h00 - {{ i+9+j%2 }}h00</div>

                                                                <div class="slot-label">
                                                                    {% if i==5 %}<span class="glyphicon glyphicon-user" title="Pas de préférences" data-toggle="tooltip"></span>{% endif %}
                                                                    Nom autre fiche
                                                                </div>

                                                                <div class="slot-label">
                                                                    <small><span class="glyphicon glyphicon-map-marker"></span> A{{ i ~ j }}0000</small>
                                                                </div>
                                                            </div>
                                                        {% elseif j==1 and i in [3,7,8] %}
                                                            <div class="slot happening">
                                                                <div class="slot-label slot-label-small">{{ i+8+j%2 }}h00 - {{ i+9+j%2 }}h00</div>
                                                                <span class="glyphicon glyphicon-bullhorn"></span>
                                                            </div>
                                                        {% elseif j==3 and i in [1,6] %}
                                                            <div class="slot unavailability">
                                                                <div class="slot-label slot-label-small">{{ i+8+j%2 }}h00 - {{ i+9+j%2 }}h00</div>
                                                            </div>
                                                        {% else %}
                                                            <div class="slot empty-slot">
                                                                <div class="slot-label slot-label-small">{{ i+8+j%2 }}h00 - {{ i+9+j%2 }}h00</div>
                                                            </div>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </table>
                                    </td>
                                    {% endfor %}
                                </tr>
                            </tbody>
                        </table>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
