{% extends 'AdminBundle::base.html.twig' %}

{% block title %}Agenda{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-2">
            <table class="table table-condensed table-hover table-striped">
                <thead>
                    <tr>
                        <th>
                            Légende
                            <table class="table table-condensed table-bordered">
                                <tr>
                                    <td class="text-center"><a href="#" title="Nombre de demandes" data-toggle="tooltip">A</a></td>
                                    <td class="text-center"><a href="#" title="Nombre de propositions" data-toggle="tooltip">B</a></td>
                                    <td class="text-center"><a href="#" title="Nombre de demandes et propositions acceptées" data-toggle="tooltip">C</a></td>
                                    <td class="text-center"><a href="#" title="Nombre de slots en tenant du nombre de participants" data-toggle="tooltip">D</a></td>
                                    <td class="text-center"><a href="#" title="Nombre de slots utilisables" data-toggle="tooltip">E</a></td>
                                    <td class="text-center"><a href="#" title="Nombre de RDV" data-toggle="tooltip">F</a></td>
                                </tr>
                            </table>
                        </th>
                    </tr>
                </thead>
                <tbody>
                {% for sheet in sheets.results %}
                    <tr id="sheet-{{ sheet.id }}">
                        <td style="cursor: pointer">
                            {% if sheet.countParticipant > 1 %}
                                <span class="label label-info pull-right"><i class="icon icon-Profil_1"></i> {{ sheet.countParticipant }}</span>
                            {% endif %}

                            <a href="#">{{ sheet.title }}</a>

                            <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}" target="_blank" title="Voir la fiche"><span class="glyphicon glyphicon-link"></span></a>

                            <br><small>{{ sheet.type }}</small>

                            {% if sheet.follower %}
                                <br><small><span class="glyphicon glyphicon-arrow-right"></span> {{ sheet.follower }}</small>
                            {% endif %}

                            <table class="table table-condensed table-bordered" style="margin-bottom: 0">
                                <tr>
                                    <td class="text-center">109</td>
                                    <td class="text-center">45</td>
                                    <td class="text-center">66</td>
                                    <td class="text-center">35</td>
                                    <td class="text-center">32</td>
                                    <td class="text-center">8</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="col-md-10">
        </div>
    </div>
{% endblock %}
