<script type="x/template" id="filter-sheet-form">
    <modal :show="show" @close-modal="$emit('close-modal')">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'admin.common.close'|trans }}" @click="$emit('close-modal')">
                <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title" id="filterSheetModalLabel">{{ 'admin.agenda.filters.title.label'|trans }}</h4>
        </div>
        <div class="modal-body">
            <form>
                <div class="form-group">
                    <label for="selectedTypes">{{ 'admin.agenda.filters.type'|trans }}</label>
                    <ul class="list-unstyled">
                        <li v-for="type in types">
                            <input name="selectedTypes" type="checkbox" v-model:value="selectedTypes" v-bind:value="type">
                            ${ type }
                        </li>
                    </ul>
                </div>
                <div class="form-group">
                    <label for="selectedTypes">{{ 'admin.agenda.filters.indicators.label'|trans }}</label>
                    <ul class="list-unstyled">
                        <li>
                            <input name="selectedTypes" type="checkbox" v-model:value="hasSentMeetingRequest" v-bind:value="true">
                            {{ 'admin.agenda.filters.hasSentMeetingRequest.label'|trans }}
                        </li>
                        <li>
                            <input name="selectedTypes" type="checkbox" v-model:value="hasMeetingToApprove" v-bind:value="true">
                            {{ 'admin.agenda.filters.hasMeetingToApprove.label'|trans }}
                        </li>
                        <li>
                            <input name="selectedTypes" type="checkbox" v-model:value="hasNotEnoughtAvailableSlot" v-bind:value="true">
                            {{ 'admin.agenda.filters.hasNotEnoughtAvailableSlot.label'|trans }}
                        </li>
                    </ul>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal" @click="$emit('close-modal')">
                {{ 'admin.common.close'|trans }}
            </button>
            <button type="button" class="btn btn-primary" @click="save()">Ok</button>
        </div>
    </modal>
</script>
