<!-- template for the MeetingUpdateModal component -->
<script type="x/template" id="meeting-update-modal-template">
    <modal v-bind:show="meetingToUpdate !== null && meetingToUpdate !== undefined" v-on:close-modal="close()" v-if="meetingToUpdate != null">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close" @click="close()"><span aria-hidden="true">&times;</span></button>
            <h4 class="modal-title">Meeting update</h4>
        </div>

        <div class="modal-body">
            <div class="checkbox">
                <label>
                    <input type="checkbox" v-model="meetingToUpdate.blockedSlot"> Créneau bloqué
                </label>
            </div>

            <div class="checkbox">
                <label>
                    <input type="checkbox" v-model="meetingToUpdate.blockedSpot" value="1"> Lieu bloqué
                </label>
            </div>

            <div class="form-group">
                <label for="modal_spot">Lieu</label>
                <select id="modal_spot" class="form-control" v-model="meetingToUpdate.spotId">
                    <option v-for="spot in meetingToUpdate.availableSpots" v-bind:value="spot.id">
                        ${ spot.label }
                    </option>
                </select>
            </div>
        </div>

        <div class="modal-footer text-right">
            <button @click="save()" v-bind:class="{ 'btn': true, 'btn-primary': true, 'disabled': disabled}" v-bind:disabled="disabled">
                Enregistrer
            </button>
        </div>
    </modal>
</script>
