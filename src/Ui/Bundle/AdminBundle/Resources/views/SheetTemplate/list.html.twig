{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.template.sheet.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ 'admin.template.sheet.title'|trans }}</h1>

    <button type="button" class="btn btn-primary btn-success" data-toggle="modal" data-target="#create-modal">
        {{ 'admin.template.action.create'|trans }}
    </button>

    {{ form_start(form) }}
        <div class="modal fade" id="create-modal" tabindex="-1" role="dialog" aria-labelledby="create-modal-label">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="create-modal-label">{{ 'admin.template.action.create'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_errors(form) }}
                        {{ form_row(form.title) }}
                        {{ form_row(form.locale) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">
                            {{ 'form.sheet_template_create.children.close.label'|trans({}, 'forms') }}
                        </button>
                        {{ form_widget(form.submit) }}
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}

    <h3 class="page-header">{{ 'admin.template.sheet.titleBase'|trans }}</h3>
    <table class="table">
        <thead>
            <tr>
                <th>{{ 'admin.template.sheet.table.column.title'|trans }}</th>
                <th class="text-right">{{ 'admin.template.sheet.table.column.action'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for baseTemplate in baseTemplates %}
                <tr>
                    <td>{{ baseTemplate.title }}</td>
                    <td class="text-right">
                        <div class="btn-group">
                            <a href="{{ path('admin_template_sheet_builder', {
                                'template': baseTemplate.id, 'locale': baseTemplate.fallback
                            }) }}" class="btn btn-sm btn-default">
                                {{ 'admin.template.action.edit'|trans }}
                            </a>
                            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-right">
                                <li>
                                    <a href="{{ path('admin_template_sheet_preview_update', {
                                        'template': baseTemplate.id
                                    }) }}">{{ 'admin.template.action.preview'|trans }}</a>
                                </li>
                                <li>
                                    <a href="{{ path('admin_template_sheet_print_template_builder', {
                                        'template': baseTemplate.id
                                    }) }}">{{ 'admin.template.action.print'|trans }}</a>
                                </li>
                                <li>
                                    <a href="{{ path('admin_template_sheet_duplicate', { 'template': baseTemplate.id }) }}"
                                       data-toggle="modal" data-target="#duplicate-modal">
                                        {{ 'admin.template.action.duplicate'|trans }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if eventsTemplates|length %}
    <h3 class="page-header">{{ 'admin.template.sheet.titleEvent'|trans }}</h3>
    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.template.sheet.table.column.title'|trans }}</th>
            <th>{{ 'admin.template.sheet.table.column.eventType'|trans }}</th>
            <th class="text-right">{{ 'admin.template.sheet.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for eventsTemplate in eventsTemplates %}
            <tr>
                <td>{{ eventsTemplate.title }}</td>
                <td>
                    {{ eventsTemplate.event.title }}
                    {% if eventsTemplate.types is not null %}
                        <ul>
                            {% for type in eventsTemplate.types %}
                                <li>{{ type.getTitle(type.event.getAvailableLocale(app.request.locale)) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
                <td class="text-right">
                    <div class="btn-group">
                        <a href="{{ path('admin_template_sheet_builder', {
                            'template': eventsTemplate.id, 'locale': eventsTemplate.fallback
                        }) }}" class="btn btn-sm btn-default">
                            {{ 'admin.template.action.edit'|trans }}
                        </a>
                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a href="{{ path('admin_template_sheet_preview_update', {
                                    'template': eventsTemplate.id
                                }) }}">{{ 'admin.template.action.preview'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_template_sheet_print_template_builder', {
                                    'template': eventsTemplate.id
                                }) }}">{{ 'admin.template.action.print'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_template_sheet_duplicate', { 'template': eventsTemplate.id }) }}"
                                   data-toggle="modal" data-target="#duplicate-modal">
                                    {{ 'admin.template.action.duplicate'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}



    <div class="modal fade clear-on-hidden-modal" id="duplicate-modal" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>

{% endblock %}

