{% extends 'AdminBundle::base.html.twig' %}

{% import 'AdminBundle::macro.html.twig' as macro %}

{% block title 'admin.template.sheet.title'|trans %}

{% block content %}

    <h1 class="page-header">{{ 'admin.template.sheet.link'|trans }}</h1>

    <h2>
        <button type="button" class="btn btn-primary btn-success" data-toggle="modal" data-target="#create-modal">
            {{ 'admin.template.action.create'|trans }}
        </button>
    </h2>

    {{ form_start(form) }}
        <div class="modal fade" id="create-modal" tabindex="-1" role="dialog" aria-labelledby="create-modal-label">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="create-modal-label">{{ 'admin.template.action.create'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_errors(form) }}
                        {{ form_row(form.title) }}
                        {{ form_row(form.event) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">
                            {{ 'form.organizer_sheet_template_create.children.close.label'|trans({}, 'forms') }}
                        </button>
                        {{ form_widget(form.submit) }}
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}

    {{ include('AdminBundle:Common:filters_summary.html.twig', {
        filters:   filters_summary,
        resetLink: path('admin_organizer_template_sheet_list')
    }) }}

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.organizer_template_list.table.column.title'|trans }}</th>
            <th>{{ macro.choice_as_dropdown(filter_form.event) }}</th>
            <th>{{ 'admin.organizer_template_list.table.column.date'|trans }}</th>
            <th class="text-right">{{ 'admin.organizer_template_list.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for template in organizer_templates %}
            <tr>
                <td>{{ template.title }}</td>
                <td>
                    {{ template.event.title }}
                    {% if template.types is not null %}
                        <ul>
                            {% for type in template.types %}
                                <li>{{ type.getTitle(type.event.getAvailableLocale(app.request.locale)) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
                <td>{{ template.createdAt|localizeddate('medium', 'short', app.request.locale) }}</td>
                <td class="text-right">
                    <div class="btn-group">
                        <a href="{{ path('admin_template_sheet_builder', {
                            'template': template.id, 'locale': template.fallback
                        }) }}" class="btn btn-sm btn-default">
                            {{ 'admin.template.action.edit'|trans }}
                        </a>
                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a href="{{ path('admin_template_sheet_preview_update', {
                                    'template': template.id
                                }) }}">{{ 'admin.template.action.preview'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_template_sheet_print_template_builder', {
                                    'template': template.id
                                }) }}">{{ 'admin.template.action.print'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_organizer_template_sheet_duplicate', { 'template': template.id }) }}"
                                   data-toggle="modal" data-target="#duplicate-modal">
                                    {{ 'admin.template.action.duplicate'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>Templates de base</h2>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'admin.organizer_template_list.table.column.title'|trans }}</th>
            <th>{{ 'admin.organizer_template_list.table.column.locales'|trans }}</th>
            <th class="text-right">{{ 'admin.organizer_template_list.table.column.action'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for template in base_templates %}
            <tr>
                <td>{{ template.title }}</td>
                <td>{{ macro.more(template.locales|locales, 3) }}</td>
                <td class="text-right">
                    <div class="btn-group">
                        <a href="{{ path('admin_template_sheet_builder', {
                            'template': template.id, 'locale': template.fallback
                        }) }}" class="btn btn-sm btn-default">
                            {{ 'admin.template.action.edit'|trans }}
                        </a>
                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a class="btn btn-default btn-sm" href="{{ path('admin_template_sheet_preview_update', {
                                    'template': template.id
                                }) }}">{{ 'admin.template.action.preview'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_template_sheet_print_template_builder', {
                                    'template': template.id
                                }) }}">{{ 'admin.template.action.print'|trans }}</a>
                            </li>
                            <li>
                                <a href="{{ path('admin_organizer_template_sheet_duplicate', { 'template': template.id }) }}" data-toggle="modal" data-target="#duplicate-modal">
                                    {{ 'admin.template.action.duplicate'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="modal fade clear-on-hidden-modal" id="duplicate-modal" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>

{% endblock %}

