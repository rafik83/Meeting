{% extends 'AdminBundle::base.html.twig' %}

{% block title 'admin.template.sheet.title'|trans %}

{% block body %}
    {{ include('AdminBundle:Common:menu.html.twig') }}
    <div class="container-fluid template-builder-container" data-template-builder="{{ path('admin_template_sheet_save', { 'template': template.id, 'locale': locale }) }}" data-locale="{{ locale }}">
        <div class="template-builder-header">
            <div class="clear clear-fix clearfix">
                <h1 class="pull-left">{{ template.title }}</h1>
                <div class="btn-toolbar" role="toolbar" aria-label="Template actions">
                    <div class="btn-group dropdown">
                        <button class="btn btn-default dropdown-toggle" type="button" id="locale-dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            {{ locale|locale }}
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="locale-dropdown">
                            {% for template_locale in template.enabledLocales %}
                                <li{% if template_locale == locale %} class="active"{% endif %}>
                                    <a href="{{ path('admin_template_sheet_builder', { 'template': template.id, 'locale': template_locale }) }}">
                                        <span class="badge pull-right">{{ completeness[template_locale]|number_format(0) }}%</span>
                                        <span class="template-locale{% if template_locale == template.fallback %} template-fallback{% endif %}">{{ template_locale|locale }}</span>
                                    </a>
                                </li>
                            {% endfor %}
                            {% if add_locale_form %}
                                <li>
                                    <button class="text-center" data-toggle="modal" data-target="#add-locale-modal">
                                        <i class="glyphicon glyphicon-plus"></i>
                                    </button>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                    <button class="btn btn-primary" data-toggle="modal" data-target="#update-modal">{{ 'admin.template.action.edit'|trans }}</button>
                    <button class="btn btn-success" id="template-save-button" data-loading-button="{{ ('<i class="glyphicon glyphicon-refresh spin"></i> ' ~ ('admin.template.action.updating'|trans))|e }}">{{ 'admin.template.action.save'|trans }}</button>
                </div>
            </div>
            {{ include('AdminBundle::flashes.html.twig') }}
        </div>

        <div class="template-builder-body">
            <div class="block" data-config="{}">
                <span class="delete"></span>
                <div class="template-container container-fluid block-inner" id="template-container">
                    {% for uid, item in template.value|default([]) %}
                        {% if item.component == 'block' %}
                            {{ include('AdminBundle:Template/Block:' ~ item.type ~ '.html.twig', {
                                'uid': uid, 'children': item.children, 'config': item.config, 'locale': locale,
                                'fallback': template.fallback, 'nomenclatures': nomenclatures,
                                'sheet_tags': sheet_tags, 'products': products,
                                'sheet_template_tags': sheet_template_tags|default([]),
                                'uploadFormats': uploadFormats
                            }, false) }}
                        {% elseif item.component == 'object' %}
                            {{ include('AdminBundle:Template/Object:' ~ item.type ~ '.html.twig', {
                                'uid': uid, 'config': item.config, 'locale': locale,
                                'fallback': template.fallback, 'nomenclatures': nomenclatures,
                                'sheet_tags': sheet_tags, 'products': products,
                                'sheet_template_tags': sheet_template_tags|default([])
                            }, false) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="template-builder-menu" id="template-menu">
            <button class="btn btn-xs btn-default pull-left slide-menu-button" id="template-menu-button">
                <i class="glyphicon glyphicon-chevron-left"></i>
            </button>
            <div class="template-builder-menu-wrapper">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#blocks" aria-controls="blocks" role="tab" data-toggle="tab">{{ 'admin.template.blocks'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#objects" aria-controls="objects" role="tab" data-toggle="tab">{{ 'admin.template.objects'|trans }}</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="blocks">
                        <div id="block-list" class="block-list">
                            {{ include('AdminBundle:Template/Block:12.html.twig', { 'locale': locale, 'nomenclatures': nomenclatures, 'sheet_tags': sheet_tags, 'products': products }, false) }}
                            {{ include('AdminBundle:Template/Block:6-6.html.twig', { 'locale': locale, 'nomenclatures': nomenclatures, 'sheet_tags': sheet_tags, 'products': products }, false) }}
                            {{ include('AdminBundle:Template/Block:8-4.html.twig', { 'locale': locale, 'nomenclatures': nomenclatures, 'sheet_tags': sheet_tags, 'products': products }, false) }}
                            {{ include('AdminBundle:Template/Block:4-8.html.twig', { 'locale': locale, 'nomenclatures': nomenclatures, 'sheet_tags': sheet_tags, 'products': products }, false) }}
                            <hr>
                            <p>{{ 'admin.template.block.objects_collection'|trans }}</p>
                            {{ include('AdminBundle:Template/Block:objects_collection.html.twig', { 'locale': locale, 'nomenclatures': nomenclatures, 'sheet_tags': sheet_tags, 'products': products }, false) }}
                        </div>
                    </div>

                    <div role="tabpanel" class="tab-pane" id="objects">
                        <div id="object-list" class="object-list">
                            {{ include('AdminBundle:Template/Object:text.html.twig', { 'locale': locale }, false) }}
                            {{ include('AdminBundle:Template/Object:editable-text.html.twig', {
                                'locale': locale,
                                'sheet_tags': sheet_tags,
                                'sheet_template_tags': sheet_template_tags|default([]),
                            }, false) }}
                            {{ include('AdminBundle:Template/Object:button-link.html.twig', { 'locale': locale }, false) }}
                            {{ include('AdminBundle:Template/Object:participant.html.twig', { 'locale': locale }, false) }}
                            {{ include('AdminBundle:Template/Object:image.html.twig', {
                                'locale': locale,
                                'products': products,
                                'sheet_tags': sheet_tags,
                                'sheet_template_tags': sheet_template_tags|default([]),
                            }, false) }}
                            {{ include('AdminBundle:Template/Object:video.html.twig', {
                                'locale': locale,
                                'sheet_tags': sheet_tags,
                                'sheet_template_tags': sheet_template_tags|default([]),
                            }, false) }}
                            {{ include('AdminBundle:Template/Object:tag.html.twig', {
                                'locale': locale,
                                'sheet_tags': sheet_tags,
                                'sheet_template_tags': sheet_template_tags|default([]),
                            }, false) }}
                            {{ include('AdminBundle:Template/Object:collection.html.twig', { 'locale': locale }, false) }}
                            {{ include('AdminBundle:Template/Object:nomenclature.html.twig', {
                                'locale': locale,
                                'nomenclatures': nomenclatures,
                                'sheet_tags': sheet_tags,
                                'sheet_template_tags': sheet_template_tags|default([])
                            }, false) }}
                            {{ include('AdminBundle:Template/Object:media.html.twig', { 'locale': locale, 'products': products}, false) }}
                            {{ include('AdminBundle:Template/Object:tags.html.twig', {
                                'locale': locale,
                                'sheet_tags': sheet_tags,
                                'sheet_template_tags': sheet_template_tags|default([]),
                            }, false) }}
                            {{ include('AdminBundle:Template/Object:multi-upload.html.twig', {
                                'locale': locale,
                                'uploadFormats': uploadFormats
                            }, false) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if add_locale_form %}
            {{ form_start(add_locale_form, { 'attr': { 'class': 'modal fade', 'id': 'add-locale-modal' } }) }}
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="configure-modal-label">{{ 'admin.template.action.addLanguage'|trans }}</h4>
                        </div>
                        <div class="modal-body">
                            {{ form_row(add_locale_form.locale) }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.template.action.close'|trans }}</button>
                            {{ form_row(add_locale_form.submit) }}
                        </div>
                    </div>
                </div>
            {{ form_end(add_locale_form) }}
        {% endif %}

        {{ form_start(update_form, { 'attr': { 'class': 'modal fade', 'id': 'update-modal' } }) }}
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="configure-modal-label">{{ 'admin.template.action.update'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_row(update_form.title) }}
                        {% if update_form.fallback is defined %}
                            {{ form_row(update_form.fallback) }}
                        {% endif %}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'admin.template.action.close'|trans }}</button>
                        {{ form_row(update_form.submit) }}
                    </div>
                </div>
            </div>
        {{ form_end(update_form) }}

    </div>
{% endblock %}
