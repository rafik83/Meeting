{% extends 'AdminBundle::base.html.twig' %}

{% block body %}
    {{ include('AdminBundle:Common:menu.html.twig') }}

    <div class="container-fluid template-builder-container"
         data-template-builder="{{ path('admin_template_sheet_save', { 'template': template.id, 'locale': locale }) }}"
         data-locale="{{ locale }}"
    >
        <div class="template-builder-header">
            <div class="clear clear-fix clearfix">
                <h1 class="pull-left">{{ template.title }}</h1>
                <div class="btn-toolbar" role="toolbar" aria-label="Template actions">
                    <button class="btn btn-success" id="template-save-button" data-loading-button="{{ '<i class="glyphicon glyphicon-refresh spin"></i> Sauvegarde en cours ...'|e }}">{{ 'admin.template.action.save'|trans }}</button>
                </div>
            </div>
            {{ include('AdminBundle::flashes.html.twig') }}
        </div>

        <div class="template-builder-body">
            <div class="block" data-config="{}">
                <span class="delete"></span>
                <div class="template-container container-fluid block-inner" id="template-container">
                    {% for uid, item in template.value|default([]) %}
                        {% if item.component == 'block' %}
                            {{ include('AdminBundle:Template/Block:' ~ item.type ~ '.html.twig', {
                                'uid': uid, 'children': item.children, 'config': item.config, 'locale': locale,
                                'fallback': template.fallback, 'nomenclatures': null,
                                'sheet_tags': null, 'products': null
                            }, false) }}
                        {% elseif item.component == 'object' %}
                            {{ include('AdminBundle:Template/Object:' ~ item.type ~ '.html.twig', {
                                'uid': uid, 'config': item.config, 'locale': locale,
                                'fallback': template.fallback, 'nomenclatures': null,
                                'sheet_tags': null, 'products': null
                            }, false) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="template-builder-menu" id="template-menu">
            <button class="btn btn-lg btn-default pull-left slide-menu-button" id="template-menu-button" style="margin-top: 30px;">
                <i class="glyphicon glyphicon-chevron-left"></i>
            </button>
            <div class="template-builder-menu-wrapper">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#blocks" aria-controls="blocks" role="tab" data-toggle="tab">Blocks</a>
                    </li>
                    <li role="presentation">
                        <a href="#objects" aria-controls="objects" role="tab" data-toggle="tab">Objets</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="blocks">
                        <div id="block-list" class="block-list">
                            {{ include('AdminBundle:Template/Block:8-4.html.twig', { 'locale': locale, 'nomenclatures': null, 'sheet_tags': null, 'products': null }, false) }}
                            {{ include('AdminBundle:Template/Block:4-8.html.twig', { 'locale': locale, 'nomenclatures': null, 'sheet_tags': null, 'products': null }, false) }}
                            {{ include('AdminBundle:Template/Block:6-6.html.twig', { 'locale': locale, 'nomenclatures': null, 'sheet_tags': null, 'products': null }, false) }}
                            {{ include('AdminBundle:Template/Block:12.html.twig', { 'locale': locale, 'nomenclatures': null, 'sheet_tags': null, 'products': null }, false) }}
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane" id="objects">
                        <div id="object-list" class="object-list">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
