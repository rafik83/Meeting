{% extends 'MailBundle:Mail:base.html.twig' %}

{% block body %}
    {{ 'mail.transaction.confirm.body'|trans({
        '%firstname%': mail.firstname|capitalize,
        '%lastname%': mail.lastname|upper,
        '%transactionTotal%': mail.transaction.amount ~ ' ' ~ mail.transaction.currency|currency_symbol
    }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
