{% extends 'MailBundle:Mail:base.html.twig' %}

{% import "MailBundle:Mail:macros.html.twig" as macros %}

{% block body %}
    {{ 'mail.completeProfile.body'|trans({
        '%event%': mail.event.title,
        '%firstname%': mail.firstname|capitalize,
        '%lastname%': mail.lastname|upper,
        '%participationType%': mail.participantType
    }, 'mail', mail.locale)|html|nl2br }}

    <br>
    <br>
    {{ macros.button(
        'mail.completeProfile.link'|trans({}, 'mail', mail.locale),
        url('event_activate_account_already_known', {'participant': mail.participant.id})
    ) }}
    <br>

    {{ 'mail.completeProfile.end'|trans({}, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
