{% block subject %}
    {{ 'mail.preregister.subject'|trans({'%event%': mail.event.title }, 'mail', mail.locale)|html }}
{% endblock %}

{% block body %}
    {{ 'mail.preregister.body'|trans({
        '%event%': mail.event.title,
        '%url%': url('event_account_participant', {'sheet': mail.participant.sheet.id,'participant': mail.participant.id,
        '%firstname%': mail.user.firstname|humanize,
        '%lastname%': mail.user.lastname|upper,
        '%email%': mail.user.email
        }) }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}

{% block end %}
    {{ 'mail.preregister.end'|trans({
        '%event%': mail.event.title,
        '%eventPhone%': mail.event.phone,
        '%eventMail%': mail.event.organiserEmail
    }, 'mail', mail.locale|html) }}
{% endblock %}
