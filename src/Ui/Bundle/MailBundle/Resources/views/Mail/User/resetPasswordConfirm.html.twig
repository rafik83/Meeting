{% block subject %}
    {{ 'mail.confirmResetPassword.subject'|trans({ '%event%': mail.event.title }, 'mail', mail.locale) }}
{% endblock %}

{% block body %}
    {{ 'mail.confirmResetPassword.body'|trans({
        '%firstname%': mail.user.account.firstname|humanize,
        '%lastname%': mail.user.account.lastname|upper,
    }, 'mail', mail.locale)|html|nl2br }}

    {% if mail.participant is null %}
        <a href="{{ url('event_sheet_locale', { 'locale': mail.locale }) }}">
           {{ 'mail.confirmResetPassword.link'|trans({}, 'mail', mail.locale) }}
        </a>
    {% elseif mail.sheet is not null %}
        <a href="{{ url('event_account_participant', {
            'sheet': mail.sheet.id,
            'participant': mail.participant.id
        }) }}">
            {{ 'mail.confirmResetPassword.link'|trans({}, 'mail', mail.locale) }}
        </a>
    {% endif %}

    {{ 'mail.confirmResetPassword.end'|trans({
        '%event%': mail.event.title,
        '%eventPhone%': mail.event.configuration.organiserPhone,
        '%eventMail%': mail.event.organiserEmail
    }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
