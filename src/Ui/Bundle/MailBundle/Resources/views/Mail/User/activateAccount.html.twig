{% extends 'MailBundle:Mail:base.html.twig' %}

{% import "MailBundle:Mail:macros.html.twig" as macros %}

{% block body %}
    {{ 'mail.activateAccount.body'|trans({
        '%event%': mail.event.title,
        '%firstname%': mail.senderUser.account.firstname,
        '%lastname%': mail.senderUser.account.lastname,
    }, 'mail', mail.locale)|html|nl2br }}

    <br>
    <br>
    {{ macros.button(
        'mail.activateAccount.activate'|trans({}, 'mail', mail.locale),
        url('event_activate_account', {'token': mail.token})
    ) }}
    <br>

    {{ 'mail.activateAccount.end'|trans({}, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
