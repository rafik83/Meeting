{% block subject %}
    {{ 'mail.activateAccount.subject'|trans({'%event%': mail.event.title}, 'mail', mail.locale) }}
{% endblock %}

{% block body %}
    {{ 'mail.activateAccount.body'|trans({
        '%event%': mail.event.title,
        '%firstname%': mail.senderUser.account.firstname,
        '%lastname%': mail.senderUser.account.lastname,
        '%linkInvitation%': ''
    }, 'mail', mail.locale)|html|nl2br }}

    <a href="{{ url('event_activate_account', {'token': mail.token}) }}">
        {{ url('event_activate_account', {'token': mail.token}) }}
    </a><br>

{% endblock %}

{% block end %}
    {{ 'mail.activateAccount.end'|trans({
        '%event%': mail.event.title,
        '%eventPhone%': mail.event.configuration.organiserPhone,
        '%eventMail%': mail.event.organiserEmail
    }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
