{% block subject %}
    {{ 'mail.registerConfirmation.subject'|trans({'%event%': mail.event.title}, 'mail', mail.locale)|html }}
{% endblock %}

{% block body %}
    {{ 'mail.registerConfirmation.body'|trans({
        '%event%': mail.event.title,
        '%eventSite%': '',
        '%eventMail%': '',
        '%eventPhone%': '',
        '%catalogOnlineDate%': '',
        '%meetingLimitDate%': '',
        '%scheduleDate%': '',
        '%eventOpenDate%': '',
        '%firstname%': mail.user.firstname|humanize,
        '%lastname%': mail.user.lastname|upper
    }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}

{% block end %}
    {{ 'mail.registerConfirmation.body'|trans({
        '%event%': mail.event,
        '%eventSite%': '',
        '%eventMail%': '',
        '%eventPhone%': ''
    }) 'mail', mail.locale|html }}
{% endblock %}
