{% import "MailBundle:Mail:macros.html.twig" as macros %}
<html>
<body>
    {{ 'mail.spot.export.intro'|trans({'%eventTitle%': mail.event.title}, 'mail', mail.locale)|html|nl2br }}
    <br>
    {{ macros.button(
        'mail.spot.export.link.click'|trans({},'mail', mail.locale),
        url('admin_spot_export_download', {
            'event': mail.event.id,
            'hash': mail.fileHash,
            'file': mail.fileId,
            '_locale': mail.locale,
        })
    ) }}
</body>
</html>
