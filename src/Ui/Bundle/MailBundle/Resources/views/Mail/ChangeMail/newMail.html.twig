{% extends 'MailBundle:Mail:base.html.twig' %}

{% import "MailBundle:Mail:macros.html.twig" as macros %}

{% block body %}
    {{ 'mail.changeMailNew.body'|trans({
        '%currentEmail%': mail.user.email
    }, 'mail', mail.locale)|html|nl2br }}

    <br>
    <br>
    {{ macros.button(
        'mail.changeMailNew.validate'|trans({}, 'mail', mail.locale),
        url('event_activate_new_mail', {'token': mail.token})
    ) }}
    <br>

    {{ 'mail.changeMailNew.end'|trans({}, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
