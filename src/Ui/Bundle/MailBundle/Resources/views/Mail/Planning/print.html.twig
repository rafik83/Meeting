{% import "MailBundle:Mail:macros.html.twig" as macros %}
<html>
<body>
{{ 'mail.planning.print.intro'|trans({}, 'mail', mail.locale)|html|nl2br }}
<ul>
    {% for typeView in mail.typeViews %}
        <li>{{ typeView.title }}</li>
    {% endfor %}
</ul>
<br>
{{ 'mail.planning.print.orderBy.text'|trans({}, 'mail', mail.locale)|html|nl2br }}
{{ ('mail.planning.print.orderBy.' ~ mail.orderBy)|trans({}, 'mail', mail.locale)|html|nl2br }}

<br>

{{ 'mail.planning.print.link.intro'|trans({}, 'mail', mail.locale)|html|nl2br }}<br>

{{ macros.button(
    'mail.planning.print.link.click'|trans({}, 'mail', mail.locale),
    url('admin_planning_export_link', {'event': mail.event.id, 'file': mail.filePath})
) }}
</body>
</html>
