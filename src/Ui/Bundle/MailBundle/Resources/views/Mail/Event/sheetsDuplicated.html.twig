{% extends 'MailBundle:Mail:base.html.twig' %}

{% block body %}
    <p>{{ 'mail.event.sheets_duplicated.subject'|trans({'%eventOrigin%': mail.originEvent.title, '%event%': mail.event.title}, 'mail', mail.locale) }}</p>
    <ul>
        {% for sheet in mail.importedSheets %}
            <li>{{ sheet.title }}</li>
        {% endfor %}
    </ul>
{% endblock %}
