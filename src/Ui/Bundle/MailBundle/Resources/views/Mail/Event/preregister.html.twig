{% block subject %}
    {{ 'mail.event.preregister.subject'|trans({
        '%event%': mail.event.title
    }, 'mail', mail.locale) }}
{% endblock %}

{% block body %}
    {% set memberSpace = url('event_account_participant_profile', {'sheet': mail.sheet.id, 'participant': mail.participant.id}) %}

    {{ 'mail.event.preregister.body'|trans({
        '%event%': mail.event.title,
        '%firstname%': mail.receiverUser.account.firstname|humanize,
        '%lastname%': mail.receiverUser.account.lastname|upper,
        '%memberSpace%': memberSpace
    }, 'mail', mail.locale)|html|nl2br }}

    <ul>
        <li>{{ mail.participantData['sheet_organization'] }}</li>
        <li>{{ mail.receiverUser.account.firstname|humanize ~ ' ' ~ mail.receiverUser.account.lastname|upper }}</li>
        <li>{{ mail.participantData['participant_position'] }}</li>
        <li>{{ mail.participantData['participant_address'] ~ ', ' ~ mail.participantData['participant_zipcode'] ~ ', ' ~ mail.participantData['participant_city']|upper }}</li>
        <li>{{ mail.participantData['participant_mobile'] }}</li>
        <li>{{ mail.receiverUser.email }}</li>
    </ul>

    {{ 'mail.event.preregister.end'|trans({
        '%event%': mail.event.title,
        '%eventPhone%': mail.event.configuration.organiserPhone,
        '%eventMail%': mail.event.organiserEmail
    }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
