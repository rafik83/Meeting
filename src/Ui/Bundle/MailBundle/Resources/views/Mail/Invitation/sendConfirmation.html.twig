{% block subject %}
    {{ 'mail.invitation_send_confirm.subject'|trans }}
{% endblock %}

{% block body %}
    {{ 'mail.invitation_send_confirm.body'|trans({
        '%firstname%': mail.user.firstname|humanize,
        '%lastname%': mail.user.lastname|upper,
        '%guestMail%': '',
        '%event%': mail.event.title
    }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}

{% block end %}
    {{ 'mail.invitation_send_confirm.end'|trans({
        '%event%': mail.event.title,
        '%eventPhone%': '',
        '%eventMail%': ''
    }, 'mail', mail.locale) }}
{% endblock %}
