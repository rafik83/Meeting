{% extends 'MailBundle:Mail:base.html.twig' %}

{% import "MailBundle:Mail:macros.html.twig" as macros %}

{% block body %}
    {{ 'mail.sheet.change_type.body'|trans({
        '%event%': mail.event.title,
        '%fromType%': mail.fromTypeTitle,
        '%toType%': mail.toTypeTitle,
        '%firstname%': mail.firstname|capitalize,
        '%lastname%': mail.lastname|upper,
        '%participationType%': mail.participantType
    }, 'mail', mail.locale)|html|nl2br }}

    <br>
    <br>

    {{ macros.button(
        'mail.participant.profile.link'|trans({}, 'mail', mail.locale),
        'https://' ~ mail.event.domain ~ path('event_sheet_locale', { 'sheet': mail.sheet.id, 'locale': mail.locale })
    ) }}

    <br>

    {{ 'mail.sheet.change_type.end'|trans({}, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
