{% extends 'MailBundle:Mail:base.html.twig' %}

{% block body %}
    {{ 'mail.sheet.add_participant_confirmation.body'|trans({
        '%firstname%': mail.user.account.firstname|capitalize,
        '%lastname%': mail.user.account.lastname|upper,
        '%guestEmail%': mail.guest.user.email,
        '%event%': mail.event.title,
        '%eventPhone%': mail.event.configuration.organiserPhone,
        '%eventMail%': mail.event.organiserEmail
    }, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
