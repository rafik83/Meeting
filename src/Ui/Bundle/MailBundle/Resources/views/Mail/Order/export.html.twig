{% import "MailBundle:Mail:macros.html.twig" as macros %}
<html>
<body>
{{ 'mail.order.export.intro'|trans({'%eventTitle%': mail.event.title}, 'mail', mail.locale)|html|nl2br }}
<br>
{{ macros.button(
    'mail.order.export.link.click'|trans({}, 'mail', mail.locale),
    url('admin_order_export_file', {
        'event': mail.event.id,
        'hash': mail.fileHash,
        'file': mail.fileId,
        '_locale': mail.locale,
    })
) }}
</body>
</html>
