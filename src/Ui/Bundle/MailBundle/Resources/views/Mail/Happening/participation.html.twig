{% extends 'MailBundle:Mail:base.html.twig' %}

{% block body %}
    {% set locale = mail.event.availableLocale(mail.locale) %}
    <p>{{ 'mail.happening.participation.intro'|trans({}, 'mail', mail.locale) }}</p>
    {% for happeningParticipationView in mail.happeningParticipationViews %}
        {{ happeningParticipationView.happening.title(locale) }}<br/>
        <ul>
            {% for addedParticipant in happeningParticipationView.addedParticipants %}
                <li>
                    {{ 'mail.happening.participation.register'|trans({'%name%': addedParticipant.fullName}, 'mail', mail.locale) }}
                </li>
            {% endfor %}

            {% for removedParticipant in happeningParticipationView.removedParticipants %}
                <li>
                    {{ 'mail.happening.participation.unregister'|trans({'%name%': removedParticipant.fullName}, 'mail', mail.locale) }}
                </li>
            {% endfor %}
        </ul>
    {% endfor %}
{% endblock %}
