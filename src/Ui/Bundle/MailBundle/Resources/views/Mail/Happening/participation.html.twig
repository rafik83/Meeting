{% extends 'MailBundle:Mail:base.html.twig' %}

{% block body %}
    {% for happeningParticipationView in mail.happeningParticipationViews %}
        {% set locale = event.availableLocale(mail.locale) %}

        {{ happeningParticipationView.happening.title(locale) }}
        <ul>
            {% for addedParticipant in happeningParticipationView.addedParticipants %}
                <li>{{ addedParticipant.fullName }}</li>
            {% endfor %}

            {% for removedParticipant in happeningParticipationView.removedParticipants %}
                <li>{{ removedParticipant.fullName }}</li>
            {% endfor %}
        </ul>

    {% endfor %}
{% endblock %}

