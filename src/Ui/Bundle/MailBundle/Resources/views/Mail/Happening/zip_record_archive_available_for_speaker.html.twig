{% extends 'MailBundle:Mail:base.html.twig' %}

{% import "MailBundle:Mail:macros.html.twig" as macros %}

{% block body %}
    <p>{{ 'mail.happening.webinar.zip_record_archive_available_for_speaker.intro'|trans({'%happeningTitle%': mail.happeningTitle}, 'mail', mail.locale) }}</p>
    <br>
    {{ macros.button(
        'mail.happening.webinar.zip_record_archive_available_for_speaker.link'|trans({},'mail', mail.locale),
        eventUrl(
            mail.event,
            'event_happening_webinar_download_record_archive',
            {
                'happening': mail.happening.id,
                '_locale': mail.event.getAvailableLocale(mail.locale)
            }
        )
    ) }}
    <br>
    <p>{{ 'mail.happening.webinar.zip_record_archive_available_for_speaker.outro'|trans({}, 'mail', mail.locale) }}</p>
{% endblock %}
