{% extends 'MailBundle:Mail:base.html.twig' %}

{% import "MailBundle:Mail:macros.html.twig" as macros %}

{% block body %}
    {{ 'admin.mail.resetPassword.body'|trans({}, 'mail', mail.locale)|html|nl2br }}

    <br>
    <br>
    {{ macros.button(
        'admin.mail.resetPassword.link'|trans({}, 'mail', mail.locale),
        url('admin_create_new_password', { 'token': mail.token})
    ) }}
    <br>

    {{ 'admin.mail.resetPassword.end'|trans({}, 'mail', mail.locale)|html|nl2br }}
{% endblock %}
