{% extends 'EventBundle::base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title 'billing_info.title'|trans %}

{% block content %}

        <section class="main">
            {% if view is not empty and view.funnel is defined and view.funnel is not null %}
                {{ include('EventBundle:Package:breadcrumb.html.twig', {view: view}) }}
            {% endif %}

            <div class="billing-info">
                <div class="profile__content">
                    <header>
                        <h1>{{ 'billing_info.title'|trans }}</h1>
                    </header>
                    <div class="main__content">
                        {{ form(form, { 'attr': { 'class': 'styled-form form-with-label' } }) }}
                    </div>
                </div>
            </div>
        </section>
{% endblock %}
