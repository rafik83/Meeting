{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% form_theme form 'VimeetAppBundle::library.html.twig' %}

{% block title eventView.title %}

{% block content %}

    <h2>Montant de votre commande</h2>

    <table class="table table-condensed">
        <tbody>
            <tr class="info">
                <th>Total HT</th>
                <th class="text-right">{{ cart_view.totalWithoutTaxes|number_format(2, ',', '&nbsp;')|html }}&nbsp;€</th>
            </tr>
            {% if cart_view.vatApplicable %}
                <tr>
                    <th>TVA {{ cart_view.vat }}%</th>
                    <th class="text-right">{{ cart_view.taxes|number_format(2, ',', '&nbsp;')|html }}&nbsp;€</th>
                </tr>
                <tr>
                    <th>Total TTC</th>
                    <th class="text-right">{{ cart_view.totalWithTaxes|number_format(2, ',', '&nbsp;')|html }}&nbsp;€</th>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <h2>{{ 'event.sheet.payment.title'|trans }}</h2>

    <p>{{ 'event.sheet.payment.description'|trans }}</p>
    <hr>

    {{ form(form) }}

{% endblock %}
