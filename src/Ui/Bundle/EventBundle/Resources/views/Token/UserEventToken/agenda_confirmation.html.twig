{% extends 'EventBundle::base.html.twig' %}

{% block title event.title ~ ' ' ~ 'user_event.confirm.agenda.title'|trans %}

{% block content %}
    <div class="profile__content">
        <section class="main">
            <header>
                <h1>{{ 'user_event.confirm.agenda.title'|trans }}</h1>
            </header>

            <div class="important success">
                {% if already_confirmed %}
                    {{ 'user_event.confirm.agenda.already_confirmed'|trans }}
                {% else %}
                    {{ 'user_event.confirm.agenda.success'|trans }}
                {% endif %}
            </div>

            {% for tipTranslationView in tipTranslationViews %}
                <div class="main__content styled-form mg-tp">
                    <h1>{{ tipTranslationView.title }}</h1>

                    {{ tipTranslationView.content|html }}

                    {% if sendCodeForm is not null %}
                        {% form_theme sendCodeForm '@Ui/default.html.twig' %}
                        {{ form(sendCodeForm) }}
                    {% endif %}
                </div>
            {% endfor %}
        </section>
    </div>
{% endblock %}
