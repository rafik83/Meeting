{% extends 'EventBundle:Register:base.html.twig' %}

{% block title event.title %}

{% block content %}
    <section class="main">
        <header>
            <h1>Sélectionner une fiche</h1>
        </header>

        <div class="main__content">
            <ul class="styled-form">
                {% for sheetView in sheetViews %}
                    <li>
                        <a href="{{ path('event_sheet_default', {'sheet': sheetView.id}) }}">
                            {{ sheetView.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endblock %}
