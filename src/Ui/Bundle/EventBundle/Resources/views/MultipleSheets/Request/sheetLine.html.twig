<tr class="catalog__sheet">
    <td rowspan="{{ sheetView.numberOfRequest }}">
        <p>{{ sheetView.sheetTitle }} <span class="label label-primary">{{ sheetView.type }}</span></p>
    </td>

    {% for requestView in sheetView.requestViews %}
        <td>
            {% if isMultipleSheet %}
                {{ include('EventBundle:MultipleSheets/Request:displayModalSheetLink.html.twig', {
                    'displaySheetRoute': 'event_sheet_group_display_sheet_for_multisheet_user'}
                ) }}
            {% else %}
                {{ include('EventBundle:MultipleSheets/Request:displayModalSheetLink.html.twig', {
                    'displaySheetRoute': 'event_sheet_group_display_sheet_for_group_manager'}
                ) }}
            {% endif %}
        </td>
        <td>
            <div class="buttons-zone">
                {{ include('EventBundle:MeetingRequest:buttons.html.twig', {
                    'allowedToCreate': false,
                    'meetingRequest': requestView.request,
                    'viewed': sheetView.sheet,
                    'viewer': requestView.sheetMet,
                    'isMeetingPublished': requestView.planned,
                    'isMeetingRequestUpdateLocked': isMeetingRequestUpdateLocked,
                    'isMeetingRequestClosed': isMeetingRequestClosed,
                    'isAnsweringMeetingRequestClosed': isAnsweringMeetingRequestClosed,
                    'hideMeetingRequest': hideMeetingRequest|default(false),
                    'isPhoneValidationRequired': sheetView.isPhoneValidationRequired,
                    'phoneValidationLink': sheetView.validatePhoneLink
                }) }}
            </div>
        </td>
        <td class="text-center">
            {% if requestView.isProposition %}
                <i class="icon-Suivant"></i>
            {% else %}
                <i class="icon-Retour"></i>
            {% endif %}
        </td>
        <td>
            {{ requestView.sheetMetTitle }}
        </td>

        <td class="participants-list">
            {% if requestView.participantViews is not empty %}
                <ul>
                    {% for participantView in requestView.participantViews %}
                        <li>{{ participantView.completeName }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                {{ 'multiple_sheets.request.list.no-preference'|trans }}
            {% endif %}
        </td>

        {% if not loop.last %}
            </tr><tr class="catalog__sheet">
        {% endif %}
    {% endfor %}
</tr>
