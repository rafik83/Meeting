<div class="mg-bt">
    {{ form_start(filterForm) }}
    <div class="col-md-6"><h2>{{ 'group.request.filter.title'|trans }}</h2></div>
    <div class="col-md-6">
        <div class="pull-right">{{ form_row(filterForm.submit) }}</div>
    </div>
    <table class="col-md-12">
        <tr>
            <th class="col-md-3"></th>
            <th class="col-md-2">
                {{ form_label(filterForm.state) }}
                {{ form_widget(filterForm.state) }}
            </th>
            <th class="col-md-2">
                {{ form_label(filterForm.type) }}
                {{ form_widget(filterForm.type) }}
            </th>
            <th class="col-md-3"></th>
            <th class="col-md-2"></th>
        </tr>
    </table>
    {{ form_end(filterForm) }}
</div>
