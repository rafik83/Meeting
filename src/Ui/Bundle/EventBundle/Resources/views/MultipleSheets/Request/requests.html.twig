<h1>
    {{ 'multiple_sheets.request.list.totalRequest'|transchoice(sheetListView.totalRequest, {'%totalRequest%': sheetListView.totalRequest}) }}
</h1>

<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th class="col-md-3">{{ 'multiple_sheets.request.list.table.header.otherSheet'|trans }}</th>
        <th></th>
        <th class="col-md-2">{{ 'multiple_sheets.request.list.table.header.status'|trans }}</th>
        <th class="col-md-2">{{ 'multiple_sheets.request.list.table.header.side'|trans }}</th>
        <th class="col-md-3">{{ 'multiple_sheets.request.list.table.header.sheetConcerned'|trans }}</th>
        <th class="col-md-2">{{ 'multiple_sheets.request.list.table.header.participants'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% for sheetView in sheetListView.sheetViews if sheetListView.sheetViews is not empty %}
        {{ include('EventBundle:MultipleSheets/Request:sheetLine.html.twig', {
            'sheetView': sheetView,
            'isMeetingRequestUpdateLocked': sheetListView.isMeetingRequestUpdateLocked,
            'isMeetingRequestClosed': sheetListView.isMeetingRequestClosed,
            'isAnsweringMeetingRequestClosed': sheetListView.isAnsweringMeetingRequestClosed,
            'isMultipleSheet': isMultipleSheet,
            'hideMeetingRequest': hideMeetingRequest|default(false),
        }) }}
    {% else %}
        <tr>
            <td colspan="6" class="text-center">{{ 'multiple_sheets.request.list.table.no-result'|trans }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>

{{ include('AdminBundle:Paginator:paginate.html.twig', {'paginator': sheetListView}) }}

{{ include('EventBundle:MeetingRequest:modalMeetingRequest.html.twig') }}

{{ include('EventBundle:Sheet/Group/Sheet:modalDisplaySheet.html.twig') }}
