<div class="meet lock" data-beginHour="{{ cancelAttendanceUnavailability.begin|date('H:i', cancelAttendanceUnavailability.timeZone) }}" data-duration="{{ cancelAttendanceUnavailability.duration.format('%H:%I') }}">
    <header>
        <div class="content">
            <span class="prefix"><i class="icon icon-Verouiller_1"></i></span>
            <p class="title">
                {{ cancelAttendanceUnavailability.begin|date('H:i', cancelAttendanceUnavailability.timeZone) ~ ' - ' ~ cancelAttendanceUnavailability.end|date('H:i', cancelAttendanceUnavailability.timeZone) }}
                -
                {{ 'unavailability.title'|trans }}
            </p>
        </div>
    </header>
</div>
