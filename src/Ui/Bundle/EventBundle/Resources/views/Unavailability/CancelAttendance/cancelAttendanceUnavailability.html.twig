{% set timezone = cancelAttendanceUnavailability.timeZone %}
{% if isVisio and participant.timezone %}
    {% set timezone = participant.timezone %}
{% endif %}


<div class="meet lock" data-beginHour="{{ cancelAttendanceUnavailability.begin|date('H:i', timezone) }}" data-duration="{{ cancelAttendanceUnavailability.duration.format('%H:%I') }}">
    <header>
        <div class="content">
            <span class="prefix"><i class="icon icon-Verouiller_1"></i></span>
            <p class="title">
                {{ cancelAttendanceUnavailability.begin|date('H:i', timezone) ~ ' - ' ~ cancelAttendanceUnavailability.end|date('H:i', timezone) }}
                -
                {{ 'unavailability.title'|trans }}
            </p>
        </div>
    </header>
</div>
