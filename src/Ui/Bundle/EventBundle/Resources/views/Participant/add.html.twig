{% form_theme form 'EventBundle:Common:form_theme.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        Ajouter: {{ label }}
    </h4>
</div>
<div class="modal-body">
    {{ form_start(form, {attr: {class: 'styled-form'}}) }}
        <div class="inputs">
            {{ form_errors(form) }}

            {{ form_row(form.firstName) }}
            {{ form_row(form.lastName) }}
            {{ form_row(form.email) }}

            <div class="validation">
                <button type="submit" class="btn">
                    Envoyer l'invitation
                </button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
        <i class="icon-Retour"></i>Retour à la fiche
    </button>
</div>
