{% form_theme form '@Ui/default.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        {{ 'sheet.object.action.add'|trans }} {{ label }}
    </h4>
</div>
<div class="modal-body">
    {{ form_start(form, {attr: {class: 'styled-form'}}) }}
        <div class="inputs">
            {{ form_errors(form) }}

            {{ form_row(form.firstName) }}
            {{ form_row(form.lastName) }}
            {{ form_row(form.email) }}


            {% if participantProduct is not null %}
                <table class="table">
                    <tbody>
                        <tr>
                            <td class="col-xs-9">
                                <div class="buyable-product-row">
                                    {{ participantProduct.title(app.request.locale) }} :
                                </div>
                            </td>
                            <td class="col-xs-3">
                                <div class="buyable-product-row product-price">
                                    {{ 'package.product.unitPrice'|trans({
                                        '%price%': participantProduct.unitPrice,
                                        '%currency%': participantProduct.currency|currency_symbol,
                                        '%vatMode%': ('package.vatMode.' ~ participantProduct.vatMode)|trans
                                    })|html }}
                                </div>

                            </td>
                        </tr>
                    </tbody>
                </table>
            {% endif %}

            <div class="validation">
                <button type="submit" class="btn btn-primary">
                    {{ 'sheet.participant.sendInvite'|trans }}
                </button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ ('common.' ~ backRoute)|trans }}
    </button>
</div>
