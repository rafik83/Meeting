{% form_theme form '@Ui/default.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        {{ 'package.participant.add'|trans }}
    </h4>
</div>
<div class="modal-body">
    {{ form_start(form, {attr: {class: 'styled-form'}}) }}
        <div class="inputs">
            {{ form_errors(form) }}

            {% if form.firstName is defined %}
                {{ form_row(form.firstName) }}
            {% endif %}

            {% if form.lastName is defined %}
                {{ form_row(form.lastName) }}
            {% endif %}

            {{ form_row(form.email) }}

            {% if participantProductView is not null %}
                <table class="table">
                    <tbody>
                        <tr>
                            <td class="col-xs-9">
                                <div class="buyable-product-row">
                                    {{ participantProductView.title }}
                                </div>
                            </td>
                            <td class="col-xs-3">
                                <div class="buyable-product-row product-price">
                                    {# NB: need to be replaced by a select one from several products #}
                                    {{ 'package.product.unitPrice'|trans({
                                        '%price%': participantProductView.unitPrice,
                                        '%currency%': participantProductView.currency|currency_symbol,
                                        '%vatMode%': ('package.vatMode.' ~ participantProductView.vatMode)|trans
                                    })|html }}
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            {% endif %}

            <div class="validation">
                <button type="submit" class="btn btn-primary">
                    {{ 'sheet.participant.sendInvite'|trans }}
                </button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ ('common.' ~ backRoute)|trans }}
    </button>
</div>
