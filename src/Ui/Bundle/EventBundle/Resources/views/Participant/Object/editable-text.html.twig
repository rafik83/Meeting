{% set objectTags = object.getTags %}
{% if 'participant_firstname' not in objectTags and 'participant_lastname' not in objectTags and (not object.isTextarea or forceDisplay is defined and forceDisplay == true) %}
    {% if 'sheet_organization' in objectTags %}
        <strong>{{ object.contentValueLocalize }}</strong>
    {% else %}
        {{ object.contentValueLocalize }}
    {% endif %}
{% endif %}
