{% form_theme form '@Ui/default.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        {{ 'sheet.object.action.add'|trans }} {{ label }}
    </h4>
</div>
<div class="modal-body">
    {{ form_start(form, {attr: {class: 'styled-form'}}) }}
    <div class="inputs">
        {{ form_errors(form) }}

        {{ form_row(form.firstName) }}
        {{ form_row(form.lastName) }}
        {{ form_row(form.email) }}

        <strong>
            {{ sheet.package.participant.title(app.request.locale) }} :
            {{ 'package.product.unitPrice'|trans({
                '%price%': sheet.package.participant.unitPrice,
                '%currency%': sheet.package.participant.currency|currency_symbol,
                '%vatMode%': ('package.vatMode.' ~ sheet.package.participant.vatMode)|trans
            })|html }}
        </strong>

        <div class="validation">
            <button type="submit" class="btn btn-primary">
                {{ 'sheet.participant.sendInvite'|trans }}
            </button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ 'common.backToPackage'|trans }}
    </button>
</div>
