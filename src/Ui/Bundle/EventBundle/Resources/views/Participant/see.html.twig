{% extends 'EventBundle::base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <div class="profile__center">
        <div class="profile__box">
            <section class="main">
                <header>
                    <h1></span>{{ 'account.profile.profile'|trans }}</h1>
                </header>
                <div class="main__content">
                    <div class="preview">
                        <div class="object--participant">
                            <div class="list list--users">
                                <div class="user clearfix">
                                    <div class="user__avatar">
                                        <span class="bullet"></span>
                                        <div class="avatar">
                                            <p>CM</p>
                                        </div>
                                    </div>
                                    <div class="user__infos">
                                        <p class="name">Emmanuelle ANDROMACAS</p>
                                        <p class="job">Responsable Innovation</p>
                                        <p class="edit"><a href="">Modifier la photo</a></p>
                                    </div>
                                </div>
                                {# {{ include('EventBundle:Participant:preview.html.twig', { 'participant': card}) }} #}
                            </div>
                            {#
                            {% for key, avatar in avatarTemplate %}
                                <a href="{{ path('event_account_participant_avatar', {sheet: sheet.id, participant: participant.id, key: key}) }}">
                                    {{ 'account.profile.updateAvatar'|trans }}
                                </a>
                            {% endfor %}
                            #}
                        </div>
                        <div class="coordinates">
                            <strong>{{ 'account.profile.contactInformation'|trans }} :</strong>
                            <ul>
                                <li class="phone"><span class="icon-Appeler"></span> +33909090909</li>
                                <li class="smartphone"><span class="icon-Smartphone"></span> +33606060606</li>
                                <li class="email"><span class="icon-Message_1"></span> contact@elao.com</li>
                            </ul>
                            {#
                            <ul>
                            {% for object in profileTemplate %}
                                <li>
                                    {{ include('EventBundle:Participant/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}
                                </li>
                            {% endfor %}
                                <li>{{ participant.user.getEmail() }}</li>
                            </ul>
                            #}
                        </div>
                        <div class="validation">
                            <a href="{{ path('event_account_participant_profile', {sheet: sheet.id, participant: participant.id}) }}">
                                <button type="submit" class="btn btn-primary">
                                    {{ 'common.update'|trans }}
                                </button>
                            </a>
                        </div>
                    </div>
                </div>
                {% if participant.user == app.user %}
                <ul>
                    <li>
                        <a href="{{ path('event_change_password') }}"><span class="icon-Verouiller_1"></span> {{ 'account.change_password.title'|trans }}</a>
                    </li>
                    <li>
                        <a href="{{ path('event_account_change_mail') }}"><span class="icon-Message_1"></span> {{ 'account.update_email.title'|trans }}</a>
                    </li>
                </ul>
                {% endif %}
            </section>
        </div>
        <div class="profile__box">
            <section class="main">
                <header>
                    <h1>{{ 'account.profile.company'|trans }}</h1>
                </header>
                <div class="main__content">
                    <div class="preview">
                        <div>
                            <ul class="company">
                                {% for object in companyTemplate %}
                                    <li>
                                        <strong>{{ include('EventBundle:Participant/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}</strong>
                                    </li>
                                {% endfor %}
                                <li>Laboratoire public</li>
                                <li class="url"><a href="">http://www.onera.fr</a></li>
                            </ul>
                            <ul class="adress">
                                <li>34 Rue Jean Broquin</li>
                                <li>69006 LYON</li>
                                <li>FRANCE</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
