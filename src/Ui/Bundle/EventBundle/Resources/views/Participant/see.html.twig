{% extends 'EventBundle::base.html.twig' %}

{% block title event.title %}

{% block content %}
    <div class="profile__center">
        <div class="profile__box">
            <section class="main">
                <header>
                    <h1><i class="icon-Profil_1"></i> {{ 'account.profile.profile'|trans }}</h1>
                </header>
                <div class="main__content">
                    <div class="preview">
                        <div class="object--participant">
                            <div class="list list--users">
                                {{ include('EventBundle:Participant:preview.html.twig', { 'participant': card, 'editAvatar': true, 'avatarTemplate': avatarTemplate}) }}
                            </div>
                        </div>
                        <div class="coordinates">
                            <strong>{{ 'account.profile.contactInformation'|trans }}:</strong>
                            <ul>
                            {% for object in profileTemplate %}
                                <li>
                                    {{ include('EventBundle:Participant/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}
                                </li>
                            {% endfor %}
                                <li><i class="icon-Message_1"></i> {{ participant.user.getEmail() }}</li>
                            </ul>
                        </div>
                        <div class="validation">
                            <a href="{{ path('event_account_participant_profile', {sheet: sheet.id, participant: participant.id}) }}" class="btn btn-primary">
                                <i class="icon-Profil_1"></i> {{ 'common.update'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
                {% if participant.user == app.user %}
                <ul>
                    {% if not event.disabledPasswordChanging %}
                        <li>
                            <a href="{{ path('event_change_password', { sheet: sheet.id }) }}"><span class="icon-Verouiller_1"></span> {{ 'account.change_password.title'|trans }}</a>
                        </li>
                    {% endif %}
                    {% if not event.disabledEmailChanging %}
                        <li>
                            <a href="{{ path('event_account_change_mail', { sheet: sheet.id }) }}"><span class="icon-Message_1"></span> {{ 'account.update_email.title'|trans }}</a>
                        </li>
                    {% endif %}
                </ul>
                {% endif %}
            </section>
        </div>
        {% if companyTemplate %}
        <div class="profile__box">
            <section class="main">
                <header>
                    <h1><i class="icon-Societe"></i> {{ 'account.profile.company'|trans }}</h1>
                </header>
                <div class="main__content">
                    <div class="preview">
                        <ul class="company">
                            {% for object in companyTemplate %}
                                <li>
                                   {{ include('EventBundle:Participant/Object:' ~ object.type ~ '.html.twig', { 'object': object}) }}
                                </li>
                            {% endfor %}
                        </ul>
                        {% if companyTemplate %}
                            <a href="{{ path('event_account_participant_company', {sheet: sheet.id}) }}" class="btn btn-primary">
                                <i class="icon-Societe"></i> {{ 'common.update'|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            </section>
        </div>
        {% endif %}
    </div>
{% endblock %}
