{% set isCatalog = isCatalog|default(false) %}
{% set isAccountParticipantLinkEnabled = not isCatalog and participant.editable and null != participant.sheetId %}

<div class="user clearfix">
    <div class="user__avatar">
        <span class="bullet"></span>

        {% if isAccountParticipantLinkEnabled %}
            <a href="{{ path('event_account_participant', {sheet: participant.sheetId, participant: participant.id}) }}">
        {% endif %}

        <div class="avatar">
            {% if participant.isOnline is not same as null %}
                {% if participant.isOnline %}
                        <div class="user__status__online"></div>
                {% else %}
                         <div class="user__status__offline"></div>
                {% endif %}
            {% endif %}

            {% if participant.avatar != null %}
                <img {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %} src="{{ participant.avatar|imagine_filter('user_avatar') }}" alt="{{ participant.initials }} avatar">
            {% else %}
                <p {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %}>{{ participant.initials }}</p>
            {% endif %}
        </div>

        {% if isAccountParticipantLinkEnabled %}
            </a>
        {% endif %}
    </div>
    <div class="user__infos">
        <p class="name">{{ participant.firstname|capitalize }} {{ participant.lastname|upper }}</p>
        <p class="job">{{ participant.position }}</p>
        <div class="user_meet_container" data-chat>
            {% if participant.isOnline is not same as (null) %}
                {% if participant.isOnline %}
                    <a class="user__meet" data-participant-user-id="{{ sheet.id  }}" data-private-chat-url="{{ path('event_networking_chat', {sheet: sheet.id, toUser: participant.id}) }}">
                        <div class="online">{{ 'account.status.meetOnline'|trans }}</div>
                        <p></p>
                    </a>
                {% else %}
                    <span class="user__meet">
                        <div class="offline">{{ 'account.status.offline'|trans }}</div>
                    </span>
                {% endif %}
            {% endif %}
        </div>


        {% if not isCatalog and editAvatar is defined and editAvatar == true %}
            {% for key, avatar in avatarTemplate %}
                <a class="edit" href="{{ path('event_account_participant_avatar', {sheet: sheet.id, participant: participant.id, key: key}) }}">
                    <i class="icon-Image"></i> {{ 'account.profile.updateAvatar'|trans }}
                </a>
            {% endfor %}
        {% endif %}

        {% if participant.getCheckinStatus %}
            {% if participant.isCheckedToday %}
                <span class="label label-success">{{ 'contacts.list.present'|trans }}</span>
            {% else %}
                <span class="label label-danger">{{ 'contacts.list.absent'|trans }}</span>
            {% endif %}
        {% endif %}

        {% if sortFormWidget is defined %}
            {{ sortFormWidget|html }}
        {% endif %}
    </div>
</div>
