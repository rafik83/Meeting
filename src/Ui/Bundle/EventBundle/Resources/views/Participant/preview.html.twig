<div class="user clearfix">
    <div class="user__avatar">
        <span class="bullet"></span>
        {% if participant.editable and null != participant.sheetId %}
            <a href="{{ path('event_account_participant', {sheet: participant.sheetId, participant: participant.id}) }}">
                <div class="avatar">
                    {% if participant.avatar != null %}
                        <img {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %} src="{{ asset(participant.avatar) }}">
                    {% else %}
                        <p {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %}>{{ participant.firstname|first|upper }}{{ participant.lastname|first|upper }}</p>
                    {% endif %}
                </div>
            </a>
        {% else %}
            <div class="avatar">
                {% if participant.avatar != null %}
                    <img {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %} src="{{ asset(participant.avatar) }}">
                {% else %}
                    <p {% if participantAvatarId is defined %}id="{{ participantAvatarId }}"{% endif %}>{{ participant.firstname|first|upper }}{{ participant.lastname|first|upper }}</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
    <div class="user__infos">
        <p class="name">{{ participant.firstname|capitalize }} {{ participant.lastname|upper }}</p>
        <p class="job">{{ participant.position }}</p>
        {% if editAvatar is defined and editAvatar == true %}
            {% for key, avatar in avatarTemplate %}
                <a class="edit" href="{{ path('event_account_participant_avatar', {sheet: sheet.id, participant: participant.id, key: key}) }}">
                    <i class="icon-Image"></i> {{ 'account.profile.updateAvatar'|trans }}
                </a>
            {% endfor %}
        {% endif %}
    </div>
</div>

