{% extends 'EventBundle::base.html.twig' %}

{% block title event.title %}

{% block body_attributes 'class="grey"' %}

{% block content %}
    <div class="mg-tp well text-center">
        <b>
            {{ message }}
        </b>
        <br>
        {% if isLoginActivated == true %}
            <a href="{{ path('event_login') }}" title="{{ 'login.link'|trans }}">
                {{ 'login.link.label'|trans }}
            </a>
        {% endif %}

    </div>
    <div class="text-center">
        <img src="{{ asset('assets/images/vimeet_poweredby.png') }}">
    </div>
{% endblock %}

