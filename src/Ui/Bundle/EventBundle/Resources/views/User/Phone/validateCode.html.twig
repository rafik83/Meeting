{% extends 'EventBundle::base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title event.title ~ ' ' ~ 'event.user_event_phone.validate.title'|trans %}

{% block content %}
    <div class="profile__content">
        <section class="main">
            <header>
                <h1>{{ 'event.user_event_phone.validate.title'|trans }}</h1>
            </header>

            <div class="main__content">
                <p>{{ 'event.user_event_phone.validate.explanation'|trans }}</p>
                {{ form_start(form, {attr: {class: 'styled-form'}}) }}
                <div class="inputs">
                    {{ form_row(form.code) }}
                    <div class="validation">
                        <button type="submit" class="btn btn-primary">
                            <i class="icon-Suivant_3"></i> {{ 'form.user_event_phone_validate_code.children.confirm.label'|trans({}, 'forms') }}
                        </button>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
            <a class="link" href="{{ path('event_user_event_token_confirm_agenda', {'token': token }) }}">
                <i class="icon-Appeler"></i>
                {{ 'event.user_event_phone.validate.returnToPhone'|trans }}
            </a>
        </section>
    </div>
{% endblock %}
