{% extends 'EventBundle::base.html.twig' %}

{% block title %}{{ 'notification.list.title.label'|trans }}{% endblock %}

{% block content %}
    <section class="main">
        <header>
            <h1><i class="icon-Retard"></i> {{ 'notification.list.title.label'|trans }}</h1>
        </header>

        <table class="table table-striped table--notification">
            <thead>
            <tr>
                <th>{{ 'notification.columns.createdAt'|trans }}</th>
                <th>{{ 'notification.columns.category'|trans }}</th>
                <th>{{ 'notification.columns.description'|trans }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for notification in notifications.notificationViews %}
                <tr>
                    <td>{{ notification.createdAt|localizeddate('long', 'none', app.request.locale) }}</td>
                    <td>
                        <i class="{{ notification.icon }}"></i> {{ ('notification.category.' ~ notification.category ~ '.label')|trans }}
                    </td>
                    <td>
                        {{ notification.description|trans({'%locale%': notification.locale|locale(app.request.locale)|lower}) }}
                        {% if notification.hasLabel %}
                            <span class="label label-{{ notification.priority }}">{{ ('notification.label.' ~ notification.priority)|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ notification.link }}"><i class="icon-Voir_1"></i> {{ 'notification.link.label'|trans }}
                        </a>
                    </td>
                </tr>
            {% else %}
                <p>{{ 'notification.empty'|trans }}</p>
            {% endfor %}
            </tbody>
        </table>

    </section>

{% endblock %}
