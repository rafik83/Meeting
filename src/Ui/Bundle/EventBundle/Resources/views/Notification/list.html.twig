{% extends 'EventBundle::base.html.twig' %}

{% block title %}{{ 'notification.list.title.label'|trans }}{% endblock %}

{% block content %}
    <section class="main">
        <header>
            <h1><i class="icon-Retard"></i> {{ 'notification.list.title.label'|trans }}</h1>
        </header>

        {% if notifications.notificationViews is not empty %}
            <table class="table table-striped table--notification">
                <thead>
                <tr>
                    <th>{{ 'notification.columns.createdAt'|trans }}</th>
                    <th>{{ 'notification.columns.category'|trans }}</th>
                    <th>{{ 'notification.columns.description'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for notification in notifications.notificationViews %}
                    <tr>
                        <td>{{ notification.createdAt|localizeddate('long', 'none', app.request.locale, event.timeZone) }}</td>
                        <td>
                            <i class="{{ notification.icon }}"></i> {{ ('notification.category.' ~ notification.category ~ '.label')|trans }}
                        </td>
                        <td>
                            {{ notification.description|trans(notification.parameters|merge({
                                '%locale%': notification.parameters['%locale%'] is defined ?
                                notification.parameters['%locale%']|locale(app.request.locale)|lower : '',
                                '%amount%': notification.parameters['%amount%'] is defined and notification.parameters['%currency%'] is defined ?
                                notification.parameters['%amount%']|localizedcurrency(notification.parameters['%currency%']) : ''
                            })) }}
                            {% if notification.hasPriorityLabel %}
                                <span class="label label-{{ notification.priority }} {{ notification.isImportant ? 'bg-highlighted' : '' }}">{{ ('notification.label.' ~ notification.priority)|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ notification.link }}"><i class="icon-Voir_1"></i> {{ 'notification.link.label'|trans }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>{{ 'notification.empty'|trans }}</p>
        {% endif %}
    </section>

{% endblock %}
