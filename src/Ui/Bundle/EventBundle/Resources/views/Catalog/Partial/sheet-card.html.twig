<div class="col-md-4">
    <div class="catalog__item {#catalog__item--checked#}">
        <header></header>
        <div class="content">
            {{ include('EventBundle:Sheet/Card:content.html.twig', { title: catalogSheetPreviewView.title, preview: catalogSheetPreviewView.preview }, false) }}
        </div>
        <footer>
            <div class="actions">
                <a id="complete-sheet-link-{{ catalogSheetPreviewView.id }}" href="{{ path('event_catalog_complete_sheet', {'sheet': catalogSheetPreviewView.id }) }}" target="_blank"><i class="icon-Document_1"></i> <span>{{ 'catalog.complete_sheet'|trans }}</span></a>
                {#<a href=""><i class="icon-EtoilePleine"></i> <span>Retirer des favoris</span></a>#}
            </div>

            {% if not catalogSheetPreviewView.isItMySheet %}
                <div class="buttons-zone button">
                    {{ include('EventBundle:MeetingRequest:buttons.html.twig', {
                        'allowedToCreate': not catalogSheetPreviewView.hasMeetingRequest,
                        'meetingRequest': catalogSheetPreviewView.meetingRequest,
                        'viewed': catalogSheetPreviewView.sheet,
                        'viewer': viewer,
                    }) }}
                </div>
            {% endif %}

            <p class="tags">
                <i class="icon-LienTag"></i> {{ catalogSheetPreviewView.type }}
            </p>
        </footer>
    </div>
</div>
