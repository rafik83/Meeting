{% set sheetToDisplayLink = path('event_catalog_complete_sheet', { sheet: viewer.id, sheetToDisplay: catalogSheetPreviewView.id }) %}
<div class="col-md-4">
    <div class="catalog__item">
        <div class="content__sheet-card">
            {{ include('EventBundle:MeetingRequest/Partials:priorityIcon.html.twig', { isPriority: catalogSheetPreviewView.isPriority }, false) }}
            {% if catalogSheetPreviewView.hasMessage and catalogSheetPreviewView.meetingRequest is not null %}
                <a href="{{ path('event_catalog_meeting_request_discussion', { 'sheet': viewer.id, 'meetingRequest': catalogSheetPreviewView.meetingRequest.id }) }}" data-toggle="modal" data-target="#request-modal" class="pull-right no-underline ft-size-18 mg-left-8">
                    <i class="icon-Message_1 ft-bold"></i>
                </a>
            {% endif %}
            {% if catalogSheetPreviewView.isSeenByCurrentUser %}
                <a href="{{ sheetToDisplayLink }}" class="pull-right no-underline ft-size-18 mg-left-8" target="_blank">
                    <i class="icon-Voir_1 ft-bold"></i>
                </a>
            {% endif %}
            {{ include('EventBundle:Sheet/Card:content.html.twig', { title: catalogSheetPreviewView.title, preview: catalogSheetPreviewView.preview, isCatalog: isCatalog, sheetToDisplayLink: sheetToDisplayLink, sheetToDisplayId: catalogSheetPreviewView.id }, false) }}

        </div>

        <footer>
            <div class="actions">
                <a id="complete-sheet-link-{{ catalogSheetPreviewView.id }}"
                   href="{{ sheetToDisplayLink }}"
                   target="_blank">
                    <i class="icon-Document_1"></i>
                    <span>{{ 'catalog.complete_sheet'|trans }}</span>
                </a>
                {#<a href=""><i class="icon-EtoilePleine"></i> <span>Retirer des favoris</span></a>#}
            </div>

            {% if not catalogSheetPreviewView.isItMySheet %}
                <div class="buttons-zone {% if meetingRequestView.isAnsweringMeetingRequestClosed is defined and meetingRequestView.isAnsweringMeetingRequestClosed == false %}button{% endif %}">
                    {{ include('EventBundle:MeetingRequest:buttons.html.twig', {
                        'allowedToCreate': catalogSheetPreviewView.isAllowedToCreateMeetingRequest,
                        'meetingRequest': catalogSheetPreviewView.meetingRequest,
                        'viewed': catalogSheetPreviewView.sheet,
                        'viewer': viewer,
                        'isMeetingPublished': catalogSheetPreviewView.isMeetingPublished,
                        'isMeetingRequestUpdateLocked': catalogSheetPreviewView.isMeetingRequestUpdateLocked|default(false),
                        'isMeetingRequestClosed': catalogSheetPreviewView.isMeetingRequestClosed,
                        'isAnsweringMeetingRequestClosed': catalogSheetPreviewView.isAnsweringMeetingRequestClosed,
                        'isPhoneValidationRequired': catalogSheetPreviewView.isPhoneValidationRequired,
                        'phoneValidationLink': catalogSheetPreviewView.validatePhoneLink,
                        'hideMeetingRequest': hideMeetingRequest|default(false),
                    }) }}
                </div>
            {% endif %}

            <p class="tags">
                <i class="icon-LienTag"></i> {{ catalogSheetPreviewView.type }}
            </p>
        </footer>
    </div>
</div>
