<div class="filter">
    <h3>{{ form.vars.label }}</h3>

    <ul data-message-at-least-one-checked="{{ ('form.search.' ~ form.vars.name  ~ '.at_least_one_checked')|trans({}, 'forms') }}">
        {% for child in form.children %}
            {% set disabled = choices[child.vars.value].count == 0 %}
            <li class="filter__item">
                <label class="checkbox-inline {{ disabled ? 'count_zero' : '' }}">
                    <span class="filter-label">{{ form_widget(child, {attr: {class: disabled ? 'disabled' : ''}}) }}{{ child.vars.label|trans({}, child.vars.translation_domain) }}</span>
                    <span class="details">{{ choices[child.vars.value].count }}</span>
                </label>
            </li>
        {% endfor %}
    </ul>
</div>
