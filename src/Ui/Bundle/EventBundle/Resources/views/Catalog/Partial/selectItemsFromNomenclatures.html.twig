{% form_theme form '@Ui/default.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title">{# set by CatalogSelectFromNomenclaturesField js component #}</h4>
</div>

{{ form_start(form) }}
<div class="modal-body">
    {{ form_row(form) }}
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ 'modal.close'|trans }}
    </button>
    <button type="submit" class="btn btn btn-primary">
        {{ 'modal.submit'|trans }}
    </button>
</div>
{{ form_end(form) }}
