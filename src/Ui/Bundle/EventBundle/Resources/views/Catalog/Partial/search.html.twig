{{ form_start(searchForm) }}

<div class="catalog__research">
    {% if searchForm.type is defined %}
        {{ include('EventBundle:Catalog:Partial/checkboxes.html.twig', { form: searchForm.type, choices: typeViews }, false) }}
    {% endif %}

    {% if searchForm.organizationCategory is defined %}
        {{ include('EventBundle:Catalog:Partial/select2.html.twig', { form: searchForm.organizationCategory }, false) }}
    {% endif %}

    {% if searchForm.position is defined %}
        {{ include('EventBundle:Catalog:Partial/select2.html.twig', { form: searchForm.position }, false) }}
    {% endif %}

    {% if searchForm.localization is defined %}
        <div class="filter">
            <h3>{{ searchForm.localization.vars.label|trans({}, searchForm.localization.vars.translation_domain) }}</h3>
            {{ form_widget(searchForm.localization) }}

            <select multiple
                    data-parent-input="{{ searchForm.localization.vars.id }}"
                    data-disable-auto-submit
                    data-ajax-autocomplete
                    data-method="post"
                    data-label-input-too-short="{{ 'form.search.autocomplete.atLeastTwoChars'|trans({}, 'forms') }}"
                    data-label-searching="{{ 'form.search.autocomplete.searching'|trans({}, 'forms') }}"
                    data-action="{{ path('event_catalog_search_localization') }}"
                    data-placeholder="{{ 'form.search.localization.search.placeholder'|trans({}, searchForm.vars.translation_domain) }}"
                    data-minimum-input-length="2"
                    class="form-control">
            </select>
        </div>
    {% endif %}

    {% if searchForm.content is defined %}
        <div class="filter">
            <h3>{{ searchForm.content.vars.label|trans({}, searchForm.content.vars.translation_domain) }}</h3>

            {{ form_widget(searchForm.content) }}

            <select multiple
                    data-parent-input="{{ searchForm.content.vars.id }}"
                    data-disable-auto-submit
                    data-ajax-autocomplete
                    data-method="post"
                    data-label-input-too-short="{{ 'form.search.autocomplete.atLeastThreeChars'|trans({}, 'forms') }}"
                    data-label-searching="{{ 'form.search.autocomplete.searching'|trans({}, 'forms') }}"
                    data-action="{{ path('event_catalog_search_keywords') }}"
                    data-placeholder="{{ 'form.search.keywords.search.placeholder'|trans({}, searchForm.vars.translation_domain) }}"
                    data-minimum-input-length="3"
                    class="form-control">
            </select>
        </div>
    {% endif %}

    {% if searchForm.objective is defined %}
        <div class="filter">
            <h3>{{ searchForm.objective.vars.label|trans({}, searchForm.objective.vars.translation_domain) }}</h3>

            {{ form_widget(searchForm.objective) }}
        </div>
    {% endif %}

    {#
    <div class="actions">
        <ul>
            <li><a href=""><i class="icon-Rechercher"></i> <span>Enregistrer la recherche</span></a></li>
            <li><a href=""><i class="icon-Retard"></i> <span>Créer une alerte</span></a></li>
            <li><a href=""><i class="icon-Inserer_2"></i> <span>Format de données .csv</span></a></li>
            <li><a href=""><i class="icon-Document_1"></i> <span>Fiches complètes .pdf</span></a></li>
        </ul>
    </div>
    #}
</div>

<div class="catalog__filters">

    <div class="select-all">
        ({{ total }})
        {#
        <label class="checkbox-inline" for="select-all-catalog">
            <input type="checkbox" id="select-all-catalog">
            Tout sélectionner (40)
        </label>
        #}
    </div>

    <div class="sort">
        {{ include('EventBundle:Catalog:Partial/order-by-form.html.twig', { form: searchForm.orderBy }, false) }}

        {#
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-default active"><i class="icon-Mosaique"></i></button>
            <button type="button" class="btn btn-default"><i class="icon-Liste"></i></button>
        </div>
        #}
    </div>
</div>

{{ form_end(searchForm) }}
