<ul>
    {% for child in form.children %}
        {% set disabled = choices[child.vars.value].count == 0 %}
        <li class="filter__item">
            <a href="#">
                {{ child.vars.label|trans({}, child.vars.translation_domain) }}
                <span class="pull-right">( {{ choices[child.vars.value].count }} )</span>
            </a>
        </li>
    {% endfor %}
</ul>
