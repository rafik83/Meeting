<ul class="catalog-mobile-type-filter-list">
    <li
        class="catalog-mobile-filter"
        data-filter-id="all"
        data-count-participant="{{ totalType }}"
        data-content="{{ 'catalog.mobile.filters.allParticipants'|trans }}"
    >
        <a href="#" class="catalog-mobile-menu-button btn btn-primary btn-block {% if numberOfDifferentType != numberOfTypeSelected %}btn-inactive{% endif %}">

            <span>{{ 'catalog.mobile.filters.allParticipants'|trans }}</span>
            <span class="button-count">({{ totalType }})</span>
        </a>
    </li>
    {% for child in form.children %}
        <li
            class="catalog-mobile-filter"
            data-filter-id="{{ choices[child.vars.value].id }}"
            data-count-participant="{{ choices[child.vars.value].count }}"
            data-content="{{ child.vars.label|trans({}, child.vars.translation_domain) }}"
        >
            <a href="#" class="catalog-mobile-menu-button btn btn-primary btn-block {% if numberOfDifferentType == numberOfTypeSelected or not child.vars.data %}btn-inactive{% endif %}">
                <span>{{ child.vars.label|trans({}, child.vars.translation_domain) }}</span>
                <span class="button-count">({{ choices[child.vars.value].count }})</span>
            </a>
        </li>
    {% endfor %}
</ul>
