{{ include('EventBundle:Catalog:Partial/search.html.twig', {
    sheet: sheet,
    searchForm: searchForm,
    typeViews: typeViews,
    categoryViews: categoryViews,
    total: paginatedResult.total,
    tipTranslationViews: tipTranslationViews
}, false) }}

<div class="catalog__list catalog__list--block">
    {{ include('EventBundle:Catalog:Partial/list.html.twig', {
        sheet: sheet,
        paginatedResult: paginatedResult,
        'viewer': sheet,
        'page': page,
        isCatalog: isCatalog,
    }, false) }}
</div>

{% if seeMoreButton %}
    <div class="col-md-12 text-center see-more-align" >
        <div class="btn btn-primary see-more" data-page="{{ paginatedResult.page }}">{{ 'catalog.seeMore'|trans }}</div>
    </div>
{% endif %}

<div class="hidden" data-catalog-mobile-menu="catalog-mobile-menu">
{% if searchForm.availableSlot is defined or searchForm.type is defined %}
    <div class="catalog-mobile-menu-summary catalog-mobile-menu-container">
        {% if searchForm.content is defined %}
            <a href="#" class="catalog-mobile-menu-button btn btn-default btn-block" data-catalog-mobile-menu-button-action="catalog-mobile-menu-button-action-content-filter">
                {% if searchForm.content.vars.data %}
                    <span>{{ searchForm.content.vars.data }}</span>
                    <span id="content-filter-remove" class="button-count">
                        <i class="glyphicon glyphicon-remove"></i>
                    </span>
                {% else %}
                    <span>{{ 'catalog.mobile.filters.content'|trans }}</span>
                    <span class="button-count">
                        <i class="glyphicon glyphicon-search"></i>
                    </span>
                {% endif %}
            </a>
        {% endif %}

        {% if searchForm.availableSlot is defined %}
            {% for availableSlotOptionChosen in searchForm.availableSlot.children %}
                {% if availableSlotOptionChosen.vars.data %}
                    <a href="#" class="catalog-mobile-menu-button btn btn-primary btn-block" data-catalog-mobile-menu-button-action="catalog-mobile-menu-button-action-available-slot-filter">
                        <span>{{ availableSlotOptionChosen.vars.label|trans({}, availableSlotOptionChosen.vars.translation_domain) }}</span>
                        <span class="button-count">
                            <i class="glyphicon glyphicon-chevron-down"></i>
                        </span>
                    </a>
                {% endif %}
            {% endfor %}
        {% endif %}
        {% if searchForm.type is defined %}
            {% set totalType = 0 %}
            {% for type in typeViews %}
                {% set totalType = totalType + type.count %}
            {% endfor %}

            {% set numberOfDifferentType = searchForm.type.children|length %}
            {% set numberOfTypeSelected = 0 %}
            {% set typeSelected = null %}

            {% for child in searchForm.type.children %}
                {% if child.vars.data %}
                    {% set typeSelected = child %}
                    {% set numberOfTypeSelected = numberOfTypeSelected + 1 %}
                {% endif %}
            {% endfor %}
            <a href="#" class="catalog-mobile-menu-button btn btn-primary btn-block" data-catalog-mobile-menu-button-action="catalog-mobile-menu-button-action-type-filter">
                {% if typeSelected != null and numberOfDifferentType != numberOfTypeSelected %}
                    <span>{{ typeSelected.vars.label|trans({}, typeSelected.vars.translation_domain) }}</span>
                    <span class="button-count">
                        ({{ typeViews[typeSelected.vars.value].count }})
                        <i class="glyphicon glyphicon-chevron-down"></i>
                    </span>
                {% else %}
                    <span>{{ 'catalog.mobile.filters.allParticipants'|trans }}</span>
                    <span class="button-count">
                        ({{ totalType }})
                        <i class="glyphicon glyphicon-chevron-down"></i>
                    </span>
                {% endif %}
            </a>
        {% endif %}
    </div>
    <div class="catalog-mobile-menu-container catalog-mobile-menu-filters">
        <div class="catalog-mobile-menu-filters-list">
            {% if searchForm.content is defined %}
                <div class="filter-element">
                    {{ include('EventBundle:Catalog:Partial/Mobile/content_filter_mobile.html.twig', {
                        form: searchForm.content,
                        sheet: sheet,
                    }, false) }}
                </div>
            {% endif %}
            {% if searchForm.availableSlot is defined %}
                <div class="filter-element">
                    {{ include('EventBundle:Catalog:Partial/Mobile/available_slot_filter_mobile.html.twig', {
                        form: searchForm.availableSlot,
                    }, false) }}
                </div>
            {% endif %}
            {% if searchForm.type is defined %}
                <div class="filter-element">
                    {{ include('EventBundle:Catalog:Partial/Mobile/type_filters_mobile.html.twig', {
                        form: searchForm.type,
                        choices: typeViews,
                        totalType: totalType,
                        numberOfDifferentType: numberOfDifferentType,
                        numberOfTypeSelected: numberOfTypeSelected,
                    }, false) }}
                </div>
            {% endif %}
        </div>

        <div class="catalog-mobile-menu-action">
            <button type="button" class="catalog-close">
                <i class="icon-Fermer_4"></i> {{ 'navigation.close'|trans }}
            </button>
            <div class="clearfix"></div>
        </div>
    </div>
{% endif %}
</div>
