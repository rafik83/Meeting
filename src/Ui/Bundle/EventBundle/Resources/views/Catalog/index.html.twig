{% set resultsCount = paginatedResult.results|length %}

{% extends 'EventBundle::base.html.twig' %}

{% block title 'navigation.category.catalog'|trans %}

{% block body_attributes 'class="grey"' %}

{% form_theme searchForm '@Ui/default.html.twig' %}

{% block content %}
    <div class="catalog catalog--advanced">
        {{ include('EventBundle:Catalog:Partial/catalog.html.twig', { searchForm: searchForm, typeViews: typeViews, paginatedResult: paginatedResult, 'sheet': sheet }, false) }}
    </div>
    <div class="modal fade clear-on-hidden-modal" id="request-modal" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>
    {{ include('EventBundle:MeetingRequest:modalMeetingRequest.html.twig') }}
{% endblock %}
