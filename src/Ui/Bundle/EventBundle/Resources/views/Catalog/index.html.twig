{% set resultsCount = paginatedResult.results|length %}

{% extends 'EventBundle::base.html.twig' %}

{% block title 'navigation.category.catalog'|trans %}

{% block body_attributes 'class="grey"' %}

{% form_theme searchForm '@Ui/default.html.twig' %}

{% block content %}
    {% set phoneValidationLink = eventUserPhoneLink is defined and eventUserPhoneLink is not null ? eventUserPhoneLink : null %}
    <div class="catalog catalog--advanced">
        {{ include('EventBundle:Tip:tip.html.twig', {tipTranslationViews: tipTranslationViews}) }}
        {{ include('EventBundle:Catalog:Partial/catalog.html.twig', {
            searchForm: searchForm,
            typeViews: typeViews,
            categoryViews: categoryViews,
            paginatedResult: paginatedResult,
            sheet: sheet,
            seeMoreButton: seeMoreButton,
            page: page,
            isCatalog: isCatalog,
            tipTranslationViews: null,
        }, false) }}
    </div>
    {{ include('EventBundle:MeetingRequest:modalMeetingRequest.html.twig') }}
{% endblock %}
