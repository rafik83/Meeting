<div class="filter">
    <h3>{{ form.vars.label|trans({}, form.vars.translation_domain) }}</h3>

    <ul>
        {% for child in form.children %}
            {% set disabled = choices[child.vars.value].count == 0 %}
            <li class="filter__item">
                <label class="checkbox-inline {{ disabled ? 'count_zero' : '' }}">
                    <span class="filter-label">{{ form_widget(child, {disabled: disabled}) }}{{ child.vars.label|trans({}, child.vars.translation_domain) }}</span>
                    <span class="details">{{ choices[child.vars.value].count }}</span>
                </label>
            </li>
        {% endfor %}
    </ul>
</div>
