<div class="catalog__research">
    {{ form_start(facetsForm) }}

    <div class="filter">
        <h3 class="collapsed" role="button" data-toggle="collapse" data-target="#collapse-1"
            aria-expanded="false" aria-controls="collapse-1">{{ facetsForm.type.vars.label|trans({}, facetsForm.type.vars.translation_domain) }}</h3>

        <div class="collapse in" id="collapse-1">
            <ul>
                {% for child in facetsForm.type.children %}
                    {% set disabled = typeViews[child.vars.value].count == 0 %}
                    <li class="filter__item">
                        <label class="checkbox-inline {{ disabled ? 'count_zero' : '' }}">
                            <span class="filter-label">{{ form_widget(child, {disabled: disabled}) }}{{ child.vars.label|trans({}, child.vars.translation_domain) }}</span>
                            <span class="details">{{ typeViews[child.vars.value].count }}</span>
                        </label>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    {{ form_end(facetsForm) }}

