<div class="col-md-4">
    <div class="catalog__item {#catalog__item--checked#}">
        <header>
        </header>
        <div class="content">
            {% for object in catalogSheetPreviewView.preview %}
                {% if object.isImage and object.content is not empty %}
                    <img src="{{ object.content|imagine_filter('event_sheet_image') }}"/>
                {% else %}
                    {% if object.isStrong %}
                        <p><strong>{{ object.content }}</strong></p>
                    {% else %}
                        <p>{{ object.content }}</p>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>
        <footer>
            <div class="actions">
                <a id="complete-sheet-link-{{ catalogSheetPreviewView.id }}" href="{{ path('event_catalog_complete_sheet', {'sheet': catalogSheetPreviewView.id }) }}" target="_blank"><i class="icon-Document_1"></i> <span>{{ 'catalog.complete_sheet'|trans }}</span></a>
                {#<a href=""><i class="icon-EtoilePleine"></i> <span>Retirer des favoris</span></a>#}
            </div>

            <p class="tags">
                <i class="icon-LienTag"></i> {{ catalogSheetPreviewView.type }}
            </p>

            {#
            <div class="button">
                <button type="button" class="btn btn-primary"><i class="icon-DemandeRDV"></i> Demander
                    un RDV
                </button>
            </div>
            #}
        </footer>
    </div>
</div>
