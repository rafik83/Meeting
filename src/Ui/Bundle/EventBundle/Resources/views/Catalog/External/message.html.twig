<div class="row">
    <div class="col-md-12 tip" role="alert">
        <a href="#" data-toggle="modal" data-target="#catalogMessage">
            <i class="icon-Alerter_1"></i> {{ message.title }}
        </a>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="catalogMessage" tabindex="-1" role="dialog" aria-labelledby="catalogMessageLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'modal.close'|trans }}">
                    <span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="catalogMessage-title">{{ message.title }}</h4>
            </div>
            <div class="modal-body">
                {{ message.content|html }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'modal.close'|trans }}</button>
            </div>
        </div>
    </div>
</div>
