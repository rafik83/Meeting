{% set resultsCount = paginatedResult.results|length %}

{% extends 'EventBundle::base.html.twig' %}

{% block title 'navigation.category.catalog'|trans %}

{% block body_attributes 'class="grey"' %}

{% block content %}
    <div class="catalog catalog--advanced">
        {{ include('EventBundle::Catalog/External/catalog.html.twig', {
            searchForm: searchForm,
            paginatedResult: paginatedResult,
            seeMoreButton: seeMoreButton,
            page: page,
            tipTranslationViews: null,
            typeViews: typeViews
        }, false) }}
    </div>

    <div class="modal fade" id="catalogRegisterModal" tabindex="-1" role="dialog" aria-labelledby="catalogRegisterModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        {{ 'catalog.external.modal.content.logged'|trans({'%catalogOnlineDate%': catalogOnlineDate}) }}
                    {% else %}
                        {{ 'catalog.external.modal.content'|trans }}
                    {% endif %}
                </div>
                <div class="modal-footer">
                    <a class="btn btn-default" href="{{ path('event_login') }}">{{ 'login.connect'|trans }}</a>
                    <a class="btn btn-primary" href="{{ path('event') }}">{{ 'register.register'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
