{% extends 'EventBundle::base.html.twig' %}

{% block content %}
    <h2>Catalogue</h2>

    <ul>
        {% for category in categories %}
            <li><a href="{{ path('event_catalog_category', { 'categoryView': category.id }) }}">{{ category.title }}</a></li>
        {% endfor %}
    </ul>
{% endblock %}
