{% extends 'EventBundle::base.html.twig' %}

{% block content %}
    {% for sheetAllowed in sheetAllowedForMeetingRequest %}
        <a href="{{ path('event_catalog_sheet_meeting_request', { 'categoryView': categoryView.id, 'to': sheet.id, 'from': sheetAllowed.id }) }}" class="btn btn-primary">
            {{ 'event.catalog.sheet.meetingRequest'|trans }}
        </a>
    {% endfor %}
    {% for id,block in sheet.data %}
        <h2>{{ sheet.template[id]['label'][app.request.locale] }}</h2>
        <table class="table">
            {% for key,value in block %}
                <tr>
                    <th>{{ sheet.template[id]['template'][key]['label'][app.request.locale] }}</th>
                    <td>{{ value|format_data(sheet.template[id]['template'][key], app.request.locale) }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endfor %}

    {% for i,participant in sheet.participants %}
        <h2>Participant {{ i+1 }}</h2>
        <table class="table">
            {% for key,value in participant.data %}
                <tr>
                    <th>{{ sheet.participantTemplate[key]['label'][app.request.locale] }}</th>
                    <td>{{ value|format_data(sheet.participantTemplate[key], app.request.locale) }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endfor %}

    <a href="{{ path('event_catalog_category', { 'categoryView': categoryView.id }) }}" class="btn btn-text">&larr; Retour au catalogue</a>
{% endblock %}
