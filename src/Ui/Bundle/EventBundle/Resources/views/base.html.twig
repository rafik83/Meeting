<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8" />
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
    {% endblock %}
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
</head>
<body>
<div class="container">
    {% if eventView is defined %}
        {{ render(controller('EventBundle:Security:impersonatingUser', {'eventView': eventView})) }}
    {% endif %}

    {% block locales %}
        {% if eventView is defined %}
            {{ include('EventBundle:Common:locales.html.twig', { 'locales': eventView.locales }) }}
        {% endif %}
    {% endblock %}

    {{ include('EventBundle:Common:user.html.twig') }}

    {% block body %}
        <h1>
            <a href="{{ path('event') }}">{{ eventView.title }}</a>
        </h1>

        {{ include('VimeetAppBundle::flashes.html.twig') }}

        {% block content %}{% endblock %}
    {% endblock %}
    {% block javascripts %}
        <script src="{{ asset('assets/js/main.js') }}"></script>
    {% endblock %}
</div>
</body>
</html>
