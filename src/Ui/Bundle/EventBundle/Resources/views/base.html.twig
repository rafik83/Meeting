<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width" />
        <title>{% block title (event is defined ? event.title : '') %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('assets/css/mainStyle.css') }}">
            {% if event is defined %}
                <link rel="stylesheet" href="{{ asset(event.assetPath) }}">
            {% endif %}
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
        <link rel="mask-icon" href="{{ asset('safari-pinned-tab.svg') }}" color="#5bbad5">
        {% block head_link %}
        {% endblock %}
        <meta name="theme-color" content="#ffffff">

        {% if event is defined %}
            {{ render(controller('Proximum\\Vimeet\\Ui\\Bundle\\EventBundle\\Controller\\Event\\ExtraHeaderAction', {'event': event})) }}
        {% endif %}
        {% if sheet is defined and sheet is not null %}
            {{ networking_template_snippet.generate(sheet, app.user) | raw }}
        {% endif %}
    </head>
    <body {% block body_attributes '' %}>
        {% block body %}

            {% block header_mobile %}{% endblock %}

            <div class="wrapper">
                {% if not (disabledNavigationMenu ?? false) %}
                {{ render(controller('Proximum\\Vimeet\\Ui\\Bundle\\EventBundle\\Controller\\Navigation\\MenuAction', { 'sheet': sheet is defined ? sheet : null })) }}
                {% endif %}
            </div>

            {% if is_granted('ROLE_PREVIOUS_USER') and event is defined and sheet is defined %}
                {{ render(controller('EventBundle:Security:impersonatingSheetGroupManagerToSheetUser', { 'event': event, 'sheet': sheet })) }}
            {% endif %}

            {% if is_granted('ROLE_PREVIOUS_ADMIN') and event is defined %}
                {{ render(controller('EventBundle:Security:impersonatingUser', { 'event': event, 'sheet': sheet is defined ? sheet : null })) }}
            {% endif %}

            <div class="main-content container-fluid {% block container_classes '' %}">
                {{ include('EventBundle::flashes.html.twig') }}

                {% block content %}{% endblock %}
            </div>
        {% endblock body %}

        {% if event is defined %}
            {{ render_esi(controller('Proximum\\Vimeet\\Ui\\Bundle\\EventBundle\\Controller\\Crisp\\ChatAction')) }}
        {% endif %}

        {% if sheet is defined and sheet is not null %}
            {# notification toast #}
            <div class="notification-toast-template notification-toast hide"
                 data-notification-toast
                 data-private-chat-url="{{ path('event_networking_chat', {sheet: sheet.id}) }}"
            >
                <button class="close">&times;</button>
                <p><em class="message-author"></em></p>
                <p class="message-content"></p>
                <p>
                    <button class="message-link btn btn-sm btn-primary">{{ 'networking.chat.notification.open'|trans }}</button>
                </p>
            </div>

            <div class="notification-toast-container hide"
                 data-notification-toast-container
            >
            </div>

            <div class="modal fade notificationCallVisio hide" id="notificationCallVisio" data-notification-call-visio tabindex="-1" role="dialog" data-private-chat-url="{{ path('event_networking_index', {sheet: sheet.id}) }}">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-body">
                            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'modal.close'|trans }}">
                                <span aria-hidden="true">&times;</span></button>
                            <h2>{{ 'networking.chat.visio.request.message.author'|trans }}</h2>
                            <div class="author"></div>
                            <div class="chat-message-call-visio">
                                {% include '@Event/Networking/Partials/notificationCallVisio.html.twig' %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade dialog" id="privateChat-modalTemplate" tabindex="-1" role="dialog"  data-chat-enable="1">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'modal.close'|trans }}">
                                <span aria-hidden="true">&times;</span></button>
                        </div>
                        <div class="modal-body">
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default"
                                    data-dismiss="modal">{{ 'modal.close'|trans }}</button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="modal-container"></div>

        {% endif %}

        {% block javascripts %}
            <script src="{{ asset('assets/js/main.js') }}"></script>
        {% endblock %}
    </body>
</html>
