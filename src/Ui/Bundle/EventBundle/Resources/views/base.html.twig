<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width" />
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
            {% if event is defined %}
                <link rel="stylesheet" href="{{ asset(event.assetPath) }}">
            {% endif %}
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>
    <body {% block body_attributes '' %}>
        {% block body %}

            <div class="header-mobile col-xs-12">
                <div class="catalog-mobile-filters visible-xs">
                    <div class="header-mobile-item open" data-anchor="filter-type">
                        <div class="menu-mobile-button btn btn-primary btn-block">
                            Tous les participants
                            <span>(200)</span>
                            <i class="glyphicon glyphicon-chevron-down pull-right"></i>
                        </div>
                        <div id="filter-type" class="header-mobile-menu">
                            <h3 class="menu-mobile-title">Type de participants</h3>
                            {{ include('EventBundle:Catalog:Partial/filters_mobile.html.twig', { form: searchForm.type, choices: typeViews }, false) }}
                        </div>
                    </div>
                </div>
                <div class="header-mobile-close">
                    <button type="button" class="header-close pull-right">
                        {{ 'navigation.close'|trans }}
                        <i class="icon-Fermer_4"></i>
                    </button>
                </div>
            </div>

            <div class="wrapper">
                {{ render(controller('EventBundle:Navigation:menu', { 'sheet': sheet is defined ? sheet : null })) }}
            </div>

            {% if is_granted('ROLE_PREVIOUS_USER') and event is defined and sheet is defined %}
                {{ render(controller('EventBundle:Security:impersonatingSheetGroupManagerToSheetUser', { 'event': event, 'sheet': sheet })) }}
            {% endif %}

            {% if is_granted('ROLE_PREVIOUS_ADMIN') and event is defined %}
                {{ render(controller('EventBundle:Security:impersonatingUser', { 'event': event, 'sheet': sheet is defined ? sheet : null })) }}
            {% endif %}

            <div class="main-content container-fluid {% block full_mobile_container '' %}">
                {{ include('EventBundle::flashes.html.twig') }}

                {% block content %}{% endblock %}
            </div>
        {% endblock body %}

        {% block javascripts %}
            <script src="{{ asset('assets/js/main.js') }}"></script>
        {% endblock %}
    </body>
</html>
