<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width" />
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
            {% if event is defined %}
                <link rel="stylesheet" href="{{ asset(event.assetPath) }}">
            {% endif %}
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>
    <body>
        {% block body %}
            <div class="wrapper">
                {{ include('EventBundle:Common:header.html.twig') }}

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    {% set funnel = view is defined and view.funnel is defined %}
                    <div class="sub-header">
                        {{ render(controller('EventBundle:Navigation:menu')) }}
                        <ul>
                            <li>
                                <a href="{{ path('event_sheet') }}" class="btn btn-primary btn-lg {{ funnel ? 'btn-inactive' : '' }}">
                                    <i class="icon-Document_1"></i>
                                    <span class="name">{{ 'sheet.title'|trans }}</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('event_package') }}" class="btn btn-primary btn-lg {{ funnel ? '' : 'btn-inactive' }}">
                                    <i class="icon-Panier_2"></i>
                                    <span class="name">{{ 'package.title'|trans }}</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>

            {% if is_granted('ROLE_PREVIOUS_ADMIN') and event is defined %}
                {{ render(controller('EventBundle:Security:impersonatingUser', { 'event': event })) }}
            {% endif %}

            <div class="container-fluid">
                {{ include('EventBundle::flashes.html.twig') }}

                {% block content %}{% endblock %}
            </div>
        {% endblock body %}

        {% block javascripts %}
            <script src="{{ asset('assets/js/main.js') }}"></script>
        {% endblock %}
    </body>
</html>
