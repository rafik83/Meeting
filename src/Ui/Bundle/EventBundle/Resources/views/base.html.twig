<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width" />
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
            {% if event is defined %}
                <link rel="stylesheet" href="{{ asset(event.assetPath) }}">
            {% endif %}
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>
    <body>
        {% block body %}
            <div class="wrapper">
                <div class="header">
                    {% if event is defined %}
                        {% if event.logo != null %}
                        <a href="{{ path('event') }}">
                            <img src="{{ event.logo|imagine_filter('event_header_logo') }}" class="logo">
                        </a>
                        {% endif %}
                        <div class="header__info">
                            <p>{{ event.title }}</p>
                            <p>{{ event.description(app.request.locale) }}</p>
                        </div>
                    {% endif %}

                    <ul class="header__navigation">
                        {% if event is defined %}
                            {% for locale in event.locales if locale != app.request.locale %}
                                <li><a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({ '_locale' : locale })) }}">{{ locale }}</a><li>
                            {% endfor %}
                        {% endif %}

                        {% if is_granted('ROLE_USER') %}
                            <li class="notifs">
                                <a href="">
                                    <i class="icon-Retard"></i>
                                    <span class="name">Notifications</span> <span class="notif">1</span>
                                </a>
                            </li>
                            <li>
                                <a href="">
                                    <i class="icon-Preferences_1"></i>
                                </a>
                            </li>
                        {% endif %}

                        {% if is_granted('ROLE_USER') %}
                            <li>
                                <a href="{{ path('event_logout_confirmation') }}" title="{{ 'logout.link'|trans }}">
                                    <i class="icon-Disconnect"></i>
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('event_login') }}" title="{{ 'login.link'|trans }}">
                                    <i class="icon-Disconnect"></i>
                                </a>
                            </li>
                        {% endif %}

                        <li>
                            <a href="">
                                <i class="icon-Appeler"></i>
                            </a>
                        </li>
                    </ul>
                </div>

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    {% set funnel = view is defined and view.funnel is defined %}
                    <div class="sub-header">
                        <div class="navigation dropdown">
                            <button id="navigation" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="icon-Menu_12"></i> Menu
                            </button>
                            <div class="navigation__content dropdown-menu row" aria-labelledby="navigation">
                                <button type="button" class="navigation__close"><i class="icon-Fermer_3"></i> Fermer</button>
                                <div class="column col-md-3">
                                    <div class="navigation__item">
                                        <h3><i class="icon-Clef"></i> Espace membre</h3>
                                        <ul>
                                            <li><a href="">Profil</a></li>
                                            <li><a href="">Photo</a></li>
                                            <li><a href="">Société / Organisme</a></li>
                                        </ul>
                                    </div>
                                    <div class="navigation__item">
                                        <h3><i class="icon-Note_1"></i> Facturation</h3>
                                        <ul>
                                            <li><a href="">Informations de facturation</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="column col-md-3">
                                    <div class="navigation__item">
                                        <h3><i class="icon-Document_1"></i> Fiche de présentation</h3>
                                        <ul>
                                            <li><a href="">Version "FR"</a></li>
                                            <li><a href="">Version "EN"</a></li>
                                        </ul>
                                    </div>
                                    <div class="navigation__item">
                                        <h3><i class="icon-Panier_2"></i> Forfait de participation</h3>
                                        <ul>
                                            <li><a href="">Formule</a></li>
                                            <li><a href="">Participants & Plannings</a></li>
                                            <li><a href="">Options</a></li>
                                            <li><a href="">Récapitulatif</a></li>
                                            <li><a href="">Paiement</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="column col-md-3">
                                    <div class="navigation__item">
                                        <h3><i class="icon-Contact_1"></i> Catalogues des participants</h3>
                                        <ul>
                                            <li><a href="">Disponible le</a><span class="state">20 avril 2016</span></li>
                                        </ul>
                                    </div>
                                    <div class="navigation__item">
                                        <h3><i class="icon-RDV"></i> Gestion de RDV</h3>
                                        <ul>
                                            <li><a href="">Propositions</a><span class="state">0</span></li>
                                            <li><a href="">Demandes en attente</a><span class="state">0</span></li>
                                            <li><a href="">Acceptés</a><span class="state">0</span></li>
                                            <li><a href="">Refusés</a><span class="state">0</span></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="column col-md-3">
                                    <div class="navigation__item">
                                        <h3><i class="icon-Calendrier"></i> Agenda provisoire</h3>
                                        <ul>
                                            <li><a href="">Ajouter une disponibilité</a></li>
                                            <li><a href="">Disponible le</a><span class="state">20 avril 2016</span></li>
                                            <li><span class="inactive">Congérences</span></li>
                                            <li><span class="inactive">Présentations flash</span></li>
                                            <li><a href="">Disponible le</a><span class="state">20 avril 2016</span></li>
                                            <li><span class="inactive">Aganda définitif</span></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <ul>
                            <li>
                                <a href="{{ path('event_sheet') }}" class="btn btn-primary btn-lg {{ funnel ? 'btn-inactive' : '' }}">
                                    <i class="icon-Document_1"></i>
                                    <span class="name">{{ 'sheet.title'|trans }}</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('event_package') }}" class="btn btn-primary btn-lg {{ funnel ? '' : 'btn-inactive' }}">
                                    <i class="icon-Panier_2"></i>
                                    <span class="name">{{ 'package.title'|trans }}</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>

            {% if is_granted('ROLE_PREVIOUS_ADMIN') and event is defined %}
                {{ render(controller('EventBundle:Security:impersonatingUser', { 'event': event })) }}
            {% endif %}

            {{ include('EventBundle::flashes.html.twig') }}

            <div class="container-fluid">
                {% block content %}{% endblock %}
            </div>
        {% endblock body %}

        {% block javascripts %}
            <script src="{{ asset('assets/js/main.js') }}"></script>
        {% endblock %}
    </body>
</html>
