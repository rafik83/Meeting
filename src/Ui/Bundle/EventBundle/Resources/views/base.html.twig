<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width" />
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
            {% if event is defined %}
                <link rel="stylesheet" href="{{ asset(event.assetPath) }}">
            {% endif %}
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>
    <body {% block body_attributes '' %}>
        {% block body %}
            <div class="wrapper">
                {{ render(controller('EventBundle:Navigation:menu', { 'sheet': sheet is defined ? sheet : null })) }}
            </div>

            {% if is_granted('ROLE_PREVIOUS_USER') and event is defined and sheet is defined %}
                {{ render(controller('EventBundle:Security:impersonatingSheetGroupManagerToSheetUser', { 'event': event, 'sheet': sheet })) }}
            {% endif %}

            {% if is_granted('ROLE_PREVIOUS_ADMIN') and event is defined %}
                {{ render(controller('EventBundle:Security:impersonatingUser', { 'event': event, 'sheet': sheet is defined ? sheet : null })) }}
            {% endif %}

            <div class="container-fluid {% block full_mobile_container '' %}">
                {{ include('EventBundle::flashes.html.twig') }}

                {% block content %}{% endblock %}
            </div>
        {% endblock body %}

        {% block javascripts %}
            <script src="{{ asset('assets/js/main.js') }}"></script>
        {% endblock %}
    </body>
</html>
