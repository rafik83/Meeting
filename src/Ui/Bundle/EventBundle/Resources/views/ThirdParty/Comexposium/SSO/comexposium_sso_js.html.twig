<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js" charset="utf-8"></script>
<script src="{{ ssoComexposiumView.comexposiumSSOLoaderLibEndpoint }}"></script>

<script type="text/javascript">
    function vimeet_cmxp_login() {
        if (-1 === location.hash.indexOf('#reset-password')) {
            comexposiumCap.openCap('login', 'login');
        }
    }

    $(document).ready(function () {
        $(document).on('comexposiumConnectLoaded', function () {
            vimeet_cmxp_login();

            window.cxpm.jQuery(document).on('comexposiumConnectLogged', function (event, email, token, isExhibitor) {
                sendDataToSSOChecker(email, token, isExhibitor);
                $('#login-form').html('<div class="text-center"><span class="glyphicon glyphicon-refresh spin"></span></div>');
            });
        });
    });

    function sendDataToSSOChecker(email, token, isExhibitor) {
        window.location = '{{ url('event_login_check') }}'
          + '?comexposium_sso=true'
          + '&email=' + encodeURIComponent(email)
          + '&token=' + encodeURIComponent(token)
          + '&isExhibitor=' + (isExhibitor ? 1 : 0);
    }
</script>
