{#                        <li>{{ paymentInfoView.organiserName }}</li>#}
{#                        <li>{{ paymentInfoView.billingAddress|nl2br }}</li>#}
{#                        <li>{{ paymentInfoView.organiserEmail }}</li>#}
{#                    </ul>#}
{#                    <div class="form-info">#}
{#                        <div>{{ 'package.payment.bankInfo'|trans }}:</div>#}
{#                        <div>{{ paymentInfoView.bankInfo|nl2br }}</div>#}
{#                    </div>#}
{#                    <div>#}
{#                        {{ paymentInfoView.paymentCondition|nl2br }}#}
{#                    </div>#}
{#                </div>#}
{#            {% endif %}#}

        </div>
    </section>
{% endblock %}
