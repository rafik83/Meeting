{% form_theme form '@Ui/default.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        <i class="icon-{{ picto }}"></i>
        {{ title }}
    </h4>
</div>

{{ form_start(form) }}

<div class="modal-body">
    {{ form_errors(form) }}

    {% if form.question is defined %}
        {{ form_row(form.question) }}
    {% endif %}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ 'modal.back'|trans }}
    </button>
    <button type="submit" class="btn btn-primary pull-right">
        <i class="icon-Valider_3"></i> {{ 'form.participate.children.submit.label'|trans({}, 'forms') }}
    </button>
</div>
{{ form_end(form) }}
