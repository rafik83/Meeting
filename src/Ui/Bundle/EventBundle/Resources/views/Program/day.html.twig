{% extends 'EventBundle::base.html.twig' %}

{% block title 'program.title'|trans %}

{% block content %}
    <div class="agenda-container">
        <header class="agenda-head">
            <p>
                <i class="icon icon-Conference"></i>
                <strong>{{ 'program.title'|trans }}</strong>
                <span>- {{ happeningList.day|localizeddate('full', 'none')|capitalize }}</span>
            </p>
        </header>
        <div class="row">
            <div class="col-md-12 agenda" data-beginHour="{{ happeningList.startTime|date('H:i', event.timeZone) }}" data-endHour="{{ happeningList.endTime|date('H:i', event.timeZone) }}" data-slotDuration="{{ happeningList.scale }}">
                <div class="meets">
                    {% for happening in happeningList.happenings %}
                        {{ include('EventBundle:Program:happening.html.twig', {'happening': happening}) }}
                    {% endfor %}
                </div>
                <div class="layout"></div>
                {#
                <footer class="agenda-foot">
                    <p>
                        <i class="icon icon-Deverouiller_1"></i>
                        <strong>Disponibilité restantes</strong>
                        <span>- 17 plages horaires</span>
                    </p>
                </footer>
                #}
            </div>
            {#
            <div class="col-md-6 agenda">
                <div class="meets">
                </div>
                <div class="layout"></div>
                <footer class="agenda-foot">
                    <p>
                        A voir également
                        <a href="#conferences" class="btn btn-gray">
                            <i class="icon icon-Conference"></i> Conférences
                        </a>
                    </p>
                </footer>
            </div>
            #}
        </div>
    </div>
{% endblock %}
