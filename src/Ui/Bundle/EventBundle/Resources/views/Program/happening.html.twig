<div class="program-happening happening has-details meet" data-beginHour="{{ happening.begin|date('H:i', timeZone) }}" data-duration="{{ happening.duration.format('%H:%I') }}">

    {{ include('EventBundle:Happening:header.html.twig', {
        'leftColor': happening.category.leftColor,
        'rightColor': happening.category.rightColor,
        'picto': happening.category.picto,
        'doesCurrentUserParticipate': happening.doesCurrentUserParticipate,
        'isUserAloneParticipant': isUserAloneParticipant,
        'withHourPrefix': true,
        'isActionButtonsOnDetails': false,
        'timezone': timeZone,
    }) }}

    <div class="details">
        {{ include('EventBundle:Happening:speakers.html.twig') }}

        <p>{{ happening.description|nl2br }}</p>

        {{ include('EventBundle:Happening:footer.html.twig', {
            'happening': happening,
            'beginHour': happening.begin,
            'endHour': happening.end,
            'isUserAloneParticipant': isUserAloneParticipant,
            'isActionButtonsOnDetails': false,
            'timezone': timeZone,
        }) }}
    </div>
</div>
