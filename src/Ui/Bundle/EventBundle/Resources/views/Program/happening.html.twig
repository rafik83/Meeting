<div class="happening has-details meet {{ happening.category.title|lower }}" data-beginHour="{{ happening.beginHour|date('H:i', happening.timeZone) }}" data-duration="{{ happening.duration.format('%H:%I') }}">

    {{ include('EventBundle:Happening:header.html.twig', {leftColor: happening.category.leftColor, rightColor: happening.category.rightColor, picto: happening.category.picto, doesCurrentUserParticipate: happening.doesCurrentUserParticipate}) }}

    <div class="details">
        {{ include('EventBundle:Happening:speakers.html.twig') }}

        <p>{{ happening.description|nl2br }}</p>

        {{ include('EventBundle:Happening:footer.html.twig', { 'happening': happening, 'beginHour': happening.beginHour, 'endHour': happening.endHour, 'isUserAloneParticipant': isUserAloneParticipant}) }}
    </div>
</div>
