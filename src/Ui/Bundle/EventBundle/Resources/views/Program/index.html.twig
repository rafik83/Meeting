{% extends 'EventBundle::base.html.twig' %}

{% block title 'program.title'|trans %}

{% block container_classes 'full-mobile-container' %}

{% block content %}
    {% if tipTranslationViews is defined %}
        {{ include('EventBundle:Tip:tip.html.twig', {tipTranslationViews: tipTranslationViews}) }}
    {% endif %}

    {% if program.showTimeZone %}
        <div class="row">
            <div class="col-md-12">
                <div class="pull-right mg-tp" style="margin-right: 5px;">
                    <a href="{{ path('event_participant_timezone', { 'sheet': sheet.id, 'participant': participant.id, 'fromProgram': '' }) }}" class="btn btn-primary">
                        <i class="icon-Horaire"></i>
                        {{ program.translatedTimeZone }}
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="program-container">
        {% for day in program.days %}
            <div class="row">
                <div class="col-md-12 program">
                    <header class="program-head text-center">
                        <p>
                            <strong>{{ day.day|localizeddate('full', 'none', app.request.locale, program.timeZone)|capitalize }}</strong>
                            <span>-
                                {% if not program.hasCategory %}
                                    <i class="icon icon-Conference"></i>
                                    {{ 'program.title'|trans }}
                                {% else %}
                                    <i class="icon icon-{{ program.categoryPicto }}"></i>
                                    {{ program.categoryTitle }}
                                {% endif %}
                            </span>
                        </p>
                    </header>
                    <div class="meets">
                        {% for programElementView in day.programElementViews %}
                            {% if programElementView.isHappeningView %}
                                {{ include('EventBundle:Program:happening.html.twig', { 'sheet': sheet, 'happening': programElementView, 'isUserAloneParticipant': isUserAloneParticipant }) }}
                            {% elseif programElementView.isMassUnavailabilityView %}
                                {{ include('EventBundle:Program:mass.html.twig', { 'mass': programElementView, 'withHourPrefix': true }) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {{ include('EventBundle:Program/Partials:modal.html.twig', {}, false) }}
{% endblock %}
