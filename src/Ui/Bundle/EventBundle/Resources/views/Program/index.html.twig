{% extends 'EventBundle::base.html.twig' %}

{% block title 'program.title'|trans %}

{% block content %}
    <div class="agenda-container">
        <div class="row">
            {% for day in program.days %}
            <div class="col-md-{{ program.colSize }} agenda" data-beginHour="{{ day.startTime|date('H:i', event.timeZone) }}" data-endHour="{{ day.endTime|date('H:i', event.timeZone) }}" data-slotDuration="{{ day.scale }}">
                <header class="agenda-head">
                    <p>
                        {% if not program.hasCategory %}
                            <i class="icon icon-Conference"></i>
                            <strong>
                                {{ 'program.title'|trans }}
                            </strong>
                        {% else %}
                            <i class="icon icon-{{ program.categoryPicto }}"></i>
                            <strong>
                                {{ program.categoryTitle }}
                            </strong>
                        {% endif %}
                        <span>- {{ day.day|localizeddate('full', 'none')|capitalize }}</span>
                    </p>
                </header>
                <div class="meets">
                    {% for happening in day.happenings %}
                        {{ include('EventBundle:Program:happening.html.twig', { 'sheet': sheet, 'happening': happening, 'isUserAloneParticipant': isUserAloneParticipant }) }}
                    {% endfor %}
                    {% for mass in day.masses %}
                        {{ include('EventBundle:Program:mass.html.twig', { 'mass': mass }) }}
                    {% endfor %}
                </div>
                <div class="layout"></div>
            </div>
            {% endfor %}
        </div>
    </div>

    {{ include('EventBundle:Program/Partials:modal.html.twig', {}, false) }}
{% endblock %}
