{% form_theme form with ['@Ui/default.html.twig'] only %}

<div class="modal-header">
    <h4 class="modal-title">
        <i class="icon-Transferer"></i>
        {{ 'agenda.meeting.move.button'|trans }}
    </h4>
</div>

{{ form_start(form) }}
<div class="modal-body">
    <div class="row">
        <div class="col-md-4">{{ form_label(form.participants) }}</div>
        <div class="col-md-8">
            {{ form_widget(form.participants) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">{{ form_label(form.meetingSlot) }}</div>
        <div class="col-md-8">
            {{ form_widget(form.meetingSlot) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">{{ form_label(form.content) }}</div>
        <div class="col-md-8">
            {{ form_widget(form.content) }}
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ 'agenda.meeting.move.back'|trans }}
        <button type="submit" class="btn btn-primary pull-right">
            <i class="icon-Transferer"></i> {{ 'common.validate'|trans }}
        </button>
    </button>
</div>
{{ form_end(form) }}
