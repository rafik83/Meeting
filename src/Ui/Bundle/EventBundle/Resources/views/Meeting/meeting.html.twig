<div class="has-details meet"
     data-meeting-id="{{ meeting.id }}"
     data-beginHour="{{ meeting.begin|date('H:i', timezone) }}"
     data-duration="{{ meeting.duration.format('%H:%I') }}"
>
    <header style="background: linear-gradient(to right, {{ meeting.leftColor }} 0%, {{ meeting.rightColor }} 100%) !important;">
        <a class="content col-xs-12" href="#">
            <span class="prefix"><i class="icon icon-RDV"></i></span>
            <p class="title">
                <b>{{ meeting.spotRef }}</b>
                {% if meeting.isUserParticipantMultipleSheets %}
                    &nbsp;-&nbsp;
                    <b>{{ meeting.userSheetTitle }}</b>
                {% endif %}
                {% for sheetMetView in meeting.sheetMetTitle %}
                    &nbsp;-&nbsp;
                            {% if sheetMetView.isHighlighted %}
                                <b>{{ sheetMetView.title }}</b>
                            {% else %}
                                {{ sheetMetView.title }}
                            {% endif %}
                {% endfor %}
            </p>
        </a>
    </header>
    <div class="details">
        <div class="row">
            <div class="col-md-12">
                {% if meeting.visio %}
                    <div class="video-container" id="video-{{ meeting.id }}">
                        <div class="subscriber hide" id="subscriber-{{ meeting.id }}"></div>
                        <div class="publisher hide" id="publisher-{{ meeting.id }}"></div>
                        <div class="video-helper hide">
                            <span>
                                <i class="icon-Alerter_1"></i> {{ 'meeting.video.waitingForParticipant'|trans }}</span>
                        </div>
                    </div>
                {% endif %}

                <div class="list list--users">
                    {% for participantView in meeting.participants %}
                        {{ include('EventBundle:Participant:preview.html.twig', {'participant': participantView.card}) }}
                    {% endfor %}
                </div>

                {% if (meeting.hasMeetingOwnSheetParticipantNames) %}
                <p>{{ 'agenda.meeting.ownSheetParticipants'|trans }} {{ meeting.meetingOwnSheetParticipantNames }}</p>
                {% endif %}
            </div>
        </div>
        <footer>
            <p class="hours">
                <i class="icon icon-Horaire"></i>
                <span>{{ meeting.begin|date('H:i', timezone) }} - {{ meeting.end|date('H:i', timezone) }}</span>
            </p>

            <a href="{{ path('event_catalog_complete_sheet', { sheet: sheetId, sheetToDisplay: meeting.sheetMetId }) }}" target="_blank">
                <i class="icon icon-Document_1"></i>
                <span class="meeting-icon-label">{{ 'agenda.meeting.details'|trans }}</span>
            </a>

            {% if canMoveMeeting %}
                <a class="moveMeetingAction" href="{{ path('event_agenda_move_meeting_slot', {'sheet': sheetId, 'meeting': meeting.id, 'participant': participantId}) }}">
                    <i class="icon icon-Transferer"></i> <span class="meeting-icon-label">{{ 'agenda.meeting.move.button'|trans }}</span>
                </a>
            {% endif %}

            {% if canRemoveMeeting %}
                <a class="removeMeetingAction" href="{{ path('event_agenda_remove_meeting', {'sheet': sheetId, 'meeting': meeting.id, 'participant': participantId}) }}" data-confirm-remove-meeting-message="{{ 'agenda.meeting.remove.confirm'|trans }}">
                    <i class="icon icon-Fermer_1"></i> <span class="meeting-icon-label">{{ 'agenda.meeting.remove.button'|trans }}</span>
                </a>
            {% endif %}

            <div class="actions">
                {% if meeting.isVisioAndAvailable %}
                    <a class="btn btn-primary start-visio"
                       href="{{ path('event_video_video_meeting', { meeting: meeting.id, sheet: sheetId, participant: participantId }) }}"
                       target="_blank"
                    >
                        <i class="icon-Appeler"></i> {{ 'meeting.video.start'|trans }}
                    </a>
                {% endif %}
            </div>
        </footer>
    </div>
</div>
