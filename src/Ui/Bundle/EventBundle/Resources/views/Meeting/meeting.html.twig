<div class="has-details meet"
     data-beginHour="{{ meeting.begin|date('H:i', meeting.timeZone) }}"
     data-duration="{{ meeting.duration.format('%H:%I') }}"
        {% if meeting.visio %}
            data-isVisio="{{ meeting.visio }}"
            data-apiKey="{{ meeting.videoConference.apiKey }}"
            data-sessionId="{{ meeting.videoConference.sessionId }}"
            data-token="{{ meeting.videoConference.token }}"
        {% endif %}
>
    <header style="background: linear-gradient(to right, {{ meeting.leftColor }} 0%, {{ meeting.rightColor }} 100%) !important;">
        <a class="content" href="#">
            <span class="prefix"><i class="icon icon-RDV"></i></span>
            <p class="title">
                <b>{{ meeting.spotRef }}</b> -
                {% if meeting.isUserParticipantMultipleSheets %}
                    <b>{{ meeting.userSheetTitle }}</b> -
                {% endif %}
                {{ meeting.sheetMetTitle }}
            </p>
        </a>
    </header>
    <div class="details">
        <div class="row">
            <div class="col-md-12">
                {% if meeting.visio %}
                    <div class="videos">
                        <div class="subscriber"></div>
                        <div class="publisher"></div>
                    </div>
                {% endif %}
                <div class="list list--users">
                    {% for participantView in meeting.participants %}
                        {{ include('EventBundle:Participant:preview.html.twig', {'participant': participantView.card}) }}
                    {% endfor %}
                </div>
            </div>
        </div>
        <footer>
            <p class="hours">
                <i class="icon icon-Horaire"></i>
                <span>{{ meeting.begin|date('H:i', meeting.timeZone) }}
                    - {{ meeting.end|date('H:i', meeting.timeZone) }}</span>
            </p>
            {% if meeting.isSheetDetailsSeeAble %}
                <a href="{{ path('event_catalog_complete_sheet', { sheet: sheetId, sheetToDisplay: meeting.sheetMetId }) }}" target="_blank">
                    <i class="icon icon-Document_1"></i>
                    {{ 'agenda.meeting.details'|trans }}
                </a>
            {% endif %}
            <div class="actions">
                {% if meeting.visio %}
                    <button class="button start-visio">Démarrer le RDV</button>
                    <button class="button end-visio hide">Déconnexion</button>
                {% endif %}
                <i class="icon icon-Localiser"></i> {{ meeting.spotRef }}
            </div>
        </footer>
    </div>
</div>
