{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <p>Confirmer l'annulation de ce rendez-vous ?</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.message) }}
        <div>
            <a href="{{ path('event_sheet_schedule_meeting', {  'sheet': sheet.id, 'meeting': meeting.id }) }}" class="btn btn-text">Retour</a>
            {{ form_widget(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}
