{% set uploadObject = child.vars.value %}
{% if uploadObject.formats is defined and uploadObject.formats is not empty %}
    <div>
        {{ 'common.required_formats'|transchoice(uploadObject.formats|length, {'%format%': uploadObject.formats|join(', ')}) }}
    </div>
{% endif %}
{% if uploadObject.data.path is defined and uploadObject.data.path is not empty and uploadObject.file is defined %}
    {% if uploadObject.data.extension in constant('Proximum\\Vimeet\\Domain\\MimeType\\MimeType::IMAGE_EXTENSIONS') %}
        <img src="{{ asset(uploadObject.data.path)|imagine_filter('user_avatar') }}"/>
    {% else %}
        <a href="{{ asset(uploadObject.data.path) }}" download>
            <i class="glyphicon glyphicon-download"></i>
            {{ 'common.download'|trans }}
        </a>
    {% endif %}
{% endif %}
