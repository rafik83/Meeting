{% form_theme form '@Ui/default.html.twig' %}

{% extends 'EventBundle:Register:base.html.twig' %}

{% block title event.title %}

{% block content %}
    <div class="profile__content">
        <section class="main">
            <header>
                <h1>
                    <i class="icon-Clef"></i>{{ 'register.register'|trans }} <span>"{{ typeView.title }}"</span>
                </h1>
            </header>

            <div class="main__content">
                {{ form_start(form, {attr: {class: 'styled-form'}}) }}

                {% if not typeView.hidden %}<a href="{{ path('event_register', {'typeView': typeView.id}) }}" class="back"><i class="icon-Retour"></i></a>{% endif %}

                <div class="inputs">
                    <div class="identity">
                        <div class="avatar">
                            <img src="{{ asset('assets/images/dummy/default-user.svg')}}">
                        </div>
                        <p>{{ email }}</p>
                    </div>
                    {{ form_row(form.password) }}

                    <p class="alert alert-warning">{{ 'form.password.rules'|trans({}, 'forms') }}</p>

                    <div class="validation">
                        <button type="submit" class="btn btn-primary"><i class="icon-Suivant_3"></i> {{ 'common.next'|trans }}</button>
                    </div>
                </div>
            {{ form_end(form) }}
            </div>
        </section>
        {% if form_errors(form.password.first) %}
            <section class="important fail">
                <p>{{ form_errors(form.password.first) }}</p>
            </section>
            <br/>
        {% endif %}
        {% if typeDescription is not empty %}
            <section id="type-description" class="type-description important">
                {{ typeDescription|html }}
            </section>
        {% endif %}
    </div>
{% endblock %}
