{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form 'EventBundle:Common:form_theme.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <div class="profile__content">
        <section class="main">
            <header>
                <h1>
                    {{ stepTitle }}
                    {% if stepsCount > 1 %}
                        <span class="steps">- Etape 1/{{ stepsCount }}</span>
                    {% endif %}
                </h1>
            </header>

            <div class="main__content">
                {{ form_start(form, {attr: {class: 'styled-form'}}) }}

                <ul class="inputs">
                    {% for field in form %}
                        <li>
                            {{ form_row(field) }}
                            {{ form_errors(field) }}
                        </li>
                    {% endfor %}

                    <li class="validation">
                        <button type="submit" class="btn"><i class="icon-Suivant_3"></i> {{ 'common.next'|trans }}</button>
                    </li>
                </ul>

                {{ form_end(form) }}
            </div>
        </section>
    </div>
{% endblock %}
