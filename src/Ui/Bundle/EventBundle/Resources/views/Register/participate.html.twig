{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form 'EventBundle:Common:form_theme.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <div class="profile__content">
        <section class="main">
            <header>
                <h1>
                    {{ stepTitle }}
                    {% if stepsCount > 1 %}
                        <span class="steps">- {{ 'register.step'|trans }} 1/{{ stepsCount }}</span>
                    {% endif %}
                </h1>
            </header>

            <div class="main__content">
                {{ form_start(form, {attr: {class: 'styled-form'}}) }}

                    {{ form_errors(form) }}

                    <div class="inputs">
                        {% for field in form %}
                            {{ form_row(field) }}
                        {% endfor %}

                        <div class="validation">
                            <button type="submit" class="btn">
                                {% if stepsCount > 1 %}
                                    <i class="icon-Suivant_3"></i> {{ 'common.next'|trans }}
                                {% else %}
                                    <i class="icon-Valider_3"></i> {{ 'register.finalize'|trans }}
                                {% endif %}
                            </button>
                        </div>
                    </div>

                {{ form_end(form) }}

                <p class="info">{{ 'register.privacy_policies'|trans }}</p>
            </div>
        </section>
    </div>
{% endblock %}
