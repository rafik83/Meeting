{% extends 'EventBundle::base.html.twig' %}

{% block body %}
    {% if is_granted('ROLE_PREVIOUS_ADMIN') and event is defined %}
        {{ render(controller('EventBundle:Security:impersonatingUser', { 'event': event })) }}
    {% endif %}

    <div class="wrapper profile">
        {{ render(controller('EventBundle:Navigation:menuHeader', {'registration': true})) }}

        <div class="profile__content">
            {% block content %}{% endblock %}
            {{ include('EventBundle::flashes.html.twig') }}
        </div>
    </div>
{% endblock body %}
