{% extends 'EventBundle::base.html.twig' %}

{% block body %}
    {% if is_granted('ROLE_PREVIOUS_ADMIN') and eventView is defined %}
        {{ render(controller('EventBundle:Security:impersonatingUser', {'eventView': eventView})) }}
    {% endif %}

    <div class="wrapper profile">
        <div class="header">
            {% if eventView is defined %}
                {% if eventView.logo != null %}
                <a href="{{ path('event') }}">
                    <img src="{{ eventView.logo|imagine_filter('event_header_logo') }}" class="logo">
                </a>
                {% endif %}
                <div class="header__info">
                    <p>{{ eventView.title }}</p>
                    <p>{{ eventView.description }}</p>
                </div>
            {% endif %}
            <ul class="header__navigation">
                <li>
                    {% if eventView is defined %}
                        {% for locale in eventView.locales if locale != app.request.locale %}
                            <li><a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({ '_locale' : locale })) }}">{{ locale }}</a><li>
                        {% endfor %}
                    {% endif %}
                </li>

                {% if is_granted('ROLE_USER') %}
                    <li>
                        <a href="{{ path('event_logout_confirmation') }}" title="{{ 'logout.link'|trans }}">
                            <img src="{{ asset('assets/images/icons/icon-login.png') }}">
                        </a>
                    </li>
                {% else %}
                    <li>
                        <a href="{{ path('event_login') }}" title="{{ 'login.link'|trans }}">
                            <img src="{{ asset('assets/images/icons/icon-login.png') }}">
                        </a>
                    </li>
                {% endif %}

                <li>
                    <a href="">
                        <i class="icon-Appeler"></i>
                    </a>
                </li>
            </ul>
        </div>

        <div class="profile__content">
            {% block content %}{% endblock %}
            {{ include('EventBundle::flashes.html.twig') }}
        </div>
    </div>
{% endblock body %}
