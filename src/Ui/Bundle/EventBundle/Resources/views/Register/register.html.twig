{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form 'EventBundle:Common:form_theme.html.twig' %}

{% block title eventView.title %}

{% block content %}
<div class="profile__content">
    <section class="main">
        <header>
            <h1><img src="{{ asset('assets/images/icons/icon-key.svg') }}">{{ 'register.register'|trans }} <span>"{{ typeView.title }}"</span></h1>
        </header>

        <div class="main__content">
            {{ form_start(form, {attr: {class: 'styled-form'}}) }}
            <a href="{{ path('event') }}" class="back"><i class="icon-Retour"></i></a>
            <div class="inputs">
                <div>
                    <div class="avatar">
                        <img src="{{ asset('assets/images/dummy/default-user.svg')}}">
                    </div>
                </div>
                <div class="form-row">
                    {{ form_row(form.email) }}
                </div>
                <div class="validation">
                    <button type="submit" class="btn"><i class="icon-Suivant_3"></i> {{ 'common.next'|trans }}</button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </section>
    {% if form_errors(form.email) %}
        <section class="important fail">
            <p>{{ form_errors(form.email) }}</p>
        </section>
    {% endif %}

</div>
{% endblock %}
