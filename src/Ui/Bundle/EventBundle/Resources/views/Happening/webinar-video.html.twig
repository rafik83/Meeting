{% extends 'EventBundle::base.html.twig' %}

{% block body_attributes 'class="background-black"' %}

{% block body %}
    <div class="webinar-video">
        {% if webinarView.headerImage %}
            <div class="webinar-header"><img src="{{ webinarView.headerImage }}" class="img-responsive"></div>
        {% endif %}
        <div class="layout-container" {% if webinarView.headerImage %}style="top:125px"{% endif %}>
            {% if (
                    webinarView.liveUrl|slice(0, 31) == 'https://video-cdn.vimeet.events'
                    or webinarView.liveUrl|slice(0, 28) == 'https://upload.vimeet.events'
                )
                and webinarView.liveUrl|slice(-4) == '.mp4' %}
                <video id="webinar-video-video" width="100%" height="100%" controls autoplay controlsList="nodownload">
                    <source src="{{ webinarView.liveUrl }}" type="video/mp4"/>
                </video>
            {% else %}
                <iframe id="webinar-video-frame" src="{{ webinarView.liveUrl }}" frameborder="0" width="100%" height="100%"
                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            {% endif %}
        </div>

        <div class="buttons-container">
            <a class="btn btn-primary end-webinar" href="{{ path('event_agenda_program_redirect', {sheet: sheet.id}) }}">
                <i class="icon-Disconnect"></i> {{ 'happening.webinar.end'|trans }}
            </a>
        </div>
    </div>
    <script>
        const video = document.getElementById("webinar-video-video");
        if (video) {
            video.addEventListener('contextmenu', function(e) {
                if (e.target.nodeName === "VIDEO") {
                    e.preventDefault();
                }
            }, false);
        }
    </script>
{% endblock body %}
