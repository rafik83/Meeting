<div class="row visible-xs">
    <div class="col-md-12">
        <p>
            {% if suffixTitleWithTick is defined and suffixTitleWithTick == true %}
                <i class="pull-right icon icon-Valider_3 happeningParticipateIcon {{ doesCurrentUserParticipate ? '' : 'hide' }}"></i>
            {% endif %}
        </p>
    </div>
</div>
<div class="row">
    {% for speaker in happening.speakers %}
        {% if speaker.hasCompanyPicture %}
            <div class="col-md-4 text-center">
                <img src="{{ speaker.companyPicture|imagine_filter('program_company_logo') }}"/>
            </div>
        {% endif %}
        <div class="col-md-8">
            <div class="list list--users">
                <div class="user clearfix">
                    {% if speaker.hasPicture %}
                        <div class="user__avatar">
                            <span class="bullet"></span>
                            <div class="avatar">
                                <img src="{{ speaker.picture|imagine_filter('user_avatar') }}" alt="{{ speaker.firstname|first }}." title="{{ speaker.lastname }}">
                            </div>
                        </div>
                    {% else %}
                        <div class="user__avatar">
                            <span class="bullet"></span>
                            <div class="avatar">
                                <p>{{ speaker.initials }}</p>
                            </div>
                        </div>
                    {% endif %}
                    <div class="user__infos">
                        <p class="name">{{ speaker.firstname|capitalize }} {{ speaker.lastname|upper }}</p>
                        <p class="job">{{ speaker.position }}</p>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
