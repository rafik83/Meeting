<div class="side-container hide">
    {% if webinarView.sidebarAllowed %}
        <button class="btn btn-gray pull-right hide-on-desktop" data-mobile-toggle-sidebar><i class="icon-Suivant_3"></i></button>
        <div class="btn-group" role="group">
            <a class="btn btn-primary" href="#" data-chat-button>{{ 'happening.webinar.chat.tab'|trans }}</a>
            <a class="btn btn-gray" href="#" data-questions-button>{{ 'happening.webinar.questions.tab'|trans }}</a>
        </div>
        <div data-chat-container
             data-href="{{ path('event_chat_messages_list', {sheet: sheet.id, objectType: 'happening', objectId: webinarView.happeningId }) }}"
        >
            <div class="chat-list">
                {# content filled with javascript #}
            </div>
            <form
                    action="{{ path('event_chat_messages_add', {sheet: sheet.id, objectType: 'happening', objectId: webinarView.happeningId }) }}"
                    class="chat-form"
                    data-chat-form
            >
                <input type="text" name="content" placeholder="{{ 'happening.webinar.chat.add'|trans }}" maxlength="250" autocomplete="off">
                <button type="submit"></button>
            </form>
        </div>
        <div class="hide"
            data-questions-container
            data-href="{{ path('event_sheet_happening_webinar_questions', {sheet: sheet.id, happening: webinarView.happeningId }) }}"
        >
            <div class="questions-list">
                {# content filled with javascript #}
            </div>
            <form
                action="{{ path('event_sheet_happening_webinar_question_add', {sheet: sheet.id, happening: webinarView.happeningId }) }}"
                class="questions-form"
                data-questions-form
            >
                <input type="text" name="content" placeholder="{{ 'happening.webinar.questions.add'|trans }}" maxlength="250" autocomplete="off">
                <button type="submit"></button>
            </form>
        </div>
    {% endif %}
</div>
