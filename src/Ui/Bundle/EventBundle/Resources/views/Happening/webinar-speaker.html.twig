{% extends 'EventBundle::base.html.twig' %}

{% block head_link %}
    <link rel="chrome-webstore-item" href="{{ visio_screen_sharing_chrome_extension }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/visio.js') }}"></script>
{% endblock %}

{% block body_attributes 'class="background-black"' %}

{% block body %}
    <div class="webinar webinar-speaker"
         data-api-key="{{ webinarView.apiKey }}"
         data-token="{{ webinarView.token }}"
         data-session-id="{{ webinarView.sessionId }}"
         data-not-compatible-browser-message="{{ 'meeting.video.notCompatibleBrowserMessage'|trans }}"
         data-chat-waiting-message="{{ 'meeting.video.chat.waitingMessage'|trans }}"
         data-screen-share-already-in-progress-message="{{ 'happening.webinar.screenshare.thereIsAlreadyAScreenShareInProgress'|trans }}"
         data-media-share-url-video-message="{{ 'meeting.video.media.share.urlVideo'|trans }}"
         data-media-share-url-video-security-error-message="{{ 'meeting.video.media.share.urlVideo.securityError'|trans }}"
         data-media-share-url-video-loading-error-message="{{ 'meeting.video.media.share.urlVideo.loadingError'|trans }}"
         data-media-share-button-screenshare-message="{{ 'meeting.video.media.share.button.screenShare'|trans }}"
         data-media-share-button-videoshare-message="{{ 'meeting.video.media.share.button.videoShare'|trans }}"
         data-install-screensharing-extension-message="{{ 'meeting.video.installScreenSharingExtensionMessage'|trans }}"
         data-user-denied-media-access="{{ 'meeting.video.error.userDeniedAccess'|trans }}"
         data-user-complete-name="{{ userCompleteName }}"
         data-time-remaining="{{ webinarView.timeRemainingInSeconds }}"
         data-warning-time-remaining="{{ webinarView.warningTimeRemainingInSeconds }}"
         data-current-user-id="{{ webinarView.currentUserId }}"
         data-subscriber-mapping="{{ webinarView.speakerInfosByUserId }}"
    >
        {% if webinarView.headerImage %}
            <div class="webinar-header"><img src="{{ webinarView.headerImage }}" class="img-responsive"></div>
        {% endif %}

        <div class="layout-container" {% if webinarView.headerImage %}style="top:125px"{% endif %}></div>

        <div class="side-container hide">
            <div class="btn-group" role="group">
                <a class="btn btn-primary" href="#" data-chat-button>Chat</a>
                <a class="btn btn-gray" href="#" data-questions-button>Questions</a>
            </div>
            <div class="chat-container" data-chat-container></div>
            <div class="hide"
                data-questions-container
                data-href="{{ path('event_sheet_happening_webinar_questions', {sheet: sheet.id, happening: webinarView.happeningId }) }}"
            >
                <div class="questions-list">
                    {# content filled with javascript #}
                </div>
                <form
                    action="{{ path('event_sheet_happening_webinar_question_add', {sheet: sheet.id, happening: webinarView.happeningId }) }}"
                    class="questions-form"
                    data-questions-form
                >
                    <input type="text" name="content" placeholder="Ajoutez votre question">
                    <button type="submit" class="btn btn-primary">
                        <span class="icon-Ouvrir_4"></span>
                    </button>
                </form>
            </div>
        </div>

        <div class="video-helper" data-settings-container>
            <h1>{{ webinarView.happeningTitle }}</h1>
            <hr>
            {{ include('EventBundle:Visio:settings.html.twig') }}
            <div data-webinar-waiting-message class="hide"><i class="icon-Alerter_1"></i> {{ 'happening.webinar.waiting.message'|trans }}</div>
        </div>

        <div class="buttons-container">
            <div class="viewers-container hide" title="{{ 'happening.webinar.viewers'|trans }}">
                <span class="viewers">0</span>
                <i class="icon-Profil_1"></i>
            </div>

            <div class="timer-container">
                <div class="timer hide">
                    {{ 'happening.webinar.endingAt'|trans }}
                    <span class="countdown"></span>
                </div>
            </div>

            <button id="toggle-audio" class="btn hide">
                <i class="icon-Conference icon-center"></i>
            </button>
            <button id="toggle-video" class="btn hide">
                <i class="glyphicon glyphicon glyphicon-facetime-video icon-center"></i>
            </button>
            <button id="toggle-sidebar" class="btn btn-off hide hide-on-desktop">
                <i class="icon-Commentaire icon-center"></i>
            </button>

            <button id="media-start-sharing" class="btn screensharing hide">
                <i class="glyphicon glyphicon-share"></i>{{ 'happening.webinar.media.share'|trans }}
            </button>
            <button id="media-stop-sharing" class="btn screensharing hide">
                <i class="glyphicon glyphicon-share"></i>{{ 'happening.webinar.media.stopSharing'|trans }}
            </button>

            <button class="btn btn-primary end-webinar">
                <i class="icon-Disconnect"></i> {{ 'happening.webinar.end'|trans }}
            </button>
        </div>
    </div>
{% endblock body %}

