{% extends 'EventBundle::base.html.twig' %}

{% block head_link %}
    <link rel="chrome-webstore-item" href="{{ visio_screen_sharing_chrome_extension }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/visio.js') }}"></script>
{% endblock %}

{% block body_attributes 'class="background-black"' %}

{% block body %}
    <div class="webinar webinar-speaker"
         data-event-id="{{ webinarView.eventId }}"
         data-happening-id="{{ webinarView.happeningId }}"
         data-api-key="{{ webinarView.apiKey }}"
         data-token="{{ webinarView.token }}"
         data-session-id="{{ webinarView.sessionId }}"
         data-notifications-provider-url="{{ webinarView.notification.providerUrl }}"
         data-notifications-subscriber-key="{{ webinarView.notification.subscriberKey }}"
         data-not-compatible-browser-message="{{ 'meeting.video.notCompatibleBrowserMessage'|trans }}"
         data-chat-waiting-message="{{ 'meeting.video.chat.waitingMessage'|trans }}"

         data-chat-vote-like="{{ 'chat.vote.like'|trans }}"
         data-chat-vote-happy="{{ 'chat.vote.happy'|trans }}"
         data-chat-vote-heart="{{ 'chat.vote.heart'|trans }}"
         data-chat-vote-acclaim="{{ 'chat.vote.acclaim'|trans }}"
         data-chat-vote-instructive="{{ 'chat.vote.instructive'|trans }}"
         data-chat-vote-message="{{ 'chat.vote'|trans }}"
         data-chat-unvote-message="{{ 'chat.unvote'|trans }}"
         data-chat-vote-disabled-message="{{ 'chat.voteDisabled'|trans }}"

         {% if webinarView.canDeleteChatMessage %}data-chat-can-delete{% endif %}
         {% if webinarView.canModerateQuestion %}data-question-can-moderate{% endif %}
         {% if webinarView.canMuteStream %}data-chat-can-mute-stream{% endif %}

         data-mute-stream="{{ path('event_happening_webinar_mute', {
             'sheet': sheet.id,
             'happening': webinarView.happeningId
         }) }}"

         data-questions-count="{{ webinarView.questionsCount }}"

         data-screen-share-already-in-progress-message="{{ 'happening.webinar.screenshare.thereIsAlreadyAScreenShareInProgress'|trans }}"
         data-invisibleMode-quitConfirmation-message="{{ 'happening.webinar.invisibleMode.quitConfirmation'|trans }}"
         data-invisibleMode-enableConfirmation-message="{{ 'happening.webinar.invisibleMode.enableConfirmation'|trans }}"
         data-media-share-url-video-message="{{ 'meeting.video.media.share.urlVideo'|trans }}"
         data-media-share-url-video-security-error-message="{{ 'meeting.video.media.share.urlVideo.securityError'|trans }}"
         data-media-share-url-video-loading-error-message="{{ 'meeting.video.media.share.urlVideo.loadingError'|trans }}"
         data-media-share-button-screenshare-message="{{ 'meeting.video.media.share.button.screenShare'|trans }}"
         data-media-share-button-videoshare-message="{{ 'meeting.video.media.share.button.videoShare'|trans }}"
         data-media-screenShareStatus-message="{{ 'meeting.video.media.share.screenShareStatus'|trans }}"
         data-question-vote-message="{{ 'happening.webinar.questions.vote'|trans }}"
         data-question-unvote-message="{{ 'happening.webinar.questions.unvote'|trans }}"
         data-question-vote-disabled-message="{{ 'happening.webinar.questions.voteDisabled'|trans }}"
         data-install-screensharing-extension-message="{{ 'meeting.video.installScreenSharingExtensionMessage'|trans }}"
         data-user-denied-media-access="{{ 'meeting.video.error.userDeniedAccess'|trans }}"
         data-user-complete-name="{{ userCompleteName }}"
         data-time-remaining-before-start="{{ webinarView.timeRemainingBeforeStartInSeconds }}"
         data-time-remaining="{{ webinarView.timeRemainingInSeconds }}"
         data-warning-time-remaining="{{ webinarView.warningTimeRemainingInSeconds }}"
         data-current-user-id="{{ webinarView.currentUserId }}"
         data-subscriber-mapping="{{ webinarView.speakerInfosByUserId }}"
         data-sidebar-allowed="{{ webinarView.sidebarAllowed }}"
         data-webinar-hls="{{ webinarView.allowWebinarOnHLS ? 'true' : 'false' }}"
         data-webinar-initial-viewers-count="{{ webinarView.viewersCount }}"
         data-desktop-notification-title="{{ 'happening.webinar.desktopNotificationTitle'|trans }}"
         data-desktop-notification-body="{{ 'happening.webinar.desktopNotificationBody'|trans }}"
         {% if webinarView.liveUrl %}
         data-live-url="{{ webinarView.liveUrl }}"
         {% endif %}

         data-webinar-open-stream-to-public-endpoint="{{ path(
             'event_happening_webinar_open_stream_to_public',
             {
                 'happening': webinarView.happeningId
             }
         ) }}"

         data-is-stream-open-to-public="{{ webinarView.isStreamOpenToPublic ? 'true' : 'false' }}"

         {% if webinarView.allowWebinarOnHLS %}
         data-webinar-stream-endpoint="{{ path(
             'event_happening_webinar_stream_broadcast',
             {
                 'happening': webinarView.happeningId
             }
         ) }}"
         {% else %}
         data-webinar-stream-endpoint="{{ path(
             'event_happening_webinar_stream',
             {
                 'sheet': sheet.id,
                 'happening': webinarView.happeningId
             }
         ) }}"
         {% endif %}

        {% if webinarView.isWebinarRecorded %}
            data-webinar-recorded="true"
            data-webinar-can-record="true"
            data-webinar-auto-start="{{ webinarView.isWebinarRecordAutoStart }}"
            data-webinar-stop-timestamp="{{ webinarView.stopTimestamp }}"
            data-webinar-record-endpoint="{{ path(
                'event_happening_webinar_record',
                {
                    'sheet': sheet.id,
                    'happening': webinarView.happeningId
                }
            ) }}"
            data-webinar-stop-record-endpoint="{{ path(
                'event_happening_webinar_stop_record',
                {
                    'sheet': sheet.id,
                    'happening': webinarView.happeningId
                }
            ) }}"
            data-webinar-is-recording="{{ webinarView.isWebinarRecording ? 'true' : 'false' }}"
        {% endif %}

    >
        {% if webinarView.headerImage %}
            <div class="webinar-header"><img src="{{ webinarView.headerImage }}" class="img-responsive"></div>
        {% endif %}

        <div class="layout-container" {% if webinarView.headerImage %}style="top:125px"{% endif %}></div>

        {% include 'EventBundle:Happening:webinar-sidebar.html.twig' %}

        <div class="video-waiting-container">
            <div class="video-helper" data-settings-container>
                <h1>{{ webinarView.happeningTitle }}</h1>
                <hr>
                {{ include('EventBundle:Visio:settings.html.twig', {needPreparation: not webinarView.isStreamOpenToPublic}) }}
                <div data-webinar-waiting-message class="hide"><i class="icon-Alerter_1"></i> {{ 'happening.webinar.waiting.message'|trans }}</div>
                <div id="visio-prepare" class="row hide">
                    <div class="col-md-12 text-center">
                        <p>{{ 'event.visio.preparation'|trans|nl2br }}</p>
                    </div>
                    <div class="col-md-12 text-center">
                        <hr>
                        <button class="btn btn-primary" id="visio-prepare-validate">
                            {{ 'event.visio.close_warning_preparation'|trans }}
                        </button>
                    </div>
                </div>
                <div id="visio-openPublicReminder" class="row hide">
                    <div class="col-md-12 text-center">
                        <p>{{ 'happening.webinar.timeToOpen.message'|trans }}</p>
                    </div>
                    <div class="col-md-12 text-center">
                        <hr>
                        <button class="btn btn-primary" id="visio-openPublicReminder-notOpen">
                            {{ 'happening.webinar.timeToOpen.notOpen.button'|trans }}
                        </button>
                        <button class="btn btn-primary" id="visio-openPublicReminder-open">
                            {{ 'happening.webinar.timeToOpen.open.button'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="buttons-container">
            <div class="viewers-container hide" title="{{ 'happening.webinar.viewers'|trans }}">
                <span class="viewers">0</span>
                <i class="icon-Profil_1"></i>
            </div>

            <div class="timer-container hide">
                <div class="timer">
                    {{ 'happening.webinar.beginningAt'|trans }}
                    <span class="countdown"></span>
                </div>
            </div>

            <div class="current-container hide">
                <div class="timer">
                    {{ 'happening.webinar.endingAt'|trans() }}
                    <span class="countdown"></span>
                </div>
            </div>

            <div class="end-container hide">
                {{ 'happening.webinar.ended'|trans }}
            </div>

            {% if webinarView.isWebinarRecorded %}
                <button id="toggle-recording" class="btn btn-gray hide"
                    title="{% if webinarView.isWebinarRecording%}{{ 'happening.webinar.recordingButtonTitle'|trans }}{% else %}{{ 'happening.webinar.recordButtonTitle'|trans }}{% endif %}"
                    data-button-recording-title="{{ 'happening.webinar.recordingButtonTitle'|trans }}"
                    data-button-record-title="{{ 'happening.webinar.recordButtonTitle'|trans }}"
                >
                    <span class="dot {% if webinarView.isWebinarRecording%}recording{% endif %}"></span>
                </button>
            {% endif %}

            <button id="toggle-audio" class="btn hide">
                <i class="icon-Conference icon-center"></i>
            </button>
            <button id="toggle-video" class="btn hide">
                <i class="glyphicon glyphicon glyphicon-facetime-video icon-center"></i>
            </button>

            <button id="invisible-mode-button" class="btn btn-off hide" title="{{ 'happening.webinar.invisibleMode.button'|trans }}">
                <i class="glyphicon glyphicon-ban-circle icon-center"></i>
            </button>

            <button id="media-start-sharing" class="btn screensharing hide">
                <i class="glyphicon glyphicon-share"></i>{{ 'happening.webinar.media.share'|trans }}
            </button>
            <button id="media-stop-sharing" class="btn screensharing hide">
                <i class="glyphicon glyphicon-share"></i>{{ 'happening.webinar.media.stopSharing'|trans }}
            </button>

            <button class="btn btn-primary end-webinar hide">
                <i class="icon-Disconnect"></i> {{ 'happening.webinar.end'|trans }}
            </button>
            <button class="btn open-webinar hide">
                {{ 'happening.webinar.open'|trans }}
            </button>
        </div>

        <div class="hide video-modal" data-modal-warning-before-start>
            <div class="video-modal-body">
                <p class="video-modal-content">
                    {{ 'happening.webinar.messageWarningBeforeStart'|trans }}
                </p>
                <div class="video-modal-footer">
                    <button class="btn btn-primary" data-modal-close>{{ 'modal.close'|trans }}</button>
                </div>
            </div>
        </div>

        {% include 'EventBundle:Happening:webinar-speaker-modal.html.twig' with {attribute:'data-modal-delete-chat-message', content:'happening.webinar.messageChatConfirm'} %}
        {% include 'EventBundle:Happening:webinar-speaker-modal.html.twig' with {attribute:'data-modal-delete-question-message', content:'happening.webinar.messageQuestionConfirm'} %}
        {% include 'EventBundle:Happening:webinar-speaker-modal.html.twig' with {attribute:'data-modal-delete-question-reply', content:'happening.webinar.confirmDeleteReply'} %}
        {% include 'EventBundle:Happening:webinar-speaker-modal.html.twig' with {attribute:'data-modal-mute-stream', content:'happening.webinar.muteStreamConfirm'} %}
    </div>
{% endblock body %}
