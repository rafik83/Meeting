{% extends 'EventBundle::base.html.twig' %}

{% block title %}

{% endblock %}

{% block content %}
    <section class="main">

        <header>
            <h1><i class="icon-Document_1"></i> Fiche de présentation</h1>
            <ul class="tabs">
                {% for event_locale in eventView.locales %}
                    <li{% if event_locale == locale %} class="active"{% endif %}>
                        <a href="{{ path('event_sheet_integration_locale', { 'sheet': sheet.id, 'locale': event_locale }) }}">
                            <span class="name">{{ event_locale|locale }}*</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </header>

        <div class="main__container">
            {% for uid, item in template.value|default([]) %}
                {{ include('EventBundle:Sheet/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', {
                    'uid': uid,
                    'children': item.children|default([]),
                    'config': item.config|default([]),
                    'locale': locale,
                    'fallback': template.fallback,
                    'data': data,
                    'nomenclatures': nomenclatures
                }, false) }}
            {% endfor %}
        </div>

    </section>

{% endblock %}
