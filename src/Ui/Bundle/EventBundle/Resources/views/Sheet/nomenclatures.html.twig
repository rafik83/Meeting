{% extends 'EventBundle::base.html.twig' %}

{% block title %}

{% endblock %}

{% block content %}
    <section class="main">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {% for key, child in form if key != 'submit' %}
                {{ form_row(child) }}
            {% endfor %}
            {{ form_widget(form.submit) }}
        {{ form_end(form) }}
    </section>

{% endblock %}
