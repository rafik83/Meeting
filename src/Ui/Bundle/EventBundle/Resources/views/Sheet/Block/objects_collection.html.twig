{% set block = item %}
{% set label = block.label(locale, fallback) %}

<div class="row block block--12 {{ 'style--' ~ block.style }}">
    <div class="col-md-12">
        {% if label %}
            <header>
                <h2>{{ label }}</h2>
            </header>
        {% endif %}

        <table class="table table-striped">
            <thead>
                <tr>
                    {% for label in block.objectsLabel %}
                        <th class="col-md-2">{{ label }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in block.objectsCollectionContent %}
                <tr>
                    {% for column in row %}
                        <td>
                            {% if column is iterable %}
                                {% for value in column %}
                                    <span class="label label-default">{{ value }}</span>
                                {% endfor %}
                            {% else %}
                                {{ column }}
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if not isCatalog %}
            <footer>
                <a href="{{ path('event_sheet_objects_collection_update', { 'sheet': sheet.id, 'key': uid }) }}" class="edit-link">
                    <i class="icon-Note_2"></i>
                    {{ 'sheet.edit.object'|trans({ '%label%': block.label(locale, fallback) }) }}
                </a>
            </footer>
        {% endif %}
    </div>
</div>
