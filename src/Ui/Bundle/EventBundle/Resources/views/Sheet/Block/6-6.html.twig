<div class="row block block--6-6 {{ 'style--' ~ config['style'] }}">
    <div class="col-md-6">
        {% for uid, item in children[0]|default([]) %}
            {{ include('EventBundle:Sheet/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', {
                'sheet': sheet,
                'uid': uid,
                'config': item.config,
                'children': item.children|default([]),
                'locale': locale,
                'fallback': fallback|default,
                'data': data,
                'taggedData': taggedData,
                'nomenclatures': nomenclatures
            }, false) }}
        {% endfor %}
    </div>
    <div class="col-md-6">
        {% for uid, item in children[1]|default([]) %}
            {{ include('EventBundle:Sheet/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', {
                'sheet': sheet,
                'uid': uid,
                'config': item.config,
                'children': item.children|default([]),
                'locale': locale,
                'fallback': fallback|default,
                'data': data,
                'taggedData': taggedData,
                'nomenclatures': nomenclatures
            }, false) }}
        {% endfor %}
    </div>
</div>
