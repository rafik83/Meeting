<div class="row">
    <div class="col-md-4">
        {% for uid, item in children[0]|default([]) %}
            {{ include('EventBundle:Sheet/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', { 'uid': uid, 'config': item.config, 'children': item.children|default([]), 'locale': locale, 'fallback': fallback|default(false), 'data': data }, false) }}
        {% endfor %}
    </div>
    <div class="col-md-8">
        {% for uid, item in children[1]|default([]) %}
            {{ include('EventBundle:Sheet/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', { 'uid': uid, 'config': item.config, 'children': item.children|default([]), 'locale': locale, 'fallback': fallback|default(false), 'data': data }, false) }}
        {% endfor %}
    </div>
</div>