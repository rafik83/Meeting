<div class="row block block--12 {{ 'style--' ~ config['style'] }}">
    <div class="col-md-12">
        {% for uid, item in children[0]|default([]) %}
            {{ include('EventBundle:Sheet/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', {
                'sheet': sheet,
                'uid': uid,
                'config': item.config,
                'children': item.children|default([]),
                'locale': locale,
                'fallback': fallback|default,
                'data': data,
                'taggedData': taggedData,
                'nomenclatures': nomenclatures,
                'participants': participants,
            }, false) }}
        {% endfor %}
    </div>
</div>
