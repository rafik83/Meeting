<section id="object-{{ uid }}" class="object object--collection {{ 'style--' ~ item.style }} section">
    <header>
        <h2>{{ item.label(locale, fallback) }}{% if item.required|default(false) %}*{% endif %}</h2>
    </header>
    <div class="section__content" data-show-more="{{ 'sheet.object.showMore.title'|trans }}" data-show-less="{{ 'sheet.object.showLess.title'|trans }}">
        <ul>
            {% for list_item in item.data['items']|default([]) %}
                <li>{{ list_item['title']|localize(locale, fallback) }}</li>
            {% endfor %}
        </ul>
    </div>
    {% if not isCatalog %}
        <footer>
            <a href="{{ path('event_sheet_form', { 'locale': locale, 'key': uid }) }}" class="edit-link" data-toggle="modal" data-target="#edit-modal"><i class="icon-Note_2"></i> {{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
        </footer>
    {% endif %}
</section>
