
{% set nomenclature = nomenclatures[item.nomenclature]|default %}

<div class="object" id="object-{{ uid }}">

{% if nomenclature %}

    {% if nomenclature.depth == 1 %}

        <section class="object--nomenclature {{ 'style--' ~ item.style }} section">
            <header>
                <h2>{{ item.label(locale, fallback) }}</h2>
            </header>
            <div class="section__content">
                {% if item.data['items']|default([]) is empty %}
                    <p class="help">{{ item.label(locale, fallback) }}</p>
                {% else %}
                    <ul>
                        {% for key, child in nomenclature.value if key in item.data['items']|default([]) %}
                            <li>{{ child.label|localize(locale, fallback) }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
            <footer>
                <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_update', { 'locale': locale, 'key': uid }) }}">Editer "{{ item.label(locale, fallback) }}"</a>
            </footer>
        </section>

    {% elseif nomenclature.depth == 2 %}

        <section class="object--nomenclature {{ 'style--' ~ item.style }} section">
            <header>
                <h2>{{ item.label(locale, fallback) }}</h2>
            </header>
            <div class="section__content">
                <ul>
                    {% for child in nomenclature.value if child.children|keys|intersect(item.data['items']|default([]))|length > 0 %}
                        <li class="highlight">{{ grandchild.label|localize(locale, fallback) }}</li>
                        {% for key, grandchild in child.children if key in item.data['items']|default([]) %}
                            <li>{{ grandchild.label|localize(locale, fallback) }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
            <footer>
                <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_update', { 'locale': locale, 'key': uid }) }}">Editer "{{ item.label(locale, fallback) }}"</a>
            </footer>
        </section>

    {% elseif nomenclature.depth == 3 %}

        {% if item.data['items']|default([]) is empty %}
            <section class="object--nomenclature {{ 'style--' ~ item.style }} section">
                <header>
                    <h2>{{ item.label(locale, fallback) }}</h2>
                </header>
                <div class="section__content">
                    <p class="help">{{ item.help|localize(locale, fallback) }}</p>
                </div>
                <footer>
                    <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_update', { 'locale': locale, 'key': uid }) }}">Editer "{{ item.label(locale, fallback) }}"</a>
                </footer>
            </section>
        {% else %}

            {% for child in nomenclature.value %}

                <section class="object--nomenclature {{ 'style--' ~ item.style }} section">
                    <header>
                        <h2>{{ child.label|localize(locale, fallback) }}</h2>
                    </header>
                    <div class="section__content">
                        <ul>
                            {% for grandchild in child.children if grandchild.children|keys|intersect(item.data['items']|default([]))|length > 0 %}
                                <li class="highlight">{{ grandchild.label|localize(locale, fallback) }}</li>
                                {% for key, grandgrandchild in grandchild.children if key in item.data['items']|default([]) %}
                                    <li>{{ grandgrandchild.label|localize(locale, fallback) }}</li>
                                {% endfor %}
                            {% endfor %}
                        </ul>
                    </div>
                    <footer>
                        <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_update', { 'locale': locale, 'key': uid }) }}">Editer "{{ item.label(locale, fallback) }}"</a>
                    </footer>
                </section>

            {% endfor %}

        {% endif %}

    {% endif %}

{% else %}

    <section class="object--nomenclature {{ 'style--' ~ item.style }}">
        Missing nomenclature
    </section>

{% endif %}

</div>
