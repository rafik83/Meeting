
<div id="object-{{ uid }}" class="object object--tag {{ 'style--' ~ config['style'] }}">
    <header>
        <h2>{{ config['label']|localize(locale, fallback) }}</h2>
    </header>
    <div class="section__content">
        <p>{{ taggedData[config['tag']]|join(', ')|default }}</p>
    </div>
</div>
