<div id="object-{{ uid }}" class="object object--tag {{ 'style--' ~ item.style }}">
    {% set label = item.label(locale, fallback) %}
    {% if not item.hasOnlyTagUrl %}
        <header>
            <h2>{{ label }}</h2>
        </header>
    {% endif %}
    <div class="section__content">
        <ul>
            {% for tag in item.tags %}
                <li class="highlight">
                    {% if taggedData[tag.tag]|default([])|length == 1 and (taggedData[tag.tag]|default([])|first is same as(true) or taggedData[tag.tag]|default([])|first is same as(false)) %}
                        {% set value = taggedData[tag.tag]|default([])|first %}
                    {% else %}
                        {% set value = taggedData[tag.tag]|default([])|join(', ') %}
                    {% endif %}
                    {% if tag.tag in ["sheet_country", "participant_country"] %}
                        {% for taggedInfo in taggedData[tag.tag]|default([]) %}
                            {% if not isCatalog %}
                                <a href="{{ path('event_account_participant_company', {'sheet': sheet.id }) ~ '#field_' ~ tag.tag }}">
                            {% endif %}

                            {{ taggedInfo|country }} {% if loop.index < loop.length %}, {% endif %}

                            {% if not isCatalog %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        {% if value is url %}
                            <a href="{{ value }}" class="btn btn-primary" target="_blank"><i class="icon-Desktop"></i>{{ label }}</a>
                        {% else %}
                            {% if not isCatalog %}
                                <a href="{{ path('event_account_participant_company', {'sheet': sheet.id }) ~ '#field_' ~ tag.tag }}">
                            {% endif %}

                            {% if value is same as(true) %}
                                {{ 'sheet.object.boolean.true'|trans }}
                            {% elseif value is same as(false) %}
                                {{ 'sheet.object.boolean.false'|trans }}
                            {% else %}
                                {{ value }}
                            {% endif %}

                            {% if not isCatalog %}
                                </a>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
