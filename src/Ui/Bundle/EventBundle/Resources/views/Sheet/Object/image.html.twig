<div id="object-{{ uid }}" class="object object--image {{ 'style--' ~ item.style }}">
    {% if not isCatalog %}
        <a class="image-background" href="{{ path('event_sheet_form', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal" title="{{ item.placeholder(locale, fallback)|default(item.label(locale, fallback)) }}">
            <div class="placeholder">
                {% if item.data is defined and item.data['image'] is defined and null != item.data['image'] and item.canDisplayImage %}
                    <img src="{{ item.data['image']|imagine_filter('event_sheet_image') }}">
                {% else %}
                    <div class="add-photo"><i class="icon-Ouvrir_1"></i> {{ item.placeholder(locale, fallback)|default(item.label(locale, fallback)) }}</div>
                {% endif %}
            </div>
        </a>
    {% else %}
        <div class="image-background">
            <div class="placeholder">
                {% if item.data is defined and item.data['image'] is defined and null != item.data['image'] and item.canDisplayImage %}
                    <img src="{{ item.data['image']|imagine_filter('event_sheet_image') }}">
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
