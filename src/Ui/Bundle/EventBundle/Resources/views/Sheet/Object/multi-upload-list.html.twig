<ul class="list list--medias">
    {% for media in item.data|default([]) if media.path is defined and media.title is defined %}
        <li>
            <a href="{{ path('event_sheet_show_uploaded_file', { sheet: userSheet ? userSheet.id : sheet.id, sheetToDisplayId: sheet.id, objectKey: item.key, path: media['path'] }) }}" target="_blank">{{ media['title'] }}</a>
        </li>
    {% endfor %}
</ul>
