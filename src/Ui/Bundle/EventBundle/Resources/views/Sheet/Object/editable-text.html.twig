
<section id="object-{{ uid }}" class="object object--editable-text {{ 'style--' ~ item.style }}">
    {% if true != item.hideLabel|default %}
        {% if item.option('type') == 'title' %}
            <header>
                <h2>{{ item.data['text'][locale]|default(item.label(locale, fallback)) }}</h2>
            </header>
        {% elseif item.option('type') == 'text' %}
            <header>
                <h2>{{ item.label(locale, fallback) }}</h2>
            </header>
        {% endif %}
    {% endif %}
    {% if item.option('type') == 'text' %}
        <p>{{ item.data['text'][locale]|default|nl2br }}</p>
    {% endif %}

    <footer>
        <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_form', { 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal">{{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
    </footer>
</section>
