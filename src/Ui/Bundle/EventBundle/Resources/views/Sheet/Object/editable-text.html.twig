
<section class="object object--editable-text {{ 'style--' ~ config['style'] }}">
    {% if config.type == 'title' %}
        <header>
            <h2>{{ data[uid]['text'][locale] }}</h2>
        </header>
    {% elseif config.type == 'text' %}
        <header>
            <h2>{{ config['label'][locale] }}</h2>
        </header>
        <p>{{ data[uid]['text'][locale]|nl2br }}</p>
    {% endif %}

    <footer>
        <i class="icon-Note_2"></i> <a href="">Editer "{{ config['label'][locale] }}"</a>
    </footer>
</section>
