<section id="object-{{ uid }}" class="object object--editable-text {{ 'style--' ~ item.style }}">
    {% if true != item.hideLabel|default %}
        {% if item.option('type') == 'title' %}
            {% set label = item.tag ? item.content(locale)|default(taggedData[item.tag]|join(', ')) : item.content|default(item.label(locale, fallback)) %}
        {% else %}
            {% set label = item.label(locale, fallback) %}
        {% endif %}

        {% if label %}
            <header>
                <h2>{{ label }}{% if not isCatalog and item.required|default(false) %}*{% endif %}</h2>
            </header>
        {% endif %}
    {% endif %}

    {% if item.option('type') == 'text' %}
        {% if item.isTranslatable %}
            <p>{{ item.content(locale)|default|nl2br }}</p>
        {% else %}
            <p>{{ item.content|default|nl2br }}</p>
        {% endif %}
    {% endif %}

    {% if not isCatalog %}
        <footer>
            <a href="{{ path('event_sheet_form', { 'locale': locale, 'key': uid }) }}" class="edit-link" data-toggle="modal" data-target="#edit-modal"><i class="icon-Note_2"></i> {{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
        </footer>
    {% endif %}
</section>
