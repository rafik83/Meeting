<section id="object-{{ uid }}" class="object object--editable-text {{ 'style--' ~ item.style }}">

    {% if true != item.hideLabel|default %}
        {% if item.option('type') == 'title' %}
            {% if item.content(locale) is not empty %}
                {% set label = item.content(locale) %}
            {% elseif item.taggedDataViews[0] is defined %}
                {% set label = item.taggedDataViews[0].content %}
            {% else %}
                {% set label = '' %}
            {% endif %}
        {% else %}
            {% set label = item.label(locale, fallback) %}
        {% endif %}

        {% if label %}
            <header>
                <h2>{{ label }}{% if not isCatalog and item.required|default(false) %}*{% endif %}</h2>
            </header>
        {% endif %}
    {% endif %}

    {% if item.option('type') == 'text' %}
        {% if item.content(locale) is not empty %}
            <p>{{ item.content(locale)|default|nl2br }}</p>
        {% else %}
            {% for taggedDataView in item.taggedDataViews %}
                {{ include('EventBundle:Sheet/Tag:' ~ taggedDataView.type ~ '.html.twig', {
                    'sheet': sheet,
                    'taggedDataView': taggedDataView,
                    'locale': locale,
                    'label': label,
                    'isCatalog': isCatalog,
                    'loop': loop,
                    'maskLinkToEdit': true,
                }, false) }}
            {% endfor %}
        {% endif %}
    {% endif %}

    {% if not isCatalog %}
        <footer>
            <a href="{{ path('event_sheet_form', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" class="edit-link" data-toggle="modal" data-target="#edit-modal"><i class="icon-Note_2"></i> {{ 'sheet.object.action.edit'|trans }}
                "{{ item.label(locale, fallback) }}"
            </a>
        </footer>
    {% endif %}
</section>
