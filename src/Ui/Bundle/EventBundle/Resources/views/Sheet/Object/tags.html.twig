
<section id="object-{{ uid }}" class="object object--collection {{ 'style--' ~ item.style }} section">
    <header>
        <h2>{{ item.label(locale, fallback) }}{% if item.required|default(false) %}*{% endif %}</h2>
    </header>
    <div class="section__content">
        <ul>
            {% for tag in item.tags %}
                <li><a href="{{ path('event_account_participant_company', {'sheet': sheet.id}) }}" >{{ tag['label']|localize(locale, fallback) }} : {{ taggedData[tag.tag]|default([])|join(', ') }}</a></li>
            {% endfor %}
            
            {% if item.collectionEnabled %}
                {% for list_item in item.data['items']|default([]) %}
                    <li>{{ list_item['title']|localize(locale, fallback) }}</li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>
    {% if item.collectionEnabled %}
        <footer>
            <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_form', { 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal">{{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
        </footer>
    {% endif %}
</section>
