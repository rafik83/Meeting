<section id="object-{{ uid }}" class="object object--collection {{ 'style--' ~ item.style }} section">
    {% set label = item.label(locale, fallback) %}
    {% if label %}
        <header>
            <h2>{{ label }}{% if not isCatalog and item.required|default(false) %}*{% endif %}</h2>
        </header>
    {% endif %}
    <div class="section__content">
        <ul>
            {% for tag in item.tags %}
                <li>
                    {% if not isCatalog %}
                        <a href="{{ path('event_account_participant_company', {'sheet': sheet.id}) ~ '#field_' ~ tag.tag }}" >
                    {% endif %}

                    {{ tag['label']|localize(locale, fallback) }} :
                    {% if tag.tag in ["sheet_country", "participant_country"] %}
                        {% for taggedInfo in taggedData[tag.tag]|default([]) %}
                            {{ taggedInfo|country }} {% if loop.index < loop.length %}, {% endif %}
                        {% endfor %}
                    {% else %}
                        {% if taggedData[tag.tag]|default([])|length == 1 and (taggedData[tag.tag]|default([])|first is same as(true) or taggedData[tag.tag]|default([])|first is same as(false)) %}
                            {% if taggedData[tag.tag]|default([])|first %}
                                {{ 'sheet.object.boolean.true'|trans }}
                            {% else %}
                                {{ 'sheet.object.boolean.false'|trans }}
                            {% endif %}
                        {% else %}
                            {{ taggedData[tag.tag]|default([])|join(', ') }}
                        {% endif %}
                    {% endif %}

                    {% if not isCatalog %}
                        </a>
                    {% endif %}
                </li>
            {% endfor %}

            {% if item.collectionEnabled %}
                {% for list_item in item.data['items']|default([]) %}
                    <li>{{ list_item['title']|localize(locale, fallback) }}</li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>
    {% if item.collectionEnabled and not isCatalog %}
        <footer>
            <a href="{{ path('event_sheet_form', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" class="edit-link" data-toggle="modal" data-target="#edit-modal"><i class="icon-Note_2"></i> {{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
        </footer>
    {% endif %}
</section>
