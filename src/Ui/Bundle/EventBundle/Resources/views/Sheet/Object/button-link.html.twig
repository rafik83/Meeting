<div id="object-{{ uid }}" class="object object--button-link {{ 'style--' ~ item.style }}">
    <p>
        <a href="{{ item.data['url']?path('event_catalog_sheet_follow_link', {'sheet': sheet.id, 'objectId': item.uid}):'#' }}" class="btn btn-primary">
            <i class="icon-Desktop"></i> {{ item.data['label'][locale]|default(item.label(locale, fallback)) }}
        </a>
    </p>
    <footer>
        {% if not isCatalog %}
            <a href="{{ path('event_sheet_form', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" class="edit-link" data-toggle="modal" data-target="#edit-modal"><i class="icon-Note_2"></i> {{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
        {% endif %}
    </footer>
</div>
