
<div id="object-{{ uid }}" class="object object--button-link {{ 'style--' ~ item.style }}">
    <p>
        <a href="{{ item.data['url']|default('#') }}" class="btn btn-primary"><i class="icon-Desktop"></i> {{ item.data['label'][locale]|default(item.label(locale, fallback)) }}</a>
    </p>
    <footer>
        <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_form', { 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal">{{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
    </footer>
</div>
