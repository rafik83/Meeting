<section id="object-{{ uid }}" class="object object--participant {{ 'style--' ~ item.style }} section section--list">
    {% set label = item.label(locale, fallback) %}
    {% if label %}
        <header>
            <h2>{{ label }}</h2>
        </header>
    {% endif %}

    <div class="section__content">
        <div class="list list--users sheet-participants-list-users">
            {% for participant in participants.cardViews %}
                {{ include('EventBundle:Participant:preview.html.twig', { 'participant': participant, 'isCatalog': isCatalog }) }}

                {% if not loop.last and loop.index == item.numberOfParticipantShown %}
                    <div class="show-more-zone" style="display: none;">
                {% endif %}
                {% if loop.last and loop.index > item.numberOfParticipantShown %}
                    </div>
                    <div class="pull-right btn btn-link show-more-button"
                         data-show-more-translation="{{ 'sheet.participant.seeMore.title'|trans }}"
                         data-show-less-translation="{{ 'sheet.participant.seeLess.title'|trans }}"
                        >
                        <i class="icon-Voir_1"></i> {{ 'sheet.participant.seeMore.title'|trans }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>

    {% if not isCatalog and canAddParticipant|default(false) %}
        <a href="{{ path('event_sheet_add_participant', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" class="btn btn-primary" data-toggle="modal" data-target="#edit-modal">
            <i class="icon-Profil_1"></i>{{ 'sheet.object.action.add'|trans }} {{ item.label(locale, fallback) }}
        </a>
    {% endif %}

    {% if not isCatalog and participants.cardViews|length > 1 %}
        <footer>
            <a href="{{ path('event_sheet_change_order_participant', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" class="btn btn-gray">
                <i class="icon-Preferences_1"></i> {{ 'sheet.object.action.changeOrder'|trans }}
            </a>
            <br>
            <a href="{{ path('event_sheet_remove_participant', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal" class="btn btn-gray">
                <i class="icon-Effacer"></i> {{ 'sheet.object.action.remove'|trans }} {{ item.label(locale, fallback) }}
            </a>
        </footer>
    {% endif %}

    {% if isCatalog and userSheet != sheet %}
        <div class="buttons-zone button clearboth">
            {{ include('EventBundle:Sheet/Partial:meetingRequestButtons.html.twig', {
                'sheet': sheet,
                'userSheet': userSheet,
                'meetingRequest': meetingRequest,
                'isMeetingPublished': isMeetingPublished|default(false),
                'isMeetingRequestUpdateLocked': isMeetingRequestUpdateLocked|default(false),
                'isMeetingRequestClosed': isMeetingRequestClosed|default(false),
                'isAnsweringMeetingRequestClosed': isAnsweringMeetingRequestClosed|default(false),
                'isPhoneValidationRequired': isPhoneValidationRequired,
                'phoneValidationLink': phoneValidationLink,
                'hideMeetingRequest': hideMeetingRequest|default(false),
            }) }}
        </div>
    {% endif %}
</section>
