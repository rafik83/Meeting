<section id="object-{{ uid }}" class="object object--participant {{ 'style--' ~ item.style }} section section--list">
    {% set label = item.label(locale, fallback) %}
    {% if label %}
        <header>
            <h2>{{ label }}</h2>
        </header>
    {% endif %}

    <div class="section__content">
        <div class="list list--users">
            {% if not isCatalog %}
                {% for participant in participants.cardViews %}
                    {{ include('EventBundle:Participant:preview.html.twig', { 'participant': participant, 'isCatalog': isCatalog }) }}
                {% endfor %}
            {% else %}
                {% for participant in participants.cardViews %}
                    {% if loop.index0 < item.numberOfParticipantShown %}
                        {{ include('EventBundle:Participant:preview.html.twig', { 'participant': participant, 'isCatalog': isCatalog}) }}
                    {% endif %}
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {% if not isCatalog and sheet.canBuyParticipant %}
        <a href="{{ path('event_sheet_add_participant', { 'locale': locale, 'key': uid }) }}" class="btn btn-primary" data-toggle="modal" data-target="#edit-modal">
            <i class="icon-Profil_1"></i>{{ 'sheet.object.action.add'|trans }} {{ item.label(locale, fallback) }}
        </a>
    {% endif %}

    {% if not isCatalog and participants.cardViews|length > 1 %}
        <footer>
            <a href="{{ path('event_sheet_remove_participant', { 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal">
                <i class="icon-Effacer"></i> {{ 'sheet.object.action.remove'|trans }} {{ item.label(locale, fallback) }}
            </a>
        </footer>
    {% endif %}

    {% if isCatalog and userSheet != sheet %}
        <div class="buttons-zone button">
            {{ include('EventBundle:Sheet/Partial:meetingRequestButtons.html.twig', {'sheet': sheet, 'userSheet': userSheet, 'meetingRequest': meetingRequest, 'isMeetingPublished': isMeetingPublished|default(false)}) }}
        </div>
    {% endif %}
</section>
