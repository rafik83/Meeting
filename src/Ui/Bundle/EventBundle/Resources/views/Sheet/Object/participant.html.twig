
<section id="object-{{ uid }}" class="object object--participant {{ 'style--' ~ config['style'] }} section section--list">
    <header>
        <h2>{{ config['label']|localize(locale, fallback) }}</h2>
    </header>
    <div class="section__content">
        <ul class="list list--users">
            {% for participant in participants.cardViews %}
            <li class="user clearfix">
                <div class="user__avatar">
                    <span class="bullet"></span>
                    {% if participant.editable %}
                        <a href="{{ path('event_account_participant_profile', {sheet: participant.sheetId, participant: participant.id}) }}">
                            <div class="avatar">
                                {% if participant.avatar != null %}
                                    <img  src="{{ asset(participant.avatar) }}">
                                {% else %}
                                    <p>{{ participant.firstname|first|upper }}{{ participant.lastname|first|upper }}</p>
                                {% endif %}
                            </div>
                        </a>
                    {% else %}
                        <div class="avatar">
                            {% if participant.avatar != null %}
                                <img  src="{{ asset(participant.avatar) }}">
                            {% else %}
                                <p>{{ participant.firstname|first }}{{ participant.lastname|first }}</p>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
                <div class="user__infos">
                    <p class="name">{{ participant.firstname|capitalize }} {{ participant.lastname|upper }}</p>
                    <p class="job">{{ participant.position }}</p>
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
    <footer>
        <button class="btn"><img src="{{ asset('assets/images/icons/icon-user.png') }}">{{ 'sheet.object.action.add'|trans }} {{ config['label']|localize(locale, fallback) }}</button>
    </footer>
</section>
