
<section id="object-{{ uid }}" class="object object--participant {{ 'style--' ~ item.style }} section section--list">
    <header>
        <h2>{{ item.label(locale, fallback) }}</h2>
    </header>
    <div class="section__content">
        <div class="list list--users">
            {% for participant in participants.cardViews %}
                {{ include('EventBundle:Participant:preview.html.twig', { 'participant': participant}) }}
            {% endfor %}
        </div>
    </div>
    <footer>
        <a href="{{ path('event_sheet_add_participant', { 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal">
            <button class="btn btn-primary"><img src="{{ asset('assets/images/icons/icon-user.png') }}">{{ 'sheet.object.action.add'|trans }} {{ item.label(locale, fallback) }}</button>
        </a>
    </footer>
</section>
