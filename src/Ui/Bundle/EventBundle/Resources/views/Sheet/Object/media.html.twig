
<section id="object-{{ uid }}" class="object object--media section">
    <header>
        <h2>{{ item.label(locale, fallback) }}</h2>
    </header>
    <div class="section__content">
        <ul class="list list--medias">
            {% for media in item.data['medias']|default([]) %}
                <li>
                    <i class="icon-Document_1"></i>
                    <a href="{{ media['url'] }}">{{ media['title']|localize(locale, fallback) }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
    <footer>
        <i class="icon-Note_2"></i> <a href="{{ path('event_sheet_form', { 'locale': locale, 'key': uid }) }}" data-toggle="modal" data-target="#edit-modal">{{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
    </footer>
</section>
