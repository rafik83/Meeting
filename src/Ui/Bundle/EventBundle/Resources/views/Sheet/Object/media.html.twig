{% import '@Event/Sheet/macro.html.twig' as macros %}
<section id="object-{{ uid }}" class="object object--media section">
    {% set label = item.label(locale, fallback) %}
    {% if label %}
        <header>
            <h2>{{ label }}{% if not isCatalog and item.required|default(false) %}*{% endif %}</h2>
        </header>
    {% endif %}
    <div class="section__content">
        <ul class="list list--medias">
            {% for index, media in item.data['medias']|default([]) %}
                <li>
                    {% if media['type'] is defined and media['type'] == 'video' %}
                        <i class="icon-Video_1"></i>
                    {% else %}
                        <i class="icon-Document_1"></i>
                    {% endif %}
                    <a href="{{ eventUrl(
                        sheet.event,
                        'event_catalog_sheet_follow_link',
                        {
                            'sheet': sheet.id,
                            'objectId': item.uid,
                            'index': index,
                            '_locale': locale
                        }) }}" target="_blank">
                        {{ media['title']|localize(locale, fallback) }}
                    </a>

                    {{ displayAnalyticsStat ? macros.badge_click_analytics(sheet, uid, index) }}
                </li>
            {% endfor %}
        </ul>
    </div>
    {% if not isCatalog %}
        <footer>
            <a href="{{ path('event_sheet_form', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}" class="edit-link" data-toggle="modal" data-target="#edit-modal"><i class="icon-Note_2"></i> {{ 'sheet.object.action.edit'|trans }} "{{ item.label(locale, fallback) }}"</a>
         </footer>
    {% endif %}
</section>
