
<section id="object-{{ uid }}" class="object object--media {{ 'style--' ~ config['style'] }} section" data-refresh="{{ path('event_sheet_object', { 'sheet': sheet.id, 'locale': locale, 'key': uid }) }}">
    <header>
        <h2>{{ config['label']|localize(locale, fallback) }}</h2>
    </header>
    <div class="section__content">
        <ul class="list list--medias">
            {% for media in data[uid]|default([]) %}
                <li><i class="icon-Document_1"></i> <a href="">{{ media }}</a></li>
            {% endfor %}
        </ul>
    </div>
    <footer>
        <i class="icon-Note_2"></i> <a href="#">Editer "{{ config['label']|localize(locale, fallback) }}"</a>
    </footer>
</section>

<div class="modal fade clear-on-hidden-modal" id="edit-modal-{{ uid }}" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>
