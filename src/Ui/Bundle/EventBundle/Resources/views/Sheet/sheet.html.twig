{% extends 'EventBundle::base.html.twig' %}

{% block title %}
    {{ event.title }}: {{ 'sheet.title'|trans }}
{% endblock %}

{% block content %}
    {% if sheetToDisplay is defined %}
        {% set userSheet = sheet %}
        {% set sheet = sheetToDisplay %}
    {% endif %}

    {% set isRequestMeetingEnabled = isCatalog is defined and isCatalog == true and userSheet != sheet %}

    {{ include('EventBundle:Sheet/Partial:sheet-content.html.twig') }}
{% endblock %}
