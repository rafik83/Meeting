{% extends 'EventBundle::base.html.twig' %}

{% block title %}
    {{ eventView.title }}: {{ 'sheet.title'|trans }}
{% endblock %}

{% block content %}
    <section class="main">

        <header>
            <h1><i class="icon-Document_1"></i> {{ 'sheet.title'|trans }}</h1>
            <ul class="tabs">
                {% for event_locale in eventView.locales %}
                    <li{% if event_locale == locale %} class="active"{% endif %}>
                        <a href="{{ path('event_sheet_locale', { 'locale': event_locale }) }}">
                            <span class="name">{{ event_locale|locale }}*</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </header>

        <div class="main__container">
            {% for uid, child in templateData.column(0) %}
                {{ include('EventBundle:Sheet/' ~ child.component|capitalize ~ ':' ~ child.type ~ '.html.twig', {
                    'sheet': sheet,
                    'uid': uid,
                    'item': child,
                    'locale': templateData.locale,
                    'fallback': templateData.fallback,
                    'taggedData': taggedData,
                    'nomenclatures': nomenclatures,
                    'participants': participants,
                }, false) }}
            {% endfor %}
        </div>

    </section>

    <div class="modal fade clear-on-hidden-modal{% if form is defined or form_participant is defined %} show-modal{% endif %}" id="edit-modal" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                {% if form is defined %}
                    {{ include('EventBundle:Sheet:form.html.twig', { 'form': form, 'label': label, 'uid': uid, 'type': form.vars.data.type }) }}
                {% elseif form_participant is defined %}
                    {{ include('EventBundle:Participant:add.html.twig', { 'form': form_participant, 'label': label }) }}
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}
