{% set hideLinkToEdit = not (maskLinkToEdit is defined and maskLinkToEdit == true) %}
{% if not isCatalog and not taggedDataView.isTextarea and hideLinkToEdit %}
    <a href="{{ path('event_account_participant_company', {'sheet': sheet.id }) ~ '#field_' ~ taggedDataView.tag }}">
{% endif %}
    {{ taggedDataView.content }}
{% if not isCatalog and not taggedDataView.isTextarea %}
    </a>
{% endif %}


{% if taggedDataView.isTextarea and not isCatalog %}
    {% if hideLinkToEdit %}
        <div>
            <a href="{{ path('event_account_participant_company', {'sheet': sheet.id }) ~ '#field_' ~ taggedDataView.tag }}" class="edit-link">
                <i class="icon-Note_2"></i> {{ 'sheet.object.action.edit'|trans }}
                "{{ label }}"
            </a>
        </div>
    {% endif %}
{% endif %}
