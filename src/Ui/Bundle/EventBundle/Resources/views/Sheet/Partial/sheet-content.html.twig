{% set isRequestMeetingEnabled = isCatalog is defined and isCatalog == true and userSheet != sheet %}
<section class="main {% if isRequestMeetingEnabled %}catalog__sheet{% endif %}">
    <header class="sheet-header">

        <h1>
            <i class="icon-Document_1"></i> {{ 'sheet.title'|trans }}
        </h1>

        <div class="buttons-zone button request-meeting-sheet">
            {% if isRequestMeetingEnabled %}
                {{ include('EventBundle:Sheet:meetingRequestButtons.html.twig', {'sheet': sheet, 'meetingRequest': meetingRequest}) }}
            {% else %}
                {% if sheet.isValidationDraft %}
                    <button class="btn btn-primary" data-toggle="modal" data-target="#sheetSubmitModal">{{ 'sheet.submit.validation'|trans }}</button>
                {% elseif sheet.isValidationPending %}
                    <a class="btn btn-black" data-toggle="tooltip" title="{{ 'sheet.submit.validation.moreInfoOnPending'|trans }}">
                        <span><i class="icon-Retard"></i> {{ 'sheet.submit.validation.pending'|trans }}</span>
                    </a>
                {% endif %}
            {% endif %}
            <a href="{{ path('event_sheet_generate_pdf', { sheet: sheet.id, locale: locale }) }}" class="btn btn-gray"><span class="glyphicon glyphicon-print"></span>Pdf</a>
        </div>

        {% if isCatalog is not defined or isCatalog == false %}
            <ul class="tabs">
                <li{% if locale == event.fallback %} class="active"{% endif %}>
                    <a href="{{ path('event_sheet_locale', { 'locale': event.fallback }) }}">
                        <span class="name">{{ event.fallback|locale }}*</span>
                    </a>
                </li>
                {% for event_locale in event.locales if event_locale != event.fallback %}
                    <li{% if event_locale == locale %} class="active"{% endif %}>
                        <a href="{{ path('event_sheet_locale', { 'locale': event_locale }) }}">
                            <span class="name">{{ event_locale|locale }}*</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </header>

    <div class="main__container">
        {% for uid, child in templateData.column(0) %}
            {{ include('EventBundle:Sheet/' ~ child.component|capitalize ~ ':' ~ child.type ~ '.html.twig', {
                'sheet': sheet,
                'uid': uid,
                'item': child,
                'locale': templateData.locale,
                'fallback': templateData.fallback,
                'taggedData': taggedData,
                'nomenclatures': nomenclatures,
                'participants': participants,
                'isCatalog': isCatalog|default(false),
                'userSheet': userSheet|default(false),
                'meetingRequest' : meetingRequest|default(false),
            }, false) }}
        {% endfor %}
    </div>
</section>

<div class="modal fade clear-on-hidden-modal{% if form is defined or form_participant is defined or form_remove is defined %} show-modal{% endif %}" id="edit-modal" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            {% if form is defined %}
                {{ include('EventBundle:Sheet:form.html.twig', { 'form': form, 'label': label, 'uid': uid, 'type': form.vars.data.type }) }}
            {% elseif form_participant is defined %}
                {{ include('EventBundle:Participant:add.html.twig', { 'form': form_participant, 'label': label, 'sheet': sheet, 'backRoute': 'backToSheet', 'participantProduct': participantProduct }) }}
            {% elseif form_remove is defined %}
                {{ include('EventBundle:Participant:remove.html.twig', { 'form': form_remove, 'participants': participants, 'label': label }) }}
            {% endif %}
        </div>
    </div>
</div>

{% if isRequestMeetingEnabled %}
    {{ include('EventBundle:MeetingRequest:modalMeetingRequest.html.twig') }}
{% endif %}

{% if sheetValidationView is not empty %}
    {{ include('EventBundle:Sheet:modalSheetValidation.html.twig', {'view': sheetValidationView }) }}
{% endif %}
