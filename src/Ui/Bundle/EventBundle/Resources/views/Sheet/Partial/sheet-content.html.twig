{% set link = phoneValidationLink is defined and phoneValidationLink is not null ? phoneValidationLink : null %}

<section class="main {% if isRequestMeetingEnabled %}catalog__sheet{% endif %}">

{% if displayAnalyticsStat|default(false) %}
    <div class="row">
        <div class="col-md-12 tip tip--stats" role="contentinfo">
            <i class="glyphicon glyphicon-stats"></i>
            {{ 'analytics.view_counter'|transchoice(sheet.analytics.views, {'%views%': sheet.analytics.views, '%uniqueViews%': sheet.analytics.uniqueViews}) }}
        </div>
    </div>
{% endif %}

    <header class="sheet-header">
        <h1>
            <i class="icon-Document_1"></i> {{ 'sheet.title'|trans }}
        </h1>

        {% if isRequestMeetingEnabled %}
            {% if meetingRequest is defined and meetingRequest is null and isMeetingRequestClosed is defined and isMeetingRequestClosed == true %}
                {# Hide buttons if the meetingRequests are closed #}
            {% elseif meetingRequest is defined and meetingRequest is not null and isAnsweringMeetingRequestClosed is defined and isAnsweringMeetingRequestClosed == true %}
                {# Hide buttons if the meetingRequests answering are closed #}
            {% else %}
                <div class="buttons-zone button request-meeting-sheet">
                    {{ include('EventBundle:Sheet/Partial:meetingRequestButtons.html.twig', {
                        'sheet': sheet,
                        'userSheet': userSheet,
                        'meetingRequest': meetingRequest,
                        'isMeetingPublished': isMeetingPublished|default(false),
                        'isMeetingRequestUpdateLocked': isMeetingRequestUpdateLocked|default(false),
                        'isMeetingRequestClosed': isMeetingRequestClosed|default(false),
                        'isAnsweringMeetingRequestClosed': isAnsweringMeetingRequestClosed|default(false),
                        'isPhoneValidationRequired': isPhoneValidationRequired,
                        'phoneValidationLink': link,
                        'hideMeetingRequest': hideMeetingRequest|default(false),
                    }, false) }}
                </div>
            {% endif %}
        {% else %}
            {{ include('EventBundle:Sheet/Partial:validationButton.html.twig', {'sheet': sheet}, false) }}
        {% endif %}

        <a href="{{ path('event_sheet_generate_pdf', { sheet: userSheet is defined ? userSheet.id : sheet.id, sheetToDisplay: sheet.id, locale: locale }) }}" class="btn btn-gray" target="_blank"><span class="glyphicon glyphicon-print"></span>Pdf</a>

        {% if isCatalog is not defined or isCatalog == false %}
            <ul class="tabs">
                <li{% if locale == event.localeFallback %} class="active"{% endif %}>
                    <a href="{{ path('event_sheet_locale', { 'sheet': sheet.id, 'locale': event.fallback }) }}">
                        <span class="name">{{ event.localeFallback|locale }}*</span>
                    </a>
                </li>
                {% for event_locale in event.locales if event_locale != event.fallback %}
                    <li{% if event_locale == locale %} class="active"{% endif %}>
                        <a href="{{ path('event_sheet_locale', { 'sheet': sheet.id, 'locale': event_locale }) }}">
                            <span class="name">{{ event_locale|locale }}*</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </header>

    <div class="main__container">
        {% for uid, child in templateData.column(0) %}
            {{ include('EventBundle:Sheet/' ~ child.component|capitalize ~ ':' ~ child.type ~ '.html.twig', {
                'sheet': sheet,
                'uid': uid,
                'item': child,
                'locale': templateData.locale,
                'fallback': templateData.fallback,
                'taggedData': taggedData,
                'nomenclatures': nomenclatures,
                'participants': participants,
                'isCatalog': isCatalog|default(false),
                'userSheet': userSheet|default(false),
                'meetingRequest' : meetingRequest|default(false),
                'isMeetingPublished': isMeetingPublished|default(false),
                'isMeetingRequestUpdateLocked': isMeetingRequestUpdateLocked|default(false),
                'isMeetingRequestClosed': isMeetingRequestClosed|default(false),
                'isAnsweringMeetingRequestClosed': isAnsweringMeetingRequestClosed|default(false),
                'isPhoneValidationRequired': isPhoneValidationRequired|default(false),
                'phoneValidationLink': link,
                'hideMeetingRequest': hideMeetingRequest|default(false),
                'canAddParticipant': canAddParticipant|default(false),
                'displayAnalyticsStat': displayAnalyticsStat|default(false),
            }, false) }}
        {% endfor %}
    </div>
</section>

<div class="modal fade clear-on-hidden-modal{% if form is defined or form_participant is defined or form_remove is defined %} show-modal{% endif %}" id="edit-modal" tabindex="-1" role="dialog" data-placeholder="{{ '<div class="modal-body text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>'|e }}">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            {% if form is defined %}
                {{ include('EventBundle:Sheet:form.html.twig', { 'form': form, 'label': label, 'uid': uid, 'type': form.vars.data.type }) }}
            {% elseif form_participant is defined %}
                {{ include('EventBundle:Participant:add.html.twig', { 'form': form_participant, 'sheet': sheet, 'backRoute': 'backToSheet', 'participantProductViews': participantProductViews }) }}
            {% elseif form_remove is defined %}
                {{ include('EventBundle:Participant:remove.html.twig', { 'form': form_remove, 'participants': participants, 'label': label }) }}
            {% endif %}
        </div>
    </div>
</div>

{% if popinWelcome is defined and popinWelcome is not null %}
<div class="modal fade  show-modal" id="edit-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-welcom-popin" role="document">
        <div class="modal-content">
            {{ include('EventBundle:Sheet/Partial:welcome.html.twig', { 'popinWelcome': popinWelcome }) }}
        </div>
    </div>
</div>
{% endif %}

{% if isRequestMeetingEnabled %}
    {{ include('EventBundle:MeetingRequest:modalMeetingRequest.html.twig') }}
{% endif %}

{% if sheetValidationView is defined and sheetValidationView is not empty %}
    {{ include('EventBundle:Sheet:modalSheetValidation.html.twig', { 'view': sheetValidationView, 'sheet': sheet }, false) }}
{% endif %}
