<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        {{ 'sheet.welcome.title'|trans }}
    </h4>
    <div class="modal-subtitle">
        {{ 'sheet.welcome.subtitle'|trans }}
    </div>
</div>

<div class="modal-body row relative-modal">
    <div class="text-center col-md-{{ popinWelcome.hasPackage ? "6" : "12" }}">
        {{ 'sheet.welcome.sheetContent'|trans }}
    </div>

    {% if popinWelcome.hasPackage %}
        <div class="separator"></div>
        <div class="col-md-6 text-center">
            {{ 'sheet.welcome.packageContent'|trans }}
        </div>
    {% endif %}
</div>

<div class="modal-footer">
    <div class="row">
        <div class="col-md-{{ popinWelcome.hasPackage ? "6" : "12" }} text-center">
            <button type="button" class="btn btn btn-primary btn-lg" data-dismiss="modal">
                <i class="icon-Document_1"></i>
                {{ 'navigation.category.sheet'|trans }}
            </button>
        </div>
        {% if popinWelcome.hasPackage %}
            <div class="col-md-6 text-center">
                <a type="button" class="btn btn-gray btn-lg" href="{{ path('event_package') }}">
                    <i class="icon-Panier_2"></i>
                    {{ 'navigation.category.package'|trans }}
                </a>
            </div>
        {% endif %}
    </div>
</div>
