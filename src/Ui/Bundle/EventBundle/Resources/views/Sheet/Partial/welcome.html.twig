<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        {{ 'sheet.welcome.title'|trans }}
    </h4>
    <div class="modal-subtitle">
        {{ 'sheet.welcome.subtitle'|trans }}
    </div>
</div>
<div class="row modal-welcome">
    <div class="col-md-{{ popinWelcome.colSize }}">
        <div class="text-center custom-modal-content">
            <p class="custom-modal-text">{{ 'sheet.welcome.sheetContent'|trans|nl2br }}</p>
            <div class="custom-modal-button-parent">
                <div class="custom-modal-button-child">
                    <button type="button" class="btn btn btn-primary" data-dismiss="modal">
                        <i class="icon icon-Document_1"></i>
                        {{ 'navigation.category.sheet'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>
    {% if popinWelcome.hasPackage %}
        <div class="col-md-{{ popinWelcome.colSize }}">
            <div class="text-center custom-modal-content">
                <p class="custom-modal-text">{{ 'sheet.welcome.packageContent'|trans|nl2br }}</p>
                <div class="custom-modal-button-parent">
                    <div class="custom-modal-button-child">
                        <a type="button" class="btn btn-primary" href="{{ path('event_package_redirect_depending_on_context', {'sheet': sheet.id}) }}">
                            <i class="icon icon-Panier_2"></i>
                            {{ 'navigation.category.package'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    {% if popinWelcome.hasProgram %}
        <div class="col-md-{{ popinWelcome.colSize }}">
            <div class="text-center custom-modal-content">
                <p class="custom-modal-text">{{ 'sheet.welcome.programContent'|trans|nl2br }}</p>
                <div class="custom-modal-button-parent">
                    <div class="custom-modal-button-child">
                        <a type="button" class="btn btn-primary" href="{{ path('happening_program', {'sheet': sheet.id}) }}">
                            <i class="icon icon-Calendrier"></i>
                            {{ 'navigation.category.program'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
<div class="modal-footer"></div>
