{% extends 'EventBundle::base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title %}
    {{ event.title }}: {{ 'sheet.title'|trans }}
{% endblock %}

{% block content %}
    <section class="main">
        {% if label %}
            <div class="content-header clearfix">
                <h1 class="pull-left">
                    {{ label }}
                </h1>

                <a href="{{ path('event_sheet_locale', { 'sheet': sheet.id, 'locale': locale }) }}" class="btn btn-gray pull-right">
                    <i class="icon-Retour"></i> {{ 'common.backToSheet'|trans }}
                </a>
            </div>
        {% endif %}

        <section class="object object--collection style--style-1 section">
            {{ form_start(form, { 'attr': { 'class': 'styled-form form' } }) }}
            {{ form_errors(form) }}

            {{ form_row(form.objectsCollection) }}

            <div class="text-right mg-bt mg-tp clearboth">
                <input type="submit" value="{{ 'form.sheet_template_objects_collection_type.children.submit.label'|trans({}, 'forms') }}" class="btn btn-primary">
            </div>

            {{ form_end(form) }}
        </section>
    </section>
{% endblock %}
