{% extends 'EventBundle::base.html.twig' %}

{% block title %}
    {{ 'group.request.title'|trans({'%groupTitle%': sheetGroup.title }) }} - {{ event.title }}
{% endblock %}

{% block content %}
    <section class="main">
        <header>
            <h1>
                <a href="{{ path('event_sheet_group_index', {'sheetGroup': sheetGroup.id}) }}">{{ sheetGroup.title }}</a>
                /
                {{ 'group.request.title'|trans }}
            </h1>
        </header>

        <div class="main__container">
            {{ include('EventBundle:MultipleSheets/Request:filterForm.html.twig', {'resetLink': path('event_sheet_group_requests_list', {'sheetGroup': sheetGroup.id})}) }}
        </div>
        <div class="main__container">
            {{ include('EventBundle:MultipleSheets/Request:requests.html.twig', {'isMultipleSheet': isMultipleSheet}) }}
        </div>
    </section>
{% endblock %}
