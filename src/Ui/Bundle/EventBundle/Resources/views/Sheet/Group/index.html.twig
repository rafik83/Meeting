{% extends 'EventBundle::base.html.twig' %}

{% block title %}
    {{ groupView.title }} - {{ event.title }}
{% endblock %}

{% block content %}
<section class="main mg-top">
    <header>
        <h1>
            {{ groupView.title }}
        </h1>
    </header>

    <div class="main__container">
        <a href="{{ path('event_sheet_group_requests_list', {'sheetGroup': groupView.id}) }}" class="btn btn-default pull-right mg-left hidden-xs">
            {{ 'group.home.link.request'|trans }}
        </a>
        <a href="{{ path('event_sheet_group_participant_update', {'sheetGroup': groupView.id}) }}" class="btn btn-default pull-right mg-left hidden-xs">
            {{ 'group.home.link.participant_update'|trans }}
        </a>
        <a href="{{ path('event_sheet_group_participants_list', {'sheetGroup': groupView.id}) }}" class="btn btn-default pull-right mg-left hidden-xs">
            {{ 'group.home.link.participants'|trans }}
        </a>
        <a href="{{ path('event_sheet_group_create_sheet', {'sheetGroup': groupView.id}) }}" class="btn btn-default pull-right hidden-xs">
            {{ 'group.home.link.create_sheet'|trans }}
        </a>

        <table class="table">
            <thead>
            <tr>
                <th>
                    {{ 'sheet.title'|trans }}
                </th>
            </tr>
            </thead>
            <tbody>
            {% for sheetView in groupView.sheetViews %}
                <tr>
                    <td>
                        <a href="{{ path('event_sheet_group_switch_to', {sheetGroup: groupView.id, sheet: sheetView.id}) }}">
                            {{ sheetView.title }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
