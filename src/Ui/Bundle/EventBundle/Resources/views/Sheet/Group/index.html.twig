{% extends 'EventBundle::base.html.twig' %}

{% block title %}
    {{ groupView.title }} - {{ event.title }}
{% endblock %}

{% block content %}
<section class="main">
    <header>
        <h1>
            {{ groupView.title }}
        </h1>
    </header>
    <div class="main__container">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'sheet.title'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for sheetView in groupView.sheetViews %}
                    <tr>
                        <td>{{ sheetView.title }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
