{% for object in preview %}
    {% if object.isImage %}
        {% if object.content is not empty %}
            <div class="image-placeholder">
                <img src="{{ object.content|imagine_filter('event_sheet_image') }}"/>
            </div>
        {% else %}
            <h3>{{ title }}</h3>
        {% endif %}
    {% else %}
        {% if object.isStrong %}
            <p><strong>{{ object.content }}</strong></p>
        {% else %}
            <p>{{ object.content }}</p>
        {% endif %}
    {% endif %}
{% endfor %}
