{% for object in preview %}
    {% if object.isImage %}
        {% if object.content is not empty %}
            <div class="image-placeholder">
                <img src="{{ object.content|imagine_filter('event_sheet_image') }}"/>
            </div>
        {% else %}
            <h3>{{ title }}</h3>
        {% endif %}
    {% elseif object.isParticipant %}
        <div class="list list--users">
            {% for participant in object.cardViews %}
                {{ include('EventBundle:Participant:preview.html.twig', { 'participant': participant, 'isCatalog': isCatalog}) }}
            {% endfor %}
        </div>
    {% elseif object.isTag %}
        {% for tag in object.tagViews %}
            {{ include('EventBundle:Sheet/Card/Tag:' ~ tag.type ~ '.html.twig', {'tag': tag}, false) }}
        {% endfor %}
    {% elseif object.isParticipantsPosition %}
        <p class="preview-participants-position">
            <span class="text-highlighted">{{ object.content }}</span>{% if object.link and sheetToDisplayLink is defined and sheetToDisplayLink is not null %}, <a href="{{ sheetToDisplayLink }}" class="see-more" target="_blank">{{ 'catalog.preview.participant_positions_see_more'|trans }}</i></a>{% endif %}
        </p>
    {% else %}
        {% if object.isStrong %}
            <p><strong>{{ object.content }}</strong></p>
        {% else %}
            <p>{{ object.content }}</p>
        {% endif %}
    {% endif %}
{% endfor %}
