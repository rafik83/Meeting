{% extends 'EventBundle::base.html.twig' %}

{% block title 'networking.title'|trans %}

{% block container_classes 'full-mobile-container' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/networking.js') }}"></script>
{% endblock %}

{% block content %}

        <div class="networking_container">
            <div class="networking_chat">
                <div data-chat-networking
                     data-topic="{{ networkingView.topic }}"
                     data-chat-vote-like="{{ 'chat.vote.like'|trans }}"
                     data-chat-vote-happy="{{ 'chat.vote.happy'|trans }}"
                     data-chat-vote-heart="{{ 'chat.vote.heart'|trans }}"
                     data-chat-vote-acclaim="{{ 'chat.vote.acclaim'|trans }}"
                     data-chat-vote-instructive="{{ 'chat.vote.instructive'|trans }}"
                     data-chat-vote-message="{{ 'chat.vote'|trans }}"
                     data-chat-unvote-message="{{ 'chat.unvote'|trans }}"
                     data-chat-vote-disabled-message="{{ 'chat.voteDisabled'|trans }}"
                     data-notifications-provider-url="{{ networkingView.providerUrl }}"
                     data-notifications-subscriber-key="{{ networkingView.subscriberKey }}"
                >
                    <h2>{{ 'networking.chat.global.title'|trans }}</h2>
                    <div data-chat-container
                         data-href="{{ path('event_chat_messages_list', {sheet: sheet.id, objectType: 'networking', objectId: sheet.event.id}) }}"
                         data-vote-chat-href="{{ path('event_chat_messages_vote', {sheet: sheet.id}) }}"
                    >
                        <div class="chat-list">
                            {# content filled with javascript #}
                        </div>
                        <form
                                action="{{ path('event_chat_messages_add', {sheet: sheet.id, objectType: 'networking', objectId: sheet.event.id}) }}"
                                class="chat-form"
                                data-chat-form
                        >
                            <input type="text" name="content" placeholder="{{ 'networking.chat.add'|trans }}" maxlength="250" autocomplete="off">
                            <button type="submit"></button>
                        </form>
                    </div>
                    <hr>

                    {% if networkingView.privateChatSessions|length %}
                    <h2>{{ 'networking.chat.title'|trans }}</h2>
                    <table class="list list--private-messages table table-condensed table-hover">
                    {% for chatSessionView in networkingView.privateChatSessions %}
                        <tr>
                            <td>
                                <a href="{{ path('event_networking_chat', {
                                        'sheet': sheet.id,
                                        'toUser': chatSessionView.otherUser.id,
                                    }) }}">
                                    <div>
                                        <em>{{ chatSessionView.latestMessageDate | localizeddate('short', 'short') }}</em>
                                    </div>
                                    <div>
                                        <img src="{{ chatSessionView.otherUser.avatar }}">
                                    {{ chatSessionView.otherUser.fullName }}
                                    </div>
                                </a>
                            </td>
                            <td class="text-right">
                                {{ 'networking.chat.messages.count'|transchoice(chatSessionView.messagesCount, {'%count%': chatSessionView.messagesCount}) }}
                            </td>
                        </tr>
                    {% endfor %}
                    </table>
                    {% endif %}
                </div>
            </div>
            <div class="networking_list">
                <div class="networking_list_header">
                    <h2>{{ 'networking.participants.title'|trans }}</h2>
                    <div class="networking_list_search">
                        <input id="networking_list_search_input" type="search" placeholder="{{ 'networking.participants.search'|trans }}">
                    </div>
                </div>
                <table class="list list--users table table-striped table-bordered table-hover participantList">
                    <tbody id="ParticipantList" data-user-current="{{ networkingView.userCurrentId }}">
                    {% for userId, subscription in networkingView.subscriptions %}
                    <tr data-participant-user-id="{{ subscription.userId }}">
                        <td class="networking_list_row">
                            <img src="{{ subscription.userAvatar }}">
                            <a href="{{ path('event_networking_chat', {sheet: sheet.id, toUser: userId}) }}"><p>{{ subscription.userFirstName }}  {{ subscription.userLastName }} - {{ subscription.userCompany }} - <em> {{ subscription.userPosition }}</em></p></a>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
