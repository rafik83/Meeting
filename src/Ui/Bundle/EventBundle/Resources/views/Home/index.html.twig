{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title event.title %}

{% block content %}
    {% if is_granted('IS_AUTHENTICATED_FULLY') and sheets is not empty %}
        <ul>
            <li>
                <a href="{{ path('event_catalog') }}">
                    {{ 'event.link.see_catalog'|trans }}
                </a>
            </li>
            {% for sheet in sheets %}
                <li>
                    <a href="{{ path('event_sheet', { 'sheet': sheet.id }) }}">
                        {{ 'event.link.see_my_sheet'|trans({ '%type%': sheet.typeTitle }) }}
                    </a>
                    <ul>
                        <li>
                            <a href="{{ path('event_meeting_list_request', { 'sheet': sheet.id }) }}">
                                {{ 'event.link.see_meeting_request'|trans() }}
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('event_meeting_list_proposition', { 'sheet': sheet.id }) }}">
                                {{ 'event.link.see_meeting_proposition'|trans() }}
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('event_sheet_schedule', { 'sheet': sheet.id }) }}">
                                {{ 'event.link.see_schedule'|trans({ '%type%': sheet.typeTitle }) }}
                            </a>
                        </li>
                    </ul>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <section class="main">
            <header>
                <h1><i class="icon-Clef"></i> {{ 'register.register_as'|trans }}</h1>
            </header>

            <div class="main__content">
                {{ form_start(form, {attr: {class: 'styled-form'}}) }}
                {{ form_row(form.type) }}

                <div class="validation">
                    <button type="submit" class="btn btn-primary"><i class="icon-Suivant_3"></i> {{ 'common.next'|trans }}</button>
                </div>

                {{ form_end(form) }}
            </div>
        </section>

        <section id="type-description" class="important hide">
        </section>
    {% endif %}
{% endblock %}
