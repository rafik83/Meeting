        {% if menuView is not null %}
            <ul class="sub-header__item">
                <li>
                    <div class="navigation">
                        {{ include('EventBundle:Navigation/Partial:mainMenu.html.twig') }}
                    </div>
                </li>
            </ul>
        {% endif %}

        {% if submenuView is not null %}
            {{ include('EventBundle:Navigation/Partial:submenu.html.twig') }}
        {% endif %}
    </div>
{% endif %}

