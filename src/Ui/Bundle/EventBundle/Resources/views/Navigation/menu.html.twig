<div class="sub-header">
    <ul class="sub-header__item">
        <li>
            <div class="navigation dropdown">
                {{ render(controller('EventBundle:Navigation:menu')) }}
            </div>
        </li>
        {% if isCatalog is defined and isCatalog == true and resultsCount is defined and resultsCount > 0 %}
        <li>
            <button class="btn btn-primary btn-lg btn-inactive display-catalog-research"><i class="icon-Rechercher"></i> Recherche avancée</button>
        </li>
        {% endif %}
    </ul>

    <ul class="sub-header__item">
        {% if isCatalog is defined %}
            <li>
                <a href="{{ path('event_catalog_index') }}" class="btn btn-primary btn-lg">
                    <i class="icon-Contact_1"></i>
                    <span class="name">{{ 'navigation.category.catalog'|trans }}</span>
                </a>
            </li>
        {% else %}
            {% set funnel = view is defined and view.funnel is defined %}
            <li>
                <a href="{{ path('event_sheet') }}" class="btn btn-primary btn-lg {{ funnel ? 'btn-inactive' : '' }}">
                    <i class="icon-Document_1"></i>
                    <span class="name">{{ 'sheet.title'|trans }}</span>
                </a>
            </li>
            <li>
                <a href="{{ path('event_package') }}" class="btn btn-primary btn-lg {{ funnel ? '' : 'btn-inactive' }}">
                    <i class="icon-Panier_2"></i>
                    <span class="name">{{ 'package.title'|trans }}</span>
                </a>
            </li>
        {% endif %}

        {% if isMeeting is defined and sheet is defined %}
            <li>
                <a href="{{ path('event_meeting_list_request', {'sheet': sheet.id }) }}" class="btn btn-primary btn-lg">
                    <i class="icon-RDV"></i>
                    <span class="name">{{ 'navigation.category.happening'|trans }}</span>
                </a>
            </li>
        {% endif %}
    </ul>
</div>
