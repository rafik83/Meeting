<div class="sub-header">
    <ul class="sub-header__item">
        <li>
            <div class="navigation dropdown">
                {{ render(controller('EventBundle:Navigation:menu')) }}
            </div>
        </li>
    </ul>

    <ul class="sub-header__item">
        {% if isCatalog is defined or (isMeeting is defined and sheet is defined) %}
            {% set classCatalog = (isMeeting is defined) ? 'btn-inactive' : '' %}
            <li>
                <a href="{{ path('event_catalog_index') }}" class="btn btn-primary {{ classCatalog }} btn-lg">
                    <i class="icon-Contact_1"></i>
                    <span class="name">{{ 'navigation.category.catalog'|trans }}</span>
                </a>
            </li>

            <li>
                {% set classMeeting = (isMeeting is defined) ? '' : 'btn-inactive' %}
                {% set sheetId = (userSheet is defined) ? userSheet.id : sheet.id %}
                <a href="{{ path('event_meeting_list_request', {'sheet': sheetId }) }}" class="btn btn-primary {{ classMeeting }} btn-lg">
                    <i class="icon-RDV"></i>
                    <span class="name">{{ 'navigation.category.meeting'|trans }}</span>
                </a>
            </li>
        {% else %}
            {% set funnel = view is defined and view.funnel is defined %}
            <li>
                <a href="{{ path('event_sheet') }}" class="btn btn-primary btn-lg {{ funnel ? 'btn-inactive' : '' }}">
                    <i class="icon-Document_1"></i>
                    <span class="name">{{ 'sheet.title'|trans }}</span>
                </a>
            </li>
            {% if sheet is defined and sheet.package.isPassable == true %}
                <li>
                    <a href="{{ path('event_package') }}" class="btn btn-primary btn-lg {{ funnel ? '' : 'btn-inactive' }}">
                        <i class="icon-Panier_2"></i>
                        <span class="name">{{ 'package.title'|trans }}</span>
                    </a>
                </li>
            {% endif %}
        {% endif %}
    </ul>
</div>
