<ul class="sub-header__item">
    {% for button in submenuView.submenuButtonViews %}
        <li>
            <a href="{{ button.link }}" class="btn btn-primary btn-lg {{ (button.state == false) ? 'btn-inactive': '' }}">
                <i class="{{ button.icon }}"></i>
                <span class="name pull-left">{{ button.label|trans }}</span>

                {% if button.hasAlert %}
                    <span class="alert-notification">!</span>
                {% endif %}
            </a>
        </li>
    {% endfor %}
</ul>
