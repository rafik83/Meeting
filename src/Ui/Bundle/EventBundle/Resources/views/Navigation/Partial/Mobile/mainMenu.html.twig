<ul class="sub-header__item">
    {% for button in submenuView.submenuButtonViews %}
        {% if button.isShowOnMobile %}
            <li>
                <a href="{{ button.link }}" class="btn btn-primary {{ (button.state == false) ? 'btn-inactive': '' }}">
                    <span class="{{ button.icon }}"></span>

                    {% if button.hasAlert %}
                        <span class="alert-notification">!</span>
                    {% endif %}
                </a>
            </li>
        {% endif %}
    {% endfor %}
</ul>
