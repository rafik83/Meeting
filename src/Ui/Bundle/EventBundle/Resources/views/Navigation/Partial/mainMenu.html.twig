{% if menuView.categoriesView is not empty %}
    <button id="navigation" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <i class="icon-Menu_12"></i> {{ 'navigation.menu'|trans }}
    </button>
    <div class="navigation__content dropdown-menu row" aria-labelledby="navigation">
        <button type="button" class="navigation__close">
            <i class="icon-Fermer_3"></i> {{ 'navigation.close'|trans }}
        </button>

        {% for key, category in menuView.categoriesView %}
            {% if key % 2 == 0 %}
                <div class="column col-md-3">
            {% endif %}
            <div class="navigation__item">
                <h3><i class="{{ category.icon }}"></i> {{ category.title|trans }}</h3>
                {% if category.linksView|length > 0 %}
                    <ul>
                        {% for link in category.linksView %}
                            <li>
                                {% if link.link and link.state == true %}
                                    <a href="{{ link.link }}">{{ link.label|trans }}</a>
                                    {% if link.button is not empty %}
                                        <span class="state">{{ link.button.label|trans }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="inactive">{{ link.label|trans }}</span>
                                    {% if link.button is not empty %}
                                        <span class="state">{{ link.button.label|trans }}</span>
                                    {% endif %}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
            {% if key % 2 == 1 %}
                </div>
            {% endif %}
        {% endfor %}

        {% if menuView.categoriesView|length % 2 == 1 %}
    </div>
    {% endif %}
{% endif %}
