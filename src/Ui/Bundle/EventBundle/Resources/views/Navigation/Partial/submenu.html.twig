<ul class="sub-header__item">
	{% for button in submenuView.submenuButtonViews %}
		<li>
			<a {% for attribute, value in button.attributes %} 
				{{ attribute }}="{{ value }}" {% endfor %} 
				href="{{ button.link }}" 
				class="btn btn-primary {{ (button.state == false) ? 'btn-inactive': '' }}"
				data-unread-networking-button-message-count="{{button.counter}}"
				>
				<i class="{{ button.icon }}"></i>
				<span class="name pull-right">{{ button.label|trans }}</span>
			</a>
		</li>
	{% endfor %}
</ul>
