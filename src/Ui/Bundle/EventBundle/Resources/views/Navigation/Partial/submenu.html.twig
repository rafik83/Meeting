<ul class="sub-header__item">
	{% for button in submenuView.submenuButtonViews %}
		<li>
			<a {% for attribute, value in button.attributes %} {{ attribute }}="{{ value }}" {% endfor %}
                style="{% if button.labelColor %}color:{{button.labelColor}}!important;{% endif %}{% if button.bgButtonColor %}background-color:{{button.bgButtonColor}}!important{% endif %}"
                href="{{ button.link }}" class="btn btn-primary {{ (button.state == false) ? 'btn-inactive': '' }}">
                <i class="{{ button.icon }}" {% if button.iconColor %} style="color:{{ button.iconColor }}!important"{% endif %} ></i>
                    <span class="name pull-right">{{ button.label|trans }}</span>
				{% if button.counter is not null and button.counter > 0 %}
					<span class="alert-notification">{{ button.counter <= 99 ? button.counter : "99+"  }}</span>
				{% endif %}
			</a>
		</li>
	{% endfor %}
</ul>
