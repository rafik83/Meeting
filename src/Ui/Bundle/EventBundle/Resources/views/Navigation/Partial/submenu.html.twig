<ul class="sub-header__item">
    {% for button in submenuView.submenuButtonViews %}
        <li>
            <a {% if button.attributes %}
                {% for attribute, value in button.attributes %}
                    {{ attribute }} = "{{ value }}"
                {% endfor %}
            {% endif %}

            href="{{ button.link }}" class="btn btn-primary {{ (button.state == false) ? 'btn-inactive': '' }}">
                <i class="{{ button.icon }}"></i>
                <span class="name pull-left">{{ button.label|trans }}</span>

                {% if button.hasAlert %}
                    <span class="alert-notification">!</span>
                {% endif %}
            </a>
        </li>
    {% endfor %}
</ul>
