{% extends 'EventBundle::base.html.twig' %}

{% block head_link %}
    <link rel="chrome-webstore-item" href="{{ visio_screen_sharing_chrome_extension }}">
{% endblock %}

{% block body %}
    {% set participantPresenceAction = null %}
    {% if participant is defined and meeting is defined and sheet is defined %}
        {% set participantPresenceAction = path('event_video_meeting_presence', {'sheet': sheet.id, 'participant': participant.id, 'meeting': meeting.id}) %}
    {% endif %}

    <div class="video-conference"
         data-token="{{ videoConferenceView.token }}"
         data-session-id="{{ videoConferenceView.sessionId }}"
         data-api-key="{{ videoConferenceView.apiKey }}"
         data-not-compatible-browser-message="{{ 'meeting.video.notCompatibleBrowserMessage'|trans }}"
         data-chat-waiting-message="{{ 'meeting.video.chat.waitingMessage'|trans }}"
         data-install-screensharing-extension-message="{{ 'meeting.video.installScreenSharingExtensionMessage'|trans }}"
         data-user-denied-media-access="{{ 'meeting.video.error.userDeniedAccess'|trans }}"
         data-participant-presence-action="{{ participantPresenceAction }}"
         data-user-complete-name="{{ userCompleteName }}"
         {% if meetingView is defined %}
             data-meeting-start-time="{{ meetingView.begin.timestamp }}"
             data-meeting-end-time="{{ meetingView.end.timestamp }}"
             data-current-time="{{ currentTime }}"
         {% endif %}
    >
        <div class="layout-container"></div>
        <div class="publisher-container"></div>
        <div class="chat-container hide"></div>
        <div class="video-helper">
            {{ include('EventBundle:Visio:settings.html.twig') }}
            <div><i class="icon-Alerter_1"></i> {{ 'meeting.video.waitingForParticipant'|trans }}</div>

            {% if meetingView is defined %}
                <br>
                <h1>
                    {% for sheetMetView in meetingView.sheetMetTitle %}
                        {% if sheetMetView.isHighlighted %}
                            <b>{{ sheetMetView.title }}</b>
                        {% else %}
                            {{ sheetMetView.title }}
                        {% endif %}
                    {% endfor %}
                </h1>

                <div class="list list--users">
                    {% for participantView in meetingView.participants %}
                        {{ include('EventBundle:Participant:preview.html.twig', {'participant': participantView.card}) }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {% if meetingView is defined %}
        <div class="timer-container">
            <div class="timer">
                {{ 'meeting.video.endingAt'|trans }}
                <span class="countdown"></span>
            </div>
        </div>
        {% endif %}

        <div class="buttons-container">
            <button id="toggle-audio" class="btn">
                <i class="icon-Conference icon-center"></i>
            </button>
            <button id="toggle-video" class="btn">
                <i class="glyphicon glyphicon glyphicon-facetime-video icon-center"></i>
            </button>
            <button id="toggle-chat" class="btn btn-off hide">
                <i class="icon-Commentaire icon-center"></i>
            </button>
            <button id="start-screensharing" class="btn screensharing">
                <i class="glyphicon glyphicon-share"></i>{{ 'meeting.video.screenshare.start'|trans }}
            </button>
            <button id="end-screensharing" class="btn screensharing hide">
                <i class="glyphicon glyphicon-share"></i>{{ 'meeting.video.screenshare.end'|trans }}
            </button>
            <button class="btn btn-primary end-meeting">
                <i class="icon-Disconnect"></i> {{ 'meeting.video.end'|trans }}
            </button>
        </div>
    </div>
{% endblock body %}

