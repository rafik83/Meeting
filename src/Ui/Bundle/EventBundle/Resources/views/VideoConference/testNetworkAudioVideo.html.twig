{% extends 'EventBundle::base.html.twig' %}

{% block content %}
<section class="main">
    <header>
        <h1>
            {{ 'event.visio.test.title'|trans }}
        </h1>
    </header>

    <div class="main__container video-conference-test"
         data-token="{{ videoConferenceView.token }}"
         data-session-id="{{ videoConferenceView.sessionId }}"
         data-api-key="{{ videoConferenceView.apiKey }}"
         data-label-test-in-progress="{{ 'event.visio.test.testInProgress'|trans }}"
         data-label-test-successful="{{ 'event.visio.test.testSuccessful'|trans }}"
         data-label-quality="{{ 'event.visio.test.quality'|trans }}"
         data-error-network-api="{{ 'event.visio.test.error.network.api'|trans }}"
         data-not-compatible-browser-message="{{ 'meeting.video.notCompatibleBrowserMessage'|trans }}"
         data-install-screensharing-extension-message="{{ 'meeting.video.installScreenSharingExtensionMessage'|trans }}"
         data-visio-tested-url="{{ path('event_video_conference_network_tested') }}"
    >
        <p>{{ 'event.visio.test.description'|trans }}</p>

        <div data-spinner style="display: none" class="text-center"><i class="glyphicon glyphicon-refresh spin text-xl"></i></div>

        <p data-loading class="text-center"><i class="glyphicon glyphicon-refresh spin"></i> {{ 'event.visio.test.loading'|trans }}</p>
        <p class="text-center"><a href="#" class="btn btn-primary" data-start-button style="display: none">{{ 'event.visio.test.start'|trans }}</a></p>

        <div class="row text-center">
            <div class="col-md-6">
                <div data-results style="display:none;">
                    <table class="table">
                        <tr data-result-network>
                            <td class="col-md-2">
                                <div class="show" data-label-icon><i class="glyphicon glyphicon-globe icon-center text-xl"></i></div>
                            </td>
                            <td class="col-md-2"><h2>{{ 'event.visio.test.network'|trans }}</h2></td>
                            <td data-comment></td>
                        </tr>

                        <tr data-result-audio>
                            <td>
                                <div class="show" data-label-icon><i class="icon-Conference icon-center text-xl"></i></div>
                            </td>
                            <td><h2>{{ 'event.visio.test.audio'|trans }}</h2></td>
                            <td data-comment></td>
                        </tr>

                        <tr data-result-video>
                            <td>
                                <div class="show" data-label-icon><i class="glyphicon glyphicon-facetime-video icon-center text-xl"></i></div>
                            </td>
                            <td><h2>{{ 'event.visio.test.video'|trans }}</h2></td>
                            <td data-comment></td>
                        </tr>

                        <tr data-result-screensharing>
                            <td>
                                <div class="show" data-label-icon><i class="glyphicon glyphicon-share icon-center text-xl"></i></div>
                            </td>
                            <td><h2>{{ 'event.visio.test.screenSharing'|trans }}</h2></td>
                            <td data-comment></td>
                        </tr>
                    </table>
                </div>

            </div>

            <div class="col-md-6">
                <div class="video-conference-preview"
                     data-token="{{ videoConferenceView.token }}"
                     data-session-id="{{ videoConferenceView.sessionId }}"
                     data-api-key="{{ videoConferenceView.apiKey }}"
                     data-not-compatible-browser-message="{{ 'meeting.video.notCompatibleBrowserMessage'|trans }}"
                     data-install-screensharing-extension-message="{{ 'meeting.video.installScreenSharingExtensionMessage'|trans }}"
                     data-user-denied-media-access="{{ 'meeting.video.error.userDeniedAccess'|trans }}"
                     data-participant-presence-action=""
                     style="display:none;"
                >
                    <div class="layout-container"></div>
                    <div class="publisher-container"></div>

                    <div class="buttons-container">
                        <button id="toggle-audio" class="btn">
                            <i class="icon-Conference icon-center"></i>
                        </button>
                        <button id="toggle-video" class="btn">
                            <i class="glyphicon glyphicon glyphicon-facetime-video icon-center"></i>
                        </button>
                        <button id="start-screensharing" class="btn screensharing">
                            <i class="glyphicon glyphicon-share"></i>{{ 'meeting.video.screenshare.start'|trans }}
                        </button>
                        <button id="end-screensharing" class="btn screensharing hide">
                            <i class="glyphicon glyphicon-share"></i>{{ 'meeting.video.screenshare.end'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock content %}
