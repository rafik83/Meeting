{% extends 'EventBundle::base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title event.title %}

{% block content %}
<div class="profile__content">
    <section class="main">
        <header>
            <h1>{{ 'event.activateAccount.password'|trans }}</h1>
        </header>

        <div class="main__content">
            {{ form_start(form, {attr: {class: 'styled-form'}}) }}
            {{ form_errors(form) }}

            <div class="inputs">
                {% for child in form %}
                    {{ form_row(child) }}
                {% endfor %}

                <p class="alert alert-warning">{{ 'form.password.rules'|trans({}, 'forms') }}</p>

                <div class="validation">
                    <button type="submit" class="btn btn-primary">
                        <i class="icon-Suivant_3"></i> {{ 'common.validate'|trans }}
                    </button>
                </div>
            </div>

            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}
