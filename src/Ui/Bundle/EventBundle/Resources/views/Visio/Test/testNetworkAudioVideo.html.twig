{% extends 'EventBundle::base.html.twig' %}

{% block body %}
    <div class="video-conference-test"
         id="video-conference-test"
         data-token="{{ videoConferenceView.token }}"
         data-session-id="{{ videoConferenceView.sessionId }}"
         data-api-key="{{ videoConferenceView.apiKey }}"
         data-not-compatible-browser-message="{{ 'meeting.video.notCompatibleBrowserMessage'|trans }}"
         data-install-screensharing-extension-message="{{ 'meeting.video.installScreenSharingExtensionMessage'|trans }}"
         data-user-denied-media-access="{{ 'meeting.video.error.userDeniedAccess'|trans }}"
         data-error-audio-not-supported="{{ 'meeting.video.test.error.audio-not-supported'|trans }}"
         data-error-video-not-supported="{{ 'meeting.video.test.error.video-not-supported'|trans }}"
         data-error-network-api="{{ 'meeting.video.test.error.network.api'|trans }}"
         data-error-network-media="{{ 'meeting.video.test.error.network.media'|trans }}"
         data-error-network-messaging="{{ 'meeting.video.test.error.network.messaging'|trans }}"
         data-error-network-logging="{{ 'meeting.video.test.error.network.logging'|trans }}"
         data-error-quality-low="{{ 'meeting.video.test.error.mos.quality-low'|trans }}"
         data-error-quality-test="{{ 'meeting.video.test.error.quality'|trans }}"
         data-error-connectivity-test="{{ 'meeting.video.test.error.connectivity'|trans }}"
    >
        <div class="layout-container"></div>
        <div class="publisher-container"></div>
        <div class="video-helper"></div>
    </div>
{% endblock body %}
