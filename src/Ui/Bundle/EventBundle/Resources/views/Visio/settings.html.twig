<section class="main" id="video-settings-section">
    <header>
        <h1>{{ 'event.visio.settings.title'|trans }}</h1>
    </header>

    <div class="main__content">
        <div id="visio-request-permission" class="row">
            <div class="col-md-12 text-center">
                <p>{{ 'event.visio.settings.askPermissionsDescription'|trans|nl2br }}</p>
                <hr>
                <button class="btn btn-primary" id="visio-request-permission-ask" autofocus>
                    <i class="icon-Video_2"></i> {{ 'event.visio.settings.askPermissions'|trans }}
                </button>
            </div>
        </div>
        <div id="visio-settings" class="row hide">
            <div class="col-md-5">
                <label for="visio-video-source-select">{{ 'event.visio.settings.selectVideo'|trans }}</label>
                <select id="visio-video-source-select" name="video-source" class="form-control" required>
                </select>
                <hr/>
                <br/>
                <label for="visio-audio-source-select">{{ 'event.visio.settings.selectAudio'|trans }}</label>
                <select id="visio-audio-source-select" name="audio-source" class="form-control" required>
                </select>
                <hr />
                <label>{{ 'event.visio.settings.testAudio'|trans }}</label>
                <audio controls>
                    <source src="{{ asset('assets/sounds/fight-bell.mp3') }}" type="audio/mp3">
                    Your browser does not support the audio element.
                </audio>
            </div>
            <div class="col-md-7">
                <span>{{ 'event.visio.settings.preview'|trans }}</span>
                <video id="visio-video-box" class="img-responsive" autoplay playsinline muted></video>
                <br/>
                <div class="progress">
                    <div class="progress-bar" id="visio-audio-volume" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        <span class="sr-only">0%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-12 text-center">
                <hr>
                <button class="btn btn-primary" id="visio-settings-validate">
                    <i class="icon-RDV"></i> {{ 'event.visio.settings.startMeeting'|trans }}
                </button>
            </div>
        </div>
    </div>
</section>
