{% import '@Event/Badge/Print/macros.html.twig' as macro -%}
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: RobotoRegular, HelveticaNeue, Helvetica, Calibri, sans-serif !important;
        }

        .page {
            page-break-after: always;
        }

        .text {
            margin: 0 5mm;
        }

        .badge-content .qrcode {
            font-size: 13px;
            text-align: center;
            top: 50mm;
            position: absolute;
            width: 100%;
            color: #555555;
        }

        .badge-content .qrcode-border {
            border: solid 1px #ddd;
            margin: 0 auto;
            width: 34mm;
            padding: 2mm;
        }

        .badge-content .qrcode img {
            height: 30mm;
            width: 30mm;
        }

        .badge-content {
            margin: 0 auto;
        }

        .badge-content .company-participant {
            height: 17mm;
            overflow: hidden;
            color: #2F2F2F;
            font-size: 24px;
            margin: 10px 0 0 0;
            font-weight: 700;
            position: absolute;
            top: 32mm;
            text-align: center;
            width: 100%;
        }

        .badge-content .info-participant {
            max-height: 28mm;
            height: 26mm;
            margin: 0;
            position: absolute;
            top: 94mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .badge-content .info-participant .name-participant {
            color: #2F2F2F;
            font-size: 20px;
            font-weight: 400;
            margin: 0;
            max-height: 14mm;
            overflow: hidden;
        }

        .badge-content .info-participant .name-participant .last-name-participant {
            text-transform: uppercase;
        }

        .badge-content .info-participant .position-participant {
            color: #1518E7;
            font-size: 20px;
            font-weight: 700;
            max-height: 20mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .badge-participationType {
            font-size: 23px;
            height: 24mm;
            text-transform: uppercase;
            position: absolute;
            bottom: 0;
            text-align: center;
            width: 100%;
        }

        .badge-participationType-content {
            display: table;
            width: 100%;
            height: 100%;
        }

        .badge-participationType-content-text {
            display: table-cell;
            vertical-align: middle;
        }

        .text-center {
            margin: 0 auto;
            text-align: center;
        }

        .company-zone-without-qrcode {
            top: 36mm !important;
        }

        .participant-zone-without-qrcode {
            margin-top: -27mm !important;
            max-height: 42mm !important;
            height: 42mm !important;
        }

        .text-participant-without-qrcode {
            font-size: 24px !important;
            max-height: 21mm !important;
        }

        @media print {
            body {
                zoom: 0.75;
            }
        }

        {% include '@Admin/User/Event/Badge/commonRules.css' %}

    </style>
    <title>
        {{ userBadgeByEventView.firstName }} {{ userBadgeByEventView.lastName }} - {{ userBadgeByEventView.sheetTitle }}
    </title>
</head>
<body>
<div class="page">
    {{ macro.write_badge(userBadgeByEventView) }}
    {% if userBadgeByEventView.isMirrored %}
        {{ macro.write_badge(userBadgeByEventView, 'right') }}
    {% endif %}
    {% if userBadgeByEventView.leftImage %}
        {{ macro.write_image(userBadgeByEventView.leftImage, 'left') }}
    {% endif %}
    {% if userBadgeByEventView.rightImage %}
        {{ macro.write_image(userBadgeByEventView.rightImage, 'right', userBadgeByEventView.isRightImageFullHeight) }}
    {% endif %}
</div>
</body>
</html>
