<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style type="text/css">
        body {
            margin: 0;
        }
        .ebadge {
            width: 50%;
            height: 50%;
            margin: 0;
            padding: 0;
            position: relative;
        }

        .ebadge-logo {
            max-width: 100%;
            max-height: 48mm;
            margin: 0 auto;
            text-align: center;
            display: block;
        }

        .ebadge-qrcode {
            width: 170px;
            border: 1px solid #e2e3e4;
            margin: 10px auto;
            padding: 10px 10px 4px 10px;
        }

        .ebadge-qrcode img {
            width: 150px;
            height: 150px;
        }

        .ebadge-qrcode-token {
            margin-top: 4px;
        }

        .ebadge-content {
            text-align: center;
            padding: 10px;
        }

        .ebadge-participation-type {
            font-size: 24px;
            font-weight: 400;
            height: 90px;
            line-height: 90px;
            text-transform: uppercase;
            position: absolute;
            top: 133mm;
            text-align: center;
            width: 100%;
        }

        @media print {
            body {
                zoom: 0.75;
            }
        }
    </style>
    <title>
        {{ userBadgeByEventView.firstName }} {{ userBadgeByEventView.lastName }} - {{ userBadgeByEventView.sheetTitle }}
    </title>
</head>
<body>
    <div class="ebadge">
        {% if userBadgeByEventView.header %}
            <img src="{{ userBadgeByEventView.header }}" class="ebadge-logo" />
        {% endif %}

        <div class="ebadge-content">
            <div class="ft-bold">
                {{ userBadgeByEventView.sheetTitle }}
            </div>

            {% if userBadgeByEventView.qrCodeIdentifier %}
                <div class="ebadge-qrcode">
                    <img src="{{ userBadgeByEventView.qrCodeImage }}" /><br>
                    <div class="ebadge-qrcode-token">ID {{ userBadgeByEventView.qrCodeIdentifier }}</div>
                </div>
            {% endif %}

            <div>
                <div>{{ userBadgeByEventView.firstName }} {{ userBadgeByEventView.lastName }}</div>

                <div class="ft-bold highlight">
                    {{ userBadgeByEventView.position }}
                    {% if userBadgeByEventView.country is not empty %}
                        <br/>{{ userBadgeByEventView.country|upper }}
                    {% endif %}
                </div>
            </div>
        </div>

        {% if userBadgeByEventView.participationTypeOrCategoryLabel %}
            <div class="ebadge-participation-type ft-bold" style="background: {{ userBadgeByEventView.footerColor }}; color: {{ userBadgeByEventView.footerTextColor }};">
                {{ userBadgeByEventView.participationTypeOrCategoryLabel }}
            </div>
        {% endif %}
    </div>
</body>
</html>
