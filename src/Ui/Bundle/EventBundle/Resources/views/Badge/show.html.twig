{% extends 'EventBundle::base.html.twig' %}

{% block title 'badge.title'|trans %}

{% block container_classes 'no-margin-mobile-container' %}

{% block stylesheets %}
    {{ parent() }}

    <style type="text/css">
        .ebadge-logo {
            width: 100%;
            background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
        }

        .ebadge-qrcode {
            top: 50mm;
            position: absolute;
            width: 100%;
        }

        .ebadge-qrcode-border {
            border: 1px solid #e2e3e4;
            margin: 10px auto;
            padding: 10px 10px 4px 10px;
        }

        .ebadge-qrcode-token {
            margin-top: 4px;
        }

        .ebadge-content {
            font-size: 20px;
            text-align: center;
            padding: 4px;
            margin: 0 auto;
        }

        .ebadge-content .company-participant {
            height: 17mm;
            overflow: hidden;
            color: #2F2F2F;
            font-size: 22px;
            margin: 10px 0 0 0;
            font-weight: 700;
            position: absolute;
            top: 32mm;
            text-align: center;
            width: 100%;
        }

        .ebadge-content .info-participant {
            max-height: 28mm;
            height: 26mm;
            margin: 0;
            position: absolute;
            top: 94mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .ebadge-content .info-participant .position-participant {
            color: #1518E7;
            font-size: 20px;
            font-weight: 700;
            max-height: 20mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .ebadge-qrcode-token {
            font-size: 12px;
        }

        .ebadge-participation-type {
            font-size: 23px;
            height: 24mm;
            text-transform: uppercase;
            position: absolute;
            bottom: 0;
            text-align: center;
            width: 100%;
        }

        .ebadge-participation-type-content {
            display: table;
            width: 100%;
            height: 100%;
        }

        .ebadge-participation-type-content-text {
            display: table-cell;
            vertical-align: middle;
        }

        @media screen and (max-width: 767px) {
            .ebadge {
                height: 100vh;
            }

            .ebadge-qrcode-border {
                width: 170px;
            }

            .ebadge-qrcode-border img {
                width: 150px;
                height: 150px;
            }

            .ebadge-content {
                position: relative;
            }

            .ebadge-content .company-participant {
                max-height: 17mm;
                height: auto;
                position: relative;
                top: 0;
            }

            .ebadge-qrcode {
                top: 0;
                position: relative;
                width: 100%;
            }

            .ebadge-qrcode-border {
                border: 1px solid #e2e3e4;
                margin: 10px auto;
                padding: 10px 10px 4px 10px;
            }

            .ebadge-content .info-participant {
                max-height: 28mm;
                height: auto;
                top: 0;
                position: relative;
            }

            .ebadge-participation-type {
                bottom: 80px;
                position: fixed;
                max-height: 24mm;
                min-height: 15mm;
                height: auto;
            }
        }

        @media screen and (min-width: 768px) {
            .ebadge-container {
                margin: 0 auto;
            }
            .ebadge {
                position: relative;
                margin: auto;
                width: 105mm;
                border: 1px solid black;
                height: 148mm;
            }

            .ebadge-qrcode-border {
                width: 35mm;
            }

            .ebadge-qrcode .ebadge-qrcode-border img {
                width: 30mm;
                height: 30mm;
            }

            .ebadge-content {
                margin-top: 7mm;
            }

            .ebadge-participation-type {
                bottom: 0;
            }
        }

        @media print {
            * {
                font-family: RobotoRegular, HelveticaNeue, Helvetica, sans-serif !important;
            }

            .container-fluid {
                padding: 0;
                margin: 0;
            }

            .ebadge-container {
                page-break-after: always;
                clear: both;
                width: 105mm;
                height: 148mm;
            }

            .ebadge {
                position: relative;
                font-size: 20px;
                width: 98mm;
                height: 141mm;
                margin: 0;
            }

            .ebadge-logo {
                max-width: 100%;
                max-height: 44mm;
                margin: 0 auto;
                text-align: center;
                display: block;
                background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
            }

            .ebadge-qrcode-border {
                width: 35mm;
            }

            .ebadge-qrcode .ebadge-qrcode-border img {
                width: 30mm;
                height: 30mm;
            }

            .ebadge-content {
                margin-top: 7mm;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="ebadge-container">
        <div class="ebadge print-bg">
            {% if userBadgeByEventView.header %}
                <img src="{{ userBadgeByEventView.header }}" class="ebadge-logo print-bg" />
            {% endif %}

            <div class="ebadge-content">
                <div class="company-participant ft-bold">
                    {{ userBadgeByEventView.sheetTitle }}
                </div>

                {% if userBadgeByEventView.qrCodeIdentifier %}
                    <div class="ebadge-qrcode">
                        <div class="ebadge-qrcode-border">
                            <img src="{{ userBadgeByEventView.qrCodeImage }}" /><br>
                            <div class="ebadge-qrcode-token">ID {{ userBadgeByEventView.qrCodeIdentifier }}</div>
                        </div>
                    </div>
                {% endif %}

                <div class="info-participant">
                    <div>{{ userBadgeByEventView.firstName }}
                        <span class="last-name-participant">{{ userBadgeByEventView.lastName }}</span>
                    </div>

                    <div class="ft-bold highlight position-participant">
                        {{ userBadgeByEventView.position }}
                        {% if userBadgeByEventView.country is not empty %}
                            <br/>{{ userBadgeByEventView.country|upper }}
                        {% endif %}
                    </div>
                </div>
            </div>

            {% if userBadgeByEventView.participationTypeOrCategoryLabel %}
                <div class="ebadge-participation-type ft-bold print-bg" style="background: {{ userBadgeByEventView.footerColor }};">
                    <div class="ebadge-participation-type-content">
                        <div class="ebadge-participation-type-content-text" style="color: {{ userBadgeByEventView.footerTextColor }} !important;">
                            {{ userBadgeByEventView.participationTypeOrCategoryLabel }}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
