{% extends 'EventBundle::base.html.twig' %}

{% block title 'badge.title'|trans %}

{% block container_classes 'no-margin-mobile-container' %}

{% block stylesheets %}
    {{ parent() }}

    <style type="text/css">
        .ebadge-logo {
            width: 100%;
            background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
        }
        .ebadge-qrcode {
            border: 1px solid #e2e3e4;
            margin: 10px auto;
            padding: 10px 10px 4px 10px;
        }

        .ebadge-qrcode-token {
            margin-top: 4px;
        }

        .ebadge-content {
            text-align: center;
            padding: 4px;
        }

        .ebadge-participation-type {
            overflow: hidden;
            display: block;
            text-align: center;
            width: 100%;
            position: absolute;
        }

        @media screen and (max-width: 767px) {
            .ebadge {
                height: 100vh;
            }

            .ebadge-qrcode {
                width: 170px;
            }

            .ebadge-qrcode img {
                width: 150px;
                height: 150px;
            }

            .ebadge-content {
                margin-top: 5vh;
            }

            .ebadge-participation-type {
                bottom: 80px;
                position: fixed;
            }
        }

        @media screen and (min-width: 768px) {
            .ebadge-container {
                margin: 0 auto;
            }
            .ebadge {
                position: relative;
                margin: auto;
                width: 105mm;
                border: 1px solid black;
                height: 148mm;
            }

            .ebadge-qrcode {
                width: 45mm;
            }

            .ebadge-qrcode img {
                width: 40mm;
                height: 40mm;
            }

            .ebadge-content {
                margin-top: 7mm;
            }

            .ebadge-participation-type {
                bottom: 0;
            }
        }

        @media print {
            * {
                font-family: RobotoRegular, HelveticaNeue, Helvetica, sans-serif !important;
            }

            .ebadge {
                position: relative;
                width: 50%;
                height: 138mm;
                font-size: 24px;
            }

            .ebadge-logo {
                width: 100%;
                background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
            }

            .ebadge-qrcode {
                width: 45mm;
            }

            .ebadge-qrcode img {
                width: 40mm;
                height: 40mm;
            }

            .ebadge-content {
                margin-top: 7mm;
            }

            .ebadge-participation-type {
                bottom: 0;
            }

            .ebadge-qrcode-token {
                font-size: 12px;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="ebadge-container">
        <div class="ebadge print-bg">
            {% if userBadgeByEventView.header %}
                <img src="{{ userBadgeByEventView.header }}" class="ebadge-logo print-bg" />
            {% endif %}

            <div class="ebadge-content">
                <div class="ft-bold">
                    {{ userBadgeByEventView.sheetTitle }}
                </div>

                {% if userBadgeByEventView.qrCodeIdentifier %}
                    <div class="ebadge-qrcode">
                        <img src="{{ userBadgeByEventView.qrCodeImage }}" /><br>
                        <div class="ebadge-qrcode-token">ID {{ userBadgeByEventView.qrCodeIdentifier }}</div>
                    </div>
                {% endif %}

                <div>
                    <div>{{ userBadgeByEventView.firstName }} {{ userBadgeByEventView.lastName }}</div>

                    <div class="ft-bold highlight">
                        {{ userBadgeByEventView.position }}
                    </div>
                </div>
            </div>

            {% if userBadgeByEventView.participationTypeOrCategoryLabel %}
                <div class="ebadge-participation-type ft-bold print-bg" style="background: {{ userBadgeByEventView.footerColor }}; color: {{ userBadgeByEventView.footerTextColor }};">
                    {{ userBadgeByEventView.participationTypeOrCategoryLabel }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
