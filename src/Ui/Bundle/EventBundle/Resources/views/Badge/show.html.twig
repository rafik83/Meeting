{% extends 'EventBundle::base.html.twig' %}

{% import '@Event/Badge/macros.html.twig' as macro %}

{% block title 'badge.title'|trans %}

{% block container_classes 'no-margin-mobile-container' %}

{% block stylesheets %}
    {{ parent() }}

    <style type="text/css">
        .ebadge-image {
            width: 100%;
        }

        .ebadge-image--logo {
            background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
        }

        .ebadge-qrcode {
            top: 50mm;
            position: absolute;
            width: 100%;
        }

        .ebadge-qrcode-border {
            border: 1px solid #e2e3e4;
            margin: 10px auto;
            padding: 10px 10px 4px 10px;
        }

        .ebadge-qrcode-token {
            margin-top: 4px;
        }

        .ebadge-content {
            font-size: 20px;
            text-align: center;
            padding: 4px;
            margin: 0 auto;
        }

        .ebadge-content .company-participant {
            height: 17mm;
            overflow: hidden;
            color: #2F2F2F;
            font-size: 22px;
            margin: 10px 0 0 0;
            font-weight: 700;
            position: absolute;
            top: 32mm;
            text-align: center;
            width: 100%;
        }

        .ebadge-content .info-participant {
            max-height: 28mm;
            height: 26mm;
            margin: 0;
            position: absolute;
            top: 94mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .ebadge-content .info-participant .position-participant {
            color: #1518E7;
            font-size: 20px;
            font-weight: 700;
            max-height: 20mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .ebadge-qrcode-token {
            font-size: 12px;
        }

        .ebadge-participation-type {
            font-size: 23px;
            height: 24mm;
            text-transform: uppercase;
            position: absolute;
            bottom: 0;
            text-align: center;
            width: 100%;
        }

        .ebadge-participation-type-content {
            display: table;
            width: 100%;
            height: 100%;
        }

        .ebadge-participation-type-content-text {
            display: table-cell;
            vertical-align: middle;
        }

        @media screen {
            .quarterSection-container--upRight, .quarterSection-container--downLeft, .quarterSection-container--downRight {
                display: none;
            }
        }

        @media screen and (max-width: 767px) {
            .quarterSection {
                height: 100vh;
            }

            .ebadge-qrcode-border {
                width: 170px;
            }

            .ebadge-qrcode-border img {
                width: 150px;
                height: 150px;
            }

            .ebadge-content {
                position: relative;
            }

            .ebadge-content .company-participant {
                max-height: 17mm;
                height: auto;
                position: relative;
                top: 0;
            }

            .ebadge-qrcode {
                top: 0;
                position: relative;
                width: 100%;
            }

            .ebadge-qrcode-border {
                border: 1px solid #e2e3e4;
                margin: 10px auto;
                padding: 10px 10px 4px 10px;
            }

            .ebadge-content .info-participant {
                max-height: 28mm;
                height: auto;
                top: 0;
                position: relative;
            }

            .ebadge-participation-type {
                bottom: 80px;
                position: fixed;
                max-height: 24mm;
                min-height: 15mm;
                height: auto;
            }
        }

        @media screen and (min-width: 768px) {
            .quarterSection-container {
                margin: 0 auto;
            }
            .quarterSection {
                position: relative;
                margin: auto;
                width: 105mm;
                height: 148mm;
            }

            .ebadge {
                border: 1px solid black;
            }

            .ebadge-qrcode-border {
                width: 35mm;
            }

            .ebadge-qrcode .ebadge-qrcode-border img {
                width: 30mm;
                height: 30mm;
            }

            .ebadge-content {
                margin-top: 7mm;
            }

            .ebadge-participation-type {
                bottom: 0;
            }
        }

        @media print {
            * {
                font-family: RobotoRegular, HelveticaNeue, Helvetica, sans-serif !important;
            }

            .printZone-fix {
                width: 210mm;
                height: 297mm;
                position: absolute;
            }

            .container-fluid {
                padding: 0;
                margin: 0;
            }

            .quarterSection-container {
                page-break-after: always;
                clear: both;
                width: 105mm;
                height: 148mm;
            }

            .halfXSection-container {
                page-break-after: always;
                clear: both;
                width: 105mm;
                height: 297mm;
            }

            .quarterSection {
                position: relative;
                width: 98mm;
                height: 141mm;
                margin: 0;
            }

            .halfXSection {
                position: relative;
                width: 98mm;
                height: 297mm;
                margin: 0;
            }

            .quarterSection-container--upRight {
                position: absolute;
                left: 105mm;
                top: 0;
            }

            .quarterSection-container--upRight .quarterSection {
                margin-left: 7mm;
            }

            .quarterSection-container--downLeft {
                position: absolute;
                top: 148mm;
            }

            .quarterSection-container--downLeft .quarterSection {
                margin-top: 7mm;
            }

            .quarterSection-container--downRight {
                position: absolute;
                left: 105mm;
                top: 148mm;
            }

            .quarterSection-container--downRight .quarterSection {
                margin-top: 7mm;
                margin-left: 7mm;
            }

            .halfXSection-container--right {
                position: absolute;
                left: 105mm;
                top: 0;
            }

            .halfXSection-container--right .halfXSection {
                margin-left: 7mm;
            }

            .ebadge {
                font-size: 20px;
            }

            .ebadge-image {
                max-height: 100%;
                max-width: 100%;
                width: auto;
                margin: 0 auto;
                text-align: center;
                display: block;
                height: auto;
            }

            .ebadge-image--logo {
                max-height: 44mm;
                background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
            }

            .ebadge-qrcode-border {
                width: 35mm;
            }

            .ebadge-qrcode .ebadge-qrcode-border img {
                width: 30mm;
                height: 30mm;
            }

            .ebadge-content {
                margin-top: 7mm;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="printZone-fix"></div>
    {{ macro.write_badge(userBadgeByEventView, 'left') }}
    {% if userBadgeByEventView.isMirrored %}
        {{ macro.write_badge(userBadgeByEventView, 'right') }}
    {% endif %}
    {% if userBadgeByEventView.leftImage %}
        {{ macro.write_image(userBadgeByEventView.leftImage, 'left') }}
    {% endif %}
    {% if userBadgeByEventView.rightImage %}
        {{ macro.write_image(userBadgeByEventView.rightImage, 'right', userBadgeByEventView.isRightImageFullHeight) }}
    {% endif %}
    {% if launchPrint ?? false %}
    <script>
      window.print();
    </script>
    {% endif %}
{% endblock %}
