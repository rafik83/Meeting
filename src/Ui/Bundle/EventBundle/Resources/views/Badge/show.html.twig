{% extends 'EventBundle::base.html.twig' %}

{% import '@Event/Badge/macros.html.twig' as macro %}

{% block title 'badge.title'|trans %}

{% block container_classes 'no-margin-mobile-container' %}

{% block stylesheets %}
    {{ parent() }}

    <style type="text/css">
        .badge-image {
            width: 100%;
        }

        .badge-image--logo {
            background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
        }

        .ebadge-qrcode {
            top: 50mm;
            position: absolute;
            width: 100%;
        }

        .ebadge-qrcode-border {
            border: 1px solid #e2e3e4;
            margin: 10px auto;
            padding: 10px 10px 4px 10px;
        }

        .ebadge-qrcode-token {
            margin-top: 4px;
        }

        .badge-content {
            font-size: 20px;
            text-align: center;
            padding: 4px;
            margin: 0 auto;
        }

        .badge-content .company-participant {
            height: 17mm;
            overflow: hidden;
            color: #2F2F2F;
            font-size: 22px;
            margin: 10px 0 0 0;
            font-weight: 700;
            position: absolute;
            top: 32mm;
            text-align: center;
            width: 100%;
        }

        .badge-content .info-participant {
            max-height: 28mm;
            height: 26mm;
            margin: 0;
            position: absolute;
            top: 94mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .badge-content .info-participant .position-participant {
            color: #1518E7;
            font-size: 20px;
            font-weight: 700;
            max-height: 20mm;
            overflow: hidden;
            text-align: center;
            width: 100%;
        }

        .ebadge-qrcode-token {
            font-size: 12px;
        }

        .badge-participationType {
            font-size: 23px;
            height: 24mm;
            text-transform: uppercase;
            position: absolute;
            bottom: 0;
            text-align: center;
            width: 100%;
        }

        .badge-participationType-content {
            display: table;
            width: 100%;
            height: 100%;
        }

        .badge-participationType-content-text {
            display: table-cell;
            vertical-align: middle;
        }

        @media screen {
            .quarterSection-container--upRight, .quarterSection-container--downLeft,
            .quarterSection-container--downRight, .halfXSection-container--right {
                display: none;
            }
        }

        @media screen and (max-width: 767px) {
            .quarterSection {
                height: 100vh;
            }

            .ebadge-qrcode-border {
                width: 170px;
            }

            .ebadge-qrcode-border img {
                width: 150px;
                height: 150px;
            }

            .badge-content {
                position: relative;
            }

            .badge-content .company-participant {
                max-height: 17mm;
                height: auto;
                position: relative;
                top: 0;
            }

            .ebadge-qrcode {
                top: 0;
                position: relative;
                width: 100%;
            }

            .ebadge-qrcode-border {
                border: 1px solid #e2e3e4;
                margin: 10px auto;
                padding: 10px 10px 4px 10px;
            }

            .badge-content .info-participant {
                max-height: 28mm;
                height: auto;
                top: 0;
                position: relative;
            }

            .badge-participationType {
                bottom: 80px;
                position: fixed;
                max-height: 24mm;
                min-height: 15mm;
                height: auto;
            }
        }

        @media screen and (min-width: 768px) {
            .quarterSection-container {
                margin: 0 auto;
            }
            .quarterSection {
                position: relative;
                margin: auto;
                width: 105mm;
                height: 148mm;
            }

            .ebadge {
                border: 1px solid black;
            }

            .ebadge-qrcode-border {
                width: 35mm;
            }

            .ebadge-qrcode .ebadge-qrcode-border img {
                width: 30mm;
                height: 30mm;
            }

            .badge-content {
                margin-top: 7mm;
            }

            .badge-participationType {
                bottom: 0;
            }
        }

        @media print {
            * {
                font-family: RobotoRegular, HelveticaNeue, Helvetica, sans-serif !important;
            }

            .container-fluid {
                padding: 0;
                margin: 0;
            }

            {% include '@Admin/User/Event/Badge/commonRules.css' %}

            .quarterSection-container {
                page-break-after: always;
            }

            .badge-image {
                height: auto;
                width: auto;
            }

            .badge-image--logo {
                background: linear-gradient(to right, {{ event.configuration.headerLeftColor }} 0%, {{ event.configuration.headerRightColor }} 100%);
            }

            .ebadge {
                font-size: 20px;
            }

            .ebadge-qrcode-border {
                width: 35mm;
            }

            .ebadge-qrcode .ebadge-qrcode-border img {
                width: 30mm;
                height: 30mm;
            }

            .badge-content {
                margin-top: 7mm;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="printZone-fix"></div>
    {{ macro.write_badge(userBadgeByEventView, 'left') }}
    {% if userBadgeByEventView.isMirrored %}
        {{ macro.write_badge(userBadgeByEventView, 'right') }}
    {% endif %}
    {% if userBadgeByEventView.leftImage %}
        {{ macro.write_image(userBadgeByEventView.leftImage, 'left') }}
    {% endif %}
    {% if userBadgeByEventView.rightImage %}
        {{ macro.write_image(userBadgeByEventView.rightImage, 'right', userBadgeByEventView.isRightImageFullHeight) }}
    {% endif %}
    {% if launchPrint ?? false %}
    <script>
        window.onload = function() {
            window.print();
        }
    </script>
    {% endif %}
{% endblock %}
