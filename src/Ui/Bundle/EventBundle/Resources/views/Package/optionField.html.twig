{% if template['type'] == 'radio' %}
    {% include 'EventBundle:Package:choiceField.html.twig' with {
    'fields': fields|first.children,
    'choicesTemplate': template['choices']
    } %}
{% else %}
    <tr>
        <td>
            {{ form_widget(fields|first) }}
            {{ form_errors(field) }}
        </td>
        <td>
            {{ form_label(fields|first) }}
        </td>
        <td>
            {{ template['description'][app.request.locale]|nl2br }}
        </td>
        <td class="text-right">
            {{ template['unitPrice']|number_format_currency('EUR') }}
        </td>
        <td class="text-right">
            {% if template['quantity'] is defined and template['quantity']['min'] != template['quantity']['max'] %}
                {{ form_widget(fields|last) }}
            {% elseif template['quantity'] is defined and template['quantity']['min'] == template['quantity']['max'] %}
                {{ template['quantity']['min'] }}
            {% else %}
                1
            {% endif %}
        </td>
    </tr>
{% endif %}
