{% if app.session.flashbag.get('package_promotion_code_error')|length %}
    <section class="important fail text-danger">
        {% for promotion_code_error in app.session.flashbag.get('package_promotion_code_error') %}
            <p>{{ promotion_code_error|trans({}, 'flashes') }}</p>
        {% endfor %}
    </section>
{% endif %}
