{% extends 'EventBundle::base.html.twig' %}

{% block title %}{{ 'package.title'|trans }}: {{ view.currentStep.title }}{% endblock %}

{% block content %}
<section class="main">

    {% if tipTranslationViews is defined %}
        {{ include('EventBundle:Tip:tip.html.twig', {tipTranslationViews: tipTranslationViews}) }}
    {% endif %}

    {{ include('EventBundle:Package:breadcrumb.html.twig', {view: view}) }}

    <div class="main__container">
        <div class="product">
            <div class="step-number-title"> {{ view.currentStep.index }} </div>

            {{ include('EventBundle:Package/Step:' ~ view.currentStep.type ~ '.html.twig', {
                view: view,
                form: form,
                form_add: form_add,
                form_remove: form_remove,
                displayAddParticipantForm: displayAddParticipantForm,
                displayRemoveParticipantForm: displayRemoveParticipantForm,
                participants: participants
            }) }}
        </div>
    </div>
</section>
{% endblock %}
