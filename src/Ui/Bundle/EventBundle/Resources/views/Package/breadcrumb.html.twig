<header class="header-product">
    <h1>
        <i class="icon-Panier_2"></i>
        {{ 'package.title'|trans }}
    </h1>
    {% set remainingStep = 0 %}

    <ul class="tunnel-step">
        {% for step in view.funnel.steps %}
            <li class="li {% if step.completed %}complete{% endif %} {% if view.currentStep is defined and step == view.currentStep %}current{% endif %}">
                {% if step.completed %}
                    <a href="{{ path('event_package_step', {'sheet': view.funnel.sheet.id, 'step': step.index}) }}">
                {% endif %}
                    <div class="number-step">{{ step.index }}</div>
                    <div class="name-step">
                        <p>{{ step.title }}</p>
                    </div>
                {% if step.completed %}</a>{% endif %}
            </li>
            {% set remainingStep = step.index %}
        {% endfor %}

        <li class="li
        {% if app.request.attributes.get('_route') == 'event_package_summary' %}current{% endif %}
        {% if app.request.attributes.get('_route') == 'event_package_payment' %}complete{% endif %}
        " >
            {% if view.funnel.isCompleted %}
                <a href="{{ path('event_package_summary', {'sheet': view.funnel.sheet.id}) }}">
            {% endif %}
            <div class="number-step">{{ remainingStep + 1 }}</div>
            <div class="name-step">
                <p>{{ 'package.funnel.summary'|trans }}</p>
            </div>
            {% if view.funnel.isCompleted %}
                </a>
            {% endif %}
        </li>

        <li class="li {% if app.request.attributes.get('_route') == 'event_package_payment' %}current{% endif %}">
            <div class="number-step">{{ remainingStep + 2 }}</div>
            <div class="name-step">
                <p>{{ 'package.funnel.payment'|trans }}</p>
            </div>
        </li>
    </ul>
</header>
