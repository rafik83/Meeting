{% if null != participantGroup %}
    <tr class="title">
        <td class="col-md-6">
            <h3>{{ participantGroup.label }}</h3>
        </td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
    </tr>

    {% set stripped = true %}

    {% for product in participantGroup.options %}
        {% if null != product %}
            {{ include('EventBundle:Package/Summary:product.html.twig', {product: product, stripped: stripped}) }}
            {% if product.included is empty %}
                {% set stripped = not stripped %}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endif %}
