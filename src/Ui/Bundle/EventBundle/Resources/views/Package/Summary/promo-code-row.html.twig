{% if null != promotionCodeView %}
    <tr {% if stripped is defined and stripped %}class="even"{% endif %}>
        <td class="col-md-6">
            <strong>{{ promotionCodeView.title }}</strong>
            {{ promotionCodeView.description }}
        </td>
        <td class="col-md-2">
            <div class="product">
                <span class="product-price text-center">
                    {{ 'package.product.unitPrice'|trans({
                        '%price%': promotionCodeView.total,
                        '%currency%': promotionCodeView.currency|currency_symbol,
                        '%vatMode%': ('package.vatMode.' ~ promotionCodeView.vatMode)|trans
                    })|html }}
                </span>
            </div>
        </td>
        <td class="col-md-2">
            <p class="text-center">{{ promotionCodeView.quantity }}</p>
        </td>
        <td class="col-md-2">
            <div class="product">
                <span class="product-price text-center">
                    {{ 'package.product.unitPrice'|trans({
                        '%price%': promotionCodeView.total,
                        '%currency%': promotionCodeView.currency|currency_symbol,
                        '%vatMode%': ('package.vatMode.' ~ promotionCodeView.vatMode)|trans
                    })|html }}
                </span>
            </div>
        </td>
    </tr>
{% endif %}
