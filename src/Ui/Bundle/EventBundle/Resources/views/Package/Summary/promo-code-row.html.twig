{% if null != promotionCodeView %}
    {% import 'EventBundle::macro.html.twig' as macros %}

    <tr {% if stripped is defined and stripped %}class="even"{% endif %}>
        <td class="col-md-6">
            <div class="col-md-10">
                <strong>{{ promotionCodeView.title }}</strong>
                {{ promotionCodeView.description|nl2br }}
            </div>
            <div class="col-md-2 text-right">
                {{ macros.delete_button(
                path('event_package_remove_promotion_code', { 'sheet': sheet.id, 'promotion': promotionCodeView.id }),
                '<span class="glyphicon glyphicon-remove" style="margin: 0;" aria-hidden="true"></span>',
                { 'class': 'btn btn-xs btn-danger' }
                ) }}
            </div>
        </td>
        <td class="col-md-2">
            <div class="product">
                <span class="product-price text-center">
                    {{ 'package.product.unitPrice'|trans({
                        '%price%': promotionCodeView.total|localizednumber,
                        '%currency%': promotionCodeView.currency|currency_symbol,
                        '%vatMode%': ('package.vatMode.' ~ promotionCodeView.vatMode)|trans
                    })|html }}
                </span>
            </div>
        </td>
        <td class="col-md-2">
            <p class="text-center">{{ promotionCodeView.quantity }}</p>
        </td>
        <td class="col-md-2">
            <div class="product">
                <span class="product-price text-center">
                    {{ 'package.product.unitPrice'|trans({
                        '%price%': promotionCodeView.total|localizednumber,
                        '%currency%': promotionCodeView.currency|currency_symbol,
                        '%vatMode%': ('package.vatMode.' ~ promotionCodeView.vatMode)|trans
                    })|html }}
                </span>
            </div>
        </td>
    </tr>
{% endif %}
