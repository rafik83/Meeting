{% form_theme form '@Ui/default.html.twig' %}

<tr class="title" id="summary-promo-code-row">
    <td class="col-md-6">
        <h3>{{ 'package.summary.promotion.label'|trans }}</h3>
        {{ form_start(form, {'attr': {'class': 'form-inline'}}) }}
        {{ form_row(form.promotionCode) }}

        <button type="submit" class="btn btn-gray">
            <i class="icon-Valider_3"></i>{{ 'package.summary.promotion.button.label'|trans }}
        </button>
        {{ form_end(form) }}
    </td>
    <td class="col-md-2"></td>
    <td class="col-md-2"></td>
    <td class="col-md-2"></td>
</tr>
