{% if null != participantGroup %}
    {% set participant = participantGroup.options|first %}
    <tr class="title">
        <td class="col-md-6">
            <h3>{{ participantGroup.label }}</h3>
        </td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
    </tr>
    {% set stripped = true %}
    {{ include('EventBundle:Package/Summary:product.html.twig', {product: participant, stripped: stripped}) }}
{% endif %}
