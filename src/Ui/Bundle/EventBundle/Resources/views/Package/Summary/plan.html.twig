{% if null != planGroup %}
    {% set plan = planGroup.options|first %}
    <tr class="title">
        <td class="col-md-6">
            <h3>{{ planGroup.label }}</h3>
        </td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
    </tr>
    {% set stripped = true %}
    {{ include('EventBundle:Package/Summary:product.html.twig', {product: plan, stripped: stripped}) }}
{% endif %}
