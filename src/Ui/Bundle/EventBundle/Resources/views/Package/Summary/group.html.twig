{% if null != group and group.options is not empty %}
    {% set stripped = true %}
    <tr class="title">
        <td class="col-md-6">
            <h3>{{ 'package.summary.option'|trans }}</h3>
            <p class="category-option pull-left">{{ group.label }}</p>
        </td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
    </tr>
    {% for product in group.options %}
        {% if null != product %}
            {{ include('EventBundle:Package/Summary:product.html.twig', {product: product, stripped: stripped}) }}
            {% if product.included is empty %}
                {% set stripped = not stripped %}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endif %}
