{% form_theme form '@Ui/default.html.twig' %}

<div class="content-header">
    <h2>{{ 'package.select'|trans }} {{ view.currentStep.title }}</h2>
</div>

<section class="section product">
    <div class="object object--collection style--style-1"></div>
    {{ form_start(form, {'attr': {'class': 'form--table--head', 'data-product-selector': true }}) }}
        {% if not form.vars.valid %}
            <div class="message-error text-danger">
                {{ 'package.funnel.error'|trans }}
            </div>
        {% endif %}

        {{ form_errors(form) }}
        {{ form_errors(form.plan) }}
        <table class="table table-striped form-group">
            <tbody>

            {% for plan in view.products.plans %}
                <tr>
                    <td class="col-md-3">
                        <div class="row">
                            <div class="col-sm-1">
                                {% if not plan.isOutOfStock %}
                                    {{ form_widget(form.plan[plan.id]) }}
                                {% endif %}
                            </div>
                            <div class="col-sm-10 product">
                                <h2>{{ plan.title }}</h2>
                                <span class="product-price">{{ plan.price }} <sup>{{ plan.currency|currency_symbol(app.request.locale) }} {{ ('package.vatMode.' ~ plan.vatMode)|trans }}</sup></span>
                                {% if plan.addon %}
                                    <p class="product-addon">{{ plan.addon }}</p>
                                {% endif %}

                                {% if plan.isOutOfStock %}
                                    <h3 class="product-limite">{{ 'package.product.outOfStock'|trans }}</h3>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="col-md-5">
                        <h3>{{ plan.heading }}</h3>
                        <p>
                            {{ plan.description }}
                            {% if plan.image %}
                                <img src="{{ plan.image }}" class="img-responsive"/>
                            {% endif %}
                        </p>
                        <button type="submit" class="btn btn-primary pull-right hidden-unselected"><i class="icon-Valider_3"></i>{{ 'package.plans.validate'|trans }}</button>
                    </td>
                    <td>
                        {% for feature in plan.features %}
                            {% if loop.index == 4 %}
                                <a href="#" class="hidden-selected"><i class="icon-Note_1"></i> {{ 'package.plans.seeMore'|trans }}</a>
                            {% endif %}
                            <dl {% if loop.index > 3 %}class="hidden-unselected"{% endif %}>
                                <dt>{{ feature.title }}</dt>
                                <dd>{{ feature.description }}</dd>
                            </dl>
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {{ form_end(form) }}
</section>
