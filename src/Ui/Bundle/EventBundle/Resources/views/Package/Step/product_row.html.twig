<tr class="row-quantity {{ product.numberIncluded > 0 or quantityForm.vars.value > 0 ? 'selected-line' : '' }}">
    <td class="col-md-2">
        <div class="product">
            <span class="product-price">
                {{ product.price }}
                <sup>€ {{ ('package.vatMode.' ~ product.vatMode)|trans }}</sup>
            </span>
        </div>
    </td>
    <td class="col-md-6">
        <h3>{{ product.title }}</h3>
        <p>{{ product.description }}</p>
    </td>
    <td class="col-md-2">
        {% if product.numberIncluded %}
            <h2 class="text-center">{{ product.numberIncluded }}</h2>
            <hr>
        {% endif %}

        {{ form_widget(quantityForm, {attr: {
            'class': 'qty',
            'data-selected-line-class': 'selected-line',
            'data-unit-price': product.price,
            'data-included': product.numberIncluded
        }}) }}

        <div class="message-error text-danger text-center">
            {{ form_errors(quantityForm) }}
        </div>
    </td>
    <td class="col-md-2">
        <div class="product">
            {% if product.numberIncluded %}
                <h2 class="text-center">{{ 'package.options.included'|trans }}</h2>
                <hr>
            {% endif %}

            <span class="product-price text-center">
                <span class="product-total-price">{{ quantityForm.vars.value * product.price }}</span>
                <sup>€ {{ ('package.vatMode.' ~ product.vatMode)|trans }}</sup>
            </span>
        </div>
    </td>
</tr>
