{% form_theme form '@Ui/default.html.twig' %}

{% set quantity = quantityForm.quantity is defined
    ? quantityForm.quantity.vars.value
    : quantityForm.participants is defined ? max(0, quantityForm.participants.vars.value|length - product.included) : 0
%}

<tr
    class="{{ product.isOutOfStock or not product.isBuyable ? '': 'row-quantity' }} {{ product.included > 0 or quantityForm is not null and quantity > 0 ? 'selected-line' : '' }}"
    data-selected-line-class="selected-line"
    data-unit-price="{{ product.unitPrice }}"
    data-included="{{ product.included }}"
>
    <td class="col-md-2">
        <div class="product">
            <span class="product-price">
                {{ 'package.product.unitPrice'|trans({
                    '%price%': product.unitPrice,
                    '%currency%': product.currency|currency_symbol,
                    '%vatMode%': ('package.vatMode.' ~ product.vatMode)|trans
                })|html }}
            </span>
            <p class="product-addon">{{ product.addon }}</p>
            {% if product.availabilityMax %}
                <span class="product-limite">
                    {{ 'package.product.available'|trans }}<br>
                    {{ 'package.product.availability'|trans({
                        '%availabilityCurrent%': product.availabilityCurrent,
                        '%availabilityMax%': product.availabilityMax
                    }) }}
                </span>
            {% endif %}
        </div>
    </td>
    <td class="col-md-6">
        <h3>{{ product.title }}</h3>
        <p>{{ product.description }}</p>

        {% if product.image %}
            <img src="{{ asset(product.image) }}" class="img-responsive">
        {% endif %}

        {% if product.isSubjectedToValidation %}
            <p>
                <span class="icon-Info_1"></span>
                <i>
                    {{ product.subjectedToValidationHelp|default('package.product.subjectedToValidationHelp'|trans) }}
                </i>
            </p>
        {% endif %}

        {% if product.participantsCompleteNameWithAttributedProduct is not empty %}
            <label>{{ 'package.product.selectedParticipants'|trans }}</label>
            <select class="select2 col-md-12" data-disallow-clear="true" multiple disabled>
                {% for participantsCompleteName in product.participantsCompleteNameWithAttributedProduct %}
                    <option selected>{{ participantsCompleteName }}</option>
                {% endfor %}
            </select>
        {% endif %}

        {% if quantityForm.participants is defined %}
            {{ form_row(
                quantityForm.participants,
                {
                    attr: {
                        'data-select-participants': '',
                        'data-placeholder': 'form.options.selectParticipants.placeholder'|trans({}, 'forms')
                    }
                }
            ) }}
        {% endif %}
    </td>
    <td class="col-md-2">
        {% if product.included %}
            <h2 class="text-center">{{ product.included }}</h2>
            <hr>
        {% endif %}

        {% if product.isOutOfStock %}
            <h3 class="out-of-stock text-center">{{ 'package.product.outOfStock'|trans }}</h3>
        {% elseif not product.isBuyable %}
            <h3 class="out-of-stock text-center">{{ 'package.product.unavailable'|trans }}</h3>
        {% elseif quantityForm is defined and quantityForm != null %}
            {% if quantityForm.quantity is defined %}
                {{ form_widget(quantityForm.quantity) }}

                {% if not quantityForm.quantity.vars.valid %}
                    <div class="message-error text-danger text-center">
                        {{ form_errors(quantityForm.quantity) }}
                    </div>
                {% endif %}
            {% else %}
                <h2 class="text-center highlight" data-quantity-text>{{ quantity }}</h2>
            {% endif %}

            <div class="message-error text-danger text-center">
                {{ form_errors(quantityForm) }}
            </div>
        {% endif %}
    </td>
    <td class="col-md-2">
        <div class="product">
            {% if product.included %}
                <h2 class="text-center">{{ 'package.options.included'|trans }}</h2>
                <hr>
            {% endif %}

            <span class="product-price text-center">
                {% if quantityForm is not null %}
                    {{ 'package.product.totalPrice'|trans({
                        '%price%': quantity * product.unitPrice,
                        '%currency%': product.currency|currency_symbol,
                        '%vatMode%': ('package.vatMode.' ~ product.vatMode)|trans
                    })|html }}
                {% endif %}
            </span>
        </div>
    </td>
</tr>
