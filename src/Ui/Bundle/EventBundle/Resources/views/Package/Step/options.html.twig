{% form_theme form '@Ui/default.html.twig' %}

{{ form_start(form, {attr: {class: 'form--table--head'}}) }}
    {% if not form.vars.valid %}
        <div class="message-error text-danger">
            {{ 'package.funnel.error'|trans }}
        </div>
    {% endif %}

    {{ form_errors(form) }}

    {% for groupKey, group in view.products.groups %}
        {% set displaySeeMore = not loop.first and form.vars.valid %}

        <div {% if displaySeeMore %}data-toggle-visibility data-toggle-visibility-display-type="inline"{% endif %}>
            <div class="content-header clearfix">
                <h2 class="pull-left">
                    {{ group.label }}

                    {% if displaySeeMore %}
                        <a href="#" class="btn btn-primary" data-toggle-visibility-hide style="display: none;">{{ 'package.product.seeLess'|trans }}</a>
                    {% endif %}
                </h2>
            </div>

            <section class="section">
                <div class="object object--collection style--style-1"></div>

                {% if displaySeeMore %}
                    <p class="text-center">
                        <a href="#" class="btn btn-primary" data-toggle-visibility-show>
                            {{ 'package.product.seeMore'|transchoice(group.options|length, {'%count%': group.options|length}) }}
                        </a>
                    </p>
                {% endif %}

                <table class="table table-striped" {% if displaySeeMore %}style="display: none;" data-toggle-visibility-element-to-open{% endif %}>
                    <thead>
                        <tr>
                            <th>{{ 'package.product.unitPriceLabel'|trans }}</th>
                            <th>{{ 'package.product.label'|trans }}</th>
                            <th class="text-center">{{ 'package.product.quantity'|trans }}</th>
                            <th class="text-center">{{ 'package.product.total'|trans }}</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for option in group.options %}
                            {{ include('EventBundle:Package/Step:product_row.html.twig', {
                                product: option,
                                quantityForm: form.children[option.id] is defined ? form.children[option.id] : null
                            }) }}
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary pull-right"><i class="icon-Valider_3"></i>{{ 'package.product.validate'|trans }}</button>
        </div>
    </div>
{{ form_end(form) }}
