<form class="form--table--head">
    {% for group in view.products.groups %}
        <div class="content-header clearfix">
            <h2 class="pull-left">Sélectionner vos options</h2>
            <p class="category-option pull-left">{{ group.label }}</p>
        </div>

        <section class="object object--collection style--style-1 section">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Prix unitaire</th>
                        <th>Intitulé & description</th>
                        <th class="text-center">Quantité</th>
                        <th class="text-center">Total</th>
                    </tr>
                </thead>

                <tbody>
                    {% for option in group.options %}
                        <tr>
                            <td class="col-md-2">
                                <div class="product">
                                    <span class="product-price">{{ option.unitPrice }} <sup>{{ option.currency }} {{ ('package.vatMode.' ~ option.vatMode)|trans }}</sup></span>
                                    {% if option.availabilityMax %}
                                        <span class="product-limite">Disponible <br>{{ option.availabilityCurrent }} sur {{ option.availabilityMax }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <h3>{{ option.title }}</h3>
                                <p><strong>{{ option.heading }}</strong></p>
                                <p>{{ option.description }}</p>
                            </td>
                            <td class="col-md-2">
                                {% if option.isOutOfStock %}
                                    <h3 class="out-of-stock text-center">Epuisé</h3>
                                {% endif %}
                            </td>
                            <td class="col-md-2">
                                <div class="product">

                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary pull-right"><i class="icon-Valider_3"></i>Valider vos options</button>
        </div>
    </div>
</form>
