{% form_theme form '@Ui/default.html.twig' %}

<div class="content-header">
    <h2>{{ 'package.select'|trans }} {{ view.currentStep.title }}</h2>
</div>

{{ form_start(form) }}
    {% if not form.vars.valid %}
        <div class="message-error text-danger">
            {{ 'package.funnel.error'|trans }}
        </div>
    {% endif %}

    {{ form_errors(form) }}

    {{ include('EventBundle:Package/Step:participants.html.twig') }}

    {{ include('EventBundle:Package/Step:planning.html.twig') }}

    <div class="row">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary pull-right"><i class="icon-Valider_3"></i>{{ 'package.participant_planning.validate'|trans }}</button>
        </div>
    </div>
{{ form_end(form) }}

{# Leave this outside the previous form #}
