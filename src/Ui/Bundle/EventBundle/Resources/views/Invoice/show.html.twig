<html>
<head>
    <title>{{ invoiceView.invoiceNumber }}</title>
    <link rel="stylesheet" href="{{ asset('assets/css/mainStyle.css') }}">
    <script type="text/javascript">
        var PhantomJSPrinting = {
            header: {
                height: "3.5cm",
                contents: function(pageNum, numPages) { return '{{ include('EventBundle:Invoice/Partial:header.html.twig', {invoiceView: invoiceView})|escape('js') }}'; }
            },
            footer: {
                height: "2cm",
                contents: function(pageNum, numPages) { return '{{ include('EventBundle:Invoice/Partial:footer.html.twig', {invoiceView: invoiceView})|escape('js') }}'; }
            }
        };
    </script>
</head>
<body>
    {#
        Due to this issue https://github.com/ariya/phantomjs/issues/12887,
        we need to render the image in the body content in order to be rendered in header.
    #}
    <img src="{{ asset(invoiceView.invoiceLogo) }}" style="display: none" />

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-offset-6 col-md-6">
                <strong>{{ invoiceView.billingInfosView.company }}</strong><br>
                {{ ('invoice.gender.' ~ invoiceView.billingInfosView.gender)|trans({}, "invoices", invoiceView.eventDefaultLocale) }} {{ invoiceView.billingInfosView.firstname }} {{ invoiceView.billingInfosView.lastname }}<br>
                {{ invoiceView.billingInfosView.street }}<br>
                {{ invoiceView.billingInfosView.zipcode }} {{ invoiceView.billingInfosView.city }}<br>
                {{ invoiceView.billingInfosView.country|country(invoiceView.eventDefaultLocale)|upper }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <p>
                    <strong>{{ invoiceView.eventTitle }}</strong>
                    <br><strong>{{ 'invoice.number.title'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong>
                    {{ invoiceView.invoiceNumber }}

                    {% if invoiceView.billingInfosView.reference is not null %}
                        <br><strong>{{ 'invoice.reference.title'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong>
                        {{ invoiceView.billingInfosView.reference }}
                    {% endif %}

                    <br><strong>{{ 'invoice.date.title'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong>
                    {{ invoiceView.createdAt|localizeddate('medium', 'none', invoiceView.eventDefaultLocale, invoiceView.eventTimeZone) }}
                </p>
            </div>
        </div>

        {{ include('EventBundle:Invoice/Partial:summary.html.twig', { invoiceView: invoiceView }) }}

        {% if invoiceView.billingInfosView.vatNumber %}
            <p>
                <strong>{{ 'invoice.vatNumber.title'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong>
                {{ invoiceView.billingInfosView.vatNumber }}
            </p>
        {% endif %}

        <div class="row">
            <div class="col-md-6">
                <p>
                    {{ invoiceView.eventBillingAddress|nl2br }}
                </p>
                <p>
                    <strong>{{ 'invoice.bankInfo.title'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong><br>
                    {{ invoiceView.eventBankInfo|nl2br }}
                </p>
            </div>
            <div class="col-md-6">
                <p>
                    {{ invoiceView.eventPaymentCondition|nl2br }}
                </p>
            </div>
        </div>
    </div>
</body>
</html>
