{% if invoiceView.summaryView is defined %}
    <table class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                <th class="col-md-6">{{ 'invoice.summary.column.title'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</th>
                <th class="text-center col-md-2">{{ 'invoice.summary.column.unitPrice'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</th>
                <th class="text-center col-md-2">{{ 'invoice.summary.column.quantity'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</th>
                <th class="text-center col-md-2">{{ 'invoice.summary.column.total'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</th>
            </tr>
        </thead>
        <tbody>

        {{ include('EventBundle:Invoice/Partial:groups.html.twig', {invoiceView: invoiceView}) }}
        {{ include('EventBundle:Invoice/Partial:promotion_codes.html.twig', {invoiceView: invoiceView}) }}

            <tr>
                <td colspan="3" class="text-right"><strong>{{ ('invoice.summary.' ~ (invoiceView.vatApplicable ? 'totalExcludeTaxes' : 'totalIncludeTaxes'))|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong></td>
                <td class="text-right">{{ invoiceView.total|format_amount|localizedcurrency(invoiceView.currency, invoiceView.eventDefaultLocale) }}</td>
            </tr>

        {% if invoiceView.vatApplicable %}
            {% if invoiceView.vatListView is not null %}
                {% for vatView in invoiceView.vatListView.vatViews %}
                    <tr>
                        <td colspan="3" class="text-right"><strong>{{ 'invoice.summary.totalByVat'|trans({'%vatRate%': vatView.vatRate}, 'invoices', invoiceView.eventDefaultLocale) }}</strong></td>
                        <td class="text-right">{{ vatView.total|format_amount|localizedcurrency(invoiceView.currency, invoiceView.eventDefaultLocale) }} {{ ('package.vatMode.' ~ vatView.vatMode)|trans }}</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-right"><strong>{{ 'invoice.summary.vatRate'|trans({'%vatRate%': vatView.vatRate}, 'invoices', invoiceView.eventDefaultLocale) }}</strong></td>
                        <td class="text-right">{{ vatView.totalVat|format_amount|localizedcurrency(invoiceView.currency, invoiceView.eventDefaultLocale) }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="3" class="text-right"><strong>{{ 'invoice.summary.vatRate'|trans({'%vatRate%': invoiceView.vatRate}, "invoices", invoiceView.eventDefaultLocale) }}</strong></td>
                    <td class="text-right">{{ invoiceView.vatAmount|format_amount|localizedcurrency(invoiceView.currency, invoiceView.eventDefaultLocale) }}</td>
                </tr>
            {% endif %}

            <tr>
                <td colspan="3" class="text-right"><strong>{{ 'invoice.summary.totalIncludeTaxes'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong></td>
                <td class="text-right">{{ invoiceView.totalWithVat|format_amount|localizedcurrency(invoiceView.currency, invoiceView.eventDefaultLocale) }}</td>
            </tr>
        {% endif %}

        <tr>
            <td colspan="3" class="text-right"><strong>{{ 'invoice.summary.remainToPay'|trans({}, "invoices", invoiceView.eventDefaultLocale) }}</strong></td>
            <td class="text-right">{{ invoiceView.amountRemainToPay|format_amount|localizedcurrency(invoiceView.currency, invoiceView.eventDefaultLocale) }}</td>
        </tr>
        </tbody>
    </table>
{% endif %}
