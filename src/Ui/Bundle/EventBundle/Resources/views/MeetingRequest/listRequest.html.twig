{% extends 'EventBundle::base.html.twig' %}

{% block title 'event.meeting.listRequest.title'|trans %}

{% block body_attributes 'class="grey"' %}

{% block content %}
    <div class="catalog">
        
        <div class="catalog__list catalog__list--block">
            <div class="row">
                {% for meetingView in meetingRequestView.meetingRequestsView %}
                {{ include('EventBundle:MeetingRequest/Partials:sheet-card.html.twig', {'meetingRequestView': meetingView}) }}
                {% if loop.index % 3 == 0 %}</div><div class="row">{% endif %}
                {% else %}
                    <div class="col-md-12 important fail text-center">
                        {{ 'catalog.noResult'|trans }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
