{% form_theme form with ['@Ui/default.html.twig'] only %}

{% import 'EventBundle::macro.html.twig' as macros %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        <i class="icon-RDV"></i>
        {{ 'catalog.action.meeting.request.create'|trans }}
    </h4>
</div>

{{ form_start(form) }}
{{ form_errors(form) }}

<div class="modal-body">
    <div class="modal-content-request">
        {% for key, child in form if key != 'submit'%}
            {% if key == 'participants' %}
                {{ form_row(child, {'attr': { 'data-participants-checkbox': 'here', 'data-placeholder-preference': 'form.catalog_create_meeting_request.children.participants.default.no_preference'|trans({}, 'forms') }}) }}
            {% elseif key == 'fromPriority' %}
                {{ form_row(child,
                    {
                        'label' : 'form.catalog_create_meeting_request.children.fromPriority.label'|trans({}, 'forms')~' '~ 'form.catalog_create_meeting_request.children.fromPriorityRemaining.label'|transchoice(priorityNumberAvailable, {'%available%': priorityNumberAvailable, '%total%': sheet.type.priorityMeetingRequestsNumber}, 'forms'),
                        'label_attr': { 'title': priorityNumberAvailable~'form.catalog_create_meeting_request.children.tooltip.title'|trans({}, 'forms')~sheet.type.priorityMeetingRequestsNumber~' total'}
                    }
                )
                }}
            {% else %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    </div>
    <div class="validation">
        <button type="submit" class="btn btn-primary">
            <i class="icon-Valider_4"></i> {{ 'form.catalog_create_meeting_request.children.submit.label'|trans({}, 'forms') }}
        </button>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-right" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ 'catalog.action.meeting.request.back'|trans }}
    </button>
</div>
{{ form_end(form) }}

