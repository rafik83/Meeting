{% if discussion.hasMessages %}
<div class="messages">
    <div class="row">
    {% for message in discussion.messages %}
        {% if message.isLeft %}
            <div class="message col-xs-8">
                <span class="author">{{ message.sheetName|upper }}</span>
                <p>{{ message.content }}</p>
            </div>
        {% else %}
            <div class="message message--right col-xs-offset-4 col-xs-8">
                <span class="author">{{ message.sheetName|upper }}</span>
                <p>{{ message.content }}</p>
            </div>
        {% endif %}
    {% endfor %}
    </div>
</div>
{% endif %}
