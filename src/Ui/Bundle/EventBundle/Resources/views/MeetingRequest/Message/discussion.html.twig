{% if discussion.hasMessages %}
<div class="message" style="margin-bottom: 10px;">
    <div class="row">
        {% for message in discussion.messages %}
            {% if message.isLeft %}
                <div class="col-md-8">
                    <div>
                        <div class="text-center">
                            {{ message.sheetName }}
                        </div>
                        <div class="img-thumbnail">
                            {{ message.content }}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-md-offset-4 col-md-8">
                        <div>
                            <div class="text-center">
                                {{ message.sheetName }}
                            </div>
                            <div class="img-thumbnail pull-right">
                                {{ message.content }}
                            </div>
                        </div>
                    </div>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endif %}
