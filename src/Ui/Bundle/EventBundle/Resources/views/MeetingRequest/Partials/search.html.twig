{{ form_start(searchForm) }}

<div class="catalog__research">
    <div class="filter">
        <h3>{{ form_label(searchForm.state) }}</h3>
        <ul class="radio">
            {% for state in searchForm.children.state %}
                <li class="filter__item">
                    <label class="checkbox-inline">
                        <span class="filter-label">
                            {{ form_widget(state) }}
                            {{ state.vars.label|trans({}, state.vars.translation_domain) }}
                        </span>
                        <span class="details">
                            {% if stateListsView.byState(state.vars.value) is not null %}
                                {{ stateListsView.byState(state.vars.value).count }}
                            {% endif %}
                        </span>
                    </label>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>

<div class="catalog__filters">

    <div class="select-all">
    </div>

    <div class="sort">
        <div class="orderBy">
            <strong>{{ form_label(searchForm.orderBy) }}</strong>

            <div class="sort-inputs">
                {% for orderBy in searchForm.orderBy %}
                    <label class="radio-inline">
                        {{ form_widget(orderBy) }}
                        {{ orderBy.vars.label|trans({}, orderBy.vars.translation_domain) }}
                    </label>
                {% endfor %}
            </div>
        </div>

    </div>
</div>

{{ form_end(searchForm) }}
