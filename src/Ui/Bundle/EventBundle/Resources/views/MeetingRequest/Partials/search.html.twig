{{ form_start(searchForm) }}

<div class="catalog__research">
    <div class="filter">
        <h3>{{ form_label(searchForm.state) }}</h3>
        {{ form_widget(searchForm.state) }}
    </div>

</div>

<div class="catalog__filters">

    <div class="select-all">
    </div>

    <div class="sort">
        <div class="orderBy">
            <strong>{{ form_label(searchForm.orderBy) }}</strong>

            <div class="sort-inputs">
                {% for orderBy in searchForm.orderBy %}
                    <label class="radio-inline">
                        {{ form_widget(orderBy) }}
                        {{ orderBy.vars.label|trans({}, orderBy.vars.translation_domain) }}
                    </label>
                {% endfor %}
            </div>
        </div>

    </div>
</div>

{{ form_end(searchForm) }}
