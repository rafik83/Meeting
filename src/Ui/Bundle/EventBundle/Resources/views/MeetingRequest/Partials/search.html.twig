{% form_theme searchForm '@Ui/default.html.twig' %}

{{ form_start(searchForm) }}

<div class="catalog__research hidden-xs">
    {% if isEventOpen == true %}
        <div style="margin-bottom: 15px">
            <a href="{{ path('event_meeting_request_export_contact', {sheet: sheet.id}) }}" class="btn btn-primary">
                <i class="glyphicon glyphicon-download-alt"></i>
                {{ 'event.meeting.listRequest.contact.export'|trans }}
            </a>
        </div>
    {% endif %}

    {% if searchForm.availableSlot is defined %}
        <div class="filter">
            <h3>{{ form_label(searchForm.availableSlot) }}</h3>
            {{ form_errors(searchForm.availableSlot) }}
            <ul class="radio">
                {% for availableSlotChoice in searchForm.children.availableSlot %}
                    <li class="filter__item">
                        <label class="checkbox-inline">
                        <span class="filter-label">
                            {{ form_widget(availableSlotChoice) }}
                            {{ availableSlotChoice.vars.label }}
                        </span>
                        </label>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="filter">
        <h3>{{ searchForm.state.vars.label|trans({}, searchForm.vars.translation_domain) }}</h3>
        <ul class="radio">
            {% for state in searchForm.children.state %}
                <li class="filter__item">
                    <label class="checkbox-inline">
                        <span class="filter-label">
                            {{ form_widget(state) }}
                            {{ state.vars.label|trans({}, state.vars.translation_domain) }}
                        </span>
                        <span class="details">
                            {% if stateListsView.byState(state.vars.value) is not null %}
                                {{ stateListsView.byState(state.vars.value).count }}
                            {% endif %}
                        </span>
                    </label>
                </li>
            {% endfor %}
        </ul>
    </div>

    {% if searchForm.type is defined %}
        <div class="filter">
            <h3>{{ searchForm.type.vars.label|trans({}, searchForm.vars.translation_domain) }}</h3>

            <ul data-message-at-least-one-checked="{{ ('form.search.' ~ searchForm.type.vars.name  ~ '.at_least_one_checked')|trans({}, 'forms') }}">
                {% for child in searchForm.type.children %}
                    <li>
                        <label class="checkbox-inline">
                            <span class="filter-label">{{ form_widget(child) }}{{ child.vars.label|trans({}, child.vars.translation_domain) }}</span>
                        </label>
                    </li>
                {% endfor %}
            </ul>

        </div>
    {% endif %}

    {% if searchForm.category is defined %}
        <div class="filter">
            <h3>{{ searchForm.category.vars.label|trans({}, searchForm.vars.translation_domain) }}</h3>

            <ul data-message-at-least-one-checked="{{ ('form.search.' ~ searchForm.category.vars.name  ~ '.at_least_one_checked')|trans({}, 'forms') }}">
                {% for child in searchForm.category.children %}
                    <li>
                        <label class="checkbox-inline">
                            <span class="filter-label">{{ form_widget(child) }}{{ child.vars.label|trans({}, child.vars.translation_domain) }}</span>
                        </label>
                    </li>
                {% endfor %}
            </ul>

        </div>
    {% endif %}
</div>

{{ include('EventBundle:Tip:tip.html.twig', {tipTranslationViews: tipTranslationViews}) }}

{% if hasResults %}
    {% if isEventOpen == true %}
        <div class="visible-xs-block">
            <a href="{{ path('event_meeting_request_export_contact', {sheet: sheet.id}) }}" class="btn btn-primary">
                <i class="glyphicon glyphicon-download-alt"></i>
                {{ 'event.meeting.listRequest.contact.export'|trans }}
            </a>
            <br /><br />
        </div>
    {% endif %}
    <div class="catalog__filters">
        <div class="select-all">
            {% if filterRequestProposition == true %}
                <div class="btn-group" role="group" data-meeting-request-filter-type-buttons="buttons">
                    <button class="btn btn-primary" data-meeting-request-filter-by="all">
                        {{ 'event.meeting.listRequest.filter.all'|trans }}
                    </button>
                    <button class="btn btn-default" data-meeting-request-filter-by="requests">
                        {{ 'event.meeting.listRequest.filter.requests'|trans }}
                    </button>
                    <button class="btn btn-default" data-meeting-request-filter-by="propositions">
                        {{ 'event.meeting.listRequest.filter.propositions'|trans }}
                    </button>
                </div>
            {% else %}
                {{ include('@Event/MeetingRequest/Partials/switchListMode.html.twig', { 'mode': 'thumbnail' }) }}
            {% endif %}
        </div>

        <div class="sort">
            <div class="orderBy">
                <strong>{{ form_label(searchForm.orderBy) }}</strong>

                <div class="sort-inputs">
                    {% for orderBy in searchForm.orderBy %}
                        <label class="radio-inline">
                            {{ form_widget(orderBy) }}
                            {{ orderBy.vars.label|trans({}, orderBy.vars.translation_domain) }}
                        </label>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
{% else %}
    {{ form_widget(searchForm.orderBy, { attr: { class: 'hide' } }) }}
{% endif %}

{{ form_end(searchForm) }}
