<div class="col-md-4">
    <div class="catalog__item {#catalog__item--checked#}">
        <header></header>
        <div class="content">
            {{ include('EventBundle:Sheet/Card:content.html.twig', { title: meetingRequestView.sheetName, preview: meetingRequestView.previewViews }, false) }}
        </div>
        <footer>
            <div class="actions">
                <a id="complete-sheet-link-{{ meetingRequestView.sheet.id }}" href="{{ path('event_catalog_complete_sheet', {'sheet': meetingRequestView.sheet.id }) }}" target="_blank"><i class="icon-Document_1"></i> <span>{{ 'catalog.complete_sheet'|trans }}</span></a>
            </div>

            <div class="buttons-zone button">
                {% if meetingRequestView.isProposition %}
                    {% if meetingRequestView.isPending %}
                        {{ include('EventBundle:MeetingRequest/Button:approveRefuseRequestButton.html.twig', {'meetingRequest': meetingRequestView.meetingRequest, 'sheet': sheet}) }}
                    {% elseif meetingRequestView.meetingRequest.isApproved %}
                        {{ include('EventBundle:MeetingRequest/Button:approvedProposition.html.twig', {}) }}
                    {% elseif meetingRequestView.meetingRequest.isRefused %}
                        {{ include('EventBundle:MeetingRequest/Button:refusedProposition.html.twig', {'meetingRequest': meetingRequestView.meetingRequest}) }}
                    {% endif %}
                {% else %}
                    {% if meetingRequestView.isPending %}
                        {{ include('EventBundle:MeetingRequest/Button:pendingRequestButton.html.twig', {}) }}
                    {% elseif meetingRequestView.meetingRequest.isApproved %}
                        {{ include('EventBundle:MeetingRequest/Button:approvedRequest.html.twig', {}) }}
                    {% elseif meetingRequestView.meetingRequest.isRefused %}
                        {{ include('EventBundle:MeetingRequest/Button:refusedRequestButton.html.twig', {'meetingRequest': meetingRequestView.meetingRequest}) }}
                    {% endif %}
                {% endif %}
            </div>

            <p class="tags">
                <i class="icon-LienTag"></i> {{ meetingRequestView.type }}
            </p>
        </footer>
    </div>
</div>
