{% set sheetToDisplayLink = path('event_catalog_complete_sheet', { sheet: sheet.id, sheetToDisplay: meetingRequestView.sheet.id }) %}
<div class="col-md-4" data-meeting-request="{{ meetingRequestView.meetingRequest.getTypeOfRequest(sheet) }}">
    <div class="catalog__item">
        <div class="content__sheet-card">
            {{ include('EventBundle:MeetingRequest/Partials:priorityIcon.html.twig', { 'isPriority' : meetingRequestView.isPriority }, false) }}
            {% if meetingRequestView.hasMessage and meetingRequestView.meetingRequest is not null %}
                <a href="{{ path('event_catalog_meeting_request_discussion', { 'sheet': sheet.id, 'meetingRequest': meetingRequestView.meetingRequest.id }) }}" data-toggle="modal" data-target="#request-modal" class="pull-right no-underline ft-size-18 mg-left-8">
                    <i class="icon-Message_1 ft-bold"></i>
                </a>
            {% endif %}
            {% if meetingRequestView.isSeenByCurrentUser and sheetToDisplayLink is not null %}
                <a href="{{ sheetToDisplayLink }}" class="pull-right no-underline ft-size-18 mg-left-8">
                    <i class="icon-Voir_1 ft-bold"></i>
                </a>
            {% endif %}
            {{ include('EventBundle:Sheet/Card:content.html.twig', {
                title: meetingRequestView.sheetName,
                preview: meetingRequestView.previewViews,
                isCatalog: isCatalog,
                isPriority: meetingRequestView.isPriority,
                sheetToDisplayLink: sheetToDisplayLink,
                sheetToDisplayId: meetingRequestView.sheet.id
            }, false) }}
        </div>
        <footer>
            {% if sheetToDisplayLink is not null %}
                <div class="actions">
                    <a id="complete-sheet-link-{{ meetingRequestView.sheet.id }}" href="{{ sheetToDisplayLink }}" target="_blank"><i class="icon-Document_1"></i>
                        <span>{{ 'catalog.complete_sheet'|trans }}</span></a>
                </div>
            {% endif %}

            <div class="buttons-zone">
                {{ include('EventBundle:MeetingRequest:buttons.html.twig', {
                    'allowedToCreate': false,
                    'meetingRequest': meetingRequestView.meetingRequest,
                    'viewed': meetingRequestView.sheet,
                    'viewer': sheet,
                    'isMeetingPublished': meetingRequestView.isMeetingPublished,
                    'isMeetingRequestUpdateLocked': meetingRequestView.isMeetingRequestUpdateLocked|default(false),
                    'isMeetingRequestClosed': meetingRequestView.isMeetingRequestClosed,
                    'isAnsweringMeetingRequestClosed': meetingRequestView.isAnsweringMeetingRequestClosed,
                    'isPhoneValidationRequired': meetingRequestView.isPhoneValidationRequired,
                    'phoneValidationLink': meetingRequestView.validatePhoneLink,
                    'hideMeetingRequest': hideMeetingRequest|default(false)
                }) }}
            </div>

            <p class="tags">
                <i class="icon-LienTag"></i> {{ meetingRequestView.type }}
            </p>
        </footer>
    </div>
</div>
