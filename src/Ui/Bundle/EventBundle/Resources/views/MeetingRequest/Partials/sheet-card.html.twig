<div class="col-md-4" data-meeting-request="{{ meetingRequestView.meetingRequest.getTypeOfRequest(sheet) }}">
    <div class="catalog__item">
        <div class="content__sheet-card">
            {% if meetingRequestView.hasMessage and meetingRequestView.meetingRequest is not null %}
                <a href="{{ path('event_catalog_meeting_request_discussion', { 'sheet': sheet.id, 'meetingRequest': meetingRequestView.meetingRequest.id }) }}" data-toggle="modal" data-target="#request-modal" class="pull-right no-underline ft-size-18">
                    <i class="icon-Message_1"></i>
                </a>
            {% endif %}
            {{ include('EventBundle:Sheet/Card:content.html.twig', { title: meetingRequestView.sheetName, preview: meetingRequestView.previewViews, isCatalog: isCatalog }, false) }}
        </div>
        <footer>
            {% if meetingRequestView.isSheetSeeable == true %}
                <div class="actions">
                    <a id="complete-sheet-link-{{ meetingRequestView.sheet.id }}" href="{{ path('event_catalog_complete_sheet', { sheet: sheet.id, sheetToDisplay: meetingRequestView.sheet.id }) }}" target="_blank"><i class="icon-Document_1"></i> <span>{{ 'catalog.complete_sheet'|trans }}</span></a>
                </div>
            {% endif %}

            <div class="buttons-zone button">
                {{ include('EventBundle:MeetingRequest:buttons.html.twig', {
                    'allowedToCreate': false,
                    'meetingRequest': meetingRequestView.meetingRequest,
                    'viewed': meetingRequestView.sheet,
                    'viewer': sheet,
                    'isMeetingPublished': meetingRequestView.isMeetingPublished,
                    'isMeetingRequestUpdateLocked': meetingRequestView.isMeetingRequestUpdateLocked|default(false),
                    'isMeetingRequestClosed': meetingRequestView.isMeetingRequestClosed,
                    'isAnsweringMeetingRequestClosed': meetingRequestView.isAnsweringMeetingRequestClosed,
                }) }}
            </div>

            <p class="tags">
                <i class="icon-LienTag"></i> {{ meetingRequestView.type }}
            </p>
        </footer>
    </div>
</div>
