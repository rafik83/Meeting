{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title 'event.meeting.showDetailsRequest.title'|trans %}

{% block content %}

    <h2>{{ 'event.meeting.showDetailsRequest.title'|trans }}</h2>
    <table class="table table-bordered">
        <thead>
            <th>{{ 'event.meeting.showDetailsRequest.to'|trans }}</th>
            <th>{{ 'event.meeting.showDetailsRequest.from'|trans }}</th>
            <th>{{ 'event.meeting.showDetailsRequest.participants'|trans }}</th>
            <th>{{ 'event.meeting.showDetailsRequest.state'|trans }}</th>
        </thead>
        <tbody>
        <tr>
            <td>{{ meetingRequestView.toSheetName }}</td>
            <td>{{ meetingRequestView.fromSheetName }}</td>
            <td>
                {% for participantName in meetingRequestView.participantNames %}
                    {{ participantName }}
                {% endfor %}
            </td>
            <td>
                {% set state = { approved: 'success', sent: 'info', refused: 'danger', cancelled: 'warning' } %}
                <span class="btn-xs alert-{{ state[meetingRequestView.state] }}">
                    {{ ('event.meeting.request.state.to.' ~ meetingRequestView.state)|trans }}
                </span>
            </td>
        </tr>
        </tbody>
    </table>

    <p>
        {% if canEdit %}
            <a href="{{ path('event_meeting_request_edit', { 'sheet': sheet.id, 'meetingRequest': meetingRequestView.meetingRequestId }) }}" class="btn btn-xs btn-default">
                {{ 'event.meeting.listRequest.edit'|trans }}
            </a>
        {% endif %}

        {% if canCancel %}
            <a href="{{ path('event_meeting_request_cancel', { 'sheet': sheet.id, 'meetingRequest': meetingRequestView.meetingRequestId }) }}" class="btn btn-xs btn-default">
                {{ 'event.meeting.listRequest.cancel'|trans }}
            </a>
        {% endif %}

        {% if canApprove %}
            <a href="{{ path('event_meeting_request_approve', { 'sheet': sheet.id, 'meetingRequest': meetingRequestView.meetingRequestId }) }}" class="btn btn-xs btn-primary">
                {{ 'event.meeting.listProposition.accept'|trans() }}
            </a>
        {% endif %}

        {% if canRefuse %}
            <a href="{{ path('event_meeting_request_refuse', { 'sheet': sheet.id, 'meetingRequest': meetingRequestView.meetingRequestId }) }}" class="btn btn-xs btn-danger">
                {{ 'event.meeting.listProposition.refuse'|trans() }}
            </a>
        {% endif %}
    </p>

    <h3>{{ 'event.meeting.showDetailsRequest.message'|trans }}</h3>
    {% for message in meetingRequestView.messages %}
    {% if message.from.id == meetingRequestView.fromSheetId %}
        <h5>{{ meetingRequestView.fromSheetName }}</h5>
    {% else %}
        <h5>{{ meetingRequestView.toSheetName }}</h5>
    {% endif %}
        <blockquote>
            {{ message.content }}
            <br>
            <span class="label label-default">
                {{ message.createdAt|date('d/m/Y H:i') }}
            </span>
        </blockquote>
    {% endfor %}

{% endblock %}
