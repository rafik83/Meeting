{% form_theme form '@Ui/default.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        <i class="icon-RDV"></i>
        {{ 'catalog.action.meeting.request.approve'|trans }}
    </h4>
</div>

{{ form_start(form) }}
{{ form_errors(form) }}
<div class="modal-body">
    <div class="object--form--field" style="margin-top: 0;">
        {% if message is not null %}
        <div class="message" style="margin-bottom: 10px;">
            <div class="row">
                <div class="col-md-8">
                    <div>
                        <div class="text-center">
                            {{ fromName }}
                        </div>
                        <div class="img-thumbnail">
                            {{ message }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        {% for key, child in form if key != 'submit'%}
            {% if key == 'participants' %}
                {{ form_row(child, {'attr': { 'data-participants-checkbox': 'here', 'data-placeholder-preference': 'form.catalog_create_meeting_request.children.participants.default.no_preference'|trans({}, 'forms') }}) }}
            {% else %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    </div>
    <div class="validation button">
        <button type="submit" class="btn btn-primary accept">
            <i class="icon-Valider_4"></i> {{ 'form.catalog_approve_meeting_request.children.submit.label'|trans({}, 'forms') }}
        </button>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-right" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ 'catalog.action.meeting.request.back'|trans }}
    </button>
</div>
{{ form_end(form) }}
