{% form_theme form with ['@Ui/default.html.twig'] only %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
        <i class="icon-RDV"></i>
        {{ 'catalog.action.meeting.request.approve'|trans }}
    </h4>
</div>

{{ form_start(form) }}
{{ form_errors(form) }}
<div class="modal-body">
    <div class="modal-content-request">
        {{ include('EventBundle:MeetingRequest/Message:discussion.html.twig', {'discussion': discussion}) }}
        {% for key, child in form if key != 'submit'%}
            {% if key == 'participants' %}
                {{ form_row(child, {'attr': { 'data-participants-checkbox': 'here', 'data-placeholder-preference': 'form.catalog_create_meeting_request.children.participants.default.no_preference'|trans({}, 'forms') }}) }}
            {% elseif key == 'toPriority' %}
                {{ form_row(child,
                    {
                        'label' : 'form.catalog_approve_meeting_request.children.toPriority.label'|trans({}, 'forms')~' '~'('~priorityNumberAvailable~'/'~sheet.type.priorityMeetingRequestsNumber~' restante(s))',
                        'label_attr': { 'title': priorityNumberAvailable~'form.catalog_approve_meeting_request.children.tooltip.title'|trans({}, 'forms')~sheet.type.priorityMeetingRequestsNumber~' total'}
                    }
                )
                }}
            {% else %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    </div>
    <div class="validation button">
        <button type="submit" class="btn btn-primary accept">
            <i class="icon-Valider_4"></i> {{ 'form.catalog_approve_meeting_request.children.submit.label'|trans({}, 'forms') }}
        </button>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-gray pull-right" data-dismiss="modal">
        <i class="icon-Retour"></i>{{ 'catalog.action.meeting.request.back'|trans }}
    </button>
</div>
{{ form_end(form) }}
