{% set redirectPath = path('event_catalog_index', { 'sheet': sheet.id }) %}

{% if isAnsweringMeetingRequestClosed is defined and isAnsweringMeetingRequestClosed == true or isMeetingRequestUpdateLocked is defined and isMeetingRequestUpdateLocked == true %}
    {% if isMeetingRequestUpdateLocked == true %}
        {{ include('EventBundle:MeetingRequest/Button:lockedMeetingRequest.html.twig', {}, false) }}
    {% else %}
        {{ include('EventBundle:MeetingRequest/Button:closedAnsweringMeetingRequest.html.twig', {}, false) }}
    {% endif %}
    <div class="btn btn-gray reject" disabled>
        <i class="icon-Fermer_4"></i> {{ 'catalog.meeting_request.proposition.refused'|trans }}
    </div>
{% else %}
    {% if isPhoneValidationRequired and phoneValidationLink is not null %}
        <a class="btn btn-gray reject" href="{{ phoneValidationLink }}">
            <i class="icon-Fermer_4"></i> {{ 'catalog.meeting_request.proposition.refused'|trans }}
        </a>
    {% else %}
        <div class="btn btn-gray reject" data-modal-load="{{ path('event_meeting_request_show_conversation_refuse', { 'sheet': sheet.id, 'meetingRequest': meetingRequest.id }) }}">
            <i class="icon-Fermer_4"></i> {{ 'catalog.meeting_request.proposition.refused'|trans }}
        </div>
    {% endif %}
{% endif %}
