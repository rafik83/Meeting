{% set isMeetingRequestUpdateLocked = isMeetingRequestUpdateLocked|default(false) %}
{% set redirectPath = path('event_catalog_index', { 'sheet': sheet.id }) %}
{% set isPhoneValidationRequired = isPhoneValidationRequired is defined ? isPhoneValidationRequired : false %}

<div class="{% if isMeetingRequestUpdateLocked == false %}button{% endif %}">
    {% if isAnsweringMeetingRequestClosed is defined and isAnsweringMeetingRequestClosed == true or isMeetingRequestUpdateLocked is defined and isMeetingRequestUpdateLocked == true %}
        {% if isMeetingPublished is defined and isMeetingPublished and meetingRequest.hasMeeting %}
            <div class="btn btn-gray accept" disabled>
                <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.placed'|trans }}
            </div>
        {% else %}
            {% if isMeetingRequestUpdateLocked == true %}
                {{ include('EventBundle:MeetingRequest/Button:lockedMeetingRequest.html.twig', {}, false) }}
            {% endif %}
            <div class="btn btn-gray accept" disabled>
                <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.approved'|trans }}
            </div>
        {% endif %}
    {% else %}
        {% if isPhoneValidationRequired and phoneValidationLink is not null %}
            {% if isMeetingPublished is defined and isMeetingPublished and meetingRequest.hasMeeting %}
                <div class="btn btn-gray accept">
                    <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.placed'|trans }}
                </div>
            {% else %}
                <a class="btn btn-gray accept" href="{{ phoneValidationLink }}">
                    <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.approved'|trans }}
                </a>
            {% endif %}
        {% else %}
            {% if isMeetingPublished is defined and isMeetingPublished and meetingRequest.hasMeeting %}
                <div class="btn btn-gray accept">
                    <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.placed'|trans }}
                </div>
            {% else %}
                <div class="btn btn-gray accept" data-modal-load="{{ path('event_meeting_request_edit', { 'sheet': sheet.id, 'meetingRequest': meetingRequest.id }) }}">
                    <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.approved'|trans }}
                </div>
            {% endif %}
        {% endif %}
    {% endif %}
</div>
