{% set isMeetingRequestUpdateLocked = isMeetingRequestUpdateLocked|default(false) %}

{% if not isMeetingRequestUpdateLocked %}
    {% if isMeetingPublished is defined and isMeetingPublished and meetingRequest.hasMeeting  %}
        <div class="btn btn-gray accept">
            <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.placed'|trans }}
        </div>
    {% else %}
        <div class="btn btn-gray accept" data-modal-load="{{ path('event_meeting_request_edit', { 'meetingRequest': meetingRequest.id }) }}">
            <i class="icon-Valider_4"></i> {{ 'catalog.meeting_request.proposition.approved'|trans }}
        </div>
    {% endif %}
{% endif %}
