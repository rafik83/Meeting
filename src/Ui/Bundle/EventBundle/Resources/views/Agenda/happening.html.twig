<div class="happening has-details meet {{ happening.title|lower }}" data-beginHour="{{ happening.begin|date('H:i') }}" data-duration="{{ happening.duration.format('%H:%I') }}">
    {{ include('EventBundle:Happening:header.html.twig', { leftColor: happening.leftColor, rightColor: happening.rightColor, picto: happening.picto, doesCurrentUserParticipate: true}) }}
    <div class="details">
        {{ include('EventBundle:Happening:speakers.html.twig') }}
        <p>{{ happening.description }}</p>
        {{ include('EventBundle:Happening:actions.html.twig', {happening: happening, beginHour: happening.begin, endHour: happening.end}) }}
    </div>
</div>
