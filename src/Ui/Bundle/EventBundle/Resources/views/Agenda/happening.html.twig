{% set timezone = happening.timeZone %}
{% if isVisio and participant.timezone %}
    {% set timezone = participant.timezone %}
{% endif %}

<div class="happening has-details meet" data-beginHour="{{ happening.begin|date('H:i', timezone) }}" data-duration="{{ happening.duration.format('%H:%I') }}">
    {{ include('EventBundle:Happening:header.html.twig', {
        'leftColor': happening.leftColor,
        'rightColor': happening.rightColor,
        'picto': happening.picto,
        'doesCurrentUserParticipate': true,
        'isUserAloneParticipant': isUserAloneParticipant,
        'isActionButtonsOnDetails': true,
        'timezone': timezone
    }) }}
    <div class="details">
        {{ include('EventBundle:Happening:speakers.html.twig', {happening: happening}) }}
        <p>{{ happening.description|nl2br }}</p>
        {{ include('EventBundle:Happening:footer.html.twig', {
            'sheet': agenda.sheet,
            'happening': happening,
            'beginHour': happening.begin,
            'endHour': happening.end,
            'isUserAloneParticipant': isUserAloneParticipant,
            'doesCurrentUserParticipate': true,
            'isActionButtonsOnDetails': true,
            'timezone': timezone
        }) }}
    </div>
</div>
