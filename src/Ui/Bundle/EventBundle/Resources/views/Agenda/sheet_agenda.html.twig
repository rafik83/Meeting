{% extends 'EventBundle::base.html.twig' %}

{% block title 'agenda.sheetAgenda.title'|trans %}

{% block container_classes 'full-mobile-container' %}

{% block content %}
    {% set isVisio = agenda.isParticipantVisio %}

    {% if tipTranslationViews is defined %}
        {{ include('EventBundle:Tip:tip.html.twig', {tipTranslationViews: tipTranslationViews}) }}
    {% endif %}

    <div class="row mg-tp">
        <div class="col-md-6">
            {% if agenda.participants|length > 1 %}
                <div class="btn-group" role="group">
                    <a class="btn btn-primary" href="{{ path('event_agenda_sheet', { 'sheet': sheet.id }) }}">
                        {{ 'agenda.sheetAgenda.button.title'|trans }}
                    </a>
                    <div class="btn-group" role="group">
                         <a class="btn btn-gray dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {{ 'agenda.sheetAgenda.participantsAgenda.title'|trans }}
                            <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                                {% for participantItem in agenda.participants %}
                                    {% if (participant is not null and participant.id == participantItem.id) %}
                                        <li {% if participantItem.id == agenda.participant.id %} class="active" {% endif %}>
                                            <a  class="text-uppercase" href="{{ path('event_agenda_participant', {'participant': participantItem.id, 'sheet': sheet.id}) }}">
                                                {{ 'agenda.title'|trans }}
                                            </a>
                                        </li>
                                    {% else %}
                                        <li {% if participantItem.id == agenda.participant.id %} class="active" {% endif %}>
                                            <a href="{{ path('event_agenda_participant', {'participant': participantItem.id, 'sheet': sheet.id}) }}">
                                                {{ 'agenda.participant.view'|trans({'%participant%': participantItem.fullName}) }}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                        </ul>
                    </div>
                </div>
            {% else %}
                <i class="icon-Calendrier"></i>
                 <strong>{{ 'agenda.title'|trans }}</strong>
            {% endif %}
        </div>
        <div class="col-md-6">
            {% if isVisio and participant.timezone %}
                <div class="pull-right" style="margin-right: 5px;">
                    <a href="{{ path('event_participant_timezone', { 'sheet': sheet.id, 'participant': participant.id }) }}" class="btn btn-primary">
                        <i class="icon-Horaire"></i>
                        {{ agenda.timezoneTranslated }}
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <div id="agendaAllSheet" class="agenda-container" {% if agenda.isItDDay %} data-agenda-autorefresh {% endif %}>
        <div class="agenda all-sheet">
            {% for day in agenda.days %}
                <header class="agenda-head">
                    <p>
                        <i class="icon icon-Calendrier"></i>
                        <span class="agenda-date">
                            {{ day.day|localizeddate('full', 'none', app.request.locale, agenda.timezone)|capitalize }}
                        </span>
                    </p>
                </header>

                <table class="table table-bordered table-striped table-condensed table-hover">
                    {% for slot in day.agendaSlots if day.hasMeetingsOrMassUnavailabilityBySlot(slot) %}
                        <tr>
                            <td style="width: 1%">{{ slot.begin|date('H:i', agenda.timezone) }}</td>
                            <td style="padding: 0;">
                                {% for meeting in day.getMeetingViewBySlot(slot) %}
                                    {{ include('EventBundle:Agenda:meeting.html.twig', {
                                        'isVisio': isVisio,
                                        'sheetId': agenda.sheet.id,
                                        'participant': agenda.participant,
                                        'participantId': agenda.participant.id,
                                        'meeting': meeting,
                                        'canMoveMeeting': agenda.canMoveMeeting,
                                        'canRemoveMeeting' : agenda.canRemoveMeeting
                                    }) }}
                                {% endfor %}

                                {% for mass in day.getMassUnavailabilityViewsBySlot(slot) %}
                                    {{ include('EventBundle:Agenda:mass.html.twig', {'isVisio': isVisio, 'mass': mass, 'participant': participant}) }}
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            {% endfor %}
        </div>
    </div>

    {{ include('EventBundle:Meeting:meeting-modal.html.twig') }}
{% endblock %}
