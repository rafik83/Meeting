{% extends 'EventBundle::base.html.twig' %}

{% block title 'agenda.title'|trans %}

{% block container_classes 'full-mobile-container' %}

{% block content %}
    {% set isVisio = agenda.isParticipantVisio %}

    <div class="row mg-tp">
        <div class="col-md-6">
            <div class="btn-group" role="group">
                <a class="btn btn-gray" href="{{ path('event_agenda_participant', { 'sheet': sheet.id, 'participant': participant.id }) }}">
                    {{ 'agenda.myAgenda.button.title'|trans }}
                </a>
                <a class="btn btn-primary" href="{{ path('event_agenda_sheet', { 'sheet': sheet.id }) }}">
                    {{ 'agenda.sheetAgenda.button.title'|trans }}
                </a>
            </div>
        </div>
        <div class="col-md-6">
            {% if isVisio and participant.timezone %}
                <div class="pull-right" style="margin-right: 5px;">
                    <a href="{{ path('event_participant_timezone', { 'sheet': sheet.id, 'participant': participant.id }) }}" class="btn btn-primary">
                        <i class="icon-Horaire"></i>
                        {{ participant.timezone }}
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="agenda-container">
        <div class="agenda">
            {% for day in agenda.days %}
                <header class="agenda-head">
                    <p>
                        <i class="icon icon-Calendrier"></i>
                        <span class="agenda-date">
                            {{ day.day|localizeddate('full', 'none', app.request.locale, agenda.timezone)|capitalize }}
                        </span>
                    </p>
                </header>

                <table class="table table-bordered table-striped table-condensed table-hover">
                    {% for meetingSlot in day.meetingSlots if day.hasMeetingsBySlot(meetingSlot) %}
                        <tr>
                            <td style="width: 1%">{{ meetingSlot.begin|date('H:i', agenda.timezone) }}</td>
                            <td>
                                <div class="meets">
                                    {% for meeting in day.getMeetingsBySlot(meetingSlot) %}
                                        {{ include('EventBundle:Agenda:meeting.html.twig', {
                                            'isVisio': isVisio,
                                            'sheetId': agenda.sheet.id,
                                            'participant': agenda.participant,
                                            'participantId': agenda.participant.id,
                                            'meeting': meeting,
                                            'canMoveMeeting': agenda.canMoveMeeting,
                                            'canRemoveMeeting' : agenda.canRemoveMeeting
                                        }) }}
                                    {% endfor %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            {% endfor %}
        </div>
    </div>
{% endblock %}
