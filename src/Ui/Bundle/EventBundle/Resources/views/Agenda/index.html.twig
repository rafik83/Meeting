
{% extends 'EventBundle::base.html.twig' %}

{% block title 'Agenda' %}

{% block content %}
<div class="agenda" data-beginHour="08:00" data-endHour="18:00" data-slotDuration="00:30">
    <header class="agenda-head">
        <p>
            <i class="icon icon-Conference"></i>
            <strong>Conférences</strong>
            <span>- Jeudi 02 février 2017</span>
        </p>
    </header>
    <div class="row">
        <div class="col-md-6">
            <div class="meets">
                {% for index, meeting in morning %}
                    {{ block('meet') }}
                {% endfor %}
            </div>
            <div class="layout">
                <div class="insert"><span>08h00</span></div>
                <div class="insert"><span>08h30</span></div>
                <div class="insert"><span>09h00</span></div>
                <div class="insert"><span>09h30</span></div>
                <div class="insert"><span>10h00</span></div>
                <div class="insert"><span>10h30</span></div>
                <div class="insert"><span>11h00</span></div>
                <div class="insert"><span>11h30</span></div>
                <div class="insert"><span>12h00</span></div>
                <div class="insert"><span>12h30</span></div>
                <div class="insert"><span>13h00</span></div>
            </div>
            <footer class="agenda-foot">
                <p>
                    <i class="icon icon-Deverouiller_1"></i>
                    <strong>Disponibilité restantes</strong>
                    <span>- 17 plages horaires</span>
                </p>
            </footer>
        </div>
        <div class="col-md-6">
            <div class="meets">
                {% for index, meeting in afternoon %}
                    {{ block('meet') }}
                {% endfor %}
            </div>
            <div class="layout">
                <div class="insert"><span>13h00</span></div>
                <div class="insert"><span>13h30</span></div>
                <div class="insert"><span>14h00</span></div>
                <div class="insert"><span>14h30</span></div>
                <div class="insert"><span>15h00</span></div>
                <div class="insert"><span>15h30</span></div>
                <div class="insert"><span>16h00</span></div>
                <div class="insert"><span>16h30</span></div>
                <div class="insert"><span>17h00</span></div>
                <div class="insert"><span>17h30</span></div>
                <div class="insert"><span>18h00</span></div>
            </div>
            <footer class="agenda-foot">
                A voir également <a href="" class="btn btn-gray"><i class="icon icon-Conference"></i> Conférences</a>
            </footer>
        </div>
    </div>
</div>
{% endblock %}

{% block meet %}
<div
    class="meet {{ meeting.type }}"
    data-beginHour="{{ meeting.beginHour|date('H:i') }}"
    data-duration="{{ meeting.duration.format('%H:%I') }}"
>
    <header>
        <a href="">
            <span><i class="icon icon-Conference"></i> N°{{ index }}</span>
            <p>{{ meeting.title }}</p>
        </a>
    </header>
    <div class="details">
        <div class="row">
            <div class="col-md-4">
                <img src="{{ meeting.picture }}" />
            </div>
            <div class="col-md-8">
                <div class="list list--users">
                    {% set user = meeting.user %}
                    {{ block('meet_user') }}
                </div>
            </div>
        </div>
        <p>{{ meeting.description }}</p>
        <footer>
            <p class="hours">
                <i class="icon icon-Horaire"></i>
                <span>{{ meeting.beginHour|date('H\hI') }} - {{ meeting.endHour|date('H\hI') }}</span>
            </p>
            <a href="">
                <i class="icon icon-Document_1"></i>
                Details
            </a>
            <div class="actions">
                <a href="" class="btn btn-gray"><i class="icon icon-Fermer_4"></i></a>
                <a href="" class="btn btn-gray"><i class="icon icon-Transferer"></i></a>
                <a href="" class="btn btn-gray"><i class="icon icon-Editer_1"></i></a>
                <a href="" class="btn btn-gray"><i class="icon icon-Retard"></i></a>
                <a href="" class="btn btn-gray"><i class="icon icon-Localiser"></i> Localiser</a>
            </div>
        </footer>
    </div>
</div>
{% endblock %}

{% block meet_user %}
<div class="user clearfix">
    <div class="user__avatar">
        <span class="bullet"></span>
        <div class="avatar">
            <img src="{{ user.picture }}" alt="{{ user.name|first }}." title="{{ user.name }}">
        </div>
    </div>
    <div class="user__infos">
        <p class="name">{{ user.name }}</p>
        <p class="job">{{ user.job }}</p>
    </div>
</div>
{% endblock %}
