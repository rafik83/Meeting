{% extends 'EventBundle::base.html.twig' %}

{% block title 'agenda.title'|trans %}

{% block container_classes 'full-mobile-container' %}

{% block content %}
    {% if tipTranslationViews is defined %}
        {{ include('EventBundle:Tip:tip.html.twig', {tipTranslationViews: tipTranslationViews}) }}
    {% endif %}
    <div class="row">
        <div class="col-md-6">
            <div class="mg-tp">
            {% if agenda.isUserAloneParticipant %}
                <i class="icon-Calendrier"></i>
                <strong>{{ 'agenda.title'|trans }}</strong>
            {% else %}
                <div class="dropdown">
                    <button class="btn btn-primary dropdown-toggle" type="button" data-toggle="dropdown">
                        <i class="icon-Calendrier"></i>
                        {% set currentParticipantLooked = agenda.currentParticipantView %}
                        {% if currentParticipantLooked is not null %}
                            {{ 'agenda.participant.view'|trans({'%participant%': currentParticipantLooked.fullName}) }}
                        {% endif %}
                        {% if agenda.participants|length > 1 %}<span class="caret"></span>{% endif %}
                    </button>
                    {% if agenda.participants|length > 1 %}
                    <ul class="dropdown-menu">
                        {% for participantName in agenda.participants %}
                            <li {% if participantName.id == agenda.participant.id %}class="active"{% endif %}>
                                <a href="{{ path('event_agenda_participant', {'participant': participantName.id, 'sheet': sheet.id}) }}">
                                    {{ 'agenda.participant.view'|trans({'%participant%': participantName.fullName}) }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </div>
            {% endif %}
            </div>
        </div>
        <div class="col-md-6">
            {% if sheet.attend %}
                <div class="pull-right mg-tp">
                    <a href="{{ path('event_unavailability_create', { 'participant': agenda.participant.id, 'sheet': agenda.participant.sheet.id }) }}" class="btn btn-primary" data-toggle="modal" data-target="#unavailability-modal"><i class="icon-Verouiller_1"></i>{{ 'agenda.unavailability.add'|trans }}</a>
                </div>
            {% endif %}
            {% if isVisio and participant.timezone %}
                <div class="pull-right mg-tp" style="margin-right: 5px;">
                    <a href="{{ path('event_participant_timezone', { 'sheet': sheet.id, 'participant': participant.id }) }}" class="btn btn-primary">
                        <i class="icon-Horaire"></i>
                        {{ participant.timezone }}
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="agenda-container">
        <div class="row">
            {% for day in agenda.days %}
                <div class="col-md-12 agenda" data-beginHour="{{ day.begin|date('H:i', agenda.timezone) }}" data-endHour="{{ day.end|date('H:i', agenda.timezone) }}" data-slotDuration="{{ day.getScale }}">
                    <header class="agenda-head">
                        <p>
                            <i class="icon icon-Calendrier"></i>
                            <span class="agenda-date" data-date="{{ day.day|date('d/m/y h:i:s') }}">
                                {{ day.day|localizeddate('full', 'none', app.request.locale, agenda.timezone)|capitalize }}
                            </span>
                        </p>
                    </header>
                    <div class="meets">
                        {% if day.isSheetAttendingTheEvent %}
                            {% for happening in day.happenings %}
                                {{ include('EventBundle:Agenda:happening.html.twig', {'isVisio': isVisio, 'sheet': agenda.sheet, 'happening': happening, 'participant': participant, isUserAloneParticipant: agenda.isUserAloneParticipant }) }}
                            {% endfor %}

                            {% for unavailability in day.unavailabilities %}
                                {{ include('EventBundle:Agenda:unavailability.html.twig', {'isVisio': isVisio, 'sheetId': agenda.sheet.id, 'participant': participant, 'unavailability': unavailability, 'participantId': agenda.participant.id }) }}
                            {% endfor %}

                            {% for mass in day.masses %}
                                {{ include('EventBundle:Agenda:mass.html.twig', {'isVisio': isVisio, 'mass': mass, 'participant': participant}) }}
                            {% endfor %}

                            {% for meeting in day.meetings %}
                                {{ include('EventBundle:Agenda:meeting.html.twig', {'isVisio': isVisio, 'sheetId': agenda.sheet.id, 'participant': participant, 'participantId': agenda.participant.id, 'meeting': meeting }) }}
                            {% endfor %}

                            {% for availableSlotView in day.availableSlotViews %}
                                <div class="meet available"
                                     data-beginHour="{{ availableSlotView.beginHour|date('H:i', agenda.timezone) }}"
                                     data-duration="{{ availableSlotView.duration.format('%H:%I') }}"
                                     data-slot-id="{{ availableSlotView.id }}"
                                >
                                    <header><div class="content"></div></header>
                                </div>
                            {% endfor %}
                        {% else %}
                            {{ include('EventBundle:Unavailability/CancelAttendance:cancelAttendanceUnavailability.html.twig', {'isVisio': isVisio, 'cancelAttendanceUnavailability': day.cancelAttendanceUnavailabilityView, 'participant': participant }) }}
                        {% endif %}
                    </div>
                    <div class="layout"></div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% if sheet.attend %}
        <div class="pull-right mg-tp mg-bt">
            <a href="{{ path('event_unavailability_create', { 'participant': agenda.participant.id, 'sheet': agenda.participant.sheet.id }) }}" class="btn btn-primary" data-toggle="modal" data-target="#unavailability-modal"><i class="icon-Verouiller_1"></i>{{ 'agenda.unavailability.add'|trans }}</a>
        </div>
        {{ include('EventBundle:Agenda:unavailability-modal.html.twig') }}
        {{ include('EventBundle:Agenda:send-code-form-modal.html.twig') }}
    {% endif %}
    {{ include('EventBundle:Program/Partials:modal.html.twig', {}, false) }}
{% endblock %}
