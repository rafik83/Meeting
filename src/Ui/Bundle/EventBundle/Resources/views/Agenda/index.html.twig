{% extends 'EventBundle::base.html.twig' %}

{% block title 'Agenda' %}

{% block content %}
    <div class="agenda-container">
        <header class="agenda-head">
            <p>
                <i class="icon icon-Conference"></i>
                <strong>Conférences</strong>
                <span>- Jeudi 02 février 2017</span>
            </p>
        </header>
        <div class="row">
            <div class="col-md-6 agenda" {#data-beginHour="{{ happeningList.startTime|date('H:i', event.timeZone) }}" data-endHour="{{ happeningList.middleTime|date('H:i', event.timeZone) }}" data-slotDuration="{{ happeningList.scale }}"#}>
                <div class="meets">
                </div>
                <div class="layout"></div>
                <footer class="agenda-foot">
                    <p>
                        <i class="icon icon-Deverouiller_1"></i>
                        <strong>Disponibilité restantes</strong>
                        <span>- 17 plages horaires</span>
                    </p>
                </footer>
            </div>
            <div class="col-md-6 agenda" {#data-beginHour="{{ happeningList.middleTime|date('H:i', event.timeZone) }}" data-endHour="{{ happeningList.endTime|date('H:i', event.timeZone) }}" data-slotDuration="{{ happeningList.scale }}"#}>
                <div class="meets">
                    {#
                    {% for meeting in happeningList.afternoon %}
                        {{ include('EventBundle:Agenda:meeting.html.twig', {'meeting': meeting}) }}
                    {% endfor %}
                    #}
                </div>
                <div class="layout"></div>
                <footer class="agenda-foot">
                    <p>
                        A voir également
                        <a href="#conferences" class="btn btn-gray">
                            <i class="icon icon-Conference"></i> Conférences
                        </a>
                    </p>
                </footer>
            </div>
        </div>
    </div>
{% endblock %}
