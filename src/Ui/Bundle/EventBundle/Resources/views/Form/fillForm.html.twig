{% extends 'EventBundle::base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title formTemplateTitle ~ ' - ' ~ event.title %}

{% block content %}
    <div class="main-content">
        <section class="main">
            <header>
                <h1>
                    {% if blockStepView.currentStep > 1 %}
                        <a href="{{ path('event_participant_fill_form', {
                            'sheet': sheet.id,
                            'participant': participantList.currentParticipant.id,
                            'formTemplate': formTemplate.id,
                            'step': blockStepView.currentStep - 1,
                        }) }}" class="btn btn-link">
                            <span class="icon-Precedent_3"></span>
                        </a>
                    {% endif %}
                    {{ formTemplateTitle }}
                </h1>
                &nbsp;- {{ 'form_template.fill_step.step_title'|trans({'%currentStep%': blockStepView.currentStep, '%totalStep%': blockStepView.totalStep }) }}
                <div class="dropdown pull-right">
                    <button class="btn btn-primary dropdown-toggle" type="button" data-toggle="dropdown">
                        <i class="icon-Info_1"></i>
                            {{ 'form_template.fill_step.participant'|trans({'%participant%': participantList.currentParticipant.fullName }) }}
                        {% if participantList.otherParticipants|length > 1 %}<span class="caret"></span>{% endif %}
                    </button>
                    {% if participantList.otherParticipants|length > 1 %}
                        <ul class="dropdown-menu">
                            {% for participantName in participantList.otherParticipants %}
                                <li {% if participantName.id == participantList.currentParticipant.id %}class="active"{% endif %}>
                                    <a href="{{ path('event_participant_fill_form', {
                                        'participant': participantName.id,
                                        'sheet': sheet.id,
                                        'formTemplate': formTemplate.id,
                                        'step': blockStepView.currentStep,
                                    }) }}">
                                        {{ 'form_template.fill_step.participant'|trans({'%participant%': participantName.fullName}) }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </header>

            <div class="main__container">
                <div class="row">
                    <div class="col-md-12">

                        {{ form_start(form) }}

                        {{ form_errors(form) }}

                        <div class="inputs">
                            {% for child in form %}
                                {{ form_row(child) }}

                                {% set uploadObject = child.vars.value %}
                                {% if uploadObject.isUploadAndHasPath is defined and uploadObject.isUploadAndHasPath %}
                                    {% set parameters = {
                                        'sheet': sheet.id,
                                        'participant': participantList.currentParticipant.id,
                                        'formTemplate': formTemplate.id,
                                        'objectKey': uploadObject.key
                                    } %}
                                    {% set path = path('event_form_template_download_file', parameters) %}

                                    <div class="text-center">
                                        <a href="{{ path }}" download>
                                            {% if uploadObject.isImageFormat %}
                                                {{ render(controller(
                                                    'Proximum\\Vimeet\\Ui\\Bundle\\EventBundle\\Controller\\Form\\DownloadFileAction',
                                                    parameters|merge({'preview': true})
                                                )) }}
                                            {% endif %}

                                            <i class="glyphicon glyphicon-download"></i>
                                            {{ 'common.download'|trans }}
                                        </a>
                                        <hr>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="validation text-center">
                            <button type="submit" class="btn btn-primary">
                                {% if blockStepView.currentStep != blockStepView.totalStep %}
                                    <i class="icon-Suivant_3"></i> {{ 'common.next'|trans }}
                                {% else %}
                                    <i class="icon-Valider_3"></i> {{ 'register.finalize'|trans }}
                                {% endif %}
                            </button>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
