{% if promotionCode is defined %}
    <tr>
        <td>{{ promotionCode.label }}</td>
        <td class="text-center">{{ promotionCode.total|localizedcurrency(promotionCode.currency) }} {{ ('package.vatMode.' ~ promotionCode.vatMode)|trans }}</td>
        <td class="text-center">{{ promotionCode.quantity }}</td>
        <td class="text-center">{{ promotionCode.total|localizedcurrency(promotionCode.currency) }} {{ ('package.vatMode.' ~ promotionCode.vatMode)|trans }}</td>
    </tr>
{% endif %}
