{% if summary is defined %}
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th class="col-md-6">{{ 'summary.column.title'|trans }}</th>
            <th class="text-center col-md-2">{{ 'summary.column.unitPrice'|trans }}</th>
            <th class="text-center col-md-2">{{ 'summary.column.quantity'|trans }}</th>
            <th class="text-center col-md-2">{{ 'summary.column.total'|trans }}</th>
        </tr>
    </thead>
    <tbody>
    {{ include('EventBundle:Order/Summary:groups.html.twig', {groups: summary.groups, order: order}) }}
    {{ include('EventBundle:Order/Summary:promotion_codes.html.twig', {promotionCodes: summary.promotionCodes}) }}

    {% if summary.vatApplicable %}
        {% for vatView in summary.vatListView.vatViews %}
            <tr>
                <td colspan="2"></td>
                <td><strong>{{ 'summary.totalByVat'|trans({'%vatRate%': vatView.vatRate}) }}</strong></td>
                <td class="text-center">{{ vatView.total|format_amount|localizedcurrency(summary.currency) }} {{ ('package.vatMode.' ~ vatView.vatMode)|trans }}</td>
            </tr>
            <tr>
                <td colspan="2"></td>
                <td><strong>{{ 'summary.vatRate'|trans({'%vatRate%': vatView.vatRate }) }}</strong></td>
                <td class="text-center">{{ vatView.totalVat|format_amount|localizedcurrency(summary.currency) }}</td>
            </tr>
        {% endfor %}
    {% endif %}

    <tr>
        <td colspan="2"></td>
        <td><strong>{{ 'summary.totalToPay'|trans }}</strong></td>
        <td class="text-center">
            {{ summary.totalWithVat|format_amount|localizedcurrency(summary.currency) }}
            {{ 'package.vatMode.ati'|trans }}
        </td>
    </tr>
    </tbody>
</table>
{% endif %}
