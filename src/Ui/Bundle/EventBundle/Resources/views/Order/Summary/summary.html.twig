{% if summary is defined %}
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th class="col-md-6">{{ 'summary.column.title'|trans }}</th>
            <th class="text-center col-md-2">{{ 'summary.column.unitPrice'|trans }}</th>
            <th class="text-center col-md-2">{{ 'summary.column.quantity'|trans }}</th>
            <th class="text-center col-md-2">{{ 'summary.column.total'|trans }}</th>
        </tr>
    </thead>
    <tbody>
    {{ include('EventBundle:Order/Summary:groups.html.twig', {groups: summary.groups, order: order}) }}
    {{ include('EventBundle:Order/Summary:promotion_codes.html.twig', {promotionCodes: summary.promotionCodes}) }}
    {% if summary.vatApplicable %}
        <tr>
            <td colspan="2"></td>
            <td><b>{{ 'summary.total'|trans }}</b></td>
            <td class="text-center">{{ summary.totalWithoutVat|localizedcurrency(summary.currency) }} {{ ('package.vatMode.' ~ summary.vatMode)|trans }}</td>
        </tr>
        <tr>
            <td colspan="2"></td>
            <td><b>{{ 'summary.vatRate'|trans({'%vatRate%': summary.vatRate }) }}</b></td>
            <td class="text-center">{{ summary.vatAmount|localizedcurrency(summary.currency) }}</td>
        </tr>
    {% endif %}
    <tr>
        <td colspan="2"></td>
        <td><b>{{ 'summary.totalToPay'|trans }}</b></td>
        <td class="text-center">{{ summary.totalWithVat|localizedcurrency(summary.currency) }} {{ ('package.vatMode.' ~ summary.totalVatMode)|trans }}</td>
    </tr>
    </tbody>
</table>
{% endif %}
