{% if group is defined and group.products is not empty or group.customRows is not empty %}
    <tr>
        <td colspan="4" class="active">
            {% if group.type == 'option' %}
                <b>{{ 'summary.group.option.title'|trans }}</b> {{ group.label }}
            {% else %}
                <b>{{ group.label }}</b>
            {% endif %}
        </td>
    </tr>
    {% if group.products is not empty %}
        {% for product in group.products %}
            {{ include('EventBundle:Order/Summary:product.html.twig', {product: product}) }}

            {% if product.customRows is not empty %}
                {% for customRow in product.customRows %}
                    {{ include('EventBundle:Order/Summary:custom_row.html.twig', {customRow: customRow}) }}
                {% endfor %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if group.customRows is not empty %}
        {% for customRow in group.customRows %}
            {{ include('EventBundle:Order/Summary:custom_row.html.twig', {customRow: customRow}) }}
        {% endfor %}
    {% endif %}
{% endif %}
