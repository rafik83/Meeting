{% extends 'EventBundle::base.html.twig' %}

{% block title %}{{ 'package.summary.pageTitle'|trans }}{% endblock %}

{% block content %}
    <section class="main">

        <div class="main__container">
            <div class="product product--recap">
                <div class="content-header clearfix">
                    <h2 class="pull-left">{{ 'package.summary.title'|trans }}</h2>
                    <div class="pull-right">
                        <a class="btn btn-primary" href="{{ path('event_order_list', {
                            'sheet': view.sheet.id
                        }) }}">
                            {{ 'package.summary.order-list'|trans }}
                        </a>
                        <a class="btn btn-primary" href="{{ path('event_package_step', {
                            'sheet': view.sheet.id,
                            'step': 1
                        }) }}">
                            {{ 'package.summary.edit'|trans }}
                        </a>
                    </div>
                </div>

                <section class="section object object--collection style--style-1">
                    <div class="form--table--head">
                        <table class="table table--recap">
                            <thead>
                            <tr>
                                <th class="col-md-6">{{ 'package.summary.columns.title'|trans }}</th>
                                <th class="text-center col-md-2">{{ 'package.summary.columns.unitPrice'|trans }}</th>
                                <th class="text-center col-md-2">{{ 'package.summary.columns.quantity'|trans }}</th>
                                <th class="text-center col-md-2">{{ 'package.summary.columns.total'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{ include('EventBundle:Order/SummaryTotal:groups.html.twig', {
                                groups: view.groups.groups
                            }) }}
                            {{ include('EventBundle:Order/SummaryTotal:promo-code-rows.html.twig', {
                                promotionCodes: view.promotionCodes.promotionCodes
                            }) }}
                            </tbody>
                        </table>
                        <div class="row end-table">
                            <div class="col-md-8 cgv">
                            </div>
                            <div class="col-md-4 sum">
                                <ul>
                                    {% if view.vatApplicable %}
                                        {% for vatView in view.vatListView.vatViews %}
                                            <li class="col-md-12">
                                                {{ 'summary.totalByVat'|trans({'%vatRate%': vatView.vatRate}) }}
                                                <span>
                                                    {{ vatView.total|format_amount|localizedcurrency(view.currency) }}
                                                    {{ ('package.vatMode.' ~ vatView.vatMode)|trans }}
                                                </span>
                                            </li>
                                        {% endfor %}
                                        {% for vatView in view.vatListView.vatViews %}
                                            <li class="col-md-12">
                                                {{ 'package.summary.totalVat'|trans({'%vat%': vatView.vatRate }) }}
                                                <span>
                                                    {{ vatView.totalVat|format_amount|localizedcurrency(view.currency) }}
                                                </span>
                                            </li>
                                        {% endfor %}
                                    {% endif %}

                                    <li class="total">{{ 'summary.totalToPay'|trans }}
                                        <span>
                                            {{ view.totalWithVat|format_amount|localizedcurrency(view.currency) }} {{ ('package.vatMode.ati')|trans }}
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        {% if 0 < view.remainingToPay %}
                            <div class="text-right">
                                <a href="{{ path('event_package_payment_pay_remaining', {'sheet': sheet.id}) }}" class="btn btn-primary">{{ 'order.list.pay_remaining'|trans }}</a>
                            </div>
                        {% endif %}
                    </div>
                </section>
            </div>
        </div>
    </section>
{% endblock %}
