{% if null != product %}
    <tr {% if stripped is defined and stripped %}class="even"{% endif %}>
        <td class="col-md-6">
            <p>{{ product.label }}</p>
            {% if product.buyableUntil is not empty %}
                <p>{{ 'package.product.buyableUntil'|trans({'%date%': product.buyableUntil|date('d/m/Y')}) }}</p>
            {% endif %}
            {% if product.deletableUntil is not empty %}
                {% if product.isDeletable %}
                    <p>{{ 'package.product.deletableUntil'|trans({'%date%': product.deletableUntil|date('d/m/Y') }) }}</p>
                {% else %}
                    <p>{{ 'package.product.notDeletableSince'|trans({'%date%': product.deletableUntil|date('d/m/Y') }) }}</p>
                {% endif %}
            {% endif %}
        </td>
        <td class="col-md-2">
            <div class="product">
                <span class="product-price text-center">
                    {{ 'package.product.unitPrice'|trans({
                        '%price%': product.price|localizednumber,
                        '%currency%': product.currency|currency_symbol,
                        '%vatMode%': ('package.vatMode.' ~ product.vatMode)|trans
                    })|html }}
                </span>
            </div>
        </td>
        <td class="col-md-2">
            <p class="text-center">{{ product.quantity }}</p>
        </td>
        <td class="col-md-2">
            <div class="product">
                <span class="product-price text-center">
                    {{ 'package.product.unitPrice'|trans({
                        '%price%': product.total|localizednumber,
                        '%currency%': product.currency|currency_symbol,
                        '%vatMode%': ('package.vatMode.' ~ product.vatMode)|trans
                    })|html }}
                </span>
            </div>
        </td>
        {% if product.includedProducts is not empty %}
            {% for included in product.includedProducts %}
                {% set stripped = not stripped %}
                {{ include('EventBundle:Order/SummaryTotal:included.html.twig', {included: included, stripped: stripped}) }}
            {% endfor %}
        {% endif %}
    </tr>
{% endif %}
