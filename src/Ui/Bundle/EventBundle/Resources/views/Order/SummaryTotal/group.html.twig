{% if null != group and group.products is not empty %}
    {% set stripped = true %}
    <tr class="title">
        <td class="col-md-6">
            <h3>{{ 'package.summary.option'|trans }}</h3>
            <p class="category-option pull-left">{{ group.label }}</p>
        </td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
    </tr>
    {% for product in group.products %}
        {% if null != product %}
            {{ include('EventBundle:Order/SummaryTotal:product.html.twig', {product: product, stripped: stripped}) }}
        {% endif %}
    {% endfor %}
{% endif %}
