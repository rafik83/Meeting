{% if null != group and group.products is not empty or group.customRows is not empty %}
    {% set stripped = true %}
    <tr class="title">
        <td class="col-md-6">
            <h3>{{ group.label }}</h3>
        </td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
        <td class="col-md-2"></td>
    </tr>
    {% for product in group.products %}
        {% if null != product %}
            {{ include('EventBundle:Order/SummaryTotal:product.html.twig', {product: product, stripped: stripped}) }}
        {% endif %}

        {% if product.customRows is not empty %}
            {% for customRow in product.customRows %}
                {{ include('EventBundle:Order/SummaryTotal:custom_row.html.twig', {customRow: customRow, vatMode: product.vatMode, currency: product.currency}) }}
            {% endfor %}
        {% endif %}

    {% endfor %}

    {% if group.customRows is not empty %}
        {% for customRow in group.customRows %}
            {{ include('EventBundle:Order/SummaryTotal:custom_row.html.twig', {customRow: customRow, vatMode: order.vatMode, currency: order.currency}) }}
        {% endfor %}
    {% endif %}
{% endif %}
