{% extends 'EventBundle::base.html.twig' %}

{% block title %}
    {{ event.title }}: {{ 'order.list.title'|trans }}
{% endblock %}

{% block content %}
<section class="main">
    <header>
        <h1>
            <i class="icon-Panier_2"></i>
            {{ 'order.list.title'|trans }}
        </h1>
    </header>
    <div class="main__container">
        <div class="row">
            <div class="col-md-8">
                <table class="table">
                    <thead>
                        <th>{{ 'order.list.column.numero'|trans }}</th>
                        <th>{{ 'order.list.column.date'|trans }}</th>
                        <th>{{ 'order.list.column.total'|trans }}</th>
                        <th>{{ 'order.list.column.pro_forma'|trans }}</th>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                            <tr>
                                <td>
                                    {{ order.numero }}
                                    {% if order.cancelled %}
                                        <span class="label label-danger">{{ 'order.list.cancelled'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ order.createdAt|localizeddate('medium', 'short', app.request.locale) }}</td>
                                <td>{{ order.total|localizedcurrency(order.currency) }}</td>
                                <td><a target="_blank" href="{{ path('event_pro_forma', {'sheet': sheet.id, 'order': order.id}) }}"><i class="icon-Note_1"></i> {{ 'order.list.pro_forma.link'|trans }}</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="col-md-4">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        {{ 'order.list.remainingToPay'|trans }}
                    </div>
                    <div class="panel-body text-center h1">
                        {{ remainingToPay|localizedcurrency(event.currency) }}

                        {% if 0 < remainingToPay %}
                            <a href="{{ path('event_package_payment_pay_remaining', {'sheet': sheet.id}) }}" class="btn btn-primary">{{ 'order.list.pay_remaining'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="main">
    <header>
        <h1>
            <i class="icon-Paiement_1"></i>
            {{ 'order.transaction.list.title'|trans }}
        </h1>
    </header>
    <div class="main__container">
        <table class="table">
            <thead>
            <th>{{ 'order.transaction.list.column.date'|trans }}</th>
            <th>{{ 'order.transaction.list.column.state'|trans }}</th>
            <th>{{ 'order.transaction.list.column.mode'|trans }}</th>
            <th>{{ 'order.transaction.list.column.total'|trans }}</th>
            <th></th>
            </thead>
            <tbody>
            {% for transaction in transactions %}
                <tr>
                    <td>{{ transaction.date|localizeddate('medium', 'short', app.request.locale) }}</td>
                    <td>{{ ('order.transaction.state.' ~ transaction.state)|trans }}</td>
                    <td>{{ ('order.transaction.mode.' ~ transaction.mode)|trans }}</td>
                    <td>{{ transaction.amount|localizedcurrency(transaction.currency) }}</td>
                    <td>
                        {% if transaction.isRequiredPaymentInfo %}
                            <a href="{{ path('event_payment_info') }}" target="_blank">{{ 'order.transaction.howtopay'|trans }}</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">{{ 'order.transaction.no'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
