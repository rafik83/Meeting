{% extends 'EventBundle::base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <h2>{{ 'event.sheet.listOrders.title'|trans }}</h2>

    <ul>
        {% for order in sheet.orders %}
            <li style="margin-bottom: 4px;">
                Commande du
                {{ order.createdAt|date('d/m/Y H:i') }}
                <a href="{{ path('event_sheet_order_pro_forma', { 'sheet': sheet.id, 'order' : order.id }) }}" target="_blank" class="btn btn-info btn-xs">
                    {{ 'event.sheet.listOrders.proForma'|trans }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <hr>

    <a href="{{ path('event_sheet', { 'sheet': sheet.id }) }}" class="btn btn-link">
        {{ 'event.link.go_back_to_sheet'|trans }}
    </a>

    <a href="{{ path('event_sheet_summary', { 'sheet' : sheet.id }) }}" class="btn btn-link">
        {{ 'event.sheet.summary.title'|trans }}
    </a>
{% endblock %}
