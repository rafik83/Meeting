{% extends 'EventBundle::base.html.twig' %}

{% block title 'contacts.list.title'|trans %}

{% block container_classes 'full-mobile-container' %}

{% block content %}

    {% if tipTranslationViews is defined %}
        {{ include('EventBundle:Tip:tip.html.twig', {tipTranslationViews: tipTranslationViews}) }}
    {% endif %}

    <div class="profile__content">
        <header>
            <h1>
                {% if isEventOpen %}
                    <a href="{{ path('event_meeting_request_export_contact', {sheet: sheet.id}) }}" class="btn btn-primary pull-right mg-tp--5px mg-bt">
                        <i class="glyphicon glyphicon-download-alt"></i>
                        {{ 'event.meeting.listRequest.contact.export'|trans }}
                    </a>
                {% endif %}
                <i class="icon-Badge_2"></i> {{ 'contacts.list.title'|trans }}
            </h1>
        </header>

        <div class="main__content">
            <table class="list list--users table table-striped table-bordered table-hover">
                {% for contactPreview in contactListView.contactPreviewViews %}
                    <tr>
                        <td>
                            {% set showPathParameters = {'sheet': sheet.id, 'contactUser': contactPreview.contactId} %}
                            {% if contactPreview.needEvaluation %}
                                {% set showPathParameters = showPathParameters|merge({(constant('Proximum\\Vimeet\\Ui\\Bundle\\EventBundle\\Controller\\Contact\\ShowAction::MODE_QUERY_KEY')): constant('Proximum\\Vimeet\\Ui\\Bundle\\EventBundle\\Controller\\Contact\\ShowAction::MODE_EDIT_EVALUATION')}) %}
                            {% endif %}
                            <a class="user clearfix" href="{{ path('event_contact_show', showPathParameters) }}">
                                <div class="user__avatar">
                                    <div class="avatar">
                                        {% if contactPreview.avatar %}
                                            <img src="{{ contactPreview.avatar|imagine_filter('user_avatar') }}"
                                                 alt="{{ contactPreview.initials }} avatar">
                                        {% else %}
                                            <p>{{ contactPreview.initials }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="user__infos">
                                    {% if contactPreview.hasApprovedMeetingRequestWith %}
                                        <i class="icon icon-RDV pull-right"></i>
                                    {% endif %}

                                    <p class="sheets">
                                        {{ contactPreview.sheetTitles | join(', ') }}
                                    </p>
                                    <p class="name">{{ contactPreview.firstName|capitalize }} {{ contactPreview.lastName|upper }}</p>

                                    {% if contactListView.showCheckinStatus %}
                                        {% if contactPreview.isCheckedToday %}
                                            <span class="label label-success">{{ 'contacts.list.present'|trans }}</span>
                                        {% else %}
                                            <span class="label label-danger">{{ 'contacts.list.absent'|trans }}</span>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td>{{ 'contacts.list.noResults'|trans }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
