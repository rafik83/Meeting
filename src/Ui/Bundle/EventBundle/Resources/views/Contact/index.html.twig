{% extends 'EventBundle::base.html.twig' %}

{% block title 'contacts.title'|trans %}

{% block container_classes 'full-mobile-container' %}

{% block content %}
    <div class="profile__content">
        <header>
            <h1>
                {% if true %}
                    <a href="{{ path('event_meeting_request_export_contact', {sheet: sheet.id}) }}" class="btn btn-primary pull-right mg-tp--5px mg-bt">
                        <i class="glyphicon glyphicon-download-alt"></i>
                        {{ 'event.meeting.listRequest.contact.export'|trans }}
                    </a>
                {% endif %}
                <i class="icon-Badge_2"></i> {{ 'contacts.title'|trans }}
            </h1>
        </header>

        <div class="main__content">
            <table class="list list--users table table-striped table-bordered table-hover">
                {% for contactPreview in contactListView %}
                    <tr>
                        <td>
                            <div class="user clearfix">
                                <div class="user__avatar">
                                    <div class="avatar">
                                        {% if contactPreview.avatar %}
                                            <img src="{{ contactPreview.avatar|imagine_filter('user_avatar') }}"
                                                 alt="{{ contactPreview.initials }} avatar">
                                        {% else %}
                                            <p>{{ contactPreview.initials }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="user__infos">
                                    <p class="sheets">
                                        {{ contactPreview.sheetTitles | join(', ') }}
                                    </p>
                                    <p class="name">{{ contactPreview.firstName|capitalize }} {{ contactPreview.lastName|upper }}</p>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
