{% extends 'EventBundle::base.html.twig' %}

{% block title 'Styleguide' %}

{% block content %}
    <h2 id="styleguide-icons">Buttons</h2>

    <div class="text-center">
        <a href="#" class="btn btn-primary">Primary action</a>
        <a href="#" class="btn btn-gray">Secondary action</a>
        <a href="#" class="btn btn-link">Link action</a>
    </div>

    <hr>

    <h2 id="styleguide-icons">Icons</h2>

    <div class="row">
        {% for icon in icons %}
            <div class="col-md-2 text-center thumbnail mg-left">
                <div><span class="{{ icon }}"></span></div>
                <div>
                    <a href="#" class="btn btn-gray"><i class="{{ icon }}"></i></a>
                    <a href="#" class="btn btn-primary"><i class="{{ icon }}"></i></a>
                </div>
                <div>{{ icon }}</div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
