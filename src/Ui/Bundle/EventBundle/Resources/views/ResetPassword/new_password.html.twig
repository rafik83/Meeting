{% extends 'EventBundle::base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title 'new_password.title'|trans %}

{% block content %}
<div class="profile__content">
    <section class="main">
        <header>
            <h1><i class="icon-Clef"></i> {{ 'new_password.title'|trans }}</h1>
        </header>
        <div class="highlight main__content styled-form">
            {{ form_start(form) }}
            {{ form_row(form.password.first) }}
            {{ form_row(form.password.second) }}

            <p class="alert alert-warning">{{ 'form.password.rules'|trans({}, 'forms') }}</p>

            <div class="validation">
                <button type="submit" class="btn btn-primary"><i class="icon-Valider_3"></i> {{ 'common.validate'|trans }}</button>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}
