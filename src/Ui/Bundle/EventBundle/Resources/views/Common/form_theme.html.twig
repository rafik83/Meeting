{% extends "form_div_layout.html.twig" %}

{%- block form_row -%}
    <div class="form-row">
        {{- form_label(form) -}}
        {% set attr = attr|merge({'class': (attr.class|default('') ~ ' ' ~ (errors|length ? 'error' : '')|trim)}) %}

        {% if 'select2' in attr.class %}
            {% set attr = attr|merge({'data-no-results-label': 'select2.no_results'|trans}) %}
        {% endif %}

        {{- form_widget(form, {attr: attr}) -}}

        {{ form_errors(form) }}
    </div>
{%- endblock form_row -%}

{%- block telephone_widget -%}
    {%- set type = type|default('tel') -%}
    {{ block('form_widget_simple') }}
{%- endblock telephone_widget -%}

{%- block quantity_widget -%}
    {% set attr = attr|merge({
        'data-min-message': attr['data-min-message']|trans,
        'data-max-message': attr['data-max-message']|trans
    }) %}

    <div class="select-quantity">
        <input type="button" value="-" class="qtyminus"/>
        {{ block('form_widget_simple') }}
        <input type="button" value="+" class="qtyplus"/>
    </div>
{%- endblock quantity_widget -%}

{%- block form_errors -%}
    {% if errors|length > 0 %}
        <ul class="text-danger">
            {% for error in errors %}
                <li>{{ error.message|trans({}, 'validators') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{%- endblock form_errors -%}

{%- block form_rows -%}
    <div class="inputs">
        {% for child in form %}
            {{- form_row(child) -}}
        {% endfor %}
    </div>
{%- endblock form_rows -%}

{%- block submit_row -%}
    <div class="validation">
        {{- form_widget(form) -}}
    </div>
{%- endblock -%}

{%- block submit_widget -%}
    {%- set type = type|default('submit') -%}
    {%- set attr = attr|default({})|merge({'class': 'btn'}) -%}
    {{ block('button_widget') }}
{%- endblock -%}
