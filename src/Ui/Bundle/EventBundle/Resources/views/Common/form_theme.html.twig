{% extends "form_div_layout.html.twig" %}

{%- block form_row -%}
    <li>
        {{- form_label(form) -}}
        {% set attr = attr|merge({'class': (attr.class|default('') ~ ' ' ~ (errors|length ? 'error' : '')|trim)}) %}
        {{- form_widget(form, {attr: attr}) -}}
    </li>
{%- endblock form_row -%}

{%- block form_errors -%}
    {% if errors|length > 0 %}
        <ul class="text-danger">
            {% for error in errors %}
                <li>{{ error.message|trans({}, 'validators') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{%- endblock form_errors -%}
