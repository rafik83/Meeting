{% extends "form_div_layout.html.twig" %}

{%- block form_row -%}
        {{- form_label(form) -}}
        {% set attr = attr|merge({'class': (attr.class|default('') ~ ' ' ~ (errors|length ? 'error' : '')|trim)}) %}

        {% if 'select2' in attr.class %}
            {% set attr = attr|merge({'data-no-results-label': 'select2.no_results'|trans}) %}
        {% endif %}

        {{- form_widget(form, {attr: attr}) -}}
{%- endblock form_row -%}

{%- block telephone_widget -%}
    {%- set type = type|default('tel') -%}
    {{ block('form_widget_simple') }}
{%- endblock telephone_widget -%}

{%- block form_errors -%}
    {% if errors|length > 0 %}
        <ul class="text-danger">
            {% for error in errors %}
                <li>{{ error.message|trans({}, 'validators') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{%- endblock form_errors -%}
