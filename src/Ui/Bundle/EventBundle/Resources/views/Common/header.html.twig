<div class="header">
    {% if event is defined %}
        {% if event.logo != null %}
            <a href="{{ path('event') }}">
                {% if event.isSvgLogo %}
                    <img src="{{ event.logo }}" class="logo">
                {% else %}
                    <img src="{{ event.logo|imagine_filter('event_header_logo') }}" class="logo">
                {% endif %}
            </a>
        {% endif %}
        <div class="header__info">
            <div>{{ event.description(app.request.locale)|nl2br }}</div>
        </div>
    {% endif %}

    <ul class="header__navigation">
        {% if event is defined %}
            {% for locale in event.locales if locale != app.request.locale %}
                <li><a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({ '_locale' : locale })) }}">{{ locale }}</a><li>
            {% endfor %}
        {% endif %}

        {#
        {% if is_granted('ROLE_USER') %}
            <li class="notifs">
                <a href="">
                    <i class="icon-Retard"></i>
                    <span class="name">Notifications</span> <span class="notif">1</span>
                </a>
            </li>
            <li>
                <a href="">
                    <i class="icon-Preferences_1"></i>
                </a>
            </li>
        {% endif %}
        #}

        {% if is_granted('ROLE_USER') %}
            <li>
                <a href="{{ path('event_logout_confirmation') }}" title="{{ 'logout.link'|trans }}">
                    <i class="icon-Disconnect"></i>
                </a>
            </li>
        {% else %}
            <li>
                <a href="{{ path('event_login') }}" title="{{ 'login.link'|trans }}">
                    <i class="icon-Disconnect"></i>
                </a>
            </li>
        {% endif %}

        <li>
            <a href="#event-contact-modal" data-toggle="modal" data-target="#event-contact-modal">
                <i class="icon-Appeler"></i>
            </a>
        </li>
    </ul>
</div>

<div class="modal fade" id="event-contact-modal" tabindex="-4" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><i class="icon-Appeler"></i> {{ 'event.info.contact'|trans }}</h4>
            </div>
            <div class="modal-body">
                <ul>
                    <li><strong class="highlight">{{ event.organiserName }}</strong></li>
                {% if event.configuration.contactFirstName or event.configuration.contactLastName %}
                    <li>{{ event.configuration.contactFirstName|default('')|capitalize }} {{ event.configuration.contactLastName|default('')|upper }}</li>
                {% endif %}
                {% if event.configuration.organiserPhone %}
                    <li><i class="icon-Appeler"></i> {{ event.configuration.organiserPhone }}</li>
                {% endif %}
                {% if event.organiserEmail %}
                    <li><i class="icon-Message_1"></i> <a href="mailto:{{ event.organiserEmail }}">{{ event.organiserEmail }}</a></li>
                {% endif %}
                {% if event.configuration.organiserWebsite %}
                    <li><a href="{{ event.configuration.organiserWebsite }}" target="_blank" rel="external">
                        {{ event.configuration.organiserWebsite }}
                    </a></li>
                {% endif %}
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-gray pull-left" data-dismiss="modal">
                    <i class="icon-Retour"></i>{{ 'event.info.close'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
