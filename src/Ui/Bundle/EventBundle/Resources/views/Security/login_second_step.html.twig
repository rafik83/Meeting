{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form 'EventBundle:Common:form_theme.html.twig' %}

{% block title 'login.title'|trans %}

{% block content %}
    <section class="main">
        <header>
            <h1><img src="{{ asset('assets/images/icons/icon-key.svg') }}"> Connexion <span>"Espace membre"</span></h1>
        </header>

        <div class="main__content">
            {{ form_start(form, {attr: {class: 'styled-form'}}) }}
            <ul class="inputs">
                <li class="identity">
                    <div class="avatar">
                        <img src="{{ asset('assets/images/dummy/default-user.svg') }}">
                    </div>
                    <p>{{ username }}</p>
                </li>

                {{ form_row(form.username) }}

                {{ form_row(form.password, {label: false}) }}

                <li class="validation">
                    <button type="submit" class="btn"><i class="icon-Suivant_3"></i> Suivant</button>
                </li>

                {{ form_widget(form.rememberMe) }}
                {{ form_label(form.rememberMe) }}
            </ul>
            {{ form_end(form) }}
        </div>

        <div class="sub-form">
            <a href="{{ path('event_forgotten_password') }}" class="btn key">
                Mot de passe oublié ?
            </a>
        </div>
    </section>

    {% if error %}
        <section class="important fail">
            <p>{{ error.message|trans }}</p>
        </section>
    {% endif %}
{% endblock %}
