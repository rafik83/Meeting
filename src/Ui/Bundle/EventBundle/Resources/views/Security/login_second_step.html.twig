{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title %}
    {% if type %}
        {{ 'register.register'|trans }} "{{ type.title }}"
    {% else %}
        {{ 'login.title'|trans }}
    {% endif %}
{% endblock %}

{% block content %}
    <section class="main">
        <header>
            {% if type %}
                <h1><i class="icon-Clef"></i> {{ 'register.register'|trans }} <span>"{{ type.title }}"</span></h1>
            {% else %}
                <h1><i class="icon-Clef"></i> {{ 'login.connection'|trans }} <span>"{{ 'login.memberArea'|trans }}"</span></h1>
            {% endif %}
        </header>

        <div class="main__content" id="login-form">
            {{ form_start(form, {attr: {class: 'styled-form'}}) }}
            {% if typeId %}
                <a href="{{ path('event_register', {'typeView': typeId}) }}" class="back"><i class="icon-Retour"></i></a>
            {% else %}
                <a href="{{ path('event_login') }}" class="back"><i class="icon-Retour"></i></a>
            {% endif %}
            <div class="inputs">
                <div class="identity">
                    <div class="avatar">
                        <img src="{{ asset('assets/images/dummy/default-user.svg') }}">
                    </div>
                    <p>{{ username }}</p>
                </div>

                {{ form_row(form.username) }}

                {{ form_row(form.password, {label: false}) }}

                <div class="validation">
                    <button type="submit" class="btn btn-primary"><i class="icon-Valider_3"></i> {% if typeId %}{{ 'register.connect'|trans }}{% else %}{{ 'login.connect'|trans }}{% endif %}</button>
                </div>
                {% if typeId %}
                    <input type="hidden" name="_target_path" value="{{ url('event_participate', {'typeView': typeId}) }}" />
                {% endif %}

                {{ form_widget(form.rememberMe) }}
                {{ form_label(form.rememberMe) }}
            </div>
            {{ form_end(form) }}
        </div>

        <div class="sub-form">
            <a href="{{ path('event_forgotten_password') }}" class="btn key">
                {{ 'login.forgot_password'|trans }}
            </a>
        </div>
    </section>

    {% if error %}
        <section class="important fail">
            <p>{{ error.message|trans }}</p>
        </section>
        <br/>
    {% endif %}
    {% if type is not null and typeDescription is defined and typeDescription is not empty %}
        <section id="type-description" class="type-description important">
            {{ typeDescription|html }}
        </section>
        <br/>
    {% endif %}
{% endblock %}
