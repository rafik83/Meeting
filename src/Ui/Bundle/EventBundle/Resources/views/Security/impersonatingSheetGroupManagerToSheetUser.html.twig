{% if impersonateView is not null %}
    <div class="well">
        {{ 'sheetGroup.impersonateAs'|trans({
            '%fromEmail%': impersonateView.fromUser.email,
            '%toEmail%': impersonateView.toUser.email,
            '%toFirstName%': impersonateView.toUser.firstname,
            '%toLastName%': impersonateView.toUser.lastname
        }) }}

        <a href="{{ path('event_sheet_group_unswitch', {'sheetGroup' : sheetGroup.id}) }}" class="btn btn-danger">
            {{ 'sheetGroup.quitImpersonation'|trans }}
        </a>
    </div>
{% endif %}
