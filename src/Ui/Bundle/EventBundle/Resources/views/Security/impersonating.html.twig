{% if impersonatingUser %}
    <div class="well">
        {{ 'admin.sheet.impersonateAs'|trans({
            '%adminFullname%': impersonatingUser.fullname,
            '%adminEmail%': impersonatingUser.email,
            '%userEmail%': app.user.email
        }) }}

        <a href="{{ path('event', {'_switchto': '_exit', '_redirect': url('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id })}) }}" class="btn btn-danger">
            {{ 'admin.sheet.exit_impersonation'|trans }}
        </a>
    </div>
{% endif %}
