{% if impersonateView is not null %}
    <div class="well impersonating hidden-xs">
        {{ 'admin.sheet.impersonateAs'|trans({
            '%adminFullname%': impersonateView.fromUser.fullname,
            '%adminEmail%': impersonateView.fromUser.email,
            '%userEmail%': impersonateView.toUser.email
        }) }}

        <a href="{{ impersonateView.exitLink }}" class="btn btn-danger">
            {{ 'admin.sheet.exit_impersonation'|trans }}
        </a>
    </div>
{% endif %}
