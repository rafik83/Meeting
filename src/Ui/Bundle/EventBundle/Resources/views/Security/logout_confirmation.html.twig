{% extends 'EventBundle:Register:base.html.twig' %}

{% block title 'logout.title'|trans %}

{% block content %}
    <section class="main">
        <header>
            <h1><img src="{{ asset('assets/images/icons/icon-key.svg') }}"> {{ 'logout.title'|trans }}</h1>
        </header>

        <div class="main__content">
            <ul class="inputs">
                <li>
                    {{ 'logout.confirmation'|trans }}
                </li>

                <li class="validation">
                    <a href="{{ path('event_logout') }}" class="btn">{{ 'logout.link'|trans }}</a>
                </li>
            </ul>
        </div>
    </section>
{% endblock %}
