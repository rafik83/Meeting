{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form '@Ui/default.html.twig' %}

{% block title 'login.title'|trans %}

{% block content %}
    <section class="main">
        <header>
            <h1><i class="icon-Clef"></i> {{ 'login.connection'|trans }} <span>"{{ 'login.memberArea'|trans }}"</span></h1>
        </header>

        <div class="main__content" id="login-form">
            {% if ssoComexposiumView is defined and ssoComexposiumView is not null %}
                <div class="main__content">
                    {{ include('EventBundle:ThirdParty/Comexposium/SSO:comexposium_sso.html.twig', {
                        'ssoComexposiumView': ssoComexposiumView
                    }, false) }}
                </div>
            {% else %}
                {{ form_start(form, {attr: {class: 'styled-form'}}) }}
                <div class="inputs">
                    <div>
                        <div class="avatar">
                            <img src="{{ asset('assets/images/dummy/default-user.svg') }}">
                        </div>
                    </div>

                    {{ form_row(form.email, {label: false}) }}

                    <div class="validation">
                        <button type="submit" class="btn btn-primary"><i class="icon-Suivant_3"></i> {{ 'common.next'|trans }}</button>
                    </div>
                </div>
                {{ form_end(form) }}

                {{ include('@Event/Security/oauth2_connect.html.twig') }}
            {% endif %}
        </div>
    </section>

    {% if form_errors(form.email) %}
        <section class="important fail">
            {{ form_errors(form.email) }}
        </section>
    {% endif %}

    {% if users is not empty %}
        <h3>1-click login</h3>
        <ul>
            {% for user in users %}
                <li><a href="{{ path('event_login_user', { 'user': user.id }) }}">
                    {{ user.id }} {{ user.email }} {{ user.fullname }}
                </a></li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% if ssoComexposiumView is defined and ssoComexposiumView is not null %}
        {{ include('EventBundle:ThirdParty/Comexposium/SSO:comexposium_sso_js.html.twig', {
            'ssoComexposiumView': ssoComexposiumView
        }, false) }}
    {% endif %}
{% endblock %}
