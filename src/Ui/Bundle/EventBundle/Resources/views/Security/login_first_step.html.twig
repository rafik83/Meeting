{% extends 'EventBundle:Register:base.html.twig' %}

{% form_theme form 'form_div_layout.html.twig' %}

{% block title 'login.title'|trans %}

{% block content %}
    <section class="main">
        <header>
            <h1><img src="{{ asset('assets/images/icons/icon-key.svg') }}"> Connexion <span>"Espace membre"</span></h1>
        </header>

        <div class="main__content">
            {{ form_start(form) }}
            <ul class="inputs">
                <li>
                    <div class="avatar">
                        <img src="{{ asset('assets/images/dummy/default-user.svg') }}">
                    </div>
                </li>

                <li>
                    {{ form_widget(form.username) }}
                </li>

                <li>
                    {{ form_widget(form.password) }}
                </li>

                <li class="validation">
                    <button type="submit" class="btn"><i class="icon-Suivant_3"></i> Suivant</button>
                </li>
            </ul>
            {{ form_end(form) }}
        </div>
    </section>

    {% if error %}
        <section class="important fail">
            <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        </section>
    {% endif %}


    <a href="{{ path('event_forgotten_password') }}">{{ 'login.forgotPassword'|trans }}</a>

    {% if users is not empty %}
        <h3>1-click login</h3>
        <ul>
            {% for user in users %}
                <li><a href="{{ path('event_login_user', { 'user': user.id }) }}">{{ user.username }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
