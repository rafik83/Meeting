{% set config = {
label: 'Participant',
numberOfParticipantShown: 1
}|merge(config|default({})) %}

<div class="object" data-object="participant"{% if uid is defined %} data-uid="{{ uid }}"{% endif %}>
    <ul class="block-buttons list-inline">
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <form action="#" method="GET" class="modal fade configure-modal" tabindex="-1" role="dialog" aria-labelledby="configure-modal-label">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="configure-modal-label">Les participants</h4>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">Label</label>
                                <input class="form-control" type="text" name="label" value="{{ config.label }}" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Nombre de participants affichés sur la fiche</label>
                                <input class="form-control" type="number" name="numberOfParticipantShown" value="{{ config.numberOfParticipantShown }}" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary save-configuration">Enregistrer</button>
                        </div>
                    </div>
                </div>
            </form>
        </li>
    </ul>
    <div data-bind="participant">{{ config.label }}</div>
</div>
