{% set config = { 'label': 'Lien bouton', 'url': '' }|merge(config|default({})) %}

<div class="object" data-object="button-link">
    <ul class="block-buttons list-inline">
        <li>
            <span class="btn btn-link move-button">
                <i class="glyphicon glyphicon-move"></i>
            </span>
        </li>
        <li>
            <button class="btn btn-link delete-button">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </li>
        <li>
            <button class="btn btn-link configure-button">
                <i class="glyphicon glyphicon-cog"></i>
            </button>
            <form action="#" method="GET" class="modal fade configure-modal" tabindex="-1" role="dialog" aria-labelledby="configure-modal-label">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="configure-modal-label">Lien bouton</h4>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">Label</label>
                                <input class="form-control" type="text" name="label" value="{{ config.label }}" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Url</label>
                                <input class="form-control" type="text" name="url" value="{{ config.url }}" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-primary save-configuration">Save changes</button>
                        </div>
                    </div>
                </div>
            </form>
        </li>
    </ul>
    <div>
        <a href="{{ config.url }}" class="btn btn-primary" data-bind="link">{{ config.label }}</a>
    </div>
</div>
