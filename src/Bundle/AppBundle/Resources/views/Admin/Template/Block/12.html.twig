<div class="block" data-block="12">
    <div class="block-buttons">
        <ul class="list-unstyled">
            <li>
                <span class="btn btn-link move-button">
                    <i class="glyphicon glyphicon-move"></i>
                </span>
            </li>
            <li>
                <button class="btn btn-link delete-button">
                    <i class="glyphicon glyphicon-remove"></i>
                </button>
            </li>
        </ul>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="block-inner">
                {% for item in config[0]|default([]) %}
                    {{ include('VimeetAppBundle:Admin/Template/' ~ item.component|capitalize ~ ':' ~ item.type ~ '.html.twig', { 'config': item.config }, false) }}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
