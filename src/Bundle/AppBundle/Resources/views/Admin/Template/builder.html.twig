{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}

    <div data-template-builder class="template-builder">

        <div class="template-container container" id="template-container">

        </div>

        <div class="slide-menu-container" id="template-menu">
            <button class="btn btn-lg btn-default pull-left slide-menu-button" id="template-menu-button" style="margin-top: 30px;">
                <i class="glyphicon glyphicon-chevron-left"></i>
            </button>
            <div class="slide-menu-wrapper">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#blocks" aria-controls="blocks" role="tab" data-toggle="tab">Blocks</a>
                    </li>
                    <li role="presentation">
                        <a href="#objects" aria-controls="objects" role="tab" data-toggle="tab">Objets</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="blocks">

                        <ul class="list-unstyled" id="block-list" style="margin: 20px 0px;">
                            <li data-block-template="{{ '<div class="block"><div class="block-buttons"><ul class="list-unstyled"><li><button class="btn btn-link delete-button"><i class="glyphicon glyphicon-remove"></i></button></li></ul></div><div class="row"><div class="col-md-8"><div class="block-inner"></div></div><div class="col-md-4"><div class="block-inner"></div></div></div></div>'|e }}">
                                <img class="img-responsive thumbnail" src="data:image/png;base64," />
                            </li>
                            <li data-block-template="{{ '<div class="block"><div class="block-buttons"><ul class="list-unstyled"><li><button class="btn btn-link delete-button"><i class="glyphicon glyphicon-remove"></i></button></li></ul></div><div class="row"><div class="col-md-6"><div class="block-inner"></div></div><div class="col-md-6"><div class="block-inner"></div></div></div></div>'|e }}">
                                <img class="img-responsive thumbnail" src="data:image/png;base64," />
                            </li>
                            <li data-block-template="{{ '<div class="block"><div class="block-buttons"><ul class="list-unstyled"><li><button class="btn btn-link delete-button"><i class="glyphicon glyphicon-remove"></i></button></li></ul></div><div class="row"><div class="col-md-12"><div class="block-inner"></div></div></div></div>'|e }}">
                                <img class="img-responsive thumbnail" src="data:image/png;base64," />
                            </li>
                        </ul>

                    </div>
                    <div role="tabpanel" class="tab-pane" id="objects">

                    </div>
                </div>
            </div>
        </div>

    </div>

{% endblock %}
