{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}

    <div data-template-builder="{{ path('admin_template_save', { 'template': template.id }) }}" class="template-builder">

        <div class="container-fluid">
            <h1 class="page-header">{{ template.title }} <button class="btn btn-success" id="template-save-button" data-loading-button="Sauvegarde en cours ...">Enregistrer</button></h1>
        </div>

        <div class="template-container container-fluid" id="template-container"></div>

        <div class="slide-menu-container" id="template-menu">
            <button class="btn btn-lg btn-default pull-left slide-menu-button" id="template-menu-button" style="margin-top: 30px;">
                <i class="glyphicon glyphicon-chevron-left"></i>
            </button>
            <div class="slide-menu-wrapper">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#blocks" aria-controls="blocks" role="tab" data-toggle="tab">Blocks</a>
                    </li>
                    <li role="presentation">
                        <a href="#objects" aria-controls="objects" role="tab" data-toggle="tab">Objets</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="blocks">
                        <div id="block-list" class="block-list">
                            {{ include('VimeetAppBundle:Admin/Template/Block:8-4.html.twig') }}
                            {{ include('VimeetAppBundle:Admin/Template/Block:6-6.html.twig') }}
                            {{ include('VimeetAppBundle:Admin/Template/Block:12.html.twig') }}
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane" id="objects">
                        <div id="object-list" class="object-list">
                            {{ include('VimeetAppBundle:Admin/Template/Object:text.html.twig') }}
                            {{ include('VimeetAppBundle:Admin/Template/Object:editable-text.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

{% endblock %}
