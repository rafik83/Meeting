{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}

    <div data-template-builder class="template-builder">

        <div class="container-fluid">
            <h1 class="page-header">{{ template.title }}</h1>
        </div>

        <div class="template-container container-fluid" id="template-container">


        </div>

        <div class="slide-menu-container" id="template-menu">
            <button class="btn btn-lg btn-default pull-left slide-menu-button" id="template-menu-button" style="margin-top: 30px;">
                <i class="glyphicon glyphicon-chevron-left"></i>
            </button>
            <div class="slide-menu-wrapper">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#blocks" aria-controls="blocks" role="tab" data-toggle="tab">Blocks</a>
                    </li>
                    <li role="presentation">
                        <a href="#objects" aria-controls="objects" role="tab" data-toggle="tab">Objets</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="blocks">

                        <div id="block-list" class="block-list">
                            <div class="block">
                                <div class="block-buttons">
                                    <ul class="list-unstyled">
                                        <li>
                                            <span class="btn btn-link move-button">
                                                <i class="glyphicon glyphicon-move"></i>
                                            </span>
                                        </li>
                                        <li>
                                            <button class="btn btn-link delete-button">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="block-inner"></div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="block-inner"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="block">
                                <div class="block-buttons">
                                    <ul class="list-unstyled">
                                        <li>
                                            <span class="btn btn-link move-button">
                                                <i class="glyphicon glyphicon-move"></i>
                                            </span>
                                        </li>
                                        <li>
                                            <button class="btn btn-link delete-button">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="block-inner"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="block-inner"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="block">
                                <div class="block-buttons">
                                    <ul class="list-unstyled">
                                        <li>
                                            <span class="btn btn-link move-button">
                                                <i class="glyphicon glyphicon-move"></i>
                                            </span>
                                        </li>
                                        <li>
                                            <button class="btn btn-link delete-button">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="block-inner"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div role="tabpanel" class="tab-pane" id="objects">

                    </div>
                </div>
            </div>
        </div>

    </div>

{% endblock %}
