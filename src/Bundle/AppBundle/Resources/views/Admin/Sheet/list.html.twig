{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% import 'VimeetAppBundle:Admin/Common:list_macros.html.twig' as list_macros %}

{% block list_title 'admin.sheet.title'|trans %}

{% block content %}
    <h1 class="page-header">{{ block('list_title') }}</h1>



    {{ form_start(filter_part_form) }}
        {{ form_row(filter_part_form.sheetName) }}
    {{ form_end(filter_part_form) }}

    {{ form_start(batch_form, { 'attr': { 'data-batch': true } }) }}
        {{ form_errors(batch_form) }}

        <div class="row filters">
            <div class="col-md-4">
                <div class="dropdown batch-actions hide">
                    <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <span data-batch-transchoice="{{ 'admin.batch_actions.single'|trans ~ '|' ~ 'admin.batch_actions.plural'|trans }}">{{ 'admin.batch_actions.single'|trans }}</span>
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            {{ form_widget(batch_form.validate) }}
                        </li>
                        <li>
                            <a href="#" data-toggle="modal" data-target="#commercial-follow-up">
                                {{ 'admin.sheet.commercialFollowUp'|trans }}
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        {{ include('VimeetAppBundle:Admin/Common:filters_summary.html.twig', {
            filters:   filters_summary,
            resetLink: path('admin_sheet', { 'event': event.id })
        }) }}

        <table class="table table-hover selectable-row filterable">
            <thead>
            <tr>
                <th class="minwidth">
                    <input type="checkbox" data-batch-all="tbody input[type=checkbox]" title="Tout cocher" />
                </th>
                <th>Fiche</th>
                <th>
                    <div class="dropdown">
                        <button id="state-dropdown" type="button" class="btn btn-link" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Etat
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="state-dropdown">
                            {% for choice in filter_form.state.vars.choices %}
                                <li><a href="?{{ app.request.query.all|merge({'state': choice.value})|url_encode }}">{{ choice.label|trans }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </th>
                <th>
                    <div class="dropdown">
                        <button id="state-dropdown" type="button" class="btn btn-link" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Catégorie
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="state-dropdown">
                            {% for choice in filter_form.category.vars.choices %}
                                <li><a href="?{{ app.request.query.all|merge({'category': choice.value})|url_encode }}">{{ choice.label|trans }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </th>
                <th>
                    <div class="dropdown">
                        <button id="state-dropdown" type="button" class="btn btn-link" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Type
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="state-dropdown">
                            {% for choice in filter_form.type.vars.choices %}
                                <li><a href="?{{ app.request.query.all|merge({'type': choice.value})|url_encode }}">{{ choice.label|trans }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </th>
                <th>Date création</th>
                <th>Dernière connexion</th>
                <th>Suivi commercial</th>
                <th class="text-right">Actions</th>
            </tr>
            </thead>
            <tbody class="sheet-table">
            {% for sheet in sheets.results %}
                <tr>
                    <td>
                        {{ form_widget(batch_form.ids[sheet.id], { 'attr': { 'title': sheet.title } }) }}
                    </td>
                    <td>
                        <a href="{{ path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }) }}">
                            {{ sheet.title }}
                        </a><br>
                        <small>{{ sheet.owner.firstname }} {{ sheet.owner.lastname }} ({{ sheet.owner.email }})</small><br>
                    </td>
                    <td>
                        <span class="label label-default">{{ ('event.sheet.state.' ~ sheet.state)|trans }}</span>
                    </td>
                    <td>{{ sheet.categories|join(', ') }}</td>
                    <td>{{ sheet.type }}</td>
                    <td>{{ sheet.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        {% if sheet.lastLoginAt %}
                            {{ sheet.lastLoginAt|date('d/m/Y H:i') }}
                        {% endif %}
                    </td>
                    <td>{{ sheet.follower }}</td>
                    <td class="text-right">
                        {{ list_macros.btnGroupAndRightMenuDropdown({
                            ('admin.sheet.read'|trans): path('admin_sheet_details', { 'event': event.id, 'sheet': sheet.id }),
                            ('admin.order.link'|trans): path('admin_sheet_billing', { 'event': event.id, 'sheet': sheet.id }),
                            ('admin.sheet.impersonate'|trans): app.request.scheme ~ '://' ~ event.domain ~ path('event_sheet', {'sheet': sheet.id, '_switchto': sheet.impersonationToken})
                        }) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="text-danger text-center">Aucun résultat</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ include('VimeetAppBundle:Paginator:paginate.html.twig', { 'paginator': sheets }) }}

        <div class="modal fade" tabindex="-1" role="dialog" id="commercial-follow-up">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">{{ 'admin.sheet.commercialFollowUp'|trans }}</h4>
                    </div>
                    <div class="modal-body">
                        {{ form_row(batch_form.follower) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                        {{ form_widget(batch_form.assign) }}
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(batch_form) }}
{% endblock %}
