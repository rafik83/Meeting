{% if is_granted('IS_AUTHENTICATED_FULLY') %}
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar"
                        aria-expanded="false" aria-controls="navbar">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="{{ path('admin_event_list') }}">
                    <span class="glyphicon glyphicon-home"></span>
                </a>

                {% if event is defined %}
                    <a class="navbar-brand" href="{{ path('admin_event_read', {'event': event.id}) }}">
                        {{ event.title }}
                    </a>
                {% endif %}
            </div>
            <div id="navbar" class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    {% if event is defined %}
                        <li class="dropdown">
                            <a class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                Actions
                                <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu">
                                {{ include('VimeetAppBundle:Admin/Event:links.html.twig') }}
                            </ul>
                        </li>
                    {% else %}
                        <li>
                            <a href="{{ path('admin_event_list') }}">
                                Mes évènements
                            </a>
                        </li>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <li>
                                <a href="{{ path('admin_list_admin') }}">
                                    {{ 'admin.admin_list.link'|trans }}
                                </a>
                            </li>
                        {% endif %}
                    {% endif %}
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    {% if event is defined %}
                        <li class="dropdown">
                            <a class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                Menu
                                <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a href="{{ path('admin_event_list') }}">
                                        Mes évènements
                                    </a>
                                </li>
                                {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <li>
                                        <a href="{{ path('admin_list_admin') }}">
                                            {{ 'admin.admin_list.link'|trans }}
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>
                        </li>
                    {% endif %}
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                            <span class="glyphicon glyphicon-user"></span>
                            {{ 'admin.login.logged_as'|trans({'%role%': ('admin.role.' ~ app.user.roles[0])|trans, '%lastname%': app.user.lastname, '%firstname%': app.user.firstname}) }}
                            <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li><a href="#">Profile</a></li>
                            <li role="separator" class="divider"></li>
                            <li class="dropdown-header">Language</li>
                            {{ include('VimeetAppBundle::locales.html.twig', { 'locales': ['fr', 'en'] }) }}
                            <li role="separator" class="divider"></li>
                            <li>
                                <a href="{{ path('admin_logout') }}">
                                    {{ 'logout.link'|trans }}
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
{% endif %}
