{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% import 'VimeetAppBundle::macro.html.twig' as macro %}

{% block title 'Liste des intervenants' %}

{% block content %}

    <h1>{{ event.title }}</h1>

    <h2>{{ block('title') }}</h2>

    <table class="table">
        <thead>
        <tr>
            <th>Nom</th>
            <th>Fonction</th>
            <th>Société</th>
            <th>Sous-événements</th>
            <th>
                {% if speakers is not empty %}
                    <a href="{{ path('admin_happening_speaker_create', { 'event': event.id }) }}" class="btn btn-success btn-sm">Ajouter un intervenant</a>
                {% endif %}
            </th>
        </tr>
        </thead>
        <tbody>
            {% for speaker in speakers %}
                <tr>
                    <td>{{ speaker.name }}</td>
                    <td>{{ speaker.function }}</td>
                    <td>{{ speaker.organization }}</td>
                    <td>
                        <ul>
                            {% for happening in speaker.happenings %}
                                <li><a href="{{ path('admin_happening_update', { 'event': event.id, 'happening': happening.id }) }}">{{ happening.title(app.request.locale) }}</a></li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        <a href="{{ path('admin_happening_speaker_read', { 'event': event.id, 'speaker': speaker.id }) }}" class="btn btn-primary btn-sm">Voir</a>
                        <a href="{{ path('admin_happening_speaker_update', { 'event': event.id, 'speaker': speaker.id }) }}" class="btn btn-primary btn-sm">Modifier</a>
                        {{ macro.delete_button(
                            path('admin_happening_speaker_delete', { 'event': event.id, 'speaker': speaker.id }),
                            'Supprimer',
                            { 'class': 'btn btn-danger btn-sm', 'data-confirm': 'Confirmer la suppression' }
                        ) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">
                        Aucun intervenant. <a href="{{ path('admin_happening_speaker_create', { 'event': event.id }) }}" class="btn btn-success">Ajouter un intervenant</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
