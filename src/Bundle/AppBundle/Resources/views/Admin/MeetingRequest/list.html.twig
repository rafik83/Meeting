{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1>{{ event.title }}</h1>

    <h2>Liste des demandes de RDV</h2>

    <h3>Filtrer par statut</h3>
    {{ form_start(filter_form) }}
    <div class="col-md-4">
        {{ form_row(filter_form.state) }}
        {% if filtered %}
            <a href="{{ path('admin_meeting_request_list', {id: event.id}) }}" class="btn btn-link">Vider les filtres</a>
        {% endif %}
    </div>
    <div class="col-md-4">
        {{ form_row(filter_form.submit) }}
    </div>
    {{ form_end(filter_form) }}
    <div class="col-md-4">
        <h4 class="text-right">Nombre de demande de rendez-vous: {{ totalRequest }}</h4>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>De</th>
            <th>à</th>
            <th>Créé le</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        {% for meeting_request in meeting_requests %}
            <tr>
                <td>{{ meeting_request.sheetNameFrom }}</td>
                <td>{{ meeting_request.sheetNameTo }}</td>
                <td>{{ meeting_request.createdAt|date('d/m/Y H:i') }}</td>
                <td>{{ ('admin.meeting_request.list.state.' ~ meeting_request.state)|trans }}</td>
                <td>
                    {% if meeting_request.state == 'approved' %}
                    <a href="{{ path('admin_meeting_request_position', { 'id': event.id, 'request_id': meeting_request.id }) }}" class="btn btn-primary">Placer</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">
                    Aucune demande de RDV
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ knp_pagination_render(meeting_requests) }}

{% endblock %}
