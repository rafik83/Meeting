{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block title 'Positionner un RDV' %}

{% block content %}
    <h1><a href="{{ path('admin_event_read', {event: event.id}) }}">{{ event.title }}</a></h1>

    <h2>Positionner un RDV entre <i>{{ requestView.sheetNameFrom }}</i> et <i>{{ requestView.sheetNameTo }}</i></h2>

    {{ form_start(form) }}

    <p><b>Date de la demande de RDV :</b> {{ requestView.createdAt|date('d/m/Y') }}</p>
    <p><b>Motivation :</b> {{ requestView.description|default('-') }}</p>

    <div class="row">
        <div class="col-md-5">
            <h3>Fiche participation demandeur : {{ requestView.sheetNameFrom }}</h3>
            {{ form_row(form.fromParticipants) }}

            <h3>Fiche participation destinataire : {{ requestView.sheetNameTo }}</h3>
            {{ form_row(form.toParticipants) }}
        </div>

        <div class="col-md-5">
            <h3>Créneau du rendez-vous</h3>
            {{ form_row(form.meetingSlot) }}
        </div>

        <div class="col-md-2">
            {{ form_row(form.submit) }}
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
    var ProximumVimeetMeetingAdd = ProximumVimeetMeetingAdd || {};

    ProximumVimeetMeetingAdd.methods = {
        setFromAndToParticipantsChangeEvent: function() {
            var _this = this;

            $('#meeting_create_fromParticipants input[type="checkbox"]').change(function () {
                _this.loadAvailableMeetingSlotsDependingOnParticipants($(this));
            });

            $('#meeting_create_toParticipants input[type="checkbox"]').change(function () {
                _this.loadAvailableMeetingSlotsDependingOnParticipants($(this));
            });
        },

        loadAvailableMeetingSlotsDependingOnParticipants: function(element) {
            // Simulate form data, but only include the selected fromParticipants values.
            var data = {};
            data = this.getParticipantsData(data, 'fromParticipants');
            data = this.getParticipantsData(data, 'toParticipants');

            var $form = $(element).closest('form');

            $('#meeting_create_meetingSlot').html('...')

            $.ajax({
                url: $form.attr('action'),
                type: $form.attr('method'),
                data: data,
                success: function (html) {
                    // Replace current position field ...
                    $('#meeting_create_meetingSlot').replaceWith(
                            // ... with the returned one from the AJAX response.
                            $(html).find('#meeting_create_meetingSlot')
                    );
                }
            });
        },

        getParticipantsData: function(data, fieldParticipants) {
            $participantsChecked = $('#meeting_create_' + fieldParticipants + ' input:checked');
            if ($participantsChecked.length) {
                var participantsVarName = $($participantsChecked[0]).attr('name').replace('[]', '');
                data[participantsVarName] = [];
                $participantsChecked.each(function (index, checkbox) {
                    data[participantsVarName].push($(checkbox).val());
                });
            }

            return data;
        }
    };

    ProximumVimeetMeetingAdd.methods.setFromAndToParticipantsChangeEvent();
    </script>
{% endblock %}
