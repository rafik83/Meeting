{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1>{{ event.title }}</h1>
    <h2>Ajouter un sous-événement</h2>

    {{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.category) }}
    {{ form_row(form.begin) }}
    {{ form_row(form.end) }}
    {{ form_row(form.titleTranslations) }}
    {{ form_row(form.descriptionTranslations) }}
    <div class="text-right">
        <a href="{{ path('admin_happening_list', { 'id': event.id }) }}" class="btn btn-link">&larr; Retour à la liste</a>
        {{ form_widget(form.submit) }}
    </div>
    {{ form_end(form) }}
{% endblock %}
