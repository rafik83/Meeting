{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1><a href="{{ path('admin_event_read', {event: event.id}) }}">{{ event.title }}</a></h1>
    <h2>Catégories de sous-événement</h2>

    <table class="table">
        <thead>
        <tr>
            <th>Position</th>
            <th>Titre</th>
            <th>Picto</th>
            <th><a href="{{ path('admin_happening_category_create', { 'event': event.id }) }}" class="btn btn-success btn-sm">Ajouter</a></th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.position }}</td>
                <td>{{ category.title }}</td>
                <td>{{ category.picto }}</td>
                <td>
                    <a href="{{ path('admin_happening_category_update', { 'event': event.id, 'category': category.id }) }}" class="btn btn-default">Modifier</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="text-left">
        <a href="{{ path('admin_happening_list', { 'event': event.id }) }}" class="btn btn-link">&larr; Retour aux sous-événements</a>
    </div>
{% endblock %}
