{% if template is not null %}
    <tr>
        <th>Libellé</th>
        <th>Type de champ</th>
        <th>Requis</th>
        <th>Privé</th>
        <th>Contenu</th>
        <th>Action</th>
    </tr>

    {% for key, field in template %}
        <tr>
            <td>{{ field['label'][app.request.locale] }}</td>
            <td>{{ ('template.field.type.' ~ field['type'])|trans }}</td>
            <td>{{ field['required'] is defined ? field['required']|boolean_tick : '' }}</td>
            <td>{{ field['private'] is defined ? field['private']|boolean_tick : '' }}</td>
            <td>{{ field['type'] == 'lib_choice' ? field['choices']|choices_list(app.request.locale) : '' }}</td>
            <td>
                <a href="{{ path('admin_type_template_field_update', {
                    id: event.id,
                    type_id: type.id,
                    template: templateName,
                    key: key
                }) }}" class="btn btn-default btn-sm">Modifier</a>
            </td>
        </tr>
    {% endfor %}

{% elseif linkTo is defined and linkTo is not null %}
    {% set template = null %}

    {% if 'packageTemplate' == linkTo['template'] %}
        {% set template = type.packageTemplate %}
    {% endif %}

    {% if template[linkTo['index']] is defined %}
        <tr>
            <td colspan="5">
                Lien vers "{{ linkTo['template'] }}"
                / "{{ template[linkTo['index']]['label'][app.request.locale] }}"
            </td>
            <td></td>
        </tr>
    {% endif %}
{% else %}
    <tr>
        <td colspan="6">Aucun champ</td>
    </tr>
{% endif %}
