<tr>
    <td>{{ type.label(app.request.locale) }}</td>
    <td>{{ ('template.field.type.' ~ type.rawType)|trans  }}</td>
    <td>{{ type.required|boolean_tick }}</td>
    <td>{{ type.private|boolean_tick }}</td>
    <td></td>
    <td>
        {% if type.isEditable %}
            <a href="{{ path('admin_type_template_field_update', {
                event: event.id,
                type: typeId,
                templateName: templateName,
                group: type.group.name,
                row: type.name
            }) }}" class="btn btn-default btn-xs">Modifier</a>
        {% endif %}
    </td>
</tr>
