<tr>
    <td>{{ type.label(app.request.locale) }}</td>
    <td>{{ ('template.field.type.' ~ type.rawType)|trans  }}</td>
    <td>{{ type.required|boolean_tick }}</td>
    <td>{{ type.private|boolean_tick }}</td>
    <td>
        <div class="row">
            <div class="col-xs-6">
                <input name="order[{{ type.name }}]" value="{{ type.position }}" type="number" class="form-control input-sm" />
            </div>
        </div>
    </td>
    <td>
        {% if type.isEditable %}
            <a href="{{ path('admin_type_template_field_update', {
                event: event.id,
                type: typeId,
                templateName: templateName,
                group: type.group.name,
                row: type.name
            }) }}" class="btn btn-default btn-xs">
                {{ 'template.field.update'|trans }}
            </a>
        {% endif %}
    </td>
</tr>
