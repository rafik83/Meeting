{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block title 'Formulaire type de participation' %}

{% block content %}
    <h1>{{ event.title }}</h1>
    <h2>Formulaire {{ typeView.title }}</h2>

    <table class="table table-striped table-hover">
        <tr>
            <th colspan="6" class="success">
                <h3>Participant</h3>
            </th>
        </tr>
        <tr>
            <th>Libellé</th>
            <th>Type de champ</th>
            <th>Requis</th>
            <th>Privé</th>
            <th>Contenu</th>
            <th>Action</th>
        </tr>
        {% include 'VimeetAppBundle:Admin/TypeForm:row.html.twig' with {
            template: type.participantTemplate
        } %}

        {% for template in [
            { label: 'Fiche de participation', template: type.sheetTemplate },
            { label: 'Forfait', template: type.packageTemplate }
        ] %}
            <tr>
                <th colspan="6" class="success">
                    <h3>{{ template['label'] }}</h3>
                </th>
            </tr>
            <tr>
                <th>Libellé</th>
                <th>Type de champ</th>
                <th>Requis</th>
                <th>Privé</th>
                <th>Contenu</th>
                <th>Action</th>
            </tr>

            {% for blocks in template['template'] %}
                <tr>
                    <th colspan="6" class="info">
                        {{ blocks['label'][app.request.locale] }}
                    </th>
                </tr>

                {% include 'VimeetAppBundle:Admin/TypeForm:row.html.twig' with {
                    template: blocks['template'] is defined ? blocks['template'] : null,
                    linkTo: blocks['linkTo'] is defined ? blocks['linkTo'] : null
                } %}
            {% endfor %}
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
