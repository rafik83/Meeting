{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block title 'Formulaire type de participation' %}

{% block content %}
    <h1><a href="{{ path('admin_type_list', { 'event': event.id }) }}">{{ event.title }}</a></h1>
    <h2>{{ typeView.title }}</h2>

    <ul>
        {% for templateName, template in templates %}
            <li><a href="#{{ templateName }}">{{ ('template.name.' ~ templateName)|trans }}</a></li>
        {% endfor %}
    </ul>

    <table class="table table-striped table-hover">
        {% for templateName, template in templates %}
            <tr>
                <th colspan="6">
                    <h3 id="{{ templateName }}">{{ ('template.name.' ~ templateName)|trans }}</h3>
                </th>
            </tr>
            {% if templateName != 'package' %}
                {% for groupKey, group in template.groups %}
                    {% if group.label(app.request.locale) != 'Default' %}
                        <tr>
                            <th colspan="6" class="info">
                                {{ group.label(app.request.locale) }}
                            </th>
                        </tr>
                    {% endif %}

                    {% include 'VimeetAppBundle:Admin/TypeTemplateField:row.html.twig' with {
                        typeId: typeView.id,
                        templateName: templateName,
                        types: group.types
                    } %}
                {% else %}
                    <tr>
                        <td colspan="6">Aucun champ</td>
                    </tr>
                {% endfor %}
            {% elseif packageObject %}
                {% for step in packageObject.steps %}
                    <tr>
                        <th colspan="6" class="info">
                            {{ step.label(app.request.locale) }}
                        </th>
                    </tr>
                    {% include 'VimeetAppBundle:Admin/TypeTemplateField:packageRow.html.twig' with {step: step} %}
                {% endfor %}
            {% endif %}
        {% endfor %}
    </table>
{% endblock %}
