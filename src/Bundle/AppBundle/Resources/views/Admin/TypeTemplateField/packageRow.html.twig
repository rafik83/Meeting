{% if step.products is not empty %}
    <tr>
        <th>Libellé</th>
        <th>Type de champ</th>
        <th>Requis</th>
        <th>Contenu</th>
        <th>Inclus dans</th>
        <th>Action</th>
    </tr>
    {% for product in step.products %}
        <tr>
            <td>{{ product.label(locale) }}</td>
            <td>{{ product.type }}</td>
            <td>{{ product.required|boolean_tick }}</td>
            <td>{% if product.type == 'choice_with_description' %}
                    <ul>
                        {% for choice in product.choices %}
                            <li>{{ choice.label(locale) }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </td>
            <td>
                <ul>
                    {% for including in product.includedIn %}
                        <li> {{ including.quantity }} inclus avec {{ including.productThatInclude.label(locale) }}</li>
                    {% endfor %}
                </ul>
            </td>
            <td></td>
        </tr>
    {% endfor %}
{% else %}
    <tr>
        <td colspan="6">Aucun champ</td>
    </tr>
{% endif %}
