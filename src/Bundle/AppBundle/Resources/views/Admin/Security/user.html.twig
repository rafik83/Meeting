{% if is_granted('IS_AUTHENTICATED_FULLY') %}
    {% set roles = {'ROLE_OPERATOR': 0, 'ROLE_ORGANIZER': 1,'ROLE_SUPER_ADMIN': 2} %}
    {{ 'admin.login.logged_as'|transchoice(roles[app.user.roles[0]], {'%lastname%': app.user.lastname, '%firstname%': app.user.firstname, '%email%': app.user.email}) }}
    |
    <a href="{{ path('admin_logout') }}">
        {{ 'logout.link'|trans }}
    </a>
{% endif %}
