{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h2>Types de participation</h2>
    <table class="table">
        <thead>
        <tr>
            <th>Titre</th>
            <th>Evénement</th>
            <th>
                <a href="{{ path('admin_type_create', { 'id': event.id }) }}" class="btn btn-success btn-sm">Ajouter</a>
            </th>
        </tr>
        </thead>
        <tbody>
        {% for type in types %}
            <tr>
                <td>{{ type.title }}</td>
                <td>{{ type.eventTitle }}</td>
                <td>
                    <a href="{{ path('admin_type_update', { 'id': event.id, 'type_id': type.id }) }}" class="btn btn-primary btn-sm">Modifier</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
