{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1>{{ event.title }}</h1>
    
    <h2>Types de participation</h2>

    <table class="table">
        <thead>
        <tr>
            <th>Titre</th>
            <th>
                <a href="{{ path('admin_type_create', { 'id': event.id }) }}" class="btn btn-success btn-sm">Ajouter</a>
            </th>
        </tr>
        </thead>
        <tbody>
        {% for type in types %}
            <tr>
                <td>{{ type.title }}</td>
                <td>
                    <a href="{{ path('admin_type_update', { 'id': event.id, 'type_id': type.id }) }}" class="btn btn-primary btn-sm">Modifier</a>
                    <a href="{{ path('admin_type_template_field_list', { 'id': event.id, 'type_id': type.id }) }}" class="btn btn-default btn-sm">Formulaire</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(types) }}
    <div class="text-left">
        <a href="{{ path('admin_event_list') }}" class="btn btn-link">&larr; Retour aux événements</a>
    </div>
{% endblock %}
