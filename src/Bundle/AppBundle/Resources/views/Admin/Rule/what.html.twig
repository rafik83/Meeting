{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1><a href="{{ path('admin_event_read', {event: event.id}) }}">{{ event.title }}</a></h1>

    <h2>{{ 'who.see_who_but_dont_see'|trans({
            '%seer%': ('who.the.' ~ seer.identifier)|trans ~ ' "' ~ seer.getTitle(event.availableLocale(app.request.locale)) ~ '"',
            '%seeable%': ('who.the.' ~ seeable.identifier)|trans ~ ' "' ~ seeable.getTitle(event.availableLocale(app.request.locale)) ~ '"'
        })|capitalize }}</h2>

    {{ form_start(form) }}
    {{ form_errors(form) }}
    {% for key, child in form if key not in ['submit']%}
        {{ form_row(child) }}
    {% endfor %}
    <div class="text-right">
        <a href="{{ path('admin_rule_list', { 'event': event.id }) }}" class="btn btn-link">&larr; Retour à la liste</a>
        {{ form_rest(form) }}
    </div>
    {{ form_end(form) }}
{% endblock %}
