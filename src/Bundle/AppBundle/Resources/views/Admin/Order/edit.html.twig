{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1>{{ sheet_info }}</h1>

    <h2>Commande {{ order.id }}</h2>

    <table class="table table-condensed">
        <thead>
            <tr>
                <th colspan="2">Produit</th>
                <th class="text-right">Prix unitaire</th>
                <th class="text-right">Quantité</th>
                <th class="text-right">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for groupName, group in order_view.groups %}
                <tr class="active">
                    <th colspan="4">{{ group.label }}</th>
                    <td class="text-right">
                        <a href="{{ path('admin_sheet_order_add_row', { 'id': order.id, 'group': groupName }) }}"><i class="glyphicon glyphicon-plus"></i></a>
                    </td>
                </tr>
                {% for row in group.rows %}
                    <tr>
                        <td>&nbsp;</td>
                        <td>{{ row.label }}</td>
                        <td class="text-right">{{ row.unitPrice|number_format(2, ',', ' ') }} €</td>
                        <td class="text-right">{{ row.quantity }}</td>
                        <td class="text-right">{{ row.total|number_format(2, ',', ' ') }} €</td>
                    </tr>
                    {% if row.included is not empty %}
                        <tr>
                            <td>&nbsp;</td>
                            <th colspan="4">Inclus :</th>
                        </tr>
                    {% endif %}
                    {% for included in row.included %}
                        <tr>
                            <td>&nbsp;</td>
                            <td>&gt; {{ included.label }}</td>
                            <td class="text-right">{{ included.unitPrice|number_format(2, ',', ' ') }} €</td>
                            <td class="text-right">{{ included.quantity }}</td>
                            <td class="text-right">{{ included.total|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    {% endfor %}
                {% endfor %}
            {% endfor %}

            <tr class="info">
                <th colspan="4">Total</th>
                <th class="text-right">{{ order_view.total|number_format(2, ',', ' ') }} €</th>
            </tr>
            <tr>
                <th colspan="2"></th>
                <th colspan="2">TVA</th>
                <th class="text-right">{{ order_view.vat }}%</th>
            </tr>
            <tr>
                <th colspan="2"></th>
                <th colspan="2">Total TTC</th>
                <th class="text-right">{{ order_view.totalWithVat|number_format(2, ',', ' ') }} €</th>
            </tr>
        </tbody>

    </table>

    <div class="text-left">
        <a href="{{ path('admin_sheet_order_list', { 'id': order.sheet.event.id, 'sheet_id': order.sheet.id }) }}" class="btn btn-link">&larr; Retour aux commandes</a>
    </div>

{% endblock %}

