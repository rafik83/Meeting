{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1>{{ sheet_info }}</h1>

    <h2>Commande {{ order.id }}</h2>

    <table class="table table-condensed">
        <thead>
            <tr>
                <th colspan="2">Produit</th>
                <th class="text-right">Prix unitaire</th>
                <th class="text-right">Quantité</th>
                <th class="text-right">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for group in order_view.groups %}
                <tr class="active">
                    <th colspan="5">{{ group.label }}</th>
                </tr>
                {% for row in group.rows %}
                    <tr>
                        <td>&nbsp;</td>
                        <td>{{ row.label }}</td>
                        <td class="text-right">{{ row.unitPrice }}</td>
                        <td class="text-right">{{ row.quantity }}</td>
                        <td class="text-right">{{ row.total }}</td>
                    </tr>
                {% endfor %}
            {% endfor %}

            <tr class="info">
                <th colspan="4">Total</th>
                <th class="text-right">11&nbsp;220,00&nbsp;€</th>
            </tr>
            <tr>
                <th colspan="2"></th>
                <th colspan="2">TVA</th>
                <th class="text-right">20%</th>
            </tr>
            <tr>
                <th colspan="2"></th>
                <th colspan="2">Total TTC</th>
                <th class="text-right">13&nbsp;464,00&nbsp;€</th>
            </tr>
        </tbody>

    </table>

    <div class="text-left">
        <a href="{{ path('admin_sheet_order_list', { 'id': order.sheet.event.id, 'sheet_id': order.sheet.id }) }}" class="btn btn-link">&larr; Retour aux commandes</a>
    </div>

{% endblock %}

