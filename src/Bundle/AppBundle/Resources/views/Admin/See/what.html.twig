{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <h1>{{ event.title }}</h1>

    <h2>{{ 'who.see_who_but_dont_see'|trans({
            '%seer%': ('who.the.' ~ seer.identifier)|trans ~ ' "' ~ seer.translations[app.request.locale].title ~ '"',
            '%seeable%': ('who.the.' ~ seeable.identifier)|trans ~ ' "' ~ seeable.translations[app.request.locale].title ~ '"'
        })|capitalize }}</h2>

    {{ form_start(form) }}
    {{ form_errors(form) }}
    {% for key, child in form if key not in ['submit']%}
        {{ form_row(child) }}
    {% endfor %}
    <div class="text-right">
        <a href="{{ path('admin_see_list', { 'id': event.id }) }}" class="btn btn-link">&larr; Retour à la liste</a>
        {{ form_rest(form) }}
    </div>
    {{ form_end(form) }}
{% endblock %}
