{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Langues</th>
                <th>Par défaut</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.title }}</td>
                    <td>
                        <ul>
                            {% for locale in event.locales %}
                                <li>{{ locale|language }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>{{ event.fallback|language }}</td>
                    <td>
                        <a href="{{ path('admin_event_read', { 'event': event.id }) }}" class="btn btn-primary btn-sm">
                            {{ 'admin.event.see.link'|trans }}
                        </a>

                        {% include 'VimeetAppBundle:Admin/Event:links.html.twig' with {event: event} %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
