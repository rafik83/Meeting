{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    {% if is_granted('ROLE_ORGANIZER') %}
        <a href="{{ path('admin_create_operator') }}" class="btn btn-primary">
            {{ 'admin.operator.create.link'|trans }}
        </a>
    {% endif %}

    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Langues</th>
                <th>Par défaut</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle" type="button" data-toggle="dropdown">
                                {{ event.title }}
                                <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu">
                                {{ include('VimeetAppBundle:Admin/Event:links.html.twig', {event: event}) }}
                            </ul>
                        </div>
                    </td>
                    <td>
                        {% for locale in event.locales %}
                            {{ locale|language ~ (not loop.last ? ',' : '') }}
                        {% endfor %}
                    </td>
                    <td>{{ event.fallback|language }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
