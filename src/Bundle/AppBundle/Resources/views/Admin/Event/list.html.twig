{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.title }}</td>
                    <td>
                        <a href="{{ path('admin_event_update', { 'id': event.id }) }}" class="btn btn-primary btn-sm">Modifier</a>
                        <a href="{{ path('admin_rule_list', { 'id': event.id }) }}" class="btn btn-primary btn-sm">Qui voit qui</a>
                        <a href="{{ path('admin_type_list', { 'id': event.id }) }}" class="btn btn-primary btn-sm">Types</a>
                        <a href="{{ path('admin_category_list', { 'id': event.id }) }}" class="btn btn-primary btn-sm">Catégories</a>
                        <a href="{{ path('admin_meeting_request_list', { 'id': event.id }) }}" class="btn btn-primary btn-sm">Demandes de RDV</a>
                        <a href="{{ path('admin_meeting_list', { 'id': event.id }) }}" class="btn btn-primary btn-sm">RDV</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
