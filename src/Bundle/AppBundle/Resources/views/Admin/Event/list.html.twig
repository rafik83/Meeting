{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block content %}
    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.title }}</td>
                    <td>
                        <a href="{{ path('admin_event_read', { 'event': event.id }) }}" class="btn btn-primary btn-sm">Voir</a>
                        {% include 'VimeetAppBundle:Admin/Event:links.html.twig' with {event: event} %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
