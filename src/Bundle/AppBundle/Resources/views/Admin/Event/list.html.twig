{% extends 'VimeetAppBundle:Admin:base.html.twig' %}

{% block body %}
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.title }}</td>
                    <td>
                        <a href="{{ path('admin_event_update', { 'id': event.id }) }}">Edit</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
