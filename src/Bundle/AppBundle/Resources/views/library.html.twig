{% extends 'ElaoThemeTwitterBootstrap3Bundle:Form:form_default_layout.html.twig' %}

{% block choice_with_description_row %}
    {{ form_errors(form) }}
    <table class="table table-bordered table-condensed">
        <thead>
            <th class="col-md-2">{{ 'event.sheet.package.column.label'|trans }}</th>
            <th class="col-md-7">{{ 'event.sheet.package.column.description'|trans }}</th>
            <th class="col-md-1">{{ 'event.sheet.package.column.unitPrice'|trans }}</th>
            <th class="col-md-1">{{ 'event.sheet.package.column.quantity'|trans }}</th>
        </thead>
        <tbody>
            {% for key, child in form.value %}
                <tr>
                    <td>
                        {{ form_widget(child) }}&nbsp;{{ form_label(child) }}
                    </td>
                    <td>
                        {{ template['choices'][key]['description'][locale] }}
                    </td>
                    <td>
                        {{ template['choices'][key]['unitPrice']|number_format_currency('EUR') }}
                    </td>
                    {% if loop.first %}
                        <td rowspan="{{ loop.length }}">
                            {% if template['quantity'] is defined and template['quantity']['min'] != template['quantity']['max'] and form.quantity is defined %}
                                {{ form_row(form.quantity) }}
                            {% elseif template['quantity'] is defined and template['quantity']['min'] == template['quantity']['max'] %}
                                {{ template['quantity']['min'] }}
                            {% else %}
                                1
                            {% endif %}

                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block quantity_row %}
    {{ form_errors(form) }}
    {{ form_widget(form) }}
{% endblock %}
