{% extends 'ElaoThemeTwitterBootstrap3Bundle:Form:form_default_layout.html.twig' %}

{% block quantity %}
    {% if template['quantity'] is defined and form.quantity is defined %}
        {{ form_row(form.quantity) }}
    {% endif %}
{% endblock %}

{% block choice_with_description_row %}
    {{ form_errors(form) }}
    <table class="table table-condensed">
        {{ block('thead') }}
        <tbody>
            {% for child in form.value %}
                <tr>
                    <td>
                        {{ form_widget(child) }}&nbsp;{{ form_label(child) }}
                    </td>
                    <td>
                        {{ template['choices'][child.vars.value]['description'][locale] }}
                    </td>
                    <td>
                        {{ template['choices'][child.vars.value]['unitPrice']|number_format_currency('EUR') }}
                    </td>
                    {% if loop.first and template['quantity'] is defined %}
                        <td rowspan="{{ loop.length }}">
                            {{ block('quantity') }}
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block quantity_row %}
    {{ form_errors(form) }}
    {{ form_widget(form) }}
{% endblock %}

{% block upload_with_choices %}
    {{ form_row(form.file) }}
    {{ form_row(form.value) }}
{% endblock %}

{% block thead %}
    <thead>
        <th class="col-md-2">{{ 'event.sheet.package.column.label'|trans }}</th>
        <th class="col-md-7">{{ 'event.sheet.package.column.description'|trans }}</th>
        <th class="col-md-1">{{ 'event.sheet.package.column.unitPrice'|trans }}</th>
        {% if form.quantity is defined %}
            <th class="col-md-1">{{ 'event.sheet.package.column.quantity'|trans }}</th>
        {% endif %}
    </thead>
{% endblock %}

{% block lib_option_row %}
    {% set multiple_row = false %}
    {% if is_included is defined and is_included == true and quantity_allowed is defined and quantity_allowed != 0 and quantity_included is defined and quantity_included is not null %}
        {% set multiple_row = true %}
    {% endif %}
    {{ form_errors(form) }}
    <table class="table table-condensed">
        {{ block('thead') }}
        <tbody>
            <tr>
                <td {% if multiple_row == true %}rowspan="2"{% endif %}>
                    {{ form_widget(form.value) }}&nbsp;{{ form_label(form.value) }}
                </td>
                <td {% if multiple_row == true %}rowspan="2"{% endif %}>
                    {{ template['description'][locale] }}
                </td>
                <td>
                    {% if is_included is defined and is_included == true and form.quantity is not defined %}
                        {{ 'event.sheet.package.include'|trans }}
                    {% elseif is_included is defined and is_included == true %}
                        {{ 0|number_format_currency('EUR') }}
                    {% else %}
                        {{ template['unitPrice']|number_format_currency('EUR') }}
                    {% endif %}
                </td>
                {% if form.quantity is defined and multiple_row %}
                        <td>
                            {% if quantity_allowed is defined and quantity_allowed != 0 and quantity_included is defined and quantity_included is not null %}
                                {{ 'event.sheet.package.includeQuantity'|transchoice(quantity_included, {'%count%': quantity_included}) }}
                            {% else %}
                                {{ 'event.sheet.package.include'|trans }}
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td>{{ template['unitPrice']|number_format_currency('EUR') }}</td>
                        <td>{{ block('quantity') }}</td>
                {% elseif form.quantity is defined %}
                    <td>
                        {{ block('quantity') }}
                    </td>
                {% endif %}
            </tr>
        </tbody>
    </table>
{% endblock %}

{% block lib_planning_row %}
    {{ form_errors(form) }}
    <table class="table table-condensed">
        <thead>
            <th class="col-md-8">{{ 'event.sheet.package.column.label'|trans }}</th>
            <th class="col-md-2">{{ 'event.sheet.package.column.unitPrice'|trans }}</th>
            <th class="col-md-2">{{ 'event.sheet.package.column.quantity'|trans }}</th>
        </thead>
        <tbody>
            <tr>
                <td>
                    {{ form_errors(form.planning) }}
                    {{ form_widget(form.planning) }}&nbsp;{{ form_label(form.planning) }}
                </td>
                <td>
                    {{ template['unitPrice']|number_format_currency('EUR') }}
                </td>
                <td>
                    {{ form_errors(form.planning_bought) }}
                    {{ form_widget(form.planning_bought) }}
                </td>
            </tr>
        </tbody>
    </table>
{% endblock %}

{% block lib_participant_row %}
    {{ form_errors(form) }}
    <table class="table table-condensed">
        <thead>
            <th class="col-md-8">{{ 'event.sheet.package.column.label'|trans }}</th>
            <th class="col-md-2">{{ 'event.sheet.package.column.unitPrice'|trans }}</th>
            <th class="col-md-2">{{ 'event.sheet.package.column.quantity'|trans }}</th>
        </thead>
        <tbody>
            <tr>
                <td>
                    {{ form_errors(form.participant) }}
                    {{ form_widget(form.participant) }}&nbsp;{{ form_label(form.participant) }}&nbsp;
                    {{ 'event.sheet.package.participant.boughtNumber'|transchoice(boughtParticipant,{'count': boughtParticipant}) }}
                </td>
                <td>
                    {{ template['unitPrice']|number_format_currency('EUR') }}
                </td>
                <td>
                    {{ form_errors(form.participant_bought) }}
                    {{ form_widget(form.participant_bought) }}
                </td>
            </tr>
        </tbody>
    </table>
{% endblock %}
