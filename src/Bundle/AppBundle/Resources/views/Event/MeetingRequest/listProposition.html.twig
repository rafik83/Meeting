{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title 'event.meeting.listProposition.title'|trans %}

{% block content %}
    <h2>{{ 'event.meeting.listProposition.title'|trans }}</h2>
    <table class="table table-bordered">
        <thead>
            <th>{{ 'event.meeting.listProposition.state'|trans }}</th>
            <th>{{ 'event.meeting.listProposition.from'|trans }}</th>
            <th>{{ 'event.meeting.listProposition.participants'|trans }}</th>
            <th>{{ 'event.meeting.listProposition.yourParticipants'|trans }}</th>
            <th>{{ 'event.meeting.listProposition.description'|trans }}</th>
            <th>{{ 'event.meeting.listProposition.createdAt'|trans }}</th>
            <th>{{ 'event.meeting.listProposition.informations'|trans }}</th>
            <th>{{ 'event.meeting.listProposition.actions'|trans }}</th>
        </thead>
        <tbody>
        {% set state = { approved: 'success', sent: 'info', refused: 'danger', cancelled: 'warning' } %}
        {% for proposition_view in proposition_views %}
            <tr>
                <td>
                    <span class="btn-xs alert-{{ state[proposition_view.state] }}">
                        {{ ('event.meeting.request.state.to.' ~ proposition_view.state)|trans }}
                    </span>
                </td>
                <td>{{ proposition_view.sheetNameFrom }}</td>
                <td>{% for participantNameView in proposition_view.fromParticipants %}
                        {{ participantNameView.participantName }}<br>
                    {% endfor %}
                </td>
                <td>{% for participantNameView in proposition_view.toParticipants %}
                        {{ participantNameView.participantName }}<br>
                    {% endfor %}
                </td>
                <td>{{ proposition_view.description|nl2br }}</td>
                <td nowrap>{{ proposition_view.createdAt|date('d/m/Y') }}</td>
                <td>{{ proposition_view.message|nl2br }}</td>
                <td nowrap>
                    {% if proposition_view.state == 'sent' %}
                        <a href="{{ path('event_meeting_request_approved', {

                            'id': sheet.id,
                            'meetingRequest': proposition_view.id
                        }) }}" class="btn btn-xs btn-primary">{{ 'event.meeting.listProposition.accept'|trans() }}</a>
                        <a href="{{ path('event_meeting_request_refused', {

                            'id': sheet.id,
                            'meetingRequest': proposition_view.id
                        }) }}" class="btn btn-xs btn-danger">{{ 'event.meeting.listProposition.refuse'|trans() }}</a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
