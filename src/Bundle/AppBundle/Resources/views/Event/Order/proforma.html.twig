<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8" />
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css">
        <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
    {% endblock %}
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
</head>
<body>
<div class="container">
    <div class="row">
        <div class="col-md-7">
            <h2>Evénement : {{ proforma.eventName }}</h2>
        </div>
        <div class="col-md-5">
            <h2>Informations destinataire :</h2>
            <p>{{ proforma.billingView.organization }}</p>
            <p>{{ proforma.billingView.name }}</p>
            <p>
                {{ proforma.billingView.address }}<br>
                {{ proforma.billingView.zipcode }} {{ proforma.billingView.city }}<br>
                {{ proforma.billingView.country|country }}
            </p>
            <p>N° de TVA intracommunautaire : {{ proforma.billingView.vat_number }}</p>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h2>Liste des participants</h2>
            <ul class="list-unstyled">
                {% for participant in proforma.participants %}
                    <li>{{ participant }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h2>Panier</h2>
            {{ include('VimeetAppBundle:Event/Order:table.html.twig', { 'order': proforma.orderView }, false) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <h2>Informations expéditeur</h2>
            <p>{{ proforma.organizerView.organiserName }}</p>
            <p>{{ proforma.organizerView.paymentAddress|nl2br  }}</p>
            <p>Mail: {{ proforma.organizerView.organiserEmail }}</p>
            <p>
                Coordonnées bancaires:<br>
                {{ proforma.organizerView.bankInfo|nl2br }}
            </p>
            <p>{{ proforma.organizerView.legalInformation|nl2br }}</p>
        </div>
        <div class="col-md-4 col-md-offset-4">
            <h2>Elements à joindre à votre paiement</h2>
            {{ proforma.organizerView.elementToJoinWithInvoice|nl2br }}
        </div>
        <div class="col-md-4 col-md-offset-4">
            <h2>Référence pro-forma:</h2>
            <p>Date: {{ order.createdAt|date('d/m/Y') }}</p>
        </div>
        <div class="col-md-4 col-md-offset-4">
            <h2>Condition de paiement</h2>
            <p>
                - acompte de 50% à l'inscription<br>
                - solde avant 23/10/2015
            </p>
        </div>
    </div>
</div>
{% block javascripts %}
    <script src="https://code.jquery.com/jquery-2.1.4.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/js/bootstrap.min.js"></script>
{% endblock %}
</body>
