{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <p>Confirmer l'annulation de ce rendez-vous ?</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div>
            <a href="{{ path('event_sheet_schedule_meeting', { 'subdomain': app.request.attributes.get('subdomain'), 'id': sheet.id, 'schedule_id': schedule.id, 'meeting_id': meeting.id }) }}" class="btn btn-text">Retour</a>
            {{ form_widget(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}
