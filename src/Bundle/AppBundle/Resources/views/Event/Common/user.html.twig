<p>
    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <a href="{{ path('event_account') }}">{{ 'login.logged_as'|trans({'%email%': app.user.email}) }}</a>

        {{ render(controller('VimeetAppBundle:Event/Notification:unreadNumber')) }}

        |

        <a href="{{ path('event_change_password') }}">
            {{ 'change_password.link'|trans }}
        </a>

        |

        <a href="{{ path('event_logout_confirmation') }}">
            {{ 'logout.link'|trans }}
        </a>
    {% else %}
        {{ 'greetings'|trans }}

        <a href="{{ path('event_login') }}">
            {{ 'login.link'|trans }}
        </a>
    {% endif %}

    | {{ 'now'|format_datetime }}
</p>
