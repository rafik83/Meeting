{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title eventView.title %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}
    <h2>{{ 'event.sheet.block.participants.title'|trans }}</h2>
    {% for participant in sheet.participants %}
        {{ include('VimeetAppBundle:Event:participant.html.twig', { 'template': sheet.type.participantTemplate, 'data': participant.data }) }}
    {% endfor %}
    <a href="{{ path('event_sheet_add_participant', { 'id': sheet.id, 'subdomain': app.request.attributes.get('subdomain') }) }}" class="btn btn-primary">
        {{ 'event.sheet.block.participants.add'|trans }}
    </a>
{% endblock %}
