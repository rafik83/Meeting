{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title eventView.title %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}

    <h2>{{ typeView.title }}</h2>

    <h3>{{ 'event.sheet.block.participants.title'|trans }}</h3>

    <div class="row">
        {% for participantView in participantViews %}
            <div class="col-md-4">
                {% include 'VimeetAppBundle:Event:participant.html.twig' with {
                    'template'               : sheet.type.participantTemplate,
                    'participant'            : participantView,
                    'participant_delete_form': participant_delete_forms is not empty and participant_delete_forms[participantView.id] is defined ? participant_delete_forms[participantView.id] : null
                } %}
            </div>
        {% endfor %}

        <div class="col-md-4">
            <a href="{{ path('event_sheet_add_participant', {
                'id': sheet.id,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">
                {{ 'event.sheet.block.add_participant.title'|trans }}
            </a>
        </div>
    </div>

    {% set data = sheet.data %}

    {% for i, block in sheet.type.sheetTemplate %}
        <h3>
            {{ block['title'][app.request.locale] }}
            <a href="{{ path('event_sheet_update_block', { 'id': sheet.id, 'block': i, 'subdomain': app.request.attributes.get('subdomain') }) }}" class="btn btn-xs btn-default">{{ 'event.sheet.block.edit'|trans }}</a>
        </h3>
        <table class="table table-bordered table-condensed">
            {% for key, field in block.template %}
                {% if field['private'] == 'false' %}
                    <tr>
                        <th class="col-md-3">{{ field['label'][app.request.locale]|default }}</th>
                        <td class="col-md-9">{{ data[i][key]|default('...')|nl2br }}</td>
                    </tr>
                {% endif %}
            {% endfor %}
        </table>
    {% endfor %}

    {% if sheet.type.packageTemplate[0] is defined %}
        <hr>
        <div class="text-center">
            <a href="{{ path('event_sheet_package_update_step', {
                'id'       : sheet.id,
                'step'     : 0,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">
                {{ 'event.sheet.package.step.next'|trans }}
            </a>
        </div>
    {% endif %}
{% endblock %}
