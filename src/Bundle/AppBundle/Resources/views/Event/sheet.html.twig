{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title eventView.title %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}

    <h2>{{ typeView.title }}</h2>

    <h3>{{ 'event.sheet.block.participants.title'|trans }}</h3>

    <div class="row">
        {% for participantView in participantViews %}
            <div class="col-md-3">
                {{ include('VimeetAppBundle:Event:participant.html.twig', {
                    'template': sheet.type.participantTemplate,
                    'participant': participantView
                }) }}
            </div>
        {% endfor %}

        <div class="col-md-3">
            <a href="{{ path('event_sheet_add_participant', {
                'id': sheet.id,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">
                {{ 'event.sheet.block.add_participant.title'|trans }}
            </a>
        </div>
    </div>

    {% set data = sheet.data %}

    {% for i, block in sheet.type.sheetTemplate %}
        <h3>{{ block['title'][app.request.locale] }}</h3>
        <table class="table">
            {% for key, field in block.template %}
                <tr>
                    <th>{{ field['label'][app.request.locale]|default }}</th>
                    <td>{{ data[i][key]|default }}</td>
                </tr>
            {% endfor %}
        </table>
        <a href="{{ path('event_sheet_update_block', { 'id': sheet.id, 'block': i, 'subdomain': app.request.attributes.get('subdomain') }) }}" class="btn btn-primary">Edit</a>
    {% endfor %}
{% endblock %}
