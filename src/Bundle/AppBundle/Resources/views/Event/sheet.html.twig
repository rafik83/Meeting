{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title eventView.title %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}

    <h3>Participants</h3>
    {% for participant in sheet.participants %}
        <div class="row">
            <div class="col-md-{{ 12/sheet.participants|length }}">
                {{ include('VimeetAppBundle:Event:participant.html.twig', { 'template': sheet.type.participantTemplate, 'data': participant.data }) }}
            </div>
        </div>
    {% endfor %}

    {% for block in sheet.type.sheetTemplate %}
        <h3>{{ block['title'][app.request.locale] }}</h3>
        <table class="table">
            {% for key, field in block.template %}
                <tr>
                    <th>{{ field['label'][app.request.locale]|default }}</th>
                    <td>-</td>
                </tr>
            {% endfor %}
        </table>
    {% endfor %}
{% endblock %}
