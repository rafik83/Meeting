{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title 'login.title'|trans %}

{% block content %}
    <h2>{{ 'login.title'|trans }}</h2>

    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {{ form(form) }}
            <a href="{{ path('event_forgotten_password', {'subdomain': app.request.attributes.get('subdomain')}) }}">{{ 'login.forgotPassword'|trans }}</a>
        </div>
    </div>
{% endblock %}
