{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title 'logout.title'|trans %}

{% block content %}
    <h2>{{ 'logout.title'|trans }}</h2>

    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            {{ 'logout.confirmation'|trans }}

            <div class="text-center">
                <a href="{{ path('event_logout') }}"
                   class="btn btn-primary"
                >{{ 'logout.link'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
