{% extends 'VimeetAppBundle::base.html.twig' %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}

    <h2>{{ participantView.typeTitle }}</h2>

    <table class="table">
        {% for key, field in template %}
            <tr>
                <th>{{ field['label'][app.request.locale]|default }}</th>
                <td>{{ participantView.data[key]|default }}</td>
            </tr>
        {% endfor %}
    </table>

{% endblock %}
