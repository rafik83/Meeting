<table class="table table-condensed">
    {% for key, field in template %}
        {% if not (field['private'] is defined and field['private'] == true) %}
            <tr>
                <th class="col-md-3">{{ field['label'][app.request.locale]|default }}</th>
                <td class="col-md-9">
                    {% if 'lib_country' == template[key].type %}
                        {{ data[key]|default|country }}
                    {% elseif 'lib_nomenclature' == template[key].type and data[key].label is defined %}
                        {{ data[key].label }}
                    {% elseif data[key] is defined %}
                        {% if data[key] is iterable and data[key].value is defined %}
                            {{ data[key].value|default('...')|nl2br }}
                        {% else %}
                            {{ data[key]|default('...')|nl2br }}
                        {% endif %}
                    {% else %}
                        ...
                    {% endif %}
                </td>
            </tr>
        {% endif %}
    {% endfor %}
</table>
