{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block content %}
    {% for block in sheet.data %}
        <table class="table">
            {% for key,value in block %}
                <tr>
                    <th>{{ key }}</th>
                    <td>{{ value }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endfor %}
{% endblock %}
