{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block content %}
    <h2>Catalogue "{{ categoryView.title }}"</h2>

    {% for sheet in sheets %}
        {{ include(template_from_string(sheet.type.previewTemplate), { 'sheet': sheet }) }}
        <a href="{{ path('event_catalog_sheet', { 'id': sheet.id, 'categoryView': categoryView.id, 'subdomain': app.request.attributes.get('subdomain') }) }}" class="btn btn-primary">Voir la fiche</a>
    {% endfor %}
{% endblock %}
