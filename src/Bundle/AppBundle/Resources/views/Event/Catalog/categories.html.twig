{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block content %}
    <h2>Catalogue</h2>

    <ul>
        {% for category in categories %}
            <li><a href="{{ path('event_catalog_category', { 'id': category.id, 'subdomain': app.request.attributes.get('subdomain') }) }}">{{ category.title }}</a></li>
        {% endfor %}
    </ul>
{% endblock %}
