<table class="table table-bordered table-condensed">
    {% for key, field in template %}
        {% if field['private'] == 'false' %}
            <tr>
                <th>{{ field['label'][app.request.locale]|default }}</th>
                <td>{{ participantView.data[key]|default }}</td>
            </tr>
        {% endif %}
    {% endfor %}
    <tr>
        <th>{{ 'event.sheet.participant.email'|trans }}</th>
        <td>{{ participantView.userEmail }}</td>
    </tr>
    <tr>
        <td>
            <span class="label label-info">
            {% if participantView.owner %}
                {{ 'event.sheet.participant.owner'|trans }}
            {% else %}
                {{ 'event.sheet.participant.guest'|trans }}
            {% endif %}
            </span>
        </td>
        <td>
            {% if participantView.userId == app.user.id %}
                <a href="{{ path('event_sheet_update_participant', {
                    'id':             sheet.id,
                    'participant_id': participantView.id,
                    'subdomain':      app.request.attributes.get('subdomain')
                }) }}" class="btn btn-xs btn-default">{{ 'event.sheet.block.update_participant.title'|trans }}</a>
            {% endif %}

            {% if participant_delete_form is not null %}
                {{ form_start(participant_delete_form) }}
                {{ form_widget(participant_delete_form.submit, {attr: {class: 'btn btn-xs btn-danger'}}) }}
                {{ form_end(participant_delete_form) }}
            {% endif %}
        </td>
    </tr>
</table>
