{% if slot.begin == slot.end %}
    <p>À {{ slot.begin|date('H:i') }} : {{ slot.title }}</p>
{% else %}
    <p>De {{ slot.begin|date('H:i') }} à {{ slot.end|date('H:i') }} : {{ slot.title }}</p>
{% endif %}

{% if slot.active %}
    <a href="{{ path('event_sheet_schedule_update_unavailability', { 'sheet': sheet.id,'unavailability': slot.id }) }}" class="btn btn-primary btn-xs">Modifier</a>
    <form action="{{ path('event_sheet_schedule_remove_unavailability', { 'sheet': sheet.id, 'unavailability': slot.id }) }}" method="POST" style="display: inline">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="btn btn-danger btn-xs">Supprimer</button>
    </form>
{% endif %}
