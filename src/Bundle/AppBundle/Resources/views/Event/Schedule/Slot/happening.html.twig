{% if slot.begin == slot.end %}
    <p{% if slot.active %} style="font-weight: bold;"{% endif %}>À {{ slot.begin|date('H:i') }} : {{ slot.title }}</p>
{% else %}
    <p{% if slot.active %} style="font-weight: bold;"{% endif %}>De {{ slot.begin|date('H:i') }} à {{ slot.end|date('H:i') }} : {{ slot.title }}</p>
{% endif %}

{% if slot.active %}

    <form action="{{ path('event_sheet_schedule_unparticipate_happening', {  'sheet': sheet.id, 'happening': slot.id, 'participant': participant.id }) }}" method="POST" style="display: inline">
        <button type="submit" class="btn btn-danger btn-xs">Ne pas participer</button>
    </form>
{% else %}
    <a href="{{ path('event_sheet_schedule_participate_happening', {  'sheet': sheet.id, 'happening': slot.id }) }}" class="btn btn-primary btn-xs">Participer</a>
{% endif %}
