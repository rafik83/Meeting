{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    {% for schedule in scheduleViews %}
        <h2>{{ schedule.date|date('d/m/Y') }}</h2>
        <p>
            <a href="{{ path('event_schedule_add_unavailability', { 'subdomain': app.request.attributes.get('subdomain'), 'id': schedule.id }) }}" class="btn btn-primary">Ajouter une indisponibilité</a>
        </p>
        <ul>
            {% for slot in schedule.slots %}
                {% if slot.begin == slot.end %}
                    <li>À {{ slot.begin|date('H:i') }} : {{ slot.title }}</li>
                {% else %}
                    <li>De {{ slot.begin|date('H:i') }} à {{ slot.end|date('H:i') }} : {{ slot.title }}</li>
                {% endif %}
            {% endfor %}
        </ul>
    {% endfor %}
{% endblock %}
