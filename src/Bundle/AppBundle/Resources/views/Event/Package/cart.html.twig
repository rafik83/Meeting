{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <h2>{{ 'event.sheet.cart.title'|trans }}</h2>

    {% if cartView and cartView.groups|length %}
        {{ include('VimeetAppBundle:Event/Package:table.html.twig', { 'order': cartView }, false) }}

        <div class="text-center">
            <a href="{{ path('event_sheet_billing', {
                'id'       : sheet.id,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">
                {{ 'event.sheet.cart.label.billingStep'|trans }}
            </a>
        </div>
    {% else %}
        <div class="alert alert-danger">Aucun produit dans le panier</div>
    {% endif %}
{% endblock %}
