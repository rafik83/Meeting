{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <h2>{{ 'event.sheet.cart.title'|trans }}</h2>
    <table class="table table-condensed">
        <thead>
            <th colspan="2">{{ 'event.sheet.cart.column.product'|trans }}</th>
            <th class="text-right">{{ 'event.sheet.cart.column.unitPrice'|trans }}</th>
            <th class="text-right">{{ 'event.sheet.cart.column.quantity'|trans }}</th>
            <th class="text-right">{{ 'event.sheet.cart.column.total'|trans }}</th>
        </thead>
        <tbody>
        {% for step in cart.cartSteps  %}
            {% if step.cartRows is defined and step.cartRows|length > 0 %}
                <tr class="active">
                    <th colspan="5">{{ step.title }}</th>
                </tr>
                {% for row in step.cartRows %}
                    <tr>
                        <td>&nbsp;</td>
                        <td>{{ row.title }}</td>
                        <td class="text-right">{{ row.unitPrice|number_format_currency('EUR') }}</td>
                        <td class="text-right">{{ row.quantity }}</td>
                        <td class="text-right">{{ row.subtotal|number_format_currency('EUR') }}</td>
                    </tr>
                {% endfor %}
            {% endif %}
        {% endfor %}
        {% if cart.total is defined %}
            <tr class="info">
                <th colspan="4" >{{ 'event.sheet.cart.label.totalPrice'|trans }}</th>
                <th class="text-right">{{ cart.total|number_format_currency('EUR') }}</th>
            </tr>
        {% endif %}
        </tbody>
    </table>

    <div class="text-center">
        <a href="{{ path('event_sheet_billing', {
            'id'       : sheet.id,
            'subdomain': app.request.attributes.get('subdomain')
        }) }}" class="btn btn-primary">
            {{ 'event.sheet.cart.label.billingStep'|trans }}
        </a>
    </div>
{% endblock %}
