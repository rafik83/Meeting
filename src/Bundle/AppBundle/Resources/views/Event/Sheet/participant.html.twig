{% import 'VimeetAppBundle::macro.html.twig' as macro %}

<table class="table table-bordered table-condensed">
    {% for key, field in template %}
        {% if field['private'] == false %}
            <tr>
                <th>{{ field['label'][app.request.locale]|default }}</th>
                <td>{{ participantView.data[key]|default|format_data(template[key], app.request.locale)|nl2br }}</td>
            </tr>
        {% endif %}
    {% endfor %}
    <tr>
        <th>{{ 'event.sheet.participant.email'|trans }}</th>
        <td>{{ participantView.userEmail }}</td>
    </tr>
    <tr>
        <td>
            <span class="label label-info">
            {% if participantView.owner %}
                {{ 'event.sheet.participant.owner'|trans }}
            {% else %}
                {{ 'event.sheet.participant.guest'|trans }}
            {% endif %}
            </span>
        </td>
        <td>
            {% if participantView.userId == app.user.id %}
                <a href="{{ path('event_sheet_update_participant', { 'sheet': sheetDataView.id, 'participant': participantView.id }) }}" class="btn btn-xs btn-default">
                    {{ 'event.sheet.block.update_participant.title'|trans }}
                </a>
            {% endif %}

            {% if not participantView.owner %}
                {{ macro.delete_button(path('event_sheet_delete_participant', { 'sheet': sheet.id, 'participant': participantView.id }), 'Supprimer', { 'class': 'btn btn-danger btn-xs' }) }}
            {% endif %}
        </td>
    </tr>
</table>
