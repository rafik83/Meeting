{% for i, block in blocks %}
    <h3>
        {{ block['label'][app.request.locale] }}

        {% if block.template is defined %}
            <a href="{{ path('event_sheet_update_block', { 'id': sheetDataView.id, 'block': i }) }}" class="btn btn-xs btn-default">
                {{ 'event.sheet.block.edit'|trans }}
            </a>
        {% endif %}
    </h3>

    {% if block.template is defined and sheetDataView.data is defined %}
        {% include 'VimeetAppBundle:Event:blockData.html.twig' with {
            'template': block.template,
            'data': sheetDataView.data[i]|default,
        } %}
    {% endif %}
{% endfor %}
