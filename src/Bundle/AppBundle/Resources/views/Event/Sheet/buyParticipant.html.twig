{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title 'event.sheet.block.buy_participant.title'|trans %}

{% block content %}
    <h2>{{ 'event.sheet.block.buy_participant.title'|trans }}: {{ participantPrice|number_format_currency('EUR') }}</h2>

    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            {{ form_start(form) }}
            {{ form_errors(form.participantData) }}
            {{ form_label(form.participantData) }}
            {{ form_widget(form.participantData) }}

            <h3>{{ 'event.sheet.block.buy_participant.option'|trans }}: {{ planningPrice|number_format_currency('EUR') }}</h3>
            {{ form_errors(form.participantBuyOption) }}
            {{ form_widget(form.participantBuyOption) }}
            {{ form_label(form.participantBuyOption) }}

            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
