{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <ul>
        {% for locale in eventView.locales %}
            <li><a href="{{ path('event_sheet_locale', { 'sheet': preview.id, 'locale': locale }) }}">{{ locale|locale }}</a></li>
        {% endfor %}
    </ul>

    <h2>{{ preview.typeTitle }}</h2>

    <h3>{{ 'event.sheet.block.participants.title'|trans }}</h3>

    <div class="row">
        {% for participant in preview.participants %}
            <div class="col-md-4">
                <table class="table table-bordered table-condensed">
                    {% for row in participant.rows %}
                        <tr>
                            <th>{{ row.label }}</th>
                            <td>{{ row.value }}</td>
                        </tr>
                    {% endfor %}
                    <tr>
                        <th>{{ 'event.sheet.participant.email'|trans }}</th>
                        <td>{{ participant.email }}</td>
                    </tr>
                    <tr>
                        <th>
                            <span class="label label-info">
                                {{ participant.owner ? 'event.sheet.participant.owner'|trans : 'event.sheet.participant.guest'|trans }}
                            </span>
                        </th>
                        <td>
                            {% if participant.editable %}
                                <a href="{{ path('event_sheet_update_participant', { 'sheet': preview.id, 'participant': participant.id }) }}" class="btn btn-xs btn-default">
                                    {{ 'event.sheet.block.update_participant.title'|trans }}
                                </a>
                            {% endif %}

                            {% if not participant.owner %}
                                {{ macro.delete_button(path('event_sheet_delete_participant', { 'sheet': preview.id, 'participant': participant.id }), 'Supprimer', { 'class': 'btn btn-danger btn-xs' }) }}
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </div>
        {% endfor %}

        {% for i in 0..preview.remainingParticipants %}
            <div class="col-md-4">
                <table class="table table-bordered table-condensed" style="height: 160px;">
                    <tr>
                        <td class="text-center">
                            <a href="{{ path('event_sheet_add_participant', { 'sheet': preview.id }) }}" class="btn btn-default">
                                {{ 'event.sheet.block.add_participant.title'|trans }}
                            </a>
                        </td>
                    </tr>
                </table>
            </div>
        {% endfor %}
    </div>

    {% for key, block in preview.blocks %}
        <h3>
            {{ block.title }}
            <a href="{{ path('event_sheet_update_block', { 'sheet': preview.id, 'locale': preview.locale, 'block': key }) }}" class="btn btn-xs btn-default">
                {{ 'event.sheet.block.edit'|trans }}
            </a>
        </h3>
        <table class="table table-condensed">
            {% for row in block.rows %}
                <tr>
                    <th class="col-md-3">{{ row.label }}</th>
                    <td class="col-md-9">{{ row.value }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endfor %}

    <hr />

    {% if preview.orders > 0 %}
        <div class="text-center">
            <a href="{{ path('event_sheet_package_cart', { 'sheet': preview.id }) }}" class="btn btn-primary">
                <span class="glyphicon glyphicon-shopping-cart"></span> Panier
            </a>

            <a href="{{ path('event_sheet_summary', { 'sheet': preview.id }) }}" class="btn btn-primary">
                {{ 'event.sheet.summary.title'|trans }}
            </a>

            <a href="{{ path('event_sheet_list_orders', { 'sheet': preview.id }) }}" class="btn btn-primary">
                {{ 'event.sheet.listOrders.title'|trans }}
            </a>

            <a href="{{ path('event_sheet_package_products', { 'sheet': preview.id }) }}" class="btn btn-primary">{{ 'event.sheet.package.products.title'|trans }}</a>
        </div>
    {% elseif preview.step %}
        <div class="text-center">
            <a href="{{ path('event_sheet_package_update_step', { 'sheet': preview.id, 'step': preview.step }) }}" class="btn btn-primary">
                {{ 'event.sheet.package.step.next'|trans }}
            </a>
        </div>
    {% endif %}
{% endblock %}
