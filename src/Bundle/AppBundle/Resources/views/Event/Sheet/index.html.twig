{% extends 'VimeetAppBundle:Event:base.html.twig' %}

{% block title eventView.title %}

{% block content %}
    <h2>{{ typeView.title }}</h2>

    <h3>{{ 'event.sheet.block.participants.title'|trans }}</h3>

    <div class="row">
        {% for participantView in sheetDataView.participantViews %}
            <div class="col-md-4">
                {% include 'VimeetAppBundle:Event/Sheet:participant.html.twig' with {
                    'sheetDataView': sheetDataView,
                    'template': sheetDataView.type.participantTemplate,
                    'participant': participantView,
                    'participant_delete_form': participant_delete_forms is not empty and participant_delete_forms[participantView.id] is defined ? participant_delete_forms[participantView.id] : null
                } %}
            </div>
        {% endfor %}

        {% if buttonParticipant.canAddParticipant >= 1 %}
            {% for i in 1..buttonParticipant.canAddParticipant %}
                <div class="col-md-4">
                    <table class="table table-bordered table-condensed" style="height: 160px;">
                        <tr>
                            <td class="text-center">
                                <a href="{{ path('event_sheet_add_participant', {
                                    'id': sheetDataView.id,
                                    'subdomain': app.request.attributes.get('subdomain')
                                }) }}" class="btn btn-default">
                                    {{ 'event.sheet.block.add_participant.title'|trans }}
                                </a>
                            </td>
                        </tr>
                    </table>
                </div>
            {% endfor %}
        {% endif %}
        {% if buttonParticipant.canBuyParticipant %}
            <a href="{{ path('event_sheet_buy_participant', {
                'id': sheetDataView.id,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-default">
                {{ 'event.sheet.block.buy_participant.title'|trans }}
            </a>
        {% endif %}
    </div>

    {% include 'VimeetAppBundle:Event/Sheet:block.html.twig' with {
        'sheetDataView': sheetDataView,
        'blocks': sheetDataView.type.sheetTemplate,
        'packageData': sheetDataView.packageData,
        'packageTemplate': sheetDataView.type.packageTemplate,
    } %}

    {% if sheetDataView.type.packageTemplate is not empty and sheetDataView.orders is empty %}
        <hr>
        <div class="text-center">
            <a href="{{ path('event_sheet_package_update_step', {
                'id': sheetDataView.id,
                'step': sheetDataView.type.packageTemplate|keys|first,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">
                {{ 'event.sheet.package.step.next'|trans }}
            </a>
        </div>
    {% elseif sheetDataView.orders is not empty %}
        <div class="text-center">
            <a href="{{ path('event_sheet_summary', {
                'id': sheetDataView.id,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">
                {{ 'event.sheet.summary.title'|trans }}
            </a>

            <a href="{{ path('event_sheet_list_orders', {
                'id': sheetDataView.id,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">
                {{ 'event.sheet.listOrders.title'|trans }}
            </a>

            <a href="{{ path('event_sheet_package_products', {
                'id': sheetDataView.id,
                'subdomain': app.request.attributes.get('subdomain')
            }) }}" class="btn btn-primary">{{ 'event.sheet.package.products.title'|trans }}</a>
        </div>
    {% endif %}
{% endblock %}
