{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title event.title %}

{% block body %}
    {{ 'greetings'|trans }}
    {{ 'now'|format_datetime }}

    <h1>{{ event.title }}</h1>
    <p>{{ event.description }}</p>

    <ul>
        {% for type in participant_types %}
            <li><a href="{{ path('event_register', { 'typeView': type.id, 'subdomain': app.request.attributes.get('subdomain') }) }}">{{ type.title }}</a></li>
        {% endfor %}
    </ul>
{% endblock %}
