{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title 'login.title'|trans %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}

    <h2>{{ 'login.title'|trans }}</h2>

    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {{ form(form) }}
        </div>
    </div>
{% endblock %}
