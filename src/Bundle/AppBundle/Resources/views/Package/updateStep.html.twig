{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title eventView.title %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}

    <h2>{{ stepPackageTemplate['title'][app.request.locale]|default }}</h2>
    <p>{{ stepPackageTemplate['description'][app.request.locale]|default }}</p>
    <hr>

    {{ form_start(form) }}

    {% for key, field in form.children["packageData"].children %}
        {{ form_label(field) }}

        {% if field.vars["label_attr"]["data-description"] is defined %}
            <p>{{ field.vars["label_attr"]["data-description"]|raw }}</p>
        {% endif %}

        {{ form_errors(field) }}

        {% if field.children|length %}
            <table class="table table-bordered table-condensed">
            {% for subkey, subfield in field.children %}
                {% set fieldTemplate = stepPackageTemplate['template'][key]['choices'][subkey] %}
                <tr>
                    <td>
                        {{ form_row(subfield) }}
                    </td>
                    <td>
                        {{ fieldTemplate['description'][app.request.locale]|default|raw }}
                    </td>
                    <td class="text-right">
                        {{ fieldTemplate['unitPrice']|number_format_currency('EUR') }}
                    </td>
                </tr>
            {% endfor %}
            </table>
        {% else %}
            {{ form_widget(field) }}
        {% endif %}
    {% endfor %}

    {{ form_end(form) }}
{% endblock %}
