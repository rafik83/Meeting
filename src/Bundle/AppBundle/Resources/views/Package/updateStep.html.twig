{% extends 'VimeetAppBundle::base.html.twig' %}

{% block title eventView.title %}

{% block body %}
    {{ include('VimeetAppBundle:Event:title.html.twig') }}

    <h2>{{ stepPackageTemplate['title'][app.request.locale]|default }}</h2>
    <p>{{ stepPackageTemplate['description'][app.request.locale]|default }}</p>
    <hr>

    {{ form_start(form) }}

    <table class="table table-bordered table-condensed">
        <thead>
            <th class="col-md-1">{{ 'event.sheet.package.column.choices'|trans }}</th>
            <th class="col-md-2">{{ 'event.sheet.package.column.label'|trans }}</th>
            <th class="col-md-7">{{ 'event.sheet.package.column.description'|trans }}</th>
            <th class="col-md-1">{{ 'event.sheet.package.column.unitPrice'|trans }}</th>
            <th class="col-md-1">{{ 'event.sheet.package.column.quantity'|trans }}</th>
        </thead>
        <tbody>
            {% for key, field in form.children["packageData"].children %}
                   {% include 'VimeetAppBundle:Package:optionField.html.twig' with {
                   'fields': field.children,
                   'template': stepPackageTemplate['template'][key]
                   } %}
           {% endfor %}
        </tbody>
    </table>

   {{ form_end(form) }}
{% endblock %}
