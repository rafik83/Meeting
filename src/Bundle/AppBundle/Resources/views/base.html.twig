<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8" />
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css">
            <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>
    <body>
        <div class="container">
            {% if eventView is defined %}
                {{ render(controller('VimeetAppBundle:Event/Security:impersonatingUser', {'eventView': eventView})) }}
            {% endif %}

            {% block locales %}
                {% if eventView is defined %}
                    {{ include('VimeetAppBundle::locales.html.twig', { 'locales': eventView.locales }) }}
                {% endif %}
            {% endblock %}

            {{ include('VimeetAppBundle::user.html.twig') }}

            {% block body %}{% endblock %}
            {% block javascripts %}
                <script src="https://code.jquery.com/jquery-2.1.4.min.js"></script>
                <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/js/bootstrap.min.js"></script>
            {% endblock %}
        </div>
    </body>
</html>
