<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8" />
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css">
            <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
        {% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>
    <body>
        <div class="container">
            {% if eventView is defined and is_granted('ROLE_PREVIOUS_ADMIN') %}
                {% set impersonatingUser = getImpersonatingUser() %}
                {% if impersonatingUser %}
                    <div class="well">
                        {{ impersonatingUser.firstname ~ ' ' ~ impersonatingUser.lastname }}
                        {{ impersonatingUser.email }}

                        <a href="{{ path('admin_sheet', {'event': eventView.id, '_switch_user': '_exit'}) }}" class="btn btn-danger">
                            Exit impersonation
                        </a>
                    </div>
                {% endif %}
            {% endif %}

            {% block locales %}
                {% if event is defined %}
                    {{ include('VimeetAppBundle::locales.html.twig', { 'locales': event.locales }) }}
                {% else %}
                    {{ include('VimeetAppBundle::locales.html.twig', { 'locales': ['fr', 'en'] }) }}
                {% endif %}
            {% endblock %}

            {{ include('VimeetAppBundle::user.html.twig') }}

            {% block body %}{% endblock %}
            {% block javascripts %}
                <script src="https://code.jquery.com/jquery-2.1.4.min.js"></script>
                <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/js/bootstrap.min.js"></script>
            {% endblock %}
        </div>
    </body>
</html>
