<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8" />
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>
    <body>
        <div class="container">
            {% if eventView is defined %}
                {{ render(controller('VimeetAppBundle:Event/Security:impersonatingUser', {'eventView': eventView})) }}
            {% endif %}

            {% block locales %}
                {% if eventView is defined %}
                    {{ include('VimeetAppBundle:Event/Common:locales.html.twig', { 'locales': eventView.locales }) }}
                {% endif %}
            {% endblock %}

            {{ include('VimeetAppBundle:Event/Common:user.html.twig') }}

            {% block body %}{% endblock %}
            {% block javascripts %}{% endblock %}
        </div>
    </body>
</html>
