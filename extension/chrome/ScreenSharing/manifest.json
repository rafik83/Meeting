{
  "name" : "Vimeet Screensharing Extension",
  "author": "Vimeet",
  "version" : "1.0",
  "manifest_version" : 2,
  "minimum_chrome_version": "34",
  "description" : "",
  "homepage_url": "https://vimeet.events",
  "background": {
    "scripts": ["background-script.js"],
    "persistent": false
  },
  "externally_connectable": {
    "matches": [
      "https://*.vimeet.proximum.dev/*",
      "https://*.vimeet.events/*"
    ]
  },
  "icons": {
    "16": "vimeet16.png",
    "48": "vimeet48.png",
    "128": "vimeet128.png"
  },
  "permissions": [
    "desktopCapture"
  ],
  "web_accessible_resources": [
    "icon.png"
  ]
}
